# TODO: Translation updated at 2021-08-30 23:57

# game/magaz.rpy:63
translate spanish magaz_2bd1e715:

    # nm "Я просыпаюсь на деревянной лавке; перед глазами - узкая и слабо освещенная аллея. До боли знакомая дорога... где же я могла ее видеть?"
    nm "Despierto en un banco de madera. Frente a mí un estrecho y mal iluminado callejón. Un camino extremadamente familiar... ¿Dónde lo habré visto antes?"

# game/magaz.rpy:64
translate spanish magaz_aad6796c:

    # trm "- Ну наконец-то..."
    trm "- Por fin..."

# game/magaz.rpy:70
translate spanish magaz_5b9565ac:

    # nm "Сбоку разносится голос. Я поворачиваюсь и вижу перед собой мальчика с крайне странным выражением лица."
    nm "Escucho una voz a mi lado. Me doy la vuelta y veo a un chico con una extraña expresión en su cara."

# game/magaz.rpy:76
translate spanish magaz_5c56715c:

    # trm "- Ты опоздала!"
    trm "- ¡Llegas tarde!"

# game/magaz.rpy:78
translate spanish magaz_d9ca71a8:

    # ggm "- Эм-м-м... а ты кто?"
    ggm "- Em... ¿quién eres?"

# game/magaz.rpy:79
translate spanish magaz_c96f65e3:

    # nm "Мальчик удивленно моргнул."
    nm "El chico parpadea, confuso."

# game/magaz.rpy:81
translate spanish magaz_9b91e7ea:

    # trm "- Так мы с тобой далеко не уйдем. Попробуй заново."
    trm "- Así no llegaremos a ninguna parte, vuelve a intentarlo."

# game/magaz.rpy:82
translate spanish magaz_92df8506:

    # nm "Затем он набирает полную грудь воздуха."
    nm "Toma una gran bocanada de aire."

# game/magaz.rpy:83
translate spanish magaz_21e45af1:

    # trm "- Ты! Опоздала!"
    trm "- ¡Llegas! ¡Tarde!"

# game/magaz.rpy:85
translate spanish magaz_9dec254e:

    # nm "Я непонимающе смотрю на него. Он непонимающе смотрит на меня."
    nm "Le miro, confusa. Él también me mira confuso."

# game/magaz.rpy:86
translate spanish magaz_60af0f3c:

    # ggm "- И-извини?.."
    ggm "- ¿P-perdón...?"

# game/magaz.rpy:88
translate spanish magaz_400b60e9:

    # nm "Мальчик довольно кивнул."
    nm "El chico asiente, satisfecho."

# game/magaz.rpy:89
translate spanish magaz_77916ef1:

    # trm "- Вот, уже лучше."
    trm "- ¿Lo ves? Mucho mejor."

# game/magaz.rpy:90
translate spanish magaz_e9fa80ce:

    # trm "- Имя-то у тебя есть? Меня вот Треской звать!"
    trm "- ¿Tienes nombre? ¡Yo me llamo Treska!"

# game/magaz.rpy:92
translate spanish magaz_24605459:

    # nm "Я оценивающе оглядываю наглеца. Совсем маленький, а уже лезет с такими вопросами!"
    nm "Le echo un vistazo al mocoso. Es muy joven, ¡y me sale con ese tipo de preguntas!"

# game/magaz.rpy:93
translate spanish magaz_e9fe9f8b:

    # ggm "- Не твое дело..."
    ggm "- No te importa..."

# game/magaz.rpy:94
translate spanish magaz_dfb8a18f:

    # ggm "- И вообще!.. Мне кто-нибудь скажет, что я тут делаю?"
    ggm "- ¡Además...! ¿Puede alguien decirme qué hago aquí?"

# game/magaz.rpy:96
translate spanish magaz_279aff48:

    # trm "- Эй, это невежливо! Будто тут есть кто-то еще..."
    trm "- ¡Qué borde! Aquí no hay nadie más que yo..."

# game/magaz.rpy:98
translate spanish magaz_0619fa6f:

    # nm "..."
    nm "..."

# game/magaz.rpy:100
translate spanish magaz_a899a5fc:

    # trm "- Тебе совсем ничего не рассказали? Вот я все знаю, например!"
    trm "- ¿No te han contado nada? ¡Yo sé todo lo que hay que saber!"

# game/magaz.rpy:102
translate spanish magaz_1d4b75d7:

    # ggm "- О чем?"
    ggm "- ¿Sobre qué?"

# game/magaz.rpy:104
translate spanish magaz_bf91ae6e:

    # trm "- Ты обязана проводить меня в магазин!"
    trm "- ¡Tienes que acompañarme a la tienda!"

# game/magaz.rpy:105
translate spanish magaz_aef4f109:

    # nm "После этих слов Треска встал в победную позу."
    nm "Lo dice haciendo una pose de victoria."

# game/magaz.rpy:107
translate spanish magaz_81f8ed24:

    # ggm "- Еще чего..."
    ggm "- Ni de broma..."

# game/magaz.rpy:109
translate spanish magaz_8decfd91:

    # trm "- Ты ведь понимаешь, что отказ не принимается?"
    trm "- ¿Entiendes que no puedes negarte?"

# game/magaz.rpy:111
translate spanish magaz_efc3c766:

    # ggm "- Многовато ты о себе возомнил."
    ggm "- Que engreído eres."

# game/magaz.rpy:113
translate spanish magaz_c4e65e33:

    # trm "- Я серьезно."
    trm "- Lo digo en serio."

# game/magaz.rpy:114
translate spanish magaz_7516ceb4:

    # trm "- Это, как бы, не мне решать."
    trm "- No lo he decidido yo."

# game/magaz.rpy:115
translate spanish magaz_1eeae098:

    # trm "- Думаешь, я в восторге от такой компании?"
    trm "- ¿Crees que me gusta tu compañía?"

# game/magaz.rpy:117
translate spanish magaz_f10d9bff:

    # nm "Какой-то он странный. То веселый, то грустный, то громкий, то тихий. Ненормальный какой-то. И имя дурацкое."
    nm "Es raro. Su estado de ánimo cambia constantemente, está chiflado. Y su nombre es estúpido."

# game/magaz.rpy:119
translate spanish magaz_9d1124ad:

    # trm "- Мы идем или как?"
    trm "- ¿Vamos o qué?"

# game/magaz.rpy:121
translate spanish magaz_22b68094:

    # ggm "- Ты иди, а мне подумать надо."
    ggm "- Ve tú, yo necesito pensar."

# game/magaz.rpy:123
translate spanish magaz_93798464:

    # trm "- Я бы с радостью, да только дороги не знаю..."
    trm "- Me encantaría, pero no me sé el camino..."

# game/magaz.rpy:124
translate spanish magaz_75266a4b:

    # nm "Треска хитро улыбается. Я с досадой кусаю губы."
    nm "Treska esboza una sonrisa socarrona. Me muerdo el labio con frustración."

# game/magaz.rpy:126
translate spanish magaz_5e5cae60:

    # ggm "- Буду с тобой честна - ты мне совсем не нравишься."
    ggm "- Seré honesta contigo, no me caes bien."

# game/magaz.rpy:127
translate spanish magaz_989f8e80:

    # nm "В ответ он лишь заливается смехом."
    nm "Me responde con una sonora carcajada."

# game/magaz.rpy:131
translate spanish magaz_6c52dd99:

    # trm "- Зато ты мне - очень!"
    trm "- ¡Pues tú a mí sí me gustas!"

# game/magaz.rpy:132
translate spanish magaz_80189b02:

    # nm "После этого он с уверенностью хватает меня за руку - я и рта не успеваю открыть."
    nm "Sin darme tiempo a reaccionar, me agarra de la mano sin dudar."

# game/magaz.rpy:133
translate spanish magaz_b9406d79:

    # trm "- Веди!"
    trm "- ¡Tú primera!"

# game/magaz.rpy:146
translate spanish magaz_03d48903:

    # nm "Дорога до магазина прошла нормально, если не считать того, что Треска шел заметно быстрее."
    nm "Si no fuera porque Treska caminaba mucho más rápido que yo, el trayecto hubiera estado mejor."

# game/magaz.rpy:147
translate spanish magaz_7f15f214:

    # nm "И наоборот - в какие-то моменты он резко останавливался и начинал идти назад, внимательно глядя себе под ноги."
    nm "Y, por otro lado, había momentos en los que se paraba en seco y retrocedía, estudiando la tierra bajo sus pies."

# game/magaz.rpy:148
translate spanish magaz_eaf9b630:

    # nm "В итоге дорога заняла гораздо больше времени, чем могла бы."
    nm "Al final, tardamos en llegar más de lo que se debería."

# game/magaz.rpy:154
translate spanish magaz_cf29981f:

    # nm "Оказавшись у дверей магазина, мы видим перед собой вывеску."
    nm "Al llegar a la tienda, nos da la bienvenida un cartel que dice:"

# game/magaz.rpy:155
translate spanish magaz_214bc86e:

    # nm "'Магазин закрывается через 20 минут!'"
    nm "'¡Cerramos en 20 minutos!'"

# game/magaz.rpy:156
translate spanish magaz_ba5d0e53:

    # ggm "- И взбрело же кому-то в голову таким образом обозначить часы работы своего магазина..."
    ggm "- ¿De quién fue la brillante idea de indicar las horas de trabajo así...?"

# game/magaz.rpy:157
translate spanish magaz_3b104fbf:

    # trm "- Наверно, у них для этого специальный человек есть. Каждые пять минут бегает и меняет табличку. Удобно же!"
    trm "- Probablemente tengan un trabajador solo para eso. Alguien que tiene que estar cambiando la hora cada 5 minutos, ¡qué conveniente!"

# game/magaz.rpy:158
translate spanish magaz_603668ed:

    # ggm "- Шутишь, что ли?"
    ggm "- ¿Estás de coña?"

# game/magaz.rpy:159
translate spanish magaz_72395cef:

    # trm "- Да!"
    trm "- ¡Sí!"

# game/magaz.rpy:160
translate spanish magaz_b706ff96:

    # ggm "- До чего же ты надоедливый..."
    ggm "- Eres insoportable..."

# game/magaz.rpy:161
translate spanish magaz_4e875e76:

    # trm "- Всяко лучше, чем быть занудой! Тебе, кстати, лет-то сколько?"
    trm "- ¡Mejor que ser un aburrido! ¿Cuántos años tienes, por cierto?"

# game/magaz.rpy:162
translate spanish magaz_56bd5b0c:

    # ggm "- Не твое дело."
    ggm "- No te importa."

# game/magaz.rpy:163
translate spanish magaz_7dc314bf:

    # trm "- А-а-а... а зовут как?"
    trm "- A-a-ah... ¿y cómo te llamas?"

# game/magaz.rpy:164
translate spanish magaz_b5ef0b03:

    # ggm "- Не твое дело!"
    ggm "- ¡No te importa!"

# game/magaz.rpy:165
translate spanish magaz_4f29a999:

    # nm "Я уже готова была дать мелкому поганцу подзатыльник, как вдруг за стеклом появляется жуткого вида человек. В руках он держит картонную табличку с надписью 'До закрытия магазина 15 минут!'"
    nm "Estaba a punto de pegarle un buen sopapo al crío, cuando apareció un hombre aterrador al otro lado del escaparate. Sujetando un cartel que decía: '¡Cerramos en 15 minutos!'"

# game/magaz.rpy:166
translate spanish magaz_491606b9:

    # trm "- Пойдем, чего стоишь?"
    trm "- Vamos, ¿a qué esperas?"

# game/magaz.rpy:167
translate spanish magaz_b3e070b9:

    # ggm "- А? Д-да..."
    ggm "- ¿Eh? Ah, sí..."

# game/magaz.rpy:177
translate spanish magaz_bda9d19f:

    # nm "В очередной раз проходя мимо длинного ряда с консервными банками, мы поняли, что заблудились."
    nm "Tras otra vuelta por la sección de productos enlatados, nos damos cuenta de que nos hemos perdido."

# game/magaz.rpy:178
translate spanish magaz_fab2588c:

    # ggm "- Поверить не могу, что ты не знаешь, где продается молоко."
    ggm "- No me puedo creer que no sepas dónde está la leche."

# game/magaz.rpy:179
translate spanish magaz_d2bc0976:

    # trm "- Я... эм-м-м..."
    trm "- Yo... emmm..."

# game/magaz.rpy:180
translate spanish magaz_fa0c299d:

    # ggm "- Может, спросим кого-нибудь?"
    ggm "- ¿Quizá deberíamos preguntarle a alguien?"

# game/magaz.rpy:181
translate spanish magaz_72bfe8b3:

    # trm "- Давай!"
    trm "- ¡Claro!"

# game/magaz.rpy:182
translate spanish magaz_cd2f6b76:

    # ggm "- Эй, постой!.."
    ggm "- Eh, ¡espera...!"

# game/magaz.rpy:183
translate spanish magaz_449dcf56:

    # nm "Треска отпустил мою руку и уверенно зашагал к одному из немногочисленных посетителей магазина. Тот стоял спиной к нам, что-то сосредоточенно рассматривая на прилавке."
    nm "Treska me suelta la mano y camina decidido hacia uno de los clientes. Esa persona está dándonos la espalda, fijándose en algo de los estantes."

# game/magaz.rpy:184
translate spanish magaz_d1671cc2:

    # trm "- Здрасьте, а можно!.."
    trm "- ¡Hola, ¿podría...?!"

# game/magaz.rpy:185
translate spanish magaz_7b64269c:

    # nm "Последнюю часть вопроса я не расслышала - как и ответ на него. Но мой непутевый друг внезапно застыл как вкопанный, глядя прямо в глаза посетителя магазина. Я поспешила подойти к ним."
    nm "No llego a escuchar la segunda parte de su pregunta ni la respuesta, pero mi inútil amigo se quedá completamente paralizado, mirando al cliente a los ojos. Me acerco rápidamente."

# game/magaz.rpy:191
translate spanish magaz_73ff8128:

    # mm "- Это ваш?"
    mm "- ¿Es tu hijo?"

# game/magaz.rpy:192
translate spanish magaz_fbc1a18a:

    # nm "Посетитель обратился ко мне. В его голосе явно слышалось отвращение, а на лице застыла презрительная гримаса."
    nm "Me habla a mí, habla con asco. Habla con asco mientras pone expresión de desprecio."

# game/magaz.rpy:203
translate spanish magaz_a3ef7e99:

    # ggm "- Я... эм-м..."
    ggm "- Yo... esto..."

# game/magaz.rpy:204
translate spanish magaz_2f529462:

    # mm "- Если так, то будьте добры - уберите его подальше."
    mm "- Si es tuyo, aléjalo de mí, por favor."

# game/magaz.rpy:205
translate spanish magaz_6277046c:

    # ggm "- Д-да, извините..."
    ggm "- S-sí, disculpe..."

# game/magaz.rpy:206
translate spanish magaz_5ffc47dc:

    # nm "Я хватаю Треску за руку и спешу увести в сторону - тот все глядит на посетителя, открыв рот и выпучив глаза. И дрожит."
    nm "Agarro a Treska de la mano y nos alejamos. Él sigue mirando al cliente, con la boca abierta y los ojos como platos. Está temblando."

# game/magaz.rpy:216
translate spanish magaz_5a6e2c0e:

    # nm "Лишь когда мы свернули за угол, Треска успокоился."
    nm "Treska no se calma hasta que doblamos la esquina."

# game/magaz.rpy:217
translate spanish magaz_c7dd33e3:

    # ggm "- Ну и как это понимать?"
    ggm "- ¿Qué ha pasado?"

# game/magaz.rpy:218
translate spanish magaz_a38d3841:

    # trm "- Я... я так перепугался!.. Он сказал..."
    trm "- Yo... ¡me he asustado tanto...! Ha dicho..."

# game/magaz.rpy:219
translate spanish magaz_72d73855:

    # ggm "- Что?"
    ggm "- ¿Qué?"

# game/magaz.rpy:220
translate spanish magaz_b9c8f9d0:

    # trm "- НЕТ, ТОЛЬКО НЕ ОПЯТЬ!"
    trm "- ¡NO, OTRA VEZ NO!"

# game/magaz.rpy:221
translate spanish magaz_32dc5f00:

    # nm "Внезапно Треска завопил как сумасшедший. Я зажимаю ему рот ладонью; его лицо буквально горит, а сам он плачет."
    nm "De repente, comienza a gritar como un loco. Le tapo la boca; le arde la cara y está llorando."

# game/magaz.rpy:222
translate spanish magaz_08dc37af:

    # ggm "- Ты можешь вести себя нормально?"
    ggm "- ¿Puedes actuar como una persona normal?"

# game/magaz.rpy:223
translate spanish magaz_b551f5ad:

    # trm "- Т-ты не понимаешь..."
    trm "- T-tú no lo entiendes..."

# game/magaz.rpy:224
translate spanish magaz_96ec9ded:

    # ggm "- Ну конечно, что я вообще могу понимать!"
    ggm "- ¡Pues claro que no, no entiendo nada!"

# game/magaz.rpy:225
translate spanish magaz_66e633dd:

    # ggm "- Вот только приставать к людям - это неправильно. Этого, видимо, не понимаешь ты."
    ggm "- Aún así, molestar a los demás no está bien, parece que no lo entiendas."

# game/magaz.rpy:226
translate spanish magaz_a70710db:

    # trm "- Ты злая!.. Хнык.."
    trm "- ¡Eres mala...! Buaaa..."

# game/magaz.rpy:227
translate spanish magaz_d45f1565:

    # ggm "- Я?.."
    ggm "- ¿Quién, yo...?"

# game/magaz.rpy:233
translate spanish magaz_828f1904:

    # nm "Оттолкнув меня, Треска убежал прочь."
    nm "Treska me empuja y sale corriendo."

# game/magaz.rpy:239
translate spanish magaz_ce7396de:

    # ggm "- Блин."
    ggm "- Joder."

# game/magaz.rpy:240
translate spanish magaz_0e1cb3a1:

    # nm "Краем глаза я замечаю, как работник магазина вешает на дверь новую табличку."
    nm "Por el rabillo del ojo, veo al dependiente de la tienda colgando otro cartel en la puerta."

# game/magaz.rpy:246
translate spanish magaz_15b5e8ae:

    # ggm "- Вот ты где!"
    ggm "- ¡Ahí estás!"

# game/magaz.rpy:247
translate spanish magaz_f896812e:

    # nm "Я встречаю Треску у кассы. До этого я успела сбегать в молочный отдел, предварительно узнав, где он находится."
    nm "Me encuentro con Treska en la caja. Pero antes de eso, logré encontrar la sección de lácteos."

# game/magaz.rpy:248
translate spanish magaz_d51b64cb:

    # mm "- Эй, шевелись!"
    mm "- ¡Oye, apártate!"

# game/magaz.rpy:249
translate spanish magaz_9ee11605:

    # nm "Недовольный голос раздался с конца длинной очереди, что образовалась позади Трески. Я протискиваюсь к нему."
    nm "Escucho una voz enfadada viniendo del otro lado de la larga fila formada detrás de Treska. Me apretujo entre la gente para llegar a él."

# game/magaz.rpy:250
translate spanish magaz_d71944d4:

    # ggm "- Что случилось?"
    ggm "- ¿Qué ha pasado?"

# game/magaz.rpy:251
translate spanish magaz_271d3bbb:

    # nm "Мальчик не отвечает. Смотрит себе под ноги, едва слышно хныкая, а кассир коршуном нависает над ним. Между ними лежит пакет молока."
    nm "El chico no responde, se mira a los pies y resuella. El cajero se cierne sobre él. Hay una bolsa de leche entre ellos."

# game/magaz.rpy:252
translate spanish magaz_73ff8128_1:

    # mm "- Это ваш?"
    mm "- ¿Es suyo?"

# game/magaz.rpy:253
translate spanish magaz_7cf04c09:

    # ggm "- Мой."
    ggm "- Sí."

# game/magaz.rpy:254
translate spanish magaz_630ff660:

    # mm "- В следующий раз оставьте его дома."
    mm "- Déjele en casa la próxima vez."

# game/magaz.rpy:255
translate spanish magaz_cc8f5d69:

    # nm "Люди в очереди согласно кивают."
    nm "La gente de la fila asiente."

# game/magaz.rpy:256
translate spanish magaz_4c8b218b:

    # mm "- Оплатите стоимость товара."
    mm "- Pague los productos, por favor."

# game/magaz.rpy:257
translate spanish magaz_6bad1905:

    # ggm "- Да, конечно..."
    ggm "- Sí, claro..."

# game/magaz.rpy:258
translate spanish magaz_04ace94f:

    # mm "- И издержку за ожидание!"
    mm "- ¡Y la tasa por la espera!"

# game/magaz.rpy:259
translate spanish magaz_1676dc10:

    # ggm "- Ч-что?"
    ggm "- ¿Q-qué?"

# game/magaz.rpy:260
translate spanish magaz_7be05a24:

    # mm "- Вы слышали."
    mm "- Ya me ha oído."

# game/magaz.rpy:261
translate spanish magaz_9428ac7b:

    # ggm "- Я-то слышала, но это же неслыханно!"
    ggm "- Ya, ¡pero nunca había escuchado sobre eso!"

# game/magaz.rpy:266
translate spanish magaz_4daaff38:

    # nm "Вдруг Треска начинает хихикать."
    nm "Treska comienza a reír de repente."

# game/magaz.rpy:267
translate spanish magaz_84a35435:

    # mm "- И за то, что ваш сын придурок, тоже заплатите!"
    mm "- ¡Y porque su hijo es un retrasado, también!"

# game/magaz.rpy:268
translate spanish magaz_d3f5b609:

    # ggm "- Н-но..."
    ggm "- P-pero..."

# game/magaz.rpy:269
translate spanish magaz_7be05a24_1:

    # mm "- Вы слышали."
    mm "- Ya me ha oído."

# game/magaz.rpy:270
translate spanish magaz_fe838a88:

    # ggm "- Знаете, что?!.."
    ggm "- ¡¿Sabe qué...?!"

# game/magaz.rpy:271
translate spanish magaz_ed507361:

    # nm "В гневе я бросаю кассиру смятую купюру гораздо большего номинала, чем требовалось - даже с учетом всех идиотских надбавок - хватаю пакет молока и круто разворачиваюсь."
    nm "En un arranque de ira, le tiro un billete al cajero, de más valor que el necesario, incluso contando las estúpidas tasas. Agarro la bolsa de leche y me doy la vuelta."

# game/magaz.rpy:272
translate spanish magaz_8433e4f1:

    # ggm "- Мы уходим, Треска!"
    ggm "- Treska, ¡nos vamos!"

# game/magaz.rpy:278
translate spanish magaz_07f73956:

    # nm "Всю дорогу из магазина мы шли молча. В какой-то момент мы незаметно для себя свернули вправо и оказались у автозаправки - тогда-то Треска и решил нарушить молчание."
    nm "Nos pasamos el viaje de vuelta en silencio. Llega un momento en que giramos a la derecha, hacia una gasolinera. Ahí, Treska rompe su silencio."

# game/magaz.rpy:279
translate spanish magaz_11b4592c:

    # trm "- Любишь мороженое?"
    trm "- ¿Te gusta el helado?"

# game/magaz.rpy:280
translate spanish magaz_4cd3ac67:

    # ggm "- Нет."
    ggm "- No."

# game/magaz.rpy:281
translate spanish magaz_ef883331:

    # trm "- Ладно..."
    trm "- Vale..."

# game/magaz.rpy:282
translate spanish magaz_0a0e5a9c:

    # nm "Я смотрю в поникшее лицо мальчика - на секунду в его глазах блеснул огонек и тут же погас."
    nm "Miro la cara del chico. Durante una fracción de segundo, una luz brilla en sus ojos y se desvanece."

# game/magaz.rpy:283
translate spanish magaz_8734db3e:

    # trm "- Знаешь..."
    trm "- Sabes..."

# game/magaz.rpy:284
translate spanish magaz_f6ae2c25:

    # nm "Он уверенно сворачивает с тропы прямо на автомобильную дорогу. Я провожаю его недоуменным взглядом."
    nm "Se desvía del camino y anda hacia la autopista con decisión. Miro su espalda, confundida."

# game/magaz.rpy:296
translate spanish magaz_1f80669a:

    # trm "- Похоже, ты мне совсем не помогаешь."
    trm "- Parece que no me estás ayudando nada..."

# game/magaz.rpy:297
translate spanish magaz_783d379e:

    # nm "В глазах Трески вновь блестит озорной огонек..."
    nm "Un brillo travieso titila en los ojos de Treska..."

