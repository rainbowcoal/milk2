# game/pnc_text.rpy:11
translate spanish backpack_38718438:

    # "Я опускаю глаза. Нелепый и потрепанный, мой школьный рюкзак словно кричит о своей бесполезности."
    "Miro hacia abajo. Ridícula y en mal estado, mi mochila grita por su inutilidad."

# game/pnc_text.rpy:12
translate spanish backpack_2678b6c1:

    # "С другого угла он похож на набитое брюхо - его содержимое точно так же переваривается, разлагается и превращается в густую кашу."
    "Desde otro ángulo, parece una barriga: el contenido lo digiere de la misma forma, lo descompone y lo convierte en una papilla espesa."

# game/pnc_text.rpy:14
translate spanish backpack_61aaf7e3:

    # gg "- Классно я придумала, надо бы запомнить..."
    gg "- Se me ha ocurrido una idea genial, debo recordarla..."

translate spanish strings:
    # game/pnc_text.rpy:15
    old "(Совсем не классно.)"
    new "(No es nada genial.)"

    # game/pnc_text.rpy:15
    old "(Совсем не классно. Мерзко и ужасно.)"
    new "(No es genial, es cruel y de mal gusto.)"

# game/pnc_text.rpy:21
translate spanish backpack_e615eecb:

    # gg "- А вот и нет - мой тебе ответ!"
    gg "- ¡Ladra chucho, que no te escucho!"

translate spanish strings:
    # game/pnc_text.rpy:22
    old "(Ты что, смеешься надо мной?)"
    new "(¿Te estás riendo de mí?)"

# game/pnc_text.rpy:27
translate spanish backpack_06036bad:

    # gg "- Обижаешь... ведь ты мне как родной! Хи-хи!"
    gg "- Me ofendes... ¡para mí, eres como de la familia! ¡Iji-ji!"

translate spanish strings:
    # game/pnc_text.rpy:28
    old "(Я не собираюсь продолжать этот цирк, поняла?)"
    new "(No voy a continuar con este circo, ¿entiendes?)"

# game/pnc_text.rpy:32
translate spanish backpack_b5138861:

    # gg "- Поняла!"
    gg "- ¡Entendido!"

# game/pnc_text.rpy:37
translate spanish backpack_557726c8:

    # gg "- Эй, в этот раз я не специально!.."
    gg "- ¡Oye, esta vez no ha sido a propósito...!"

translate spanish strings:
    # game/pnc_text.rpy:39
    old "(Лучше расскажи мне, что внутри твоего рюкзака.)"
    new "(Dime qué hay dentro de tu mochila.)"

# game/pnc_text.rpy:44
translate spanish backpack_9fc41a8b:

    # gg "- Да ничего особенного... книжки всякие, в основном."
    gg "- Nada especial... libros y poco más."

# game/pnc_text.rpy:47
translate spanish backpack_d0f08302:

    # gg "- Все карандаши и тетради я оттуда вытащила, а остальное меня не интересует."
    gg "- Saqué todos los lápices y cuadernos, esas cosas no me interesan."

translate spanish strings:
    # game/pnc_text.rpy:50
    old "(Ты ведь когда-то ходила в школу, да?)"
    new "(Antes ibas a la escuela, ¿verdad?)"

# game/pnc_text.rpy:54
translate spanish backpack_eceef613:

    # gg "- Ага, ходила. Отлично провела время, кстати!"
    gg "- Sí. ¡Allí lo pasaba muy bien!"

translate spanish strings:
    # game/pnc_text.rpy:55
    old "(...ты точно поняла мой вопрос?)"
    new "(¿...has entendido mi pregunta?)"

# game/pnc_text.rpy:59
translate spanish backpack_e624daf9:

    # gg "- Думаешь, все в моей жизни должно быть печально и угрюмо? А вот и нет!"
    gg "- ¿Piensas que mi vida debería ser triste y oscura? ¡Pues te equivocas!"

translate spanish strings:
    # game/pnc_text.rpy:60
    old "(Ну ладно, ладно. Что тебе больше всего понравилось?)"
    new "(Vale, vale. ¿Qué era lo que más te gustaba de allí?)"

# game/pnc_text.rpy:64
translate spanish backpack_c92e01ee:

    # gg "- Хм-м-м..."
    gg "- Mmm..."

# game/pnc_text.rpy:67
translate spanish backpack_79c4eff2:

    # gg "- Ну... В помещениях было очень светло, совсем не так, как дома."
    gg "- A ver... las habitaciones eran luminosas, no como en casa."

translate spanish strings:
    # game/pnc_text.rpy:68
    old "(И все?)"
    new "(¿Eso es todo?)"

# game/pnc_text.rpy:72
translate spanish backpack_3d194e3c:

    # gg "- Да погоди ты! Дай вспомнить..."
    gg "- ¡Un segundo! Déjame recordar..."

# game/pnc_text.rpy:75
translate spanish backpack_c7d3b724:

    # gg "- Ну, кровати были мягкие... Да и кормили неплохо."
    gg "- Bueno, las camas eran cómodas... y la comida estaba rica."

# game/pnc_text.rpy:78
translate spanish backpack_40cd7f87:

    # gg "- Между прочим, я всегда была на уроках! Остальные вечно прогуливали."
    gg "- Por cierto, ¡nunca faltaba a clase! Los demás siempre hacían pellas."

# game/pnc_text.rpy:81
translate spanish backpack_a6aff8dc:

    # gg "- Ох и досталось же им, наверно!"
    gg "- ¡Seguro que les reñían mucho!"

# game/pnc_text.rpy:84
translate spanish backpack_bc809e1d:

    # "Я слегка улыбаюсь, предаваясь теплым воспоминаниям."
    "Sonrío levemente, disfrutando de los buenos recuerdos."

translate spanish strings:
    # game/pnc_text.rpy:85
    old "(Ты ведь так и не закончила школу.)"
    new "(Pero nunca llegaste a graduarte.)"

# game/pnc_text.rpy:89
translate spanish backpack_b98b4ac4:

    # gg "- Ага."
    gg "- Ya."

translate spanish strings:
    # game/pnc_text.rpy:90
    old "(Помнишь свой последний день?)"
    new "(¿Recuerdas tu último día?)"

# game/pnc_text.rpy:94
translate spanish backpack_d2c4cf06:

    # gg "- ..."
    gg "- ..."

# game/pnc_text.rpy:95
translate spanish backpack_a707915e:

    # gg "- День как день."
    gg "- Fue un día normal."

# game/pnc_text.rpy:98
translate spanish backpack_94074f87:

    # gg "- Папа забрал меня пораньше - объяснил, что я уже выросла из школьной программы. Да я и сама это понимала, уж больно простыми были задания..."
    gg "- Papá vino a recogerme pronto; me dijo que era ya había aprobado el curso. Yo también me había dado cuenta, las tareas eran demasiado fáciles..."

# game/pnc_text.rpy:99
translate spanish backpack_1e7bb71c:

    # gg "- Потом мы сели в машину и поехали домой. Дома нас встретила мама, мы втроем поужинали и разошлись по комнатам."
    gg "- Subimos al coche y volvimos a casa. Mamá nos dio la bienvenida, cenamos y nos fuimos cada uno a su cuarto."

translate spanish strings:
    # game/pnc_text.rpy:100
    old "(А что было потом?)"
    new "(¿Y, entonces, qué pasó?)"

# game/pnc_text.rpy:104
translate spanish backpack_f52d7a56:

    # gg "- Не помню. Да и какая, в сущности, разница?"
    gg "- No me acuerdo. ¿Acaso importa?"

translate spanish strings:
    # game/pnc_text.rpy:100
    old "(Не похоже, что этот день хоть что-то значит для тебя.)"
    new "(Supongo que ese día no significa nada especial para ti.)"

# game/pnc_text.rpy:109
translate spanish backpack_3ac67b90:

    # gg "- Говорю же, день как день."
    gg "- Ya te lo he dicho, fue un día como cualquier otro."

translate spanish strings:
    # game/pnc_text.rpy:110
    old "(Ладно.)"
    new "(Bueno...)"

# game/pnc_text.rpy:115
translate spanish backpack_808e1266:

    # gg "- Вот и славно."
    gg "- Bien."

translate spanish strings:
    # game/pnc_text.rpy:110
    old "(Расскажи еще раз.)"
    new "(Cuéntamelo otra vez.)"

# game/pnc_text.rpy:120
translate spanish backpack_54f27d0a:

    # gg "- У тебя что, с памятью плохо?"
    gg "- ¿Tan mala memoria tienes?"

translate spanish strings:
    # game/pnc_text.rpy:121
    old "(Ну пожалуйста!)"
    new "(¡Va, por favor!)"


# game/pnc_text.rpy:125
translate spanish backpack_37182073:

    # gg "- Ладно уж..."
    gg "- Ay, vale..."

# game/pnc_text.rpy:128
translate spanish backpack_7fc0b6b4:

    # gg "- В тот день папа забрал меня с учебы пораньше, объяснив это тем, что мне пора взрослеть."
    gg "- Ese día, papá vino a buscarme antes de tiempo, y me dijo que era hora de que me hiciera mayor."

# game/pnc_text.rpy:129
translate spanish backpack_326cf169:

    # gg "- Не то, чтобы я до конца понимала, что он имел в виду..."
    gg "- No entendí del todo lo que me quiso decir..."

# game/pnc_text.rpy:130
translate spanish backpack_dad097f6:

    # gg "- Так или иначе, я не сопротивлялась. Мы сели в машину и поехали домой."
    gg "- Aún así, no me quejé. Subimos al coche y nos fuimos a casa."

# game/pnc_text.rpy:131
translate spanish backpack_5c8684eb:

    # gg "- Дома нас встретила мама, мы втроем поужинали и разошлись по комнатам."
    gg "- Mamá nos dio la bienvenida, cenamos y nos fuimos cada uno a su cuarto."

# game/pnc_text.rpy:134
translate spanish backpack_2e83915f:

    # gg "- Доволен?"
    gg "- ¿Satisfecho?" #THIS SENTENCE SHOULD BE TRANSLATED SO IT COULD BE ANSWERED WITH SIMPLY "YES" OR "NO"

# game/pnc_text.rpy:139
translate spanish backpack_0fa5da10:

    # gg "Вот и славно."
    gg "- Bien."

# game/pnc_text.rpy:143
translate spanish backpack_d2c4cf06_1:

    # gg "- ..."
    gg "- ..."

# game/pnc_text.rpy:146
translate spanish backpack_f8e5dc31:

    # gg "- Папа забирал меня из школы силком, пока я кусалась и царапалась. Учителя не вмешивались; подобные сцены были для них обыденностью - мало ли в чем провинилась капризная девчонка?"
    gg "- Papá me sacó de la escuela a rastras mientras yo me resistía con uñas y dientes. Los profesores no interfirieron, esa escena les parecía normal... ¿Quién sabe lo que habrá hecho esa mocosa?"

# game/pnc_text.rpy:147
translate spanish backpack_6f074fed:

    # gg "- Затем он затолкал меня в машину и мы молча ехали до самого дома."
    gg "- Entonces, me metió en el coche a empujones y pasamos el trayecto a casa en completo silencio."

# game/pnc_text.rpy:148
translate spanish backpack_5c8684eb_1:

    # gg "- Дома нас встретила мама, мы втроем поужинали и разошлись по комнатам."
    gg "- Mamá nos dio la bienvenida, cenamos y nos fuimos cada uno a su cuarto."

# game/pnc_text.rpy:151
translate spanish backpack_f4ea4fbc:

    # gg "- Прошу, давай не будем об этом больше..."
    gg "- Por favor, dejemos el tema..."

translate spanish strings:
    # game/pnc_text.rpy:152
    old "(Нет, ты расскажешь мне еще раз.)"
    new "(No, me lo vas a contar otra vez.)"

# game/pnc_text.rpy:156
translate spanish backpack_d2c4cf06_2:

    # gg "- ..."
    gg "- ..."

# game/pnc_text.rpy:157
translate spanish backpack_d2c4cf06_3:

    # gg "- ..."
    gg "- ..."

# game/pnc_text.rpy:158
translate spanish backpack_63b32716:

    # gg "- По пути домой папа купил молоко."
    gg "- En el camino a casa, papá compró leche."

# game/pnc_text.rpy:161
translate spanish backpack_ec611f59:

    # gg "- Снова."
    gg "- Otra vez."

# game/pnc_text.rpy:164
translate spanish backpack_13c5cb72:

    # gg "- Как же я ненавижу молоко..."
    gg "- Odio tanto la leche..."

# game/pnc_text.rpy:165
translate spanish backpack_2c86c5a7:

    # gg "- Мамы дома не было."
    gg "- Mamá no estaba en casa."

# game/pnc_text.rpy:168
translate spanish backpack_ec611f59_1:

    # gg "- Снова."
    gg "- Otra vez."

# game/pnc_text.rpy:171
translate spanish backpack_e5f17701:

    # gg "- Как же я ненавижу маму..."
    gg "- Odio tanto a mamá..."

# game/pnc_text.rpy:176
translate spanish backpack_eed923f3:

    # "Вдруг я чувствую чей-то взгляд на своей спине. Зная, что такие моменты ни в коем случае нельзя игнорировать, я резко оборачиваюсь."
    "De repente, siento los ojos de alguien clavados en mi espalda. Sabiendo que esas cosas no se deben ignorar, me doy la vuelta."

# game/pnc_text.rpy:177
translate spanish backpack_01440056:

    # "Но там ничего нет."
    "Pero allí no hay nada."

translate spanish strings:
    # game/pnc_text.rpy:172
    old "(Что было дальше?)"
    new "(¿Y luego qué pasó?)"

# game/pnc_text.rpy:182
translate spanish backpack_fdeda4ab:

    # gg "- Все, что было дальше, произошло уже после того, как случилось кое-что, после чего произошло все, что было после этого."
    gg "- Todo lo que pasó después, pasó después de algo, que llevó a todo lo que pasó, después de lo que había pasado."

# game/pnc_text.rpy:185
translate spanish backpack_672cab95:

    # "Я вновь смотрю на рюкзак. Свет из окна отражается на мелких металлических деталях. А еще он отбрасывает тень - значит, он реален. К несчастью."
    "Vuelvo a mirar mi mochila. La luz que entra en la habitación a través de la ventana se refleja en las partes metálicas. También hay una sombra, lo que significa que es real. Desgraciadamente."

# game/pnc_text.rpy:188
translate spanish backpack_cda0aac6:

    # gg "- Ну и пусть, какое мне вообще дело!"
    gg "- Qué más da, ¡no me importa!"

# game/pnc_text.rpy:191
translate spanish backpack_64a10fb8:

    # "Я едва не пинаю рюкзак в порыве внезапного гнева, но в последний момент беру себя в руки."
    "En un ataque de ira repentino, casi le doy una patada a la mochila, pero logro controlarme justo a tiempo."

# game/pnc_text.rpy:192
translate spanish backpack_853cfd12:

    # "Если сдвину его хоть на сантиметр, вся картина развалится и я ослепну. Сколько раз это уже происходило... не сосчитать."
    "Si me muevo aunque sea un milímetro, todo se desvanecerá y me quedaré ciega. Ya me ha pasado más veces..."

translate spanish strings:
    # game/pnc_text.rpy:193
    old "(Что значит 'ослепнешь'?)"
    new "(¿Como que 'ciega'?)"

# game/pnc_text.rpy:197
translate spanish backpack_3052d71a:

    # gg "- Мне понадобились месяцы, чтобы выучить расположение каждого предмета в комнате. Именно поэтому я вижу все так четко и ясно."
    gg "- He pasado meses memorizando la ubicación de todos los objetos de mi habitación. Por eso puedo verlos tan clara y vívidamente."

# game/pnc_text.rpy:200
translate spanish backpack_24c29394:

    # gg "- Тебе не понять."
    gg "- No lo entenderías."

translate spanish strings:
    # game/pnc_text.rpy:201
    old "(Посмотри под ноги.)"
    new "(Mira a tus pies.)"

# game/pnc_text.rpy:203
translate spanish backpack_585ebf61:

    # "Я опускаю глаза и вижу, как со стороны рюкзака ко мне ползет маленькое насекомое. Светится едва-едва, и даже взлететь не может... по всей видимости, этот светлячок очень устал."
    "Bajo la mirada y veo un pequeño insecto arrastrándose hacia mí, desde la mochila. Brilla levemente y ni siquiera puede volar... Supongo que esta luciérnaga está muy cansada."

# game/pnc_text.rpy:204
translate spanish backpack_28b7c84e:

    # "Я наклоняюсь, чтобы подобрать его."
    "Me inclino para cogerla."

# game/pnc_text.rpy:205
translate spanish backpack_0b155769:

    # "От прикосновения светлячок ярко замерцал и вдруг взлетел!"
    "Tan pronto como la toco, la luciérnaga comienza a brillar, ¡y alza el vuelo!"

# game/pnc_text.rpy:208
translate spanish backpack_875b757a:

    # gg "- Молодец, малыш! Так держать!"
    gg "- ¡Así se hace! ¡Buen trabajo!"

# game/pnc_text.rpy:211
translate spanish backpack_bf1a1939:

    # "Сделав победный круг по комнате, он на большой скорости понесся в мою сторону. Я зажмурилась в ожидании того, как светлячок залетит мне в ухо."
    "Tras dar una vuelta por la habitación, vuela hacia mí a gran velocidad. Cierro los ojos anticipando el momento en que entre en mi oreja."

# game/pnc_text.rpy:212
translate spanish backpack_094d4a3b:

    # "Так и произошло; оказавшись внутри, он какое-то время продолжал жужжать у меня в черепе, а потом затих."
    "Eso es lo que pasa. Después de entrar, zumba durante un rato y después se queda en silencio."

# game/pnc_text.rpy:215
translate spanish backpack_c68f72e4:

    # gg "- Этот какой-то грустный..."
    gg "- Esta está triste..."

translate spanish strings:
    # game/pnc_text.rpy:216
    old "(Интересно, почему?)"
    new "(Me pregunto por qué...)"

# game/pnc_text.rpy:220
translate spanish backpack_a097dd72:

    # gg "- Это неважно. Главное, что теперь он не одинок!"
    gg "- No importa, ¡lo que importa es que ya no está sola!"

translate spanish strings:
    # game/pnc_text.rpy:221
    old "(Ладно. Давай искать дальше?)"
    new "(Claro. ¿Continuamos buscando?)"

# game/pnc_text.rpy:244
translate spanish papers_cb8dd79e:

    # "Обычные тетрадные листы, приклеенные к стене на скотч. На них изображены картинки с цифрами - единственная информация, которую я воспринимаю без особых трудностей."
    "Las típicas páginas de libreta, pegadas a la pared con celo. Con números escritos, es la única información que puedo asimilar sin problemas."

translate spanish strings:
    # game/pnc_text.rpy:245
    old "(Дозировка и побочные эффекты?)"
    new "(¿Dosis y efectos secundarios?)"

# game/pnc_text.rpy:248
translate spanish papers_90766208:

    # gg "- Угу."
    gg "- Sí."

translate spanish strings:
    # game/pnc_text.rpy:249
    old "(Я думал, ты знаешь их наизусть.)"
    new "(Creía que te los sabías de memoria.)"

# game/pnc_text.rpy:253
translate spanish papers_ea9753d4:

    # gg "- Да..."
    gg "- Sí..."

translate spanish strings:
    # game/pnc_text.rpy:256
    old "(Это ведь не твой почерк, верно?)"
    new "(Esta no es tu letra, ¿no?)"

# game/pnc_text.rpy:260
translate spanish papers_d2c4cf06:

    # gg "- ..."
    gg "- ..."

# game/pnc_text.rpy:263
translate spanish papers_e9c33d7f:

    # "Конечно же, нет. Обрывистые и неровные линии, корявые и некрасивые цифры... Не почерк; скорее, царапины от когтей."
    "Claro que no. Líneas temblorosas y discontinuas, números feos... No es caligrafía, son más bien marcas de garras."

translate spanish strings:
    # game/pnc_text.rpy:264
    old "(Не забудь сказать спасибо маме.)"
    new "(No olvides darle las gracias a tu madre.)"

# game/pnc_text.rpy:268
translate spanish papers_c31fcb47:

    # gg "- Отстань!"
    gg "- ¡Déjame en paz!"

# game/pnc_text.rpy:271
translate spanish papers_cf0ae0d1:

    # "От моего крика листы забеспокоились, зашелестели; спустя секунду из-под одного лениво показался светлячок."
    "Mi grito hace que las páginas se muevan, inquietas. Un momento después, una luciérnaga aparece debajo de una de ellas."

# game/pnc_text.rpy:272
translate spanish papers_3f22d077:

    # "Деловито оглянувшись, он деловито вспорхнул и не менее деловито залетел мне в ухо."
    "Después de mirar a su alrededor con seriedad, despega en un vuelo formal y termina entrando en mi oído." 

# game/pnc_text.rpy:277
translate spanish papers_fc3f9e8b:

    # gg "- Давай искать дальше."
    gg "- Continuemos buscando."

# game/pnc_text.rpy:299
translate spanish bed_4400afce:

    # "Хи-хи, это мой спальный мешок! Мягкий и теплый; я уверена, что любое живое существо не отказалось бы провести в нем минутку-другую."
    "Eje-je, ¡este es mi saco de dormir! Es suave y cálido, seguro que no hay criatura que pueda resistirse a pasar un ratito dentro."

# game/pnc_text.rpy:300
translate spanish bed_649f7dfb:

    # "Зарыться поглубже, прихватив с собой пару любимых вещей, закрыть глаза и..."
    "Les gustaría meterse hasta el fondo, con dos de sus objetos favoritos, cerrar los ojos y luego..."

translate spanish strings:
    # game/pnc_text.rpy:301
    old "(Эй! Ты что, уже спишь?)"
    new "(¡Oye! ¿Te has dormido?)"

# game/pnc_text.rpy:304
translate spanish bed_8930ec26:

    # gg "- А?.."
    gg "- ¿Eh...?"

# game/pnc_text.rpy:307
translate spanish bed_a8bbb4e1:

    # "Я слегка ударяю себя по щекам, чтобы прийти в чувство. Время уже далеко за полночь; в обычные дни я уже сплю как убитая. Но сейчас никак нельзя!.."
    "Me doy unos cachetes en las mejillas, para despejarme. Ya es más de medianoche, debería estar durmiendo como un tronco. ¡Pero, ahora mismo, no puedo...!"

# game/pnc_text.rpy:310
translate spanish bed_fc3f9e8b:

    # gg "- Давай искать дальше."
    gg "- Continuemos buscando."

translate spanish strings:
    # game/pnc_text.rpy:311
    old "(Эй, а может внутри кто-то есть?)"
    new "(Oye, quizás encontramos algo dentro.)"

# game/pnc_text.rpy:315
translate spanish bed_f621a758:

    # gg "- Не-а. Моим мыслям несвойственно усыплять, скорее, наоборот: они всегда провоцируют бессонницу. И сегодня как раз такой день."
    gg "- Nah. Mis sueños no pueden ponerse a dormir. Al contrario, causan insomnio, como hoy."

translate spanish strings:
    # game/pnc_text.rpy:316
    old "(Что?)"
    new "(¿Qué?)"

# game/pnc_text.rpy:320
translate spanish bed_1c6c319f:

    # gg "- Здесь искать бессмысленно, говорю."
    gg "- Que buscar aquí sería inútil."

# game/pnc_text.rpy:340
translate spanish clock_686cd361:

    # "Я гляжу на часы - время неумолимо движется."
    "Miro el reloj. El tiempo pasa sin cesar."

# game/pnc_text.rpy:342
translate spanish clock_df7eb0c2:

    # gg "- Уже так поздно..."
    gg "- Qué tarde es..."

translate spanish strings:
    # game/pnc_text.rpy:343
    old "(Устала?)"
    new "(¿Estás cansada?)"

# game/pnc_text.rpy:347
translate spanish clock_27a18cb3:

    # gg "- Еще как..."
    gg "- Y tanto..."

# game/pnc_text.rpy:350
translate spanish clock_33ee45a6:

    # "Я демонстративно громко зеваю и вытягиваю руки в стороны."
    "Bostezo exageradamente y extiendo los brazos a los lados."

# game/pnc_text.rpy:351
translate spanish clock_038f9fa3:

    # "Раз-два."
    "Uno, dos."

# game/pnc_text.rpy:352
translate spanish clock_332f57b4:

    # "Затем поднимаю их над головой."
    "Y los levanto."

# game/pnc_text.rpy:353
translate spanish clock_557547f8:

    # "Три-четыре."
    "Tres, cuatro."

# game/pnc_text.rpy:354
translate spanish clock_6e34fd04:

    # "Может, небольшая гимнастика поможет взбодриться?"
    "Puede que un poco de ejercicio me despeje."

translate spanish strings:
    # game/pnc_text.rpy:355
    old "(Неплохая идея! Помнишь упражнения, которым тебя учили?)"
    new "(¡Buena idea! ¿Recuerdas los ejercicios que te enseñaron?)"

# game/pnc_text.rpy:359
translate spanish clock_649f3fc1:

    # gg "- Вроде, помню..."
    gg "- Creo que sí..."

# game/pnc_text.rpy:362
translate spanish clock_8d94999f:

    # "Я неуверенно встаю в стойку; пятки вместе, носки врозь... Или как там было?"
    "Dudo un poco. Cómo era... ¿talones juntos, puntas separadas?"

# game/pnc_text.rpy:365
translate spanish clock_a39e73c9:

    # gg "- Ладно, будь что будет. Засекай пять минут!"
    gg "- Da igual, lo haré así. ¡Cuenta cinco minutos!"

translate spanish strings:
    # game/pnc_text.rpy:366
    old "(Засек. Хотя у тебя часы прямо перед носом, вообще-то.)"
    new "(Vale, aunque tienes un reloj en las narices..)"

# game/pnc_text.rpy:370
translate spanish clock_3866490e:

    # gg "- Я не могу слишком долго смотреть на стрелки."
    gg "- No puedo mirar sus manecillas mucho rato."

# game/pnc_text.rpy:373
translate spanish clock_3629485d:

    # "Сначала они будто бы идут в обратном направлении, затем и вовсе исчезают..."
    "Primero, me da la impresión de que giran en la dirección contraria y entonces, desaparecen por completo..."

# game/pnc_text.rpy:374
translate spanish clock_a20cefa7:

    # "..."
    "..."

# game/pnc_text.rpy:375
translate spanish clock_8af69835:

    # "А после этого всегда происходит какая-нибудь ерунда."
    "Y después las cosas se ponen raras."

# game/pnc_text.rpy:376
translate spanish clock_37721a79:

    # "В последний раз мне померещилась пара глаз на циферблате..."
    "La última vez vi unos ojos en la esfera del reloj...."

# game/pnc_text.rpy:377
translate spanish clock_44335f8e:

    # "А еще..."
    "Y también..."

# game/pnc_text.rpy:378
translate spanish clock_912ad87c:

    # "Когда-то давно мне слышались голоса..."
    "Solía oír voces..."

# game/pnc_text.rpy:379
translate spanish clock_38d6eb28:

    # "Они будто... звали на помощь?"
    "Me... pedían ayuda, ¿creo?"

# game/pnc_text.rpy:380
translate spanish clock_7dea574f:

    # "Ерунда, сущая ерунда."
    "Qué locura, una verdadera locura."

# game/pnc_text.rpy:381
translate spanish clock_dba34053:

    # "Ерунда же?"
    "Era una locura, ¿verdad?"

# game/pnc_text.rpy:382
translate spanish clock_0f7c6a07:

    # "Ерунда."
    "Una locura."

# game/pnc_text.rpy:385
translate spanish clock_b35d4af1:

    # gg "- Ну что, засек время?"
    gg "- Bueno, ¿estás cronometrando?"

translate spanish strings:
    # game/pnc_text.rpy:386
    old "(Боже, наконец-то...)"
    new "(Dios mío, por fin...)"

# game/pnc_text.rpy:390
translate spanish clock_213f59bc:

    # gg "- О чем ты?"
    gg "- ¿De qué hablas?"

translate spanish strings:
    # game/pnc_text.rpy:391
    old "(Я уже полчаса не могу до тебя достучаться.)"
    new "(Llevo media hora intentando que me hagas caso.)"

# game/pnc_text.rpy:395
translate spanish clock_8930ec26:

    # gg "- А?.."
    gg "- ¿Qué...?"

translate spanish strings:
    # game/pnc_text.rpy:396
    old "(Забудь. Светлячка видишь?)"
    new "(Olvídalo. ¿Ves la luciérnaga?)"

# game/pnc_text.rpy:400
translate spanish clock_1f91f806:

    # gg "- Н-нет..."
    gg "- N-no..."

translate spanish strings:
    # game/pnc_text.rpy:401
    old "(Тогда давай искать дальше.)"
    new "(Continuemos buscando, entonces.)"

# game/pnc_text.rpy:422
translate spanish can_73aa1f9a:

    # "Приблизившись к мусорному баку, я с любопытством заглядываю внутрь."
    "Me acerco a la papelera y miro dentro, con curiosidad."

# game/pnc_text.rpy:423
translate spanish can_9cefa99d:

    # "Упаковки из-под лекарств, тетрадные листы и прочий мусор. Скука..."
    "Un blister de pastillas, páginas de cuaderno y otra basura. Aburrido..."

# game/pnc_text.rpy:425
translate spanish can_602f184f:

    # gg "- Здесь ничего. И правильно, ни один уважающий себя светлячок не стал бы прятаться в мусорке!"
    gg "- Aquí no hay nada. Es más, ¡ninguna luciérnaga que se respete a sí misma se escondería en un montón de basura!"

translate spanish strings:
    # game/pnc_text.rpy:426
    old "(Пожалуй, соглашусь.) "
    new "(Ahí tengo que darte la razón.)"

# game/pnc_text.rpy:448
translate spanish fan_352aa8f3:

    # gg "- Хи-хи!"
    gg "- ¡Eje-je!"

translate spanish strings:
    # game/pnc_text.rpy:449
    old "(Что смешного?)"
    new "(¿Qué es tan gracioso?)"

# game/pnc_text.rpy:453
translate spanish fan_ac72e700:

    # gg "- Я представила себя светлячком, который видит перед собой огромный вентилятор."
    gg "- Me he imaginado siendo una luciérnaga que observa desde un ventilador gigante."

translate spanish strings:
    # game/pnc_text.rpy:454
    old "(Ну и?..)"
    new "(¿Y...?)"

# game/pnc_text.rpy:458
translate spanish fan_e28ac19d:

    # gg "- Да я бы жуть как обзавидовалась!"
    gg "- ¡Me da mucha envidia!"

# game/pnc_text.rpy:461
translate spanish fan_f43e7afd:

    # gg "- Единственное, что не дает ему взлететь - это клетка, в которой он заперт... ну и провод."
    gg "- Lo único que le impide volar es la jaula en la que está encerrada... y el cable."

# game/pnc_text.rpy:464
translate spanish fan_ecb0c3d8:

    # gg "- Он словно заключенный в тюрьме, если задуматься..."
    gg "- Si lo piensas bien... parece una reclusa."

# game/pnc_text.rpy:467
translate spanish fan_f0cb13c4:

    # gg "- Грустно это все."
    gg "- Qué triste."

translate spanish strings:
    # game/pnc_text.rpy:468
    old "(Ага.)"
    new "(Ya.)"

# game/pnc_text.rpy:472
translate spanish fan_fc3f9e8b:

    # gg "- Давай искать дальше."
    gg "- Continuemos buscando."

# game/pnc_text.rpy:492
translate spanish laptop_0178e4bf:

    # "Я смотрю на свой ноутбук. Из-за того, что я многие годы не прикасалась к нему, он покрыт слоем пыли толщиной в палец."
    "Miro mi portátil. Hace años que no lo toco, así que está cubierto de una capa de polvo tan gruesa como mi dedo."

# game/pnc_text.rpy:493
translate spanish laptop_32e9c419:

    # "Очень странный предмет. Я его побаиваюсь..."
    "Un objeto extraño, me da miedo..."

translate spanish strings:
    # game/pnc_text.rpy:498
    old "(Вот и отлично. Рассказывай!)"
    new "(Maravilloso, ¡cuéntame más!)"

# game/pnc_text.rpy:497
translate spanish laptop_369e40f2:

    # gg "- Это долгая и скучная история."
    gg "- Es una larga, y aburrida, historia."

translate spanish strings:
    # game/pnc_text.rpy:503
    old "(Я настаиваю!)"
    new "(¡Insisto!)"

# game/pnc_text.rpy:502
translate spanish laptop_7fd94592:

    # gg "- М-м..."
    gg "- Mm..."

# game/pnc_text.rpy:507
translate spanish laptop_5f0d51e5:

    # gg "- Я не помню, как он появился в моей комнате."
    gg "- No recuerdo cómo apareció en mi cuarto."

# game/pnc_text.rpy:508
translate spanish laptop_d05dfac5:

    # gg "- Наверное, кто-то из родителей принес его сюда, потому что не нашлось другого места."
    gg "- Lo debieron traer mamá o papá, porque no encontraron un lugar mejor en el que dejarlo."

# game/pnc_text.rpy:509
translate spanish laptop_ca6f1421:

    # gg "- Мне не запрещали им пользоваться - наоборот, даже поощряли."
    gg "- No me prohibieron usarlo, al contrario, me animaban a hacerlo."

# game/pnc_text.rpy:512
translate spanish laptop_1826dfb6:

    # gg "- Еще бы, я целыми днями безвылазно сидела перед экраном! Игры, рисование, инженерный калькулятор, трехмерное моделирование..."
    gg "- ¡Me pasaba el día entero usándolo! Jugaba, dibujaba, usaba la calculadora científica, hacía modelos 3D..."

# game/pnc_text.rpy:515
translate spanish laptop_b3ebc70c:

    # gg "- Столько развлечений!"
    gg "- ¡Tantas cosas guais que hacer!"


translate spanish strings:
    # game/pnc_text.rpy:516
    old "(Занятные у тебя были хобби.)"
    new "(Tenías aficiones divertidas.)"

# game/pnc_text.rpy:520
translate spanish laptop_87077ee0:

    # gg "- Ага, были... до выхода в сеть."
    gg "- Sí, las tenía... hasta que descubrí internet."

translate spanish strings:
    # game/pnc_text.rpy:521
    old "(М-м?)"
    new "(¿Mm?)"

# game/pnc_text.rpy:525
translate spanish laptop_30b90bb2:

    # gg "- Представь себе ситуацию: ты - хомячок, что живет под землей. У тебя есть все необходимое для комфортной жизни."
    gg "- Imagina: eres un hámster que vive bajo tierra y tienes todo lo necesario para vivir cómodamente."

# game/pnc_text.rpy:528
translate spanish laptop_b730d7d5:

    # gg "- Представил?"
    gg "- ¿Lo has imaginado?"

translate spanish strings:
    # game/pnc_text.rpy:529
    old "(Твои аналогии как всегда на высоте.)"
    new "(Como siempre, tus analogías son muy acertadas.)"

    # game/pnc_text.rpy:531
    old "(Ну хорошо, представил.)"
    new "(Vale, me lo imagino.)"

# game/pnc_text.rpy:535
translate spanish laptop_fdaff107:

    # gg "- Итак, ты - хомячок, что живет под землей. У тебя есть все необходимое для комфортной жизни, да?"
    gg "- Bien, entonces, eres un hámster que vive bajo tierra y tienes todo lo necesario para vivir cómodamente, ¿vale?"

translate spanish strings:
    # game/pnc_text.rpy:536
    old "(Да...)"
    new "(Vale...)"

# game/pnc_text.rpy:540
translate spanish laptop_5a413449:

    # gg "- Отлично! Значит, ситуация следующая: ты - хомячок, что живет..."
    gg "- ¡Perfecto! Pues, esta es la situación: eres un hámster que vive..."

translate spanish strings:
    # game/pnc_text.rpy:541
    old "(Ладно, я тебя понял. Хочешь поговорить о чем-то другом?)"
    new "(Vale, lo he pillado. ¿Hablamos de otra cosa?)"

# game/pnc_text.rpy:545
translate spanish laptop_d2c4cf06:

    # gg "- ..."
    gg "- ..."

# game/pnc_text.rpy:548
translate spanish laptop_d254e5a2:

    # gg "- Угу..."
    gg "- Sí..."

translate spanish strings:
    # game/pnc_text.rpy:549
    old "(Все равно ведь вернешься к этой теме.)"
    new "(Vas a acabar volviendo al tema, de todas formas.)"

# game/pnc_text.rpy:558
translate spanish laptop_d2c4cf06_1:

    # gg "- ..."
    gg "- ..."

# game/pnc_text.rpy:561
translate spanish laptop_6000601f:

    # gg "- В один прекрасный день тебя выкапывают из твоей хомячьей норки и приносят в зоомагазин. Теперь клетка - твой новый дом."
    gg "- Un buen día, alguien te saca de tu casa de hámster y te lleva a una tienda de mascotas, ahora tu casa es una jaula."

# game/pnc_text.rpy:564
translate spanish laptop_03c88239:

    # gg "- Здесь гораздо удобнее и теплее, чем под землей."
    gg "- Es mucho más cómoda y cálida que el subsuelo."

# game/pnc_text.rpy:567
translate spanish laptop_cc648f6c:

    # gg "- А самое главное - здесь у тебя много соседей. Их клетки - точные копии твоей; да и сами хомячки как две капли воды похожи на тебя - выходит, вы ничем друг от друга не отличаетесь."
    gg "- Y lo más importante... tienes muchos vecinos. Sus jaulas son como la tuya y los otros hámsteres son idénticos a ti. Eso significa que sois todos iguales."

# game/pnc_text.rpy:570
translate spanish laptop_88bcc6b1:

    # gg "- Кроме того, что они были рождены в этом зоомагазине."
    gg "- Aunque ellos nacieron en esa tienda."

# game/pnc_text.rpy:573
translate spanish laptop_2497aa37:

    # gg "- Ты спросишь - но на что это указывает? А я тебе отвечу - да ни на что."
    gg "- Y te preguntarás: ¿Eso qué significa? Y yo te diré: Nada de nada."

# game/pnc_text.rpy:576
translate spanish laptop_70f10b0e:

    # gg "- Я забыла, о чем шла речь..."
    gg "- ¿De qué estábamos hablando...?"

translate spanish strings:
    # game/pnc_text.rpy:577
    old "(О, боже...)"
    new "(Dios...)"

# game/pnc_text.rpy:581
translate spanish laptop_7ee42079:

    # gg "- Ладно, давай начнем заново!"
    gg "- Vale, ¡volvamos a empezar!"

translate spanish strings:
    # game/pnc_text.rpy:582
    old "(В этот раз постарайся обойтись без дурацких примеров с хомяками.)"
    new "(Esta vez, olvida los estúpidos hámsteres.)"

# game/pnc_text.rpy:586
translate spanish laptop_3b77990a:

    # gg "- Ты же знаешь, что я не виновата."
    gg "- Sabes que no es culpa mía."

# game/pnc_text.rpy:589
translate spanish laptop_b061a70e:

    # gg "- Итак."
    gg "- Bueno."

# game/pnc_text.rpy:590
translate spanish laptop_3690dc5f:

    # gg "- У меня было очень много друзей в сети. Десятки, сотни... всех не сосчитать."
    gg "- Tenía muchos amigos en internet. Decenas, cientos... incontables."

# game/pnc_text.rpy:593
translate spanish laptop_f6f9494b:

    # gg "- Хотя, почему не сосчитать? Их было ровно триста семнадцать."
    gg "- ¿Bueno, por qué no contarlos? Tenía exactamente 317."

# game/pnc_text.rpy:596
translate spanish laptop_9ca563cd:

    # gg "- Впрочем, никто не считает точное количество хомячков, когда заходит в зоомагазин..."
    gg "- Aunque, supongo que nadie cuenta cuántos hámsteres hay en una tienda de mascotas..."

translate spanish strings:
    # game/pnc_text.rpy:597
    old "(Эй, не отвлекайся!)"
    new "(Oye, ¡no te distraigas!)"

# game/pnc_text.rpy:601
translate spanish laptop_b97a9039:

    # gg "- Ах да!"
    gg "- ¡Ay, es verdad!"

# game/pnc_text.rpy:604
translate spanish laptop_ee66ebc9:

    # gg "- Из трехсот семнадцати друзей шестьдесят восемь увлекались играми - прямо как я!"
    gg "- De mis 317 amigos, a 68 les gustaban los videojuegos, ¡igual que a mí!"

# game/pnc_text.rpy:605
translate spanish laptop_39f06a4e:

    # gg "- Еще сто тридцать друзей любили рисовать - ну в точности как я!"
    gg "- A 130 les gustaba dibujar, ¡igual que a mí!"

# game/pnc_text.rpy:606
translate spanish laptop_be83ef93:

    # gg "- Оставшиеся сто девятнадцать друзей увлекались калькуляторами и трехмерной графикой в равной степени."
    gg "- Y a los 119 restantes les gustaban las calculadoras y el modelado 3D por igual."

# game/pnc_text.rpy:609
translate spanish laptop_048d14d4:

    # gg "- И когда я говорю ‘в равной степени’, я не имею в виду ‘по пятьдесят девять с половиной друзей с каждой стороны’."
    gg "- Y cuando digo 'por igual', no quiero decir que hubiera '59 amigos y medio en cada lado'."

# game/pnc_text.rpy:612
translate spanish laptop_ddb17af4:

    # gg "- Понимаешь?"
    gg "- ¿Entiendes?"

# game/pnc_text.rpy:615
translate spanish laptop_66951c3e:

    # gg "- Сто девятнадцать можно разделить пополам без проблем, но с друзьями математика работает по-другому... Ну что за напасть, а?"
    gg "- Los números se pueden dividir sin problema, pero las matemáticas no funcionan así con los amigos... Un verdadero misterio, ¿no?"

translate spanish strings:
    # game/pnc_text.rpy:616
    old "(Давай ближе к делу.)"
    new "(Ve al grano.)"

# game/pnc_text.rpy:620
translate spanish laptop_6d94f79c:

    # gg "- Разумеется, я знала, что настоящих людей в сети не существует."
    gg "- Aunque, por supuesto, ya sabía que en internet no hay gente real."

# game/pnc_text.rpy:621
translate spanish laptop_09142f27:

    # gg "- И, выключая компьютер, я понимала, что все мои друзья умирают в тот же момент."
    gg "- También sé que todos mis amigos mueren cuando apago el portátil."

# game/pnc_text.rpy:624
translate spanish laptop_fd42c0ca:

    # gg "- И все же, я ни капли не беспокоилась..."
    gg "- Pero no me preocupaba, en absoluto..."

# game/pnc_text.rpy:629
translate spanish laptop_35b3eb5c:

    # gg "- Знаешь, из чего состоят компьютерные программы? Это всего-навсего комбинация чисел."
    gg "- ¿Sabes de qué están hechos los programas de ordenador? Son una simple combinación de cifras."

# game/pnc_text.rpy:632
translate spanish laptop_ec2ec1d3:

    # gg "- Значит, и мои друзья - это числа. Не находишь это занятным?"
    gg "- Lo que significa que mis amigos también son cifras. ¿No es increíble?"

translate spanish strings:
    # game/pnc_text.rpy:633
    old "(Не особо.)"
    new "(No mucho.)"

translate spanish strings:
    # game/pnc_text.rpy:635
    old "(Почему ты называешь их друзьями?)"
    new "(¿Por qué les llamas amigos?)"

# game/pnc_text.rpy:639
translate spanish laptop_2fe59e50:

    # gg "- Ну как же! Все, кто разделяет мои интересы - мои друзья. И неважно, знают ли они о моем существовании или нет."
    gg "- ¡Hombre...! Cualquiera que comparta mis gustos es mi amigo, sepa de mi existencia o no."

# game/pnc_text.rpy:642
translate spanish laptop_a2053065:

    # gg "- Так вот! У каждой программы есть определенный алгоритм, задача - словом, математическая формула."
    gg "- Bueno, ¡como iba diciendo...! Todos los programas tienen su propio algoritmo y propósito, sus fórmulas matemática."

# game/pnc_text.rpy:643
translate spanish laptop_d2b39157:

    # gg "- И если решить эту формулу, ты точно будешь знать, как программа поведет себя в тот или иной момент."
    gg "- Y, si resuelves la fórmula, podrás predecir el comportamiento del programa."

translate spanish strings:
    # game/pnc_text.rpy:644
    old "(Чем дальше - тем меньше я понимаю, о чем ты.)"
    new "(Cuanto más hablas, menos te sigo.)"

# game/pnc_text.rpy:648
translate spanish laptop_80add5f4:

    # gg "- Тебе не нужно что-либо понимать. Просто слушай."
    gg "- No hace falta que me sigas, solo escucha."

# game/pnc_text.rpy:651
translate spanish laptop_08543ea7:

    # "Я сажусь на пол, и экран ноутбука оказывается прямо у меня перед глазами. В нем я вижу лишь свое тусклое отражение и больше ничего."
    "Me siento en el suelo y la pantalla del portátil acaba justo a la altura de mi cabeza. Lo único que se refleja en ella es mi sombrío rostro."

# game/pnc_text.rpy:654
translate spanish laptop_6f1b1d71:

    # gg "- Человек из сети - это случайная картинка и случайный набор букв. Слова и поступки человека из сети - это программный код."
    gg "- Una persona de internet no es más que una foto al azar y una cadena de caracteres. Sus palabras y acciones no son más que un código ejecutable."

# game/pnc_text.rpy:657
translate spanish laptop_d2c4cf06_2:

    # gg "- ..."
    gg "- ..."

# game/pnc_text.rpy:664
translate spanish laptop_d2c4cf06_3:

    # gg "- ..."
    gg "- ..."

# game/pnc_text.rpy:667
translate spanish laptop_c37d7625:

    # gg "- Однажды кое-кто появился. С тех пор компьютер все время включен."
    gg "- Un día, apareció alguien. A partir de ese momento, mi ordenador se quedó encendido."

# game/pnc_text.rpy:670
translate spanish laptop_bf04f233:

    # gg "- В сети не бывает настоящих людей, но ему удавалось притворяться. В какой-то момент я позволила себя обмануть..."
    gg "- No hay gente real en internet, pero él sabía fingir. Hubo un momento en el que le dejé engañarme..."

translate spanish strings:
    # game/pnc_text.rpy:660
    old "(Дай мне знать, если тебе нужна передышка.)"
    new "(Si quieres descansar, dímelo.)"

translate spanish strings:
    # game/pnc_text.rpy:671
    old "(Эй, смотри!)"
    new "(¡Eh, mira!)"

# game/pnc_text.rpy:675
translate spanish laptop_8930ec26:

    # gg "- А?.."
    gg "- ¿Qué...?"

# game/pnc_text.rpy:678
translate spanish laptopff_744d5f7e:

    # "Вдруг из вентиляционной решетки ноутбука медленно выбирается светлячок. Я протягиваю руку; тот взбирается на ладонь, беспрестанно моргая."
    "De repente salió una luciérnaga de la rejilla de ventilación del portátil. Le acerqué mi mano; se posó en la palma, no dejaba de parpadear."

translate spanish strings:
    # game/pnc_text.rpy:679
    old "(По-моему, он пытается что-то сказать.)"
    new "(Creo que quiere decirte algo.)"

# game/pnc_text.rpy:684
translate spanish laptopff_535e540c:

    # gg "- Я и сама вижу. Знать бы, что именно..."
    gg "- Ya lo veo, si supiera el qué..."

translate spanish strings:
    # game/pnc_text.rpy:685
    old "(Похоже на шифр. Разве тебе не хочется его разгадать?)"
    new "(Parece un mensaje cifrado. ¿No quieres descifrarlo?)"

# game/pnc_text.rpy:689
translate spanish laptopff_2f2a6c77:

    # gg "- Я передумала. Я на за что на свете не хочу знать, что он пытается сказать."
    gg "- He cambiado de opinión, ya no quiero saber lo que intenta decir."

# game/pnc_text.rpy:690
translate spanish laptopff_d9c14513:

    # "После этих слов светлячок на секунду гаснет."
    "Tras decir eso, la luciérnaga deja de brillar unos segundos."

# game/pnc_text.rpy:691
translate spanish laptopff_dc2ada86:

    # "Затем, словно придя в себя, загорается вновь."
    "Y empieza a brillar de nuevo, como si hubiera vuelto en sí."

# game/pnc_text.rpy:692
translate spanish laptopff_7662646e:

    # "Какое-то время он обдумывает дальнейшие действия, после чего поднимается в воздух и стремительно залетает ко мне в ухо."
    "Durante un rato piensa en qué hacer, después alza el vuelo y se precipita rápidamente a mi oído."

# game/pnc_text.rpy:693
translate spanish laptopff_fc3f9e8b:

    # gg "- Давай искать дальше."
    gg "- Sigamos buscando."

translate spanish strings:
    # game/pnc_text.rpy:701
    old "(А как же твой рассказ?)"
    new "(¿Y qué pasa con tu historia?)"

# game/pnc_text.rpy:705
translate spanish rasskaz_d2c4cf06:

    # gg "- ..."
    gg "- ..."

translate spanish strings:
    # game/pnc_text.rpy:706
    old "(Должно быть, ты злишься, что я прервал тебя. Извини.)"
    new "(Debes estar enfadada conmigo por interrumpirte, perdona.)"

# game/pnc_text.rpy:710
translate spanish rasskaz_d2c4cf06_1:

    # gg "- ..."
    gg "- ..."

# game/pnc_text.rpy:713
translate spanish rasskaz_5f0715b8:

    # gg "- Если ты все сделаешь правильно, я закончу рассказ. Возможно..."
    gg "- Si lo haces todo bien, acabaré mi historia. Quizá..."

translate spanish strings:
    # game/pnc_text.rpy:714
    old "(Обещаешь?)"
    new "(¿Me lo prometes?)"

# game/pnc_text.rpy:718
translate spanish rasskaz_cc81ff2c:

    # gg "- Обещаю."
    gg "- Lo prometo."

translate spanish strings:
    # game/pnc_text.rpy:719
    old "(А если забудешь?)"
    new "(¿Y si se te olvida?)"

# game/pnc_text.rpy:721
translate spanish rasskaz_206e880f:

    # gg "- Тогда напомни мне. Кодовым словом, например."
    gg "- Recuérdamelo. Con una palabra clave, por ejemplo."

translate spanish strings:
    # game/pnc_text.rpy:722
    old "(Каким же?)"
    new "(¿Qué palabra?)"

# game/pnc_text.rpy:724
translate spanish rasskaz_d4a9506f:

    # gg "- Потом придумаю."
    gg "- Ya pensaré en una."

# game/pnc_text.rpy:727
translate spanish rasskaz_2e503c3b:

    # gg "- А сейчас - давай искать моих светлячков!"
    gg "- ¡Por ahora, sigamos buscando mis luciérnagas!"

# game/pnc_text.rpy:749
translate spanish notebook_73622d2a:

    # "Это моя тетрадь для рисунков. Половина страниц пустует - значит, хватит еще на пару лет."
    "Este es mi cuaderno de dibujo, la mitad de las páginas están en blanco, lo que significa que me servirá un par de años más."

translate spanish strings:
    # game/pnc_text.rpy:750
    old "(Ты так редко рисуешь? Почему?)"
    new "(¿Por qué dibujas tan poco?)"

# game/pnc_text.rpy:753
translate spanish notebook_2fdb1c40:

    # gg "- Разве не очевидно? Если закончатся страницы - придется покупать новую тетрадь."
    gg "- ¿No es obvio? Si se me acaban las páginas, tendré que comprar otro cuaderno."

# game/pnc_text.rpy:754
translate spanish notebook_25c9dcf1:

    # gg "- До канцелярского магазина пешком не добраться, придется ехать на автобусе."
    gg "- No puedo llegar a la papelería a pie, tendría que coger el bus."

# game/pnc_text.rpy:757
translate spanish notebook_0fdb62bd:

    # gg "- Ты вообще представляешь, каким кошмаром это может обернуться?"
    gg "- Sabes que eso sería una auténtica pesadilla."

translate spanish strings:
    # game/pnc_text.rpy:758
    old "(Так, может, попросишь маму купить тебе тетрадь?)"
    new "(Bueno, podrías pedirle a tu madre que te lo compre.)"

# game/pnc_text.rpy:762
translate spanish notebook_b5dc11a0:

    # gg "- Что купить? Кого попросить? Ты вообще умеешь расставлять акценты в речи?"
    gg "- ¿Comprar qué? ¿Pedírselo a quién? ¿Puedes construir frases coherentes?"

translate spanish strings:
    # game/pnc_text.rpy:763
    old "(Не придуривайся. Лучше попроси маму купить тебе тетрадь.)"
    new "(No te hagas la tonta. Mejor pídele a tu madre que te compre un cuaderno.)"

# game/pnc_text.rpy:767
translate spanish notebook_61128a51:

    # gg "- Лучше? То есть ты просишь от меня совершить сразу несколько действий, при этом говоря, что одно лучше другого?"
    gg "- ¿Mejor? O sea, pretendes que elija entre dos acciones, ¿pero también me dices que una es mejor que la otra?"

# game/pnc_text.rpy:770
translate spanish notebook_7b0afc12:

    # gg "- Тогда зачем мне выполнять то, которое хуже?"
    gg "- ¿Entonces dónde está la disyuntiva?"

# game/pnc_text.rpy:773
translate spanish notebook_3e4cfd0b:

    # gg "- Ты и пары слов связать не можешь, хи-хи!"
    gg "- Ji-ji, ¡qué tonto eres!"

translate spanish strings:
    # game/pnc_text.rpy:774
    old "(Боже, как с тобой тяжело...)"
    new "(Dios, qué complicada eres...)"

# game/pnc_text.rpy:778
translate spanish notebook_ff6dd08d:

    # gg "- Тебе недостает чуткости. Разве это моя вина?"
    gg "- ¿Acaso es culpa mía que te falte empatía?"

# game/pnc_text.rpy:784
translate spanish notebook_a5db7b1c:

    # "Я подхожу чуть ближе к тетради, переступая через провода, спальный мешок, трещины в ламинате и отблески из окна."
    "Me acerco al cuaderno, pisando los cables, el saco de dormir, las grietas del laminado y el reflejo de la ventana."

# game/pnc_text.rpy:785
translate spanish notebook_508d510d:

    # "Тетрадь лежит на табуретке; с высоты моего взгляда кажется, что у табуретки недостает двух ножек. Опускаюсь на корточки - все ножки на месте."
    "El cuaderno está sobre un taburete. Desde mi posición parece que le falten dos patas. Me pongo en cuclillas para verlo bien; todas las patas están en su sitio."

# game/pnc_text.rpy:786
translate spanish notebook_dde63762:

    # "Могу ли я придумать интересную аллегорию?"
    "¿Seré capaz de pensar en una buena alegoría?"

translate spanish strings:
    # game/pnc_text.rpy:787
    old "(Давай без этого, а?)"
    new "(Ah, no, eso sí que no.)"

# game/pnc_text.rpy:789
translate spanish notebook_c146e361:

    # "Я поднимаюсь и смотрю на тетрадь в упор."
    "Me incorporo y observo el cuaderno desde la distancia."

# game/pnc_text.rpy:790
translate spanish notebook_bcd03463:

    # "Листы белоснежно чистые; последний рисунок похоронен на предыдущей странице. Так и должно быть."
    "Las páginas son de un blanco puro. El último dibujo lo tapa la página anterior, como debe ser."

translate spanish strings:
    # game/pnc_text.rpy:791
    old "(Жаль, мне бы хотелось взглянуть.)"
    new "(Qué pena, me encantaría verlo.)"

# game/pnc_text.rpy:795
translate spanish notebook_f01e6c1d:

    # gg "- В другой раз."
    gg "- Quizá la próxima vez."

# game/pnc_text.rpy:798
translate spanish notebook_8dcb67c3:

    # "Вдруг в комнату ворвался прохладный ветер - тетрадные листы зашелестели."
    "Una repentina ráfaga de viento helado entra por la ventana y mueve todas las hojas."

# game/pnc_text.rpy:801
translate spanish notebook_705c7ef0:

    # gg "- Н-нет!.."
    gg "- ¡Ay no...!"

# game/pnc_text.rpy:804
translate spanish notebook_ce173ba3:

    # "Я зажмуриваюсь."
    "Cierro los ojos."

# game/pnc_text.rpy:805
translate spanish notebook_4a5bbcff:

    # "Отчетливый и характерный звук перелистываемых страниц отдается головной болью - я знаю, что сейчас произойдет..."
    "El sonido del pasar de las páginas me provoca dolor de cabeza. Sé lo que está a punto de pasar..."

# game/pnc_text.rpy:806
translate spanish notebook_a20cefa7:

    # "..."
    "..."

# game/pnc_text.rpy:807
translate spanish notebook_b092dc1b:

    # "Шелест прекратился, хотя ветер продолжал завывать из всех щелей. Это значит только одно - тетрадь открыта на первой странице."
    "El sonido ha parado, pero el viento sigue aullando. Eso solo puede significar una cosa: el cuaderno está abierto por la primera página."

# game/pnc_text.rpy:808
translate spanish notebook_1dec8145:

    # "Если я подожду еще немного, ветер захлопнет ее."
    "Si espero más, el viento lo cerrará."

# game/pnc_text.rpy:809
translate spanish notebook_759776ee:

    # "Мне не придется смотреть... если я подожду еще немного."
    "Si espero un poco más... no tendré que mirar."

# game/pnc_text.rpy:810
translate spanish notebook_f01278fc:

    # "Если я..."
    "Si espero..."

translate spanish strings:
    # game/pnc_text.rpy:811
    old "(Открой глаза.)"
    new "(Abre los ojos.)"

# game/pnc_text.rpy:813
translate spanish notebook_827bf4c2:

    # gg "- Нет!"
    gg "- ¡No!"

translate spanish strings:
    # game/pnc_text.rpy:814
    old "(Все хорошо, просто открой глаза.)"
    new "(Está bien, ábrelos.)"

# game/pnc_text.rpy:816
translate spanish notebook_271f7539:

    # gg "- Ни за что! Я знаю, что ты врешь!"
    gg "- ¡Ni de broma! ¡sé que mientes!"

translate spanish strings:
    # game/pnc_text.rpy:817
    old "(Успокойся.)"
    new "(Cálmate.)"

# game/pnc_text.rpy:819
translate spanish notebook_827bf4c2_1:

    # gg "- Нет!"
    gg "- ¡No!"

# game/pnc_text.rpy:822
translate spanish notebook_827bf4c2_2:

    # gg "- Нет!"
    gg "- ¡No!"

# game/pnc_text.rpy:825
translate spanish notebook_827bf4c2_3:

    # gg "- Нет!"
    gg "- ¡No!"

# game/pnc_text.rpy:828
translate spanish notebook_827bf4c2_4:

    # gg "- Нет!"
    gg "- ¡No!"

# game/pnc_text.rpy:831
translate spanish notebook_d2c4cf06:

    # gg "- ..."
    gg "- ..."

# game/pnc_text.rpy:834
translate spanish notebook_d2c4cf06_1:

    # gg "- ..."
    gg "- ..."

# game/pnc_text.rpy:837
translate spanish notebook_d2c4cf06_2:

    # gg "- ..."
    gg "- ..."

# game/pnc_text.rpy:838
translate spanish notebook_7e89ef29:

    # gg "- Ладно."
    gg "- Bueno."

# game/pnc_text.rpy:841
translate spanish notebook_9b2c1786:

    # "Я с опаской открываю глаза. Тетрадь все так же распахнута на середине; ни рисунков, ничего - листы по-прежнему чистые."
    "Abro los ojos con sumo cuidado. El cuaderno sigue abierto por la mitad. Sin dibujos, ni nada, las páginas siguen completamente en blanco."

# game/pnc_text.rpy:842
translate spanish notebook_57fd477a:

    # gg "- Померещилось?.."
    gg "- ¿Lo he imaginado...?"

translate spanish strings:
    # game/pnc_text.rpy:843
    old "(Не знаю. Померещилось ли?)"
    new "(No lo sé, ¿tú qué crees?)"

# game/pnc_text.rpy:847
translate spanish notebook_094deede:

    # gg "- Ты же у нас все знаешь, вот и скажи мне!"
    gg "- ¡Tú eres el listo, tú sabrás!"

translate spanish strings:
    # game/pnc_text.rpy:848
    old "(В следующий раз не закрывай глаза.)"
    new "(La próxima vez no cierres los ojos.)"

# game/pnc_text.rpy:852
translate spanish notebook_558198df:

    # gg "- Что ты?.."
    gg "- ¿Qué has...?"

# game/pnc_text.rpy:855
translate spanish notebook_efe61eb0:

    # "Не успела я договорить, как тетрадные листы вновь зашевелились."
    "No pude acabar la frase, porque las páginas comenzaron a moverse otra vez."

translate spanish strings:
    # game/pnc_text.rpy:856
    old "(Не закрывай глаза!)"
    new "(¡No cierres los ojos!)"

# game/pnc_text.rpy:860
translate spanish notebook_d0521114:

    # gg "- Не заставляй меня, мне же страшно!"
    gg "- No me hagas hacerlo, ¡tengo miedo!"

# game/pnc_text.rpy:865
translate spanish notebook_6372ec47:

    # "Шелест усиливается, листы приподнимаются - я могу разглядеть очертания рисунков на предыдущих страницах."
    "El sonido se hace más fuerte, las páginas se levantan... Casi puedo ver las marcas de los dibujos de las páginas anteriores."

# game/pnc_text.rpy:866
translate spanish notebook_cf24a82c:

    # "Нет уж! Все, что было в прошлом, должно там и оставаться!"
    "¡No! ¡Las cosas del pasado deben quedarse en el pasado!"

translate spanish strings:
    # game/pnc_text.rpy:861
    old "(Верь мне.)"
    new "(Confía en mí.)"

# game/pnc_text.rpy:869
translate spanish notebook_25767d3e:

    # gg "- Ты меня не убедил! Все, я закрываю глаза, слышишь?"
    gg "- ¡No puedes convencerme! ¡No puedo, voy a cerrarlos!"

# game/pnc_text.rpy:874
translate spanish notebook_64646323:

    # "Между страниц просачивается едва различимый свет. С каждым порывом ветра он становится все ярче и ярче..."
    "Una luz, apenas perceptible, se puede ver a través de las páginas. Y se vuelve más brillante con cada ráfaga..."

translate spanish strings:
    # game/pnc_text.rpy:870
    old "(Смотри, смотри же!)"
    new "(Mira, ¡mira ahí!)"

# game/pnc_text.rpy:877
translate spanish notebook_9a40790e:

    # gg "- Светлячок!"
    gg "- ¡Una luciérnaga!"

# game/pnc_text.rpy:880
translate spanish notebook_b496e578:

    # "Ветер вмиг прекращается. На секунду мир погружается в полную тишину, но лишь на секунду..."
    "El viento para inmediatamente. Por un momento el mundo se queda en completo silencio, pero solo un momento..."

# game/pnc_text.rpy:881
translate spanish notebook_b8632a5e:

    # "Вечно преследующий меня шум неумолимо заполоняет все вокруг. Но сейчас это неважно!"
    "El zumbido que siempre me ha perseguido llena la habitación, ¡pero ya no importa!"

# game/pnc_text.rpy:884
translate spanish notebook_ca849c5e:

    # gg "- Боже, малыш! Я так перепугалась..."
    gg "- ¡Madre mía, pequeña! Me has asustado..."

# game/pnc_text.rpy:887
translate spanish notebook_ba5348c8:

    # "В ответ светлячок моргает, после чего поднимается в воздух и с громким жужжанием влетает мне в ухо."
    "La luciérnaga parpadea, alza del vuelo y entra en mi oído, zumbando sin parar."

# game/pnc_text.rpy:888
translate spanish notebook_72b512d0:

    # "Какое-то время он ищет подходящее место в моей голове, не прекращая жужжать, но потом затихает."
    "Se pasa un rato buscando el lugar idóneo en mi cabeza, pero el zumbido acaba parando."

# game/pnc_text.rpy:891
translate spanish notebook_5794d60f:

    # gg "- Фух..."
    gg "- Uf..."

translate spanish strings:
    # game/pnc_text.rpy:892
    old "(Ты как, нормально?)"
    new "(¿Te encuentras bien?)"

# game/pnc_text.rpy:896
translate spanish notebook_cf4086f9:

    # gg "- У нас мало времени, давай искать дальше."
    gg "- Nos estamos quedando sin tiempo, sigamos buscando."

# game/pnc_text.rpy:916
translate spanish pills_311114e8:

    # "Я смотрю на кучу лекарств и голова идет кругом. Я не хочу сейчас думать об этом, совсем не хочу..."
    "Miro el montón de pastillas y me mareo. No quiero pensar en ello, no quiero..."

translate spanish strings:
    # game/pnc_text.rpy:917
    old "(Что с тобой?)"
    new "(¿Qué te pasa?)"

# game/pnc_text.rpy:920
translate spanish pills_73c963bb:

    # gg "- Сегодня я едва не пропустила курс. Что за безрассудство! Я ведь могла умереть..."
    gg "- Casi me salto la dosis de hoy. Qué imprudente, ¡podría haber muerto...!"

translate spanish strings:
    # game/pnc_text.rpy:921
    old "(Эй, успокойся. Ты уже все исправила.)"
    new "(Oye, cálmate, ya lo has arreglado.)"

# game/pnc_text.rpy:925
translate spanish pills_4ca8d596:

    # gg "- Да, по твоему приказу!"
    gg "- Sí, ¡porque tú me lo has ordenado!"

translate spanish strings:
    # game/pnc_text.rpy:926
    old "(Это обвинение?)"
    new "(¿Me estás acusando?)"

# game/pnc_text.rpy:930
translate spanish pills_d08b4fbc:

    # gg "- Конечно же нет! Только это меня и спасло."
    gg "- ¡Claro que no! Me has salvado."

translate spanish strings:
    # game/pnc_text.rpy:931
    old "(Что ж... вполне здравая мысль.)"
    new "(Bueno... eso es verdad.)"

translate spanish strings:
    # game/pnc_text.rpy:926
    old "(Все могло быть гораздо хуже.)"
    new "(Podría haber sido mucho peor.)"

# game/pnc_text.rpy:938
translate spanish pills_21c1bac1:

    # gg "- Ага..."
    gg "- Sí..."

translate spanish strings:
    # game/pnc_text.rpy:921
    old "(Ты и так умрешь, чего волноваться?)"
    new "(La muerte es inevitable, ¿por qué preocuparse?)"

# game/pnc_text.rpy:943
translate spanish pills_29ef1128:

    # gg "- Ой, и правда!"
    gg "- Ah, ¡tienes razón!"

# game/pnc_text.rpy:946
translate spanish pills_d2c4cf06:

    # gg "- ..."
    gg "- ..."

# game/pnc_text.rpy:950
translate spanish pills_30a63250:

    # "Я тяжело вздыхаю, подхожу ближе и протягиваю руку..."
    "Inspiro profundamente, me acerco y estiro el brazo..."

# game/pnc_text.rpy:953
translate spanish pills_282e87f2:

    # gg "- Ух ты, тепло!"
    gg "- ¡Hala, está calentito!"

# game/pnc_text.rpy:956
translate spanish pills_d8114ff1:

    # "Не успели слова вылететь из моего рта, как одна из баночек перевернулась; из нее градом посыпались таблетки, а затем..."
    "Cuando digo esas palabras, uno de los botes se vuelca, soltando un montón de pastillas y junto a ellas..."

# game/pnc_text.rpy:959
translate spanish pills_0225fb97:

    # gg "- Светлячок! Ура!"
    gg "- ¡Hurra, una luciérnaga!"

# game/pnc_text.rpy:962
translate spanish pills_b0537a94:

    # "Сделав пару кругов над моей макушкой, он наконец садится на протянутую руку. Спешно пробежав по ней до плеча, светлячок заползает прямо мне в ухо - ум слегка проясняется."
    "Tras rodear mi cabeza un par de veces, por fin se posa en la palma de mi mano, sube por mi brazo y al llegar a mi hombro va directo a mi oreja. Mi mente se aclara un poco."

# game/pnc_text.rpy:982
translate spanish umbrella_6177059b:

    # "От зонта веет едва ощутимой прохладой. Немудрено, ведь только он защищает меня от грозовых туч, что иногда собираются под потолком."
    "El paraguas emana un aura fría. No me extraña, es lo único que me protege de las nubes de tormenta que se arremolinan en el techo."

# game/pnc_text.rpy:983
translate spanish umbrella_7211d4a7:

    # "Какое счастье, что он справляется с этим даже без моего участия!"
    "¡Es un milagro que pueda hacerlo sin mi ayuda!"

# game/pnc_text.rpy:985
translate spanish umbrella_e9ea09c8:

    # gg "- И все же, светлячок не станет прятаться в подобном месте. Иначе он простудится и не сможет летать!"
    gg "- Pero una luciérnaga no se escondería en un lugar así. ¡Pillaría un resfriado y no podría volar!"

translate spanish strings:
    # game/pnc_text.rpy:986
    old "(И ты не хочешь проверить?)"
    new "(¿No quieres registrarlo?)"

# game/pnc_text.rpy:990
translate spanish umbrella_2c1f3804:

    # gg "- Зачем? Я точно знаю - здесь мы ничего не найдем."
    gg "- ¿Por? Estoy segura de que ahí no hay nada."

translate spanish strings:
    # game/pnc_text.rpy:986
    old "(Ладно. Давай искать дальше.)"
    new "(Bueno, pues sigamos buscando.)"

# game/pnc_text.rpy:1019
translate spanish tumba_b9934e56:

    # gg "- Это вряд ли. Все ящики намертво заперты."
    gg "- No creo, todos los cajones están cerrados."

translate spanish strings:
    # game/pnc_text.rpy:1020
    old "(А если...)"
    new "(Y si...)"

# game/pnc_text.rpy:1022
translate spanish tumba_fc1c9c4f:

    # gg "- Я не хочу даже думать о том, что внутри. Невесть чего вообразить можно!"
    gg "- No quiero ni pensar en lo que hay dentro. ¡Quién sabe lo que acabaría imaginando!"

translate spanish strings:
    # game/pnc_text.rpy:1048
    old "(Ладно, давай поищем где-нибудь еще.)"
    new "(Bueno, busquemos en otro lugar, entonces.)"

# game/pnc_text.rpy:1045
translate spanish towel_acd71dda:

    # "Я обращаю свой взгляд к неприметной полке рядом с зеркалом. На ней стоит стакан с зубной щеткой, а рядом висит маленькое полотенце. Прелесть!"
    "Poso mi mirada sobre un discreto estante cerca del espejo. Hay un vaso con un cepillo de dientes y una pequeña toalla colgada al lado. ¡Qué maravillosas vistas!"

# game/pnc_text.rpy:1047
translate spanish towel_1a28ab52:

    # gg "- Мои светлячки умные, хорошие и не станут туда лезть - у них есть понятия о личной гигиене!"
    gg "- Mis luciérnagas son buenas y listas, nunca se esconderían ahí. ¡Saben lo que es la higiene!"

# game/pnc_text.rpy:1068
translate spanish plants_b2dcd22e:

    # gg "- Точно! Насекомые же любят опылять цветы и все такое!"
    gg "- ¡Claro! ¡A los insectos les encanta polinizar flores y todo eso!"

translate spanish strings:
    # game/pnc_text.rpy:1069
    old "(Эм-м... типа того.)"
    new "(Emm... Sí, ¿supongo?)"

# game/pnc_text.rpy:1073
translate spanish plants_37284d6f:

    # "Я подхожу вплотную к полке с цветами. Принюхиваюсь - от листьев пахнет пылью и картоном. И еще смертью."
    "Me acerco a las plantas. Olfateo un poco. Las hojas huelen a polvo y cartón, y a muerte."

translate spanish strings:
    # game/pnc_text.rpy:1074
    old "(Ты в курсе, что цветы давно высохли?)"
    new "(¿Sabes que esas plantas llevan tiempo muertas?)"
    
translate spanish strings:
    # game/pnc_text.rpy:1076
    old "(Вряд ли мертвый цветок может привлечь насекомое.)"
    new "(No creo que una planta muerta atraiga insectos.)"

# game/pnc_text.rpy:1080
translate spanish plants_d40b9e9e:

    # gg "- Тут, знаешь ли, выбирать не приходится."
    gg "- Bueno, tampoco es que tengan otra elección, ¿sabes?"

# game/pnc_text.rpy:1083
translate spanish plants_eb554241:

    # gg "- Хотя... ты прав. Давай искать дальше."
    gg "- Aunque... tienes razón. Sigamos buscando."

translate spanish strings:
    # game/pnc_text.rpy:1084
    old "(Почему бы просто их не выбросить?)"
    new "(¿Por qué no las tiras?)"

# game/pnc_text.rpy:1088
translate spanish plants_bb89c88c:

    # gg "- Ты что, совсем меня не слушал?"
    gg "- ¿Es que no me escuchas?"

# game/pnc_text.rpy:1093
translate spanish plants_d2c4cf06:

    # gg "- ..."
    gg "- ..."

# game/pnc_text.rpy:1111
translate spanish cond_5ae0230c:

    # "Я поднимаю глаза высоко-высоко к потолку."
    "Alzo la vista, hacia un lugar muy alto."

# game/pnc_text.rpy:1112
translate spanish cond_3bb16f8c:

    # "Из кондиционера доносится топот множества маленьких лапок."
    "Puedo oír mogollón de patitas, marchando dentro del aire acondicionado."

# game/pnc_text.rpy:1114
translate spanish cond_ce0adfe1:

    # gg "- Ну вот..."
    gg "- Vaya..."

translate spanish strings:
    # game/pnc_text.rpy:1115
    old "(Что такое?)"
    new "(¿Qué pasa?)"

# game/pnc_text.rpy:1119
translate spanish cond_f224b446:

    # gg "- Светлячки не дружат с тараканами. Надо поискать в другом месте."
    gg "- Las luciérnagas y las cucarachas no se llevan bien. Miremos en otro sitio."

translate spanish strings:
    # game/pnc_text.rpy:1120
    old "(Боже, откуда там тараканы?)"
    new "(¿Por qué iba a haber cucarachas ahí?)"

# game/pnc_text.rpy:1124
translate spanish cond_86021029:

    # gg "- Ты уже забыл?"
    gg "- ¿Lo has olvidado?"

# game/pnc_text.rpy:1125
translate spanish cond_1e339c58:

    # gg "- Сам же сказал мне представить, будто мои мысли - это тараканы."
    gg "- Tú me dijiste que imaginase mis pensamientos como cucarachas."

translate spanish strings:
    # game/pnc_text.rpy:1126
    old "(Да, но...)"
    new "(Sí, pero...)"

# game/pnc_text.rpy:1130
translate spanish cond_911b6235:

    # gg "- Затем они стали светлячками, да... Но тараканы ведь не могут просто взять и исчезнуть!"
    gg "- Después se convirtieron en luciérnagas, pero... ¡las cucarachas no desaparecen así como así!"

# game/pnc_text.rpy:1133
translate spanish cond_c734e0a6:

    # gg "- Вот они и нашли себе местечко."
    gg "- Así que se han metido ahí."

# game/pnc_text.rpy:1136
translate spanish cond_a474b417:

    # gg "- Понял?"
    gg "- ¿Entiendes?"

translate spanish strings:
    # game/pnc_text.rpy:1137
    old "(Понял.)"
    new "(Sí.)"
translate spanish strings:
    # game/pnc_text.rpy:1137
    old "(Не понял.)"
    new "(No.)"
translate spanish strings:
    # game/pnc_text.rpy:1137
    old "(Сделаю вид, что понял.)"
    new "(Fingiré que sí.)"

# game/pnc_text.rpy:1165
translate spanish bulbs_ebc87901:

    # gg "- Ты серьезно?"
    gg "- ¿En serio?"

translate spanish strings:
    # game/pnc_text.rpy:1166
    old "(А что не так?)"
    new "(¿Qué pasa?)"

# game/pnc_text.rpy:1168
translate spanish bulbs_30c3bd25:

    # gg "- Сам подумай: стали бы светлячки лететь на свет?"
    gg "- Piénsalo: ¿por qué iban a sentirse las luciérnagas atraídas por la luz?"

# game/pnc_text.rpy:1169
translate spanish bulbs_c15c589f:

    # gg "- Мне кажется, они вполне самодостаточны в этом плане."
    gg "- Creo que, en ese sentido, son bastante autosuficientes."

# game/pnc_text.rpy:1170
translate spanish bulbs_d2c4cf06:

    # gg "- ..."
    gg "- ..."

# game/pnc_text.rpy:1173
translate spanish bulbs_6f05c6bd:

    # gg "- Если только они целенаправленно не хотят снизить себе самооценку."
    gg "- Bueno, solo si quisieran bajarse el autoestima adrede..."

# game/pnc_text.rpy:1176
translate spanish bulbs_cb7a643e:

    # gg "- Хм-м..."
    gg "- Mm..."

# game/pnc_text.rpy:1196
translate spanish vent_ac59bddc:

    # gg "- Отсюда так просто не выбраться... Хи-хи..."
    gg "- No es tan fácil salir de aquí... eje-je..."

translate spanish strings:
    # game/pnc_text.rpy:1216
    old "(А это что?)"
    new "(¿Y eso qué es?)"

# game/pnc_text.rpy:1219
translate spanish posters_9d2cceaf:

    # gg "- Ах, это..."
    gg "- Ah, eso..."

# game/pnc_text.rpy:1222
translate spanish posters_badaf50e:

    # gg "- Это фотографии моих самых счастливых моментов!"
    gg "- ¡Son fotos de mis recuerdos favoritos!"

translate spanish strings:
    # game/pnc_text.rpy:1223
    old "(На них ведь ничего нет...)"
    new "(Pero están en blanco...)"

# game/pnc_text.rpy:1227
translate spanish posters_62804578:

    # gg "- Я так долго смотрела на них, что буквально сожгла взглядом, хи-хи!"
    gg "- Las he mirado tanto que las he acabado gastando, ¡eje-je!"

# game/pnc_text.rpy:1228
translate spanish posters_c0104c7b:

    # gg "- Теперь они просто закрывают трещины в стенах."
    gg "- Ahora solo sirven para tapar las grietas de la pared."

translate spanish strings:
    # game/pnc_text.rpy:1229
    old "(Трещины?)"
    new "(¿Grietas?)"

# game/pnc_text.rpy:1233
translate spanish posters_0639eea2:

    # gg "- Неважно. Дальше искать будем или как?"
    gg "- Olvídalo, ¿seguimos buscando o qué?"

translate spanish strings:
    # game/pnc_text.rpy:1234
    old "(Будем, будем...)"
    new "(Sí, venga...)"

# game/pnc_text.rpy:1254
translate spanish smth_7b670ab8:

    # gg "- Что это?"
    gg "- ¿Esto qué es?"

# game/pnc_text.rpy:1275
translate spanish shkaf_be2fa242:

    # "Я запрокидываю голову и чуть не падаю. Шкаф висит под самым потолком - метров сто от пола, не меньше."
    "Echo la cabeza hacia atrás y casi me caigo. El armario cuelga a no menos de cien metros del suelo."

# game/pnc_text.rpy:1277
translate spanish shkaf_8ee16e1e:

    # gg "- Издеваешься?.."
    gg "- ¿Estás de broma...?"

# game/pnc_text.rpy:1278
translate spanish shkaf_597bb54a:

    # gg "- Хоть это и моя комната, но многое здесь предназначено отнюдь не для меня."
    gg "- Aunque sea mi habitación, no todo está pensado para que yo lo use."

# game/pnc_text.rpy:1281
translate spanish shkaf_3d885d51:

    # gg "- Ну и ладно!"
    gg "- ¡Da igual!"

# game/pnc_text.rpy:1284
translate spanish shkaf_d4166c15:

    # gg "- Мне вообще плевать!"
    gg "- ¡No me importa!"

# game/pnc_text.rpy:1285
translate spanish shkaf_db2e8cc7:

    # gg "- Да-да, плевать! И еще как!"
    gg "- Así es, ¡no me importa en absoluto!"

# game/pnc_text.rpy:1286
translate spanish shkaf_9fbd832c:

    # gg "- Вообще все равно! И я нисколько не переживаю!"
    gg "- ¡Nada de nada! ¡Y tampoco estoy preocupada!"

# game/pnc_text.rpy:1287
translate spanish shkaf_2ecec224:

    # gg "- Даже самую малость! Даже крупицу от самой малости!"
    gg "- ¡Ni siquiera un poquito! ¡Ni una pizca!"

# game/pnc_text.rpy:1288
translate spanish shkaf_a267440e:

    # gg "- Даже на одну тысячную процента не переживаю! Вот настолько мне все равно!"
    gg "- ¡Ni siquiera una millonésima parte! ¡Eso es lo poco que me importa!"


# game/pnc_text.rpy:1293
translate spanish shkaf_ed736609:

    # gg "- Эй! Ты еще до конца не дослушал, насколько мне все равно..."
    gg "- ¡Eh! No he acabado de decirte lo poco que me importa..."

translate spanish strings:
    # game/pnc_text.rpy:1294
    old "(Начиная с этой секунды, я тебя игнорирую.)"
    new "(A partir de ahora, te voy a ignorar.)"

# game/pnc_text.rpy:1298
translate spanish shkaf_44bd970c:

    # gg "- Ну уж нет!"
    gg "- Ah no, ¡eso sí que no!"

translate spanish strings:
    # game/pnc_text.rpy:1299
    old "(Тогда веди себя нормально.)"
    new "(Pues compórtate.)"

# game/pnc_text.rpy:1303
translate spanish shkaf_d2c4cf06:

    # gg "- ..."
    gg "- ..."
