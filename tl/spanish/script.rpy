translate spanish dnow_ff5dff03:

    # gg "- Все вещи должны оставаться на своих местах и никак иначе!"
    gg "- ¡Todo debe mantenerse en su sitio y no hay más que decir!"

translate spanish strings:
    # game/script.rpy:966
    old "(Почему?)"
    new "(¿Por qué?)"

# game/script.rpy:970
translate spanish dnow_d2c4cf06:

    # gg "- ..."
    gg "- ..."

# game/script.rpy:973
translate spanish dnow_d2c4cf06_1:

    # gg "- ..."
    gg "- ..."

translate spanish strings:
    # game/script.rpy:975
    old "(Ты что, пытаешься придумать причину прямо сейчас?)"
    new "(¿Estás intentando inventarte un motivo?)"

# game/script.rpy:979
translate spanish dnow_ce73d993:

    # gg "- Я?.. Н-нет, ничего подобного!"
    gg "- Quién, ¿yo...? N-no, ¡claro que no!"

translate spanish strings:
    # game/script.rpy:980
    old "(Кажется, ты забыла поставить свой мыслеблок - тебя всю насквозь видно.)"
    new "(Creo que has olvidado bloquear tu mente. Puedo ver a través de ti.)"

# game/script.rpy:984
translate spanish dnow_d88ada95:

    # gg "- Нахал!"
    gg "- ¡Grosero!"

translate spanish strings:
    # game/script.rpy:975
    old "(Не хочешь - не говори...)"
    new "(No me lo digas si no quieres...)"

# game/script.rpy:986
translate spanish dnow_1a408a1d:

    # gg "- Не хочу и не скажу!"
    gg "- ¡Ni quiero ni lo haré!"

translate spanish strings:
    # game/script.rpy:988
    old "(Что ж, ладно. Выходит, нам надо найти крохотных насекомых среди кучи хлама, при этом не сдвинув ничего даже на сантиметр?)"
    new "(Pues vale. Así que, ¿tenemos que encontrar un montón de diminutos insectos, entre un montón de basura, sin mover nada?)"
    
# game/script.rpy:993
translate spanish dnow_76c5c726:

    # gg "- Да!"
    gg "- ¡Sí!"

# game/script.rpy:999
translate spanish dnow_d2c4cf06_2:

    # gg "- ..."
    gg "- ..."

translate spanish strings:
    # game/script.rpy:995
    old "(Ну и ну.)"
    new "(Dios mío.)"

# game/script.rpy:1003
translate spanish dnow_1c7eb231:

    # gg "- У меня есть идея!.."
    gg "- ¡Tengo una idea...!"

# game/script.rpy:1004
translate spanish dnow_f6217dc7:

    # gg "- В прошлый раз я была персонажем визуальной новеллы, и это помогло мне справиться с задачей. Теперь я хочу быть персонажем квеста!"
    gg "- La última vez, convertirme en un personaje de novela visual me ayudó a conseguir mi objetivo. ¡Ahora quiero ser el personaje de una aventura gráfica!"

# game/script.rpy:1007
translate spanish dnow_1508e200:

    # gg "- Знаешь... Там бывают эпизоды, когда ты просто смотришь на разные предметы и что-то обязательно происходит!"
    gg "- Ya sabes... ¡en esos juegos hay momentos en los que simplemente miras diferentes objetos y seguro que algo sucede!"

# game/script.rpy:1010
translate spanish dnow_7ed4e67e:

    # gg "- Здорово же!"
    gg "- ¡Suena tan divertido!"

translate spanish strings:
    # game/script.rpy:1012
    old "(А как же те вещи, которыми ты пользуешься регулярно? Их ты тоже отказываешь трогать?)"
    new "(¿Y las cosas que usas habitualmente? ¿esas tampoco las vas a tocar?)"

# game/script.rpy:1016
translate spanish dnow_f374ad70:

    # gg "- Так даже интересней!"
    gg "- ¡Eso lo hará aún más interesante!"

translate spanish strings:
    # game/script.rpy:1018
    old "(Это так по-детски...)"
    new "(Esto es tan infantil...)"

# game/script.rpy:1022
translate spanish dnow_404b2d65:

    # gg "- А знаешь, что самое классное?"
    gg "- ¿Quieres saber cuál es la mejor parte?"

# game/script.rpy:1025
translate spanish dnow_018481c6:

    # gg "- Что этим займешься ты!"
    gg "- ¡Que serás tú el que lo haga!"

translate spanish strings:
    # game/script.rpy:1027
    old "(Ну уж нет.)"
    new "(Eso sí que no.)"

# game/script.rpy:1032
translate spanish dnow_02b45ca5:

    # gg "- А вот и да!"
    gg "- ¡Claro que sí!"

# game/script.rpy:1035
translate spanish dnow_e18ec4be:

    # gg "- У меня начинается паника, когда нужно выбрать что-то одно из множества вариантов."
    gg "- Cuando me hacen escoger entre varias opciones me entra el pánico."

# game/script.rpy:1038
translate spanish dnow_28821113:

    # gg "- Я буду без конца топтаться на месте и в конечном итоге расплачусь и убегу. Ты этого хочешь?"
    gg "- No dejaría de cambiar de opinión y acabaría poniéndome a llorar y huyendo. ¿Quieres que pase eso?"

translate spanish strings:
    # game/script.rpy:1040
    old "(До чего капризная...)"
    new "(Qué caprichosa eres...)"

    # game/script.rpy:1042
    old "(Ты ведь уже доказала, что способна на самостоятельные решения. Почему бы не продолжить в том же духе?)"
    new "(Ya has demostrado que puedes tomar decisiones. ¿Por qué no sigues así?)"

# game/script.rpy:1047
translate spanish dnow_72cdfff6:

    # gg "- Ну же, не будь таким скучным!"
    gg "- Venga hombre, ¡no seas tan aburrido!"

translate spanish strings:
    # game/script.rpy:1042
    old "(Делай, что хочешь.)"
    new "(Haz lo que quieras.)"

    # game/script.rpy:1051
    old "(Я ведь просто дразнюсь.)"
    new "(Solo te estaba tomando el pelo.)"

    # game/script.rpy:1053
    old "(Не нужно все взваливать на себя. Просить помощи - это вполне здравое решение.)"
    new "(No tienes por qué soportar toda la carga tú sola. Pedir ayuda es una opción razonable.)"

# game/script.rpy:1057
translate spanish dnow_3903e43e:

    # gg "- Давай уже приступать!"
    gg "- ¡Empecemos ya!"

# game/script.rpy:1063
translate spanish pncok_5bc7700e:

    # "Я выхожу в центр комнаты и оглядываюсь по сторонам. Куда бы я спряталась, будь я маленьким светлячком? Ах, до чего же интересно!"
    "Me pongo en el centro de la habitación y miro alrededor. ¿Dónde me escondería si fuera una pequeña luciérnaga? Ay, ¡qué emocionante!"

# game/script.rpy:1064
translate spanish pncok_860a6553:

    # "От предвкушения на сердце ощутимо теплеет."
    "Mi corazón se acelera por la agradable anticipación."

translate spanish strings:
    # game/script.rpy:1066
    old "(Эй.)"
    new "(Eh.)"

# game/script.rpy:1070
translate spanish pncok_7dc040c1:

    # gg "- Что?"
    gg "- ¿Qué?"

translate spanish strings:
    # game/script.rpy:1072
    old "(Посмотри вниз.)"
    new "(Mira abajo.)"

# game/script.rpy:1076
translate spanish pncok_a77e0f49:

    # "Я опускаю глаза; спустя секунду из-под моей кофты выползает маленький комочек тепла и света."
    "Miro hacia abajo. Tras unos segundos, una pequeña bola luminosa y cálida sale de debajo de mi suéter."

# game/script.rpy:1079
translate spanish pncok_5565644f:

    # gg "- Ух ты!"
    gg "- ¡Hala!"

translate spanish strings:
    # game/script.rpy:1081
    old "(Ух ты!)"
    new "(¡Hala!)"

    # game/script.rpy:1081
    old "(У тебя одежда дымится.)"
    new "(Tu ropa humea.)"

# game/script.rpy:1087
translate spanish pncok_cfa2ba2c:

    # gg "- Хи-хи, да и пусть!"
    gg "- Je-je, ¡qué más da!"

# game/script.rpy:1110
translate spanish pncok_b5d45138:

    # "Я аккуратно подхватываю светлячка - он приятно обжигает пальцы - и кладу на плечо."
    "Agarro la luciérnaga, cuidadosamente. Su tacto es placenteramente abrasador. La pongo sobre mi hombro."

# game/script.rpy:1111
translate spanish pncok_aba9866a:

    # gg "- Прости меня, малыш. Пора домой!"
    gg "- Lo siento, pequeña, ¡hora de volver a casa!"

# game/script.rpy:1112
translate spanish pncok_d7a01a72:

    # "Словно по команде, светлячок неспешно поднимается в воздух, кружит над головой какое-то время, а затем пулей залетает прямо мне в ухо."
    "Como si de una orden se tratase, la luciérnaga alza el vuelo lentamente, da vueltas alrededor de mi cabeza un rato y se mete en mi oído a la velocidad de una bala."

# game/script.rpy:1113
translate spanish pncok_5c63d157:

    # gg "- Хи-хи, щекотно!"
    gg "- Je-je, ¡hace cosquillas!"

translate spanish strings:
    # game/script.rpy:1114
    old "(Что ж, один есть. Давай искать остальных!)"
    new "(Una menos, ¡busquemos a las demás!)"

# game/script.rpy:1116
translate spanish pncok_2fdaa014:

    # gg "- Давай!"
    gg "- ¡Sí!"

# game/script.rpy:1151
translate spanish vse_d3cbdcd6:

    # "Мысли вроде бы собрались в кучу, но что-то все равно тревожит меня. С другой стороны, я ведь и не должна радоваться..."
    "He conseguido ordenar mis pensamientos, pero sigo preocupada. Aunque, yo no debería ser feliz..."

translate spanish strings:
    # game/script.rpy:1152
    old "(Почему так?)"
    new "(¿Por qué no?)"

# game/script.rpy:1155
translate spanish vse_6a9c5552:

    # gg "- Если я что-то потеряла, а потом нашла - это просто возврат к началу. Никаких изменений. Ноль - ни плюс, ни минус."
    gg "- Si pierdo algo y lo encuentro, es como volver al punto de salida, no cambia nada. Como sumar 0."

# game/script.rpy:1158
translate spanish vse_0057ff0c:

    # gg "- А радость - это всегда плюс, понимаешь?"
    gg "- Y la felicidad está relacionada con ser positivo, ¿no?"

translate spanish strings:
    # game/script.rpy:1159
    old "(Тебе вредно слишком много думать, знаешь ли.)"
    new "(No deberías pensar tanto, te hace mal.)"

# game/script.rpy:1163
translate spanish vse_afbf734b:

    # gg "- Спать хочется..."
    gg "- Quiero dormir..."

translate spanish strings:
    # game/script.rpy:1164
    old "(Может, проветришься перед сном?)"
    new "(¿Qué tal si tomas un poco de aire fresco antes de acostarte?)"

# game/script.rpy:1168
translate spanish vse_313b8362:

    # gg "- То есть?"
    gg "- ¿Qué quieres decir?"

translate spanish strings:
    # game/script.rpy:1169
    old "(Ну, выйдешь на балкон, воздухом подышишь.)"
    new "(Bueno, sal al balcón y tómate un respiro.)"

# game/script.rpy:1173
translate spanish vse_f207a773:

    # "Почему-то эти слова вызвали у меня приступ паники. Я неосознанно делаю шаг назад от балкона."
    "Por algún motivo, esas palabras me provocan un ataque de pánico. Inconscientemente, me alejo del balcón."

# game/script.rpy:1176
translate spanish vse_24dcda0c:

    # gg "- Не думаю, что это хорошая идея..."
    gg "- No creo que sea buena idea."

# game/script.rpy:1181
translate spanish vse_1b97dc2f:

    # gg "- Это может прозвучать глупо, но..."
    gg "- A lo mejor suena tonto, pero..."

# game/script.rpy:1184
translate spanish vse_5123b8e9:

    # gg "- Мне кажется, кто-то смотрит на меня."
    gg "- Siento que alguien me observa."

translate spanish strings:
    # game/script.rpy:1185
    old "(Хорошо, давай останемся здесь.)"
    new "(Bueno, quedémonos aquí.)"

# game/script.rpy:1189
translate spanish vse_b98b4ac4:

    # gg "- Ага."
    gg "- Sí."

# game/script.rpy:1196
translate spanish vse_d2c4cf06:

    # gg "- ..."
    gg "- ..."

translate spanish strings:
    # game/script.rpy:1185
    old "(Да кому ты нужна!)"
    new "(¡No creo que le importes tanto a nadie!)"

# game/script.rpy:1199
translate spanish vse_597b198e:

    # gg "- Всего на пару минут, ладно?"
    gg "- Solo dos minutos, ¿vale?"

# game/script.rpy:1228
translate spanish balcony_5fe0ef87:

    # "Мой дом похож на бездонный котел. Вместо копоти на его стенках - сотни бетонных и железных коробок."
    "Mi bloque parece una olla sin fondo, pero en lugar de tizne tiene cientos de ladrillos de hormigón en sus paredes."

# game/script.rpy:1229
translate spanish balcony_78598842:

    # "В окнах горит свет, звучат неразборчивые голоса. Оглушающе воет ветер, закручиваясь спиралями и разделяясь на сотни отдельных потоков - по всей видимости, для того, чтобы быть услышанным каждым жителем дома."
    "Hay luces en las ventanas y se escuchan voces ahogadas al otro lado. El viento aúlla y se divide en cientos de corrientes, parece que quiere ser escuchado por todos los inquilinos."

# game/script.rpy:1230
translate spanish balcony_d565a8c8:

    # "До чего же, должно быть, тоскливо постоянно жить в тишине..."
    "Qué triste debe ser vivir en permanente silencio..."

translate spanish strings:
    # game/script.rpy:1231
    old "(Странный у тебя дом, не находишь?)"
    new "(Tu bloque es bastante raro, ¿no?)"

# game/script.rpy:1233
translate spanish balcony_bc46b78c:

    # gg "- Раньше из окна был вид на горизонт, а дом уходил вправо и влево на многие сотни метров. Наверно, в какой-то момент он замкнулся в кольцо."
    gg "- Antes se podía ver el horizonte desde mi ventana y el edificio se extendía kilómetros en ambas direcciones. Supongo que en algún momento acabó convirtiéndose en un círculo cerrado."

# game/script.rpy:1234
translate spanish balcony_b189aeb5:

    # gg "- По-моему, ничего странного."
    gg "- En mi opinión, nada extraño."

# game/script.rpy:1239
translate spanish balcony_727b343d:

#тут должен быть вопрос "как ты себя чувствуешь?"

    # gg "- Я определенно себя чувствую. Иногда большего и не надо."
    gg "- Siento. A veces, es más que suficiente."

translate spanish strings:
    # game/script.rpy:1240
    old "(И все же, тебе тревожно. Я прав?)"
    new "(Y, aún así, estás preocupada. ¿Me equivoco?)"
    
# game/script.rpy:1242
translate spanish balcony_e6eb9e25:

    # gg "- Разумеется. Более того - я в абсолютном ужасе. Но разве это так заметно?"
    gg "- No. Es más, estoy completamente aterrada, ¿tanto se nota?"

translate spanish strings:
    # game/script.rpy:1243
    old "(Ты смотришь куда угодно, но не вверх.)"
    new "(Miras a todos lados, excepto arriba)"

# game/script.rpy:1245
translate spanish balcony_9d2cceaf:

    # gg "- Ах, это..."
    gg "- Ah, eso..."

# game/script.rpy:1246
translate spanish balcony_344ec585:

    # gg "- Я ведь тебе рассказывала, верно?"
    gg "- Ya te lo conté, ¿no?"

translate spanish strings:
    # game/script.rpy:1247
    old "(О чем?)"
    new "(¿El qué?)"

# game/script.rpy:1249
translate spanish balcony_5d9aea77:

    # gg "- Да так, пустяки."
    gg "- Ah, ya sabes, minucias."

translate spanish strings:
    # game/script.rpy:1250
    old "(Разве могут пустяки вызывать ужас?)"
    new "(¿Como pueden las 'minucias' aterrarte tanto?)"

# game/script.rpy:1252
translate spanish balcony_b32a0bf7:

    # gg "- Это... сложно описать."
    gg "- Es... difícil de explicar."

# game/script.rpy:1253
translate spanish balcony_ef0fd9d5:

    # "Я взбираюсь на металлические перила и свешиваю ноги вниз."
    "Me subo al pasamanos de metal, dejando colgar mis piernas."

# game/script.rpy:1254
translate spanish balcony_3e7b79d9:

    # "Один за другим бросаю в бездну короткие взгляды - та отвечает мне рассерженным ледяным дыханием."
    "Poco a poco, lanzo breves miradas al abismo; me responde con voz fría y enfadada."

# game/script.rpy:1255
translate spanish balcony_067566ed:

    # "Так мы и общаемся. Будто старинные друзья."
    "Así es cómo nos comunicamos. Como viejos amigos."

# game/script.rpy:1256
translate spanish balcony_ef030281:

    # gg "- Иногда мне кажется, что весь мир притворяется ненормальным."
    gg "- A veces pienso que todo el mundo finge estar loco."

# game/script.rpy:1257
translate spanish balcony_b10fcdd5:

    # gg "- Он будто бы хочет убедить меня в чем-то, чего на самом деле нет."
    gg "- Como si quisieran hacerme creer en algo que no existe."

translate spanish strings:
    # game/script.rpy:1258
    old "(Странно, не находишь?)"
    new "(Raro, ¿no te parece?)"

# game/script.rpy:1260
translate spanish balcony_dc3a6a30:

    # gg "- Да, но..."
    gg "- Sí, pero..."

# game/script.rpy:1261
translate spanish balcony_6f79190d:

    # gg "- В то же время... Я даже немного рада этому."
    gg "- Al mismo tiempo... me pone un poco feliz."

# game/script.rpy:1262
translate spanish balcony_d144836c:

    # gg "- Все вокруг создано лишь для меня. Создано обманывать, запутывать, сбивать с толку..."
    gg "- Todo a mi alrededor fue creado para mí, para engañarme y confundirme..."

# game/script.rpy:1263
translate spanish balcony_55810e11:

    # gg "- Если это правда, выходит, не такая уж я и сумасшедшая?"
    gg "- Si es verdad, supongo que no estoy tan loca, después de todo."

translate spanish strings:
    # game/script.rpy:1264
    old "(Считать это правдой и есть сумасшествие.)"
    new "(Que creas eso ya te convierte en una loca.)"

# game/script.rpy:1266
translate spanish balcony_7744fdf5:

    # gg "- Наверное."
    gg "- Puede ser."

# game/script.rpy:1267
translate spanish balcony_a20cefa7:

    # "..."
    "..."

# game/script.rpy:1268
translate spanish balcony_48687508:

    # "Очередной ураган проносится по стенкам котла, разбивая в пыль стекла и сметая бетонный налет. Меня он лишь нежно гладит, взъерошивая волосы."
    "Otra ráfaga de viento golpea las paredes de la olla, haciendo añicos los cristales y arrancando esquirlas de cemento. Yo, por otro lado, siento una suave brisa acariciándome el pelo."

# game/script.rpy:1276
translate spanish fall_db020311:

    # gg "- Я так и не придумала кодовое слово..."
    gg "- Aún no se me ha ocurrido una palabra clave..."

translate spanish strings:
    # game/script.rpy:1277
    old "(Ты ведь и сама вспомнила о своем обещании. Значит, кодовое слово уже не нужно.)"
    new "(Tú misma has recordado la promesa, ya no necesitas ninguna palabra clave.)"

# game/script.rpy:1279
translate spanish fall_c721f2ec:

    # gg "- Не люблю, когда так происходит. Хочу вспоминать о некоторых вещах только тогда, когда хочется."
    gg "- No me gusta que pase eso. Quiero recordar lo que yo quiera, cuando yo quiera."

translate spanish strings:
    # game/script.rpy:1280
    old "(Тем не менее, ты обещала.)"
    new "(Aún así, hiciste esa promesa.)"

# game/script.rpy:1282
translate spanish fall_4ae32b2e:

    # gg "- Я сдержу обещание. Просто имей в виду, что с этой секунды каждое слово будет приносить мне боль."
    gg "- Y la mantendré, pero debes saber que, de ahora en adelante, cada palabra me dolerá."

# game/script.rpy:1283
translate spanish fall_8ba04f43:

    # "Я наклоняюсь вниз и мысленно падаю в пропасть. Ровно две минуты до того, как я разобьюсь."
    "Me inclino y me imagino cayendo al abismo. Tengo exactamente dos minutos antes de que se me acabe el tiempo."

# game/script.rpy:1314
translate spanish fall_6e7ffcd9:

    # gg "- У меня был друг в сети. Лучший друг! Даже несмотря на то, что его набор букв вместо имени был не самым клевым."
    gg "- Tenía un amigo de internet, ¡mi mejor amigo! Aunque la combinación de letras que usaba como apodo no molaba nada."

# game/script.rpy:1315
translate spanish fall_04ef6841:

    # gg "- Да и набор пикселей вместо фотографии был скучным и непривлекательным..."
    gg "- Bueno, la combinación de píxeles que tenía como foto de perfil también era aburrida y algo fea..."

# game/script.rpy:1316
translate spanish fall_05fead8a:

    # gg "- Это ведь странно и неправильно - нарушать правила нахождения в сети. Зачем он это делал?"
    gg "- Romper las normas de internet es extraño y está mal. ¿Por qué lo hizo?"

# game/script.rpy:1317
translate spanish fall_4bcbf580:

    # gg "- Может, в его коде не хватало нескольких строк?"
    gg "- ¿Quizá su código tenía unas líneas de menos?"

translate spanish strings:
    # game/script.rpy:1318
    old "(Я не совсем понимаю, о чем ты.)"
    new "(No entiendo qué quieres decir.)"
    
# game/script.rpy:1320
translate spanish fall_f66a60bd:

    # gg "- Я бы могла рассказать тебе об этих правилах."
    gg "- Puedo explicarte las normas."

# game/script.rpy:1321
translate spanish fall_16920eb1:

    # gg "- Их невозможно нигде отыскать, но я-то умная и сама во всем разобралась!"
    gg "- No se pueden encontrar en ningún lugar, ¡pero soy tan lista que las descubrí!"

# game/script.rpy:1322
translate spanish fall_6dddc581:

    # gg "- Однако же..."
    gg "- Aunque..."

# game/script.rpy:1323
translate spanish fall_02dee236:

    # gg "- Я не уверена, стоит ли их озвучивать."
    gg "- No sé si debería revelarlas."

# game/script.rpy:1326
translate spanish fall_f86b348e:

    # gg "- Когда я пытаюсь произнести вслух то, что на уме - запросто могу где-то ошибиться."
    gg "- Cuando intento expresarme en voz alta, tiendo a cometer errores."

# game/script.rpy:1327
translate spanish fall_e14d8490:

    # gg "- Одна ошибка - и все сказанное дальше полностью противоречит моим мыслям."
    gg "- Si cometo alguno, todo comienza a contradecir mis pensamientos."

# game/script.rpy:1328
translate spanish fall_dbf33c3d:

    # gg "- И в итоге я сама себя разубеждаю."
    gg "- Y acabo pensando lo contrario."

# game/script.rpy:1329
translate spanish fall_d0ee67f8:

    # gg "- А я этого не хочу!"
    gg "- ¡Y no quiero eso!"

translate spanish strings:
    # game/script.rpy:1330
    old "(По твоей логике лучше вообще никогда рта не открывать.)"
    new "(Entonces, sería mejor que te quedases siempre callada.)"
    
# game/script.rpy:1332
translate spanish fall_90c701a6:

    # gg "- Конечно! Это моя мечта!"
    gg "- ¡Sí! ¡ese es mi sueño!"

# game/script.rpy:1333
translate spanish fall_ef2b79ea:

    # gg "- Не открывать рта, не вставать с кровати, ничего не видеть и не слышать..."
    gg "- Mantenerme callada, no levantarme nunca de la cama, no ver ni oír nunca nada..."

# game/script.rpy:1334
translate spanish fall_d5bd69aa:

    # gg "- Лишь сны, сны... ах, ну почему все так ужасно?"
    gg "- Simplemente, soñar sin parar... ah, ¿por qué todo es tan horrible?"

translate spanish strings:
    # game/script.rpy:1335
    old "(Не отвлекайся. Так что же твой друг?)"
    new "(No te distraigas. ¿Qué pasó con tu amigo?)"
    
# game/script.rpy:1337
translate spanish fall_068b19d2:

    # gg "- Друг?"
    gg "- ¿Mi amigo?"

# game/script.rpy:1338
translate spanish fall_de9236f7:

    # gg "- Ах, да..."
    gg "- Ah, sí..."

# game/script.rpy:1339
translate spanish fall_eb3b671b:

    # gg "- Он... и хватило же наглости!.."
    gg "- ¡Él... tuvo el descaro de...!"

translate spanish strings:
    # game/script.rpy:1340
    old "(Ну же, собери мысли в кучу.)"
    new "(Venga, arranca.)"

# game/script.rpy:1342
translate spanish fall_3e166794:

    # gg "- Он каким-то образом заставил меня поверить, будто он настоящий."
    gg "- Me hizo creer que era una persona real."

# game/script.rpy:1343
translate spanish fall_9b6a13df:

    # gg "- Расписывал мне чью-то жизнь в мельчайших подробностях, выдавая за свою."
    gg "- No paraba de describir la vida de otro, como si fuera la suya."

# game/script.rpy:1344
translate spanish fall_b2950fc7:

    # gg "- И, разумеется, ждал того же и от меня."
    gg "- Y quería que yo hiciera lo mismo."

# game/script.rpy:1345
translate spanish fall_67ffc7a0:

    # gg "- Ну я и рассказала ему все-все о себе. Ничего не утаила."
    gg "- Así que, le conté todo sobre mí. Sin esconder nada."

# game/script.rpy:1346
translate spanish fall_d72da0b3:

    # "Я крепко стискиваю зубы. Ветер нещадно хлещет по лицу, разрезает кожу на неровные полосы, словно тонкую ткань."
    "Aprieto los dientes. El viento golpea mi cara sin piedad y me corta la piel como si fuera una fina tela."

# game/script.rpy:1347
translate spanish fall_c046a810:

    # gg "- Он знал обо мне больше, чем кто-либо в мире."
    gg "- Sabía más de mí que nadie en este mundo."

# game/script.rpy:1348
translate spanish fall_3e696f84:

    # gg "- И знаешь, что он сделал?"
    gg "- Y, ¿sabes qué hizo?" #THIS SENTENCE SHOULD BE TRANSLATED SO IT COULD BE ANSWERED WITH SIMPLY "YES" OR "NO"

# game/script.rpy:1351
translate spanish fall_8ebb7d3e:

    # gg "- Ха-ха..."
    gg "- A-ja-ja..."

# game/script.rpy:1352
translate spanish fall_89d47646:

    # gg "- Натравить на меня сотни ботов, должно быть, очень весело."
    gg "- Mandar un ejército de bots a acosarme debió ser divertido."

# game/script.rpy:1353
translate spanish fall_b1494d20:

    # gg "- А главное, все от этого только выигрывают."
    gg "- Y lo más importante, era un situación beneficiosa para él."

# game/script.rpy:1354
translate spanish fall_293f6639:

    # gg "- Они появляются тут и там. Довольно простой код, не требующих особых усилий для выполнения - неудивительно, что алгоритм присуждает эту модель поведения с большей вероятностью, чем прочие из списка."
    gg "- Aparecen aquí y allá. Líneas de código muy fáciles de ejecutar. No es de extrañar que el algoritmo asigne ese patrón con más frecuencia que los demás de la lista."

# game/script.rpy:1355
translate spanish fall_a2d7e645:

    # gg "- Генераторы текстов и видеороликов тут же принимаются за работу. Мое имя всплывает в сети все чаще и чаще."
    gg "- Los generadores de texto y vídeo comienzan a trabajar a la vez. Mi nombre comienza a aparecer con más frecuencia en la red."

# game/script.rpy:1356
translate spanish fall_40939d2a:

    # gg "- Это невыносимо."
    gg "- Es insoportable."

# game/script.rpy:1357
translate spanish fall_706a6e0e:

    # gg "- Невыносимо."
    gg "- Insoportable."

# game/script.rpy:1358
translate spanish fall_97c3fe1a:

    # gg "- Из-за каждого угла, с балконов, крыш, подвалов, стен, потолков я всегда ощущаю пристальные взгляды множества глаз."
    gg "- En cada esquina, cada balcón, cada azotea, cada techo, cada pared... Siento infinitos pares de ojos observándome."

# game/script.rpy:1359
translate spanish fall_114f66a0:

    # gg "- А теперь - и с экранов."
    gg "- Y ahora, también en las pantallas."

# game/script.rpy:1360
translate spanish fall_a1594cd8:

    # gg "- Но я положу этому конец. Я давно решила."
    gg "- Pero le pondré fin. Lo decidí hace mucho tiempo."

# game/script.rpy:1361
translate spanish fall_63878067:

    # gg "- Хотя... Возможно, я решила сделать это только..."
    gg "- Aunque... Puede que decidiera hacerlo sola..."

# game/script.rpy:1369
translate spanish fall_7ccfd918:

    # "Мое тело наконец обрушивается на землю, разлетаясь, словно фарфор, на миллионы мелких частиц."
    "Mi cuerpo finalmente se estrella contra el suelo, estallando en un millón de pedazos, como un jarrón de porcelana."

# game/script.rpy:1371
translate spanish fall_b96349c6:

    # "Уже вторая смерть за сегодня."
    "Ya es la segunda muerte de hoy."

# game/script.rpy:1375
translate spanish nofall_decc57b3:

    # gg "- Мне холодно, пойдем внутрь."
    gg "- Tengo frío, volvamos adentro."

# game/script.rpy:1395
translate spanish nofall_e7bfe7ca:

    # "Я вернулась в комнату. К счастью, она совсем не изменилась за те минуты, что я была за её пределами."
    "Vuelvo a mi habitación. Afortunadamente, no ha cambiado ni un ápice durante los minutos que he estado fuera."

# game/script.rpy:1397
translate spanish nofall_4e43e68b:

    # "Ни секунды не думая, я подхожу к ноутбуку и с силой выдергиваю кабель из розетки."
    "Sin pensármelo dos veces, voy hacia mi portátil y arranco el cable de alimentación."

# game/script.rpy:1401
translate spanish nofall_37875b61:

    # gg "- Вот и все."
    gg "- Se acabó."

# game/script.rpy:1402
translate spanish nofall_5675f48a:

    # "Вот и все."
    "Se acabó."
    
translate spanish strings:
    # game/script.rpy:1403
    old "(Вот и все.)"
    new "(Se acabó.)"
    
    # game/script.rpy:1411
    old "(Что будешь делать?)"
    new "(¿Qué vas a hacer?)"
    
# game/script.rpy:1416
translate spanish room_8139d3e3:

    # gg "- Что за глупый вопрос?"
    gg "- Qué pregunta tan tonta."

# game/script.rpy:1417
translate spanish room_9920cc55:

    # gg "- Спать, конечно же."
    gg "- Es obvio, me voy a dormir."

# game/script.rpy:1420
translate spanish room_269ca6e8:

    # gg "- Надеяться, что завтра наступит через год или десять."
    gg "- Espero que mañana sea dentro de un año o diez."

# game/script.rpy:1423
translate spanish room_48115f70:

    # gg "- Представлять, будто я где-то вне своей оболочки, и при этом я - это все еще я. Немыслимо, как молоко вне пакета. И все же..."
    gg "- Me imagino fuera de mi cuerpo, pero, al mismo tiempo, sigo siendo yo. Ridículo, como la leche fuera de una bolsa de leche. Y aún así..."

translate spanish strings:
    # game/script.rpy:1424
    old "(И все же?..)"
    new "(¿Aún así...?)"
    
# game/script.rpy:1428
translate spanish room_46fc17ca:

    # gg "- Необязательно говорить вслух, чтобы я понимала, что ты переживаешь за меня."
    gg "- No hace falta que me hables en voz alta para que entienda que estás preocupado por mí."

# game/script.rpy:1429
translate spanish room_b0c4f51c:

    # gg "- Ведь я и так это знаю."
    gg "- Ya lo sé."

# game/script.rpy:1432
translate spanish room_e90031c5:

    # gg "- Также я знаю, что у нас осталось совсем немного времени."
    gg "- También sé que nos estamos quedando sin tiempo."

translate spanish strings:
    # game/script.rpy:1433
    old "(Ты не станешь пить еще одну таблетку.)"
    new "(No pretenderás tomarte otra pastilla.)"
    
# game/script.rpy:1437
translate spanish room_7de67075:

    # gg "- Разумеется. Более того, я не стану пить ее и завтра."
    gg "- Claro que no. De hecho, mañana tampoco me la tomaré."

# game/script.rpy:1440
translate spanish room_593f021e:

    # gg "- И послезавтра."
    gg "- Ni pasado mañana."

# game/script.rpy:1443
translate spanish room_1530f895:

    # gg "- И вообще никогда."
    gg "- Ni nunca más."

translate spanish strings:
    # game/script.rpy:1444
    old "(Прощаемся, выходит?)"
    new "(Entonces... ¿esto es un adiós?)"
    
# game/script.rpy:1448
translate spanish room_d2c4cf06:

    # gg "- ..."
    gg "- ..."

# game/script.rpy:1451
translate spanish room_0080ca73:

    # gg "- Нет..."
    gg "- No..."

# game/script.rpy:1452
translate spanish room_bfc80253:

    # gg "- У меня будет еще одна просьба... совсем крохотная."
    gg "- Quiero pedirte otro pequeño favor... uno muy, muy pequeño."

translate spanish strings:
    # game/script.rpy:1453
    old "(Какая же?)"
    new "(¿Qué favor?)"
    
# game/script.rpy:1457
translate spanish room_34c59097:

    # gg "- Я сегодня слишком много наговорила. Многое хотелось бы навсегда забыть."
    gg "- Hoy he hablado demasiado, sin pensar y he dicho cosas que me gustaría olvidar para siempre."

# game/script.rpy:1460
translate spanish room_e3d97ead:

    # gg "- Я не виню тебя, просто... Было ли это так необходимо?"
    gg "- No te culpo, pero... ¿realmente era necesario?"

translate spanish strings:
    # game/script.rpy:1461
    old "(Вот завтра и узнаешь.)"
    new "(Ya lo verás mañana.)"

# game/script.rpy:1465
translate spanish room_e685f7a8:

    # gg "- Нет, я так не усну."
    gg "- No, si no no podré dormir."

translate spanish strings:
    # game/script.rpy:1466
    old "(Хорошо, так что за просьба?)"
    new "(Vale, ¿qué favor?)"
    
# game/script.rpy:1470
translate spanish room_61f95837:

    # gg "- Я... м-м..."
    gg "- Yo, um..."

# game/script.rpy:1473
translate spanish room_68dca3ff:

    # "Я нервно чешу запястья и прикусываю губу."
    "Me rasco las muñecas y me muerdo el labio inferior, por los nervios."

translate spanish strings:
    # game/script.rpy:1474
    old "(Постой, ты что... боишься мне сказать?)"
    new "(Un momento... ¿te da miedo pedírmelo?)"

# game/script.rpy:1478
translate spanish room_76c5c726:

    # gg "- Да!"
    gg "- ¡Sí!"

# game/script.rpy:1481
translate spanish room_c2c02deb:

    # gg "- А еще я боюсь, что произойдет что-то очень плохое, если я скажу!"
    gg "- ¡También me asusta que pase algo muy malo si te lo digo!"

# game/script.rpy:1484
translate spanish room_f14d41aa:

    # gg "- А еще я боюсь, что из-за того, что произойдет что-то плохое, произойдет что-то гораздо, гораздо хуже!"
    gg "- ¡También tengo miedo de que si pasa algo malo, después pase algo mucho peor!"

translate spanish strings:
    # game/script.rpy:1485
    old "(Да понял я!)"
    new "(Vale, ¡ya lo pillo!)"

    # game/script.rpy:1487
    old "(И все же не отстану, пока не скажешь.)"
    new "(No te dejaré en paz hasta que me lo digas.)"
    
# game/script.rpy:1493
translate spanish room_78810b60:

    # gg "- Зануда..."
    gg "- Malo..."

translate spanish strings:
    # game/script.rpy:1494
    old "(Нет, ты!)"
    new "(¡Tú!)"
    
# game/script.rpy:1517
translate spanish room_de40471b:

    # "Я неуклюже забираюсь в спальный мешок. Внизу комнаты очень прохладно; и пусть электрический обогреватель работает изо всех сил, я, тем не менее, спешу скорей укутаться."
    "Me meto en mi saco de dormir. La parte baja de la habitación está muy fría, aunque el radiador eléctrico se esfuerza por calentarme. Me tapo rápidamente con la manta."

# game/script.rpy:1520
translate spanish room_47a7d25c:

    # gg "- Мне грустно из-за того, что сны больше не приходят."
    gg "- Estoy triste porque ya no puedo soñar."

# game/script.rpy:1521
translate spanish room_541ac548:

    # gg "- Ни за что не поверишь, как я поначалу справлялась с этим."
    gg "- No me creerás si te cuento cómo lidié con ello, al principio."

translate spanish strings:
    # game/script.rpy:1522
    old "(Конечно, поверю.)"
    new "(Claro que te creeré.)"
    
# game/script.rpy:1524
translate spanish room_16ce1f16:

    # gg "- Я знаю. Это была шутка."
    gg "- Ya lo sé, era una broma."

# game/script.rpy:1525
translate spanish room_5691257a:

    # gg "- Так вот - я умывалась, чистила зубы, ложилась и начинала воображать, будто я вижу сон. При этом я, конечно же, совсем не спала и поутру вечно клевала носом."
    gg "- Bueno... me lavaba la cara, me cepillaba los dientes y me acostaba; e imaginaba que estaba soñando. Obviamente, no dormía nada y por la mañana siempre tenía ojeras."

# game/script.rpy:1526
translate spanish room_59d116a9:

    # gg "- После недели бессонных ночей я стала себя странно чувствовать и начала видеть всякое..."
    gg "- Tras una semana sin dormir, comencé a sentirme rara y a ver cosas..."

# game/script.rpy:1527
translate spanish room_0b2b5f9d:

    # gg "- Парящие в воздухе буквы, странные силуэты, появляющиеся в самых неожиданных местах. Выпученные глаза с дрожащими бледными зрачками... Страшно, знаешь ли!"
    gg "- Letras flotando en el aire, extrañas siluetas aparecían en los lugares más inesperados. Ojos saltones con pálidas y temblorosas pupilas... ¡Daba miedo, sabes!"

# game/script.rpy:1528
translate spanish room_d0f92d40:

    # gg "- Однажды я чуть не умерла. Просто упала посреди комнаты и какое-то время не могла пошевелиться. А силуэты, буквы и глаза нависли надо мной и осуждающе шипели."
    gg "- Entonces, un día, casi muero. Colapsé en medio de la habitación y estuve un rato sin poder moverme. Y vi las siluetas, las letras y los ojos flotando sobre mí, siseando."

# game/script.rpy:1529
translate spanish room_e275b366:

    # gg "- Это было ужасно."
    gg "- Fue horrible."

# game/script.rpy:1530
translate spanish room_87ac3140:

    # gg "- И... заслуженно, что ли?"
    gg "- Y... me lo merecía, supongo."

# game/script.rpy:1531
translate spanish room_8c2610d5:

    # gg "- Я будто была поймана на самой большой в мире лжи. Да, должно быть, так и было."
    gg "- Fue como si me hubieran pillado diciendo la mayor mentira del mundo. Sí, así me sentí."

# game/script.rpy:1532
translate spanish room_71231f48:

    # gg "- После этого я прекратила."
    gg "- Tras eso, dejé de hacerlo."

# game/script.rpy:1533
translate spanish room_a98bf790:

    # gg "- А силуэты, буквы и глаза остались жить тут - понравилось, видимо!"
    gg "- Pero las siluetas, las letras y los ojos se quedaron. ¡Supongo que les gusta este sitio!"

# game/script.rpy:1534
translate spanish room_0fb6bf67:

    # gg "- Вечно ходят за мной по пятам, подглядывают... А я их побаиваюсь и не могу даже слова поперек сказать."
    gg "- Siempre me siguen, me espían... Les tengo miedo, pero ni siquiera puedo enfrentarme a ellos."

# game/script.rpy:1535
translate spanish room_771ceae3:

    # gg "- Но сегодня..."
    gg "- Pero hoy..."

# game/script.rpy:1536
translate spanish room_b780befe:

    # gg "- Сегодня..."
    gg "- Hoy..."

translate spanish strings:
    # game/script.rpy:1537
    old "(Ну?)"
    new "(¿Sí?)"
    
# game/script.rpy:1539
translate spanish room_d4a15ee5:

    # gg "- Я..."
    gg "- Yo..."

translate spanish strings:
    # game/script.rpy:1540
    old "(Ты все еще боишься мне сказать?)"
    new "(¿Aún te da miedo decírmelo?)"
    
# game/script.rpy:1542
translate spanish room_ea92e2c1:

    # gg "- Конечно, они же слушают!"
    gg "- ¡Claro! Nos están escuchando, ¿sabes?"

translate spanish strings:
    # game/script.rpy:1543
    old "(Объясни на пальцах.)"
    new "(Haz señas con las manos.)"
    
# game/script.rpy:1545
translate spanish room_524f741b:

    # gg "- Ладно!"
    gg "- ¡Vale!"

# game/script.rpy:1548
translate spanish room_e3a26920:

    # "Я принимаюсь беспорядочно, но оттого не менее воодушевленно вертеть пальцами, выстраивая сложные фигуры."
    "Comienzo a mover los dedos caóticamente, con entusiasmo, creando complejas formas."

translate spanish strings:
    # game/script.rpy:1549
    old "(Ты хочешь, чтобы я... рассказал тебе историю перед сном?)"
    new "(Quieres que te... ¿cuente un cuento antes de dormir?)"
    
# game/script.rpy:1551
translate spanish room_aaa6ed3d:

    # gg "- Тш-ш-ш-ш!"
    gg "- ¡Shhhhhhh!"

# game/script.rpy:1554
translate spanish room_f1f76ee9:

    # gg "- Я что, зря тут стараюсь? Тебя ведь услышат!"
