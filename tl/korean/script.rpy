    new "(소용도 없을 것 같고.)"
    
# game/script.rpy:1566
translate korean room_0bef18b7:

    # gg "- И вовсе нет!"
    gg "- 아니야!"

# game/script.rpy:1569
translate korean room_f6a122b0:

    # gg "- Да что ты вообще понимаешь?"
    gg "- 지금 네가 무슨 말을 하고 있는지는 알고 있어?"

translate korean strings:   
    # game/script.rpy:1570
    old "(Достаточно, чтобы понять, что мы лишь впустую потратим время.)"
    new "(결국 시간낭비를 하게 될 것쯤은 알고 있는 것 같은데.)"

    # game/script.rpy:1572
    old "(Давай сосредоточимся на чем-нибудь действительно важном.)"
    new "(정말 중요한 거에 집중하면 안 될까.)"

