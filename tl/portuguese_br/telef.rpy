# game/telef.rpy:36
translate portuguese_br telef_0fb4b444:

    # piz "- Добрый день, спасибо, что выбрали нашу пиццерию!"
    piz "Olá, agradecemos por escolher a nossa pizzaria!"

# game/telef.rpy:38
translate portuguese_br telef_ad65ab06:

    # tel "- Знаете, здесь так пусто... Впрочем, мне от этого ни хорошо, ни плохо."
    tel "- Sabe, este lugar é tão vazio... Mas isso não me faz sentir melhor e nem pior."

# game/telef.rpy:41
translate portuguese_br telef_9641db4c:

    # tel "- Я совсем одна, и в то же время вроде бы нет - в голове много мыслей, с которыми уж точно не соскучишься."
    tel "- Estou completamente sozinha, embora ao mesmo tempo eu sinta que não estou. Há vários pensamentos em minha cabeça e eles me mantém entretida."

# game/telef.rpy:44
translate portuguese_br telef_3fa36954:

    # tel "- С ними можно создать целый мир. Уверена, если очень постараться, он заполнит всю пустоту вокруг!"
    tel "- Eu posso criar um mundo inteiro com eles. Tenho certeza que consigo até preencher o vazio ao meu redor se eu me esforçar!"

# game/telef.rpy:47
translate portuguese_br telef_08a33cd2:

    # tel "- Хотя..."
    tel "- Entretanto..."

# game/telef.rpy:50
translate portuguese_br telef_8e730ebd:

    # tel "- Сколько бы я ни думала, окружение не менялось. Да, что-то происходило в моей голове, но по-прежнему оставалось в ее пределах."
    tel "- Não importa o quanto eu pense, os meus arredores não mudam. Sim, coisas acontecem dentro da minha cabeça, mas os meus pensamentos nunca escapam dela."

# game/telef.rpy:53
translate portuguese_br telef_1e072587:

    # tel "- Не то чтобы я как-то сдерживала это... Может, оно само боялось выходить?"
    tel "- E não é como se eu tentasse impedi-los... Talvez estejam com medo de sair?"

# game/telef.rpy:60
translate portuguese_br telef_cbfe431f:

    # piz "- Какую пиццу вы хотели бы заказать?"
    piz "- Qual sabor você vai querer?"

# game/telef.rpy:62
translate portuguese_br telef_93e9366a:

    # tel "- Так вот! В любом случае, в моей голове не так много места, где можно было бы развернуться."
    tel "- De qualquer maneira, há tanto espaço na minha mente que poderia ser mais bem utilizado."

# game/telef.rpy:65
translate portuguese_br telef_6b32b2a4:

    # tel "- Так что каждая мысль наворачивала бессмысленный и беспощадный круг, безнадежно возвращаясь в начало."
    tel "- Assim, todos os pensamentos dariam voltas inúteis e impiedosas em minha cabeça, destinados a voltar para onde começaram."

# game/telef.rpy:68
translate portuguese_br telef_50d3a2e6:

    # tel "- А ведь когда-то должен быть конец. Нельзя блуждать так вечно. Как вы считаете?"
    tel "- Mas tem que haver um fim em algum ponto. Você não pode simplesmente vaguear para sempre. O que acha?"

# game/telef.rpy:71
translate portuguese_br telef_dc7ad40c:

    # tel "- Конечно, звучит это очень страшно, но не страшнее постоянного существования в пустоте."
    tel "- Eu sei que parece assustador, mas não é mais assustador do que constantemente viver em meio ao vazio."

# game/telef.rpy:74
translate portuguese_br telef_6ff2f2e7:

    # tel "- Здесь определенно безопасно, и не случится ничего плохого. Как и хорошего, впрочем."
    tel "- Aqui é seguro e nada de ruim acontecerá. Contudo, nada de bom acontecerá também."

# game/telef.rpy:82
translate portuguese_br telef_81b16851:

    # piz "- Обратите внимание, что у нас проходит акция - три пиццы по цене двух!"
    piz "- E não se esqueça que temos uma oferta especial hoje: três pizzas pelo preço de duas!"

# game/telef.rpy:84
translate portuguese_br telef_a7ed4e99:

    # tel "- Да... Наверное, ничего хорошего в одних и тех же мыслях нет. Да и какой в них смысл вообще?"
    tel "- É... Provavelmente não há nada de bom em ter sempre os mesmos pensamentos repetidas vezes. Qual sentido isso faz?"

# game/telef.rpy:87
translate portuguese_br telef_2257250d:

    # tel "- Я могла бы сбежать отсюда, но, кажется, мои же мысли мне совсем не помогают."
    tel "- Eu poderia ter escapado daqui, mas eu sinto como se os meus pensamentos não estivessem me ajudando."

# game/telef.rpy:90
translate portuguese_br telef_656cea78:

    # tel "- Им должно быть стыдно... Наверное."
    tel "- Eles deveriam se envergonhar... Ou não."

# game/telef.rpy:93
translate portuguese_br telef_6796371b:

    # tel "- Никто не виноват, что здесь даже двери не видно. С ней было бы гораздо проще!"
    tel "- Não é culpa de ninguém que eu não consiga nem mesmo ver uma porta aqui. Isso seria muito mais fácil com uma!"

# game/telef.rpy:96
translate portuguese_br telef_2379eeca:

    # tel "- Я пыталась её найти - и это пустая трата времени."
    tel "- Eu tentei procurar, mas foi uma perda de tempo."

# game/telef.rpy:99
translate portuguese_br telef_d2a7bb09:

    # tel "- Сколько ни ходи, ничего не находится (ой, игра слов!), и это лишает меня всякой надежды на спасение."
    tel "- Não importa onde vejo, não vejo algo que importa (um jogo de palavras!), e isso faz com que eu perca a esperança de encontrar uma salvação."

# game/telef.rpy:106
translate portuguese_br telef_dfb41c51:

    # piz "- Также у нас есть система скидок для новых клиентов. Подробней можно узнать в личном кабинете!"
    piz "- Nós também temos um programa de desconto para clientes novos. Você pode ler mais sobre isso através da página da sua conta!"

# game/telef.rpy:108
translate portuguese_br telef_ca637c50:

    # tel "- Вам не кажется, что моё пребывание здесь - это пустая трата времени? Какой в этом смысл?"
    tel "- Não acha que eu estar aqui também é uma perda de tempo? Qual o sentindo nisso?"

# game/telef.rpy:111
translate portuguese_br telef_57a0318a:

    # tel "- Я могу просто думать. И то, мои мысли такие же бессмысленные и пустые, как всё вокруг."
    tel "- Eu poderia continuar pensando para sempre. Entretanto, os meus pensamentos são tão insignificantes e vãos quanto às outras coisas."

# game/telef.rpy:114
translate portuguese_br telef_a0f1d467:

    # tel "- Значит ли это, что я не заполняю пустоту, а просто являюсь её частью?"
    tel "- Será que isso quer dizer que eu não preencho o vazio, mas sim sou uma parte dele?"

# game/telef.rpy:117
translate portuguese_br telef_4afd3358:

    # tel "- Зачем мне тогда чувствовать себя? Знать, что я существую?"
    tel "- Então por que eu sentiria algo? Por que eu saberia que existo?"

# game/telef.rpy:120
translate portuguese_br telef_8d654971:

    # tel "- Впрочем, я даже не уверена насчёт этого."
    tel "- Embora eu não tenha nem mesmo certeza disso."

# game/telef.rpy:123
translate portuguese_br telef_e0d77aa7:

    # tel "- В этом месте всегда ни холодно, ни горячо. Вообще никак."
    tel "- Este lugar nunca é quente nem frio. É neutro."

# game/telef.rpy:126
translate portuguese_br telef_12086626:

    # tel "- И в то же время, если подумать о тепле, я согреваюсь."
    tel "- Mas ao mesmo tempo, se eu penso em calor, eu me sinto aquecida."

# game/telef.rpy:129
translate portuguese_br telef_94d3c3d2:

    # tel "- Может, этот мир полностью зависит от моих мыслей?"
    tel "- Talvez este mundo esteja ligado aos meus pensamentos?"

# game/telef.rpy:132
translate portuguese_br telef_f6724c1b:

    # tel "- Не хотелось бы признавать, что я полностью пуста."
    tel "- Se for esse o caso, eu não gostaria de ter que admitir que sou completamente vazia."

# game/telef.rpy:135
translate portuguese_br telef_3050aa69:

    # tel "- Ведь все исчезло не по моей вине? Да?"
    tel "- Eu não sou o motivo de tudo ter desaparecido, sou?"

# game/telef.rpy:138
translate portuguese_br telef_79831019:

    # tel "- Разве я не могу просто приспособиться и привыкнуть к ничему вокруг, раз ничего не могу с этим сделать?"
    tel "- Será que eu não posso me adaptar e me acostumar a ter nada ao meu redor já que não posso fazer nada em relação a isso?"

# game/telef.rpy:145
translate portuguese_br telef_f2990826:

    # piz "- Вы уже готовы сделать заказ?"
    piz "- Já decidiu o que vai querer?"

# game/telef.rpy:147
translate portuguese_br telef_eb595c33:

    # tel "- Да. Правильно."
    tel "- É. É isso mesmo."

# game/telef.rpy:150
translate portuguese_br telef_6974591b:

    # tel "- Мне должно быть все равно."
    tel "- Eu não deveria me importar."

# game/telef.rpy:153
translate portuguese_br telef_00ae3d4b:

    # tel "- Здесь пусто, и мне от этого ни хорошо, ни плохо."
    tel "- Aqui é vazio, e isso não me faz sentir melhor e nem pior."

# game/telef.rpy:156
translate portuguese_br telef_99292db0:

    # tel "- Я тут одна, и в то же время нет - в голове много мыслей, с которыми уж точно не соскучишься."
    tel "- Estou completamente sozinha, embora ao mesmo tempo eu sinta que não estou. Há vários pensamentos em minha cabeça, e eles me mantém entretida."

# game/telef.rpy:159
translate portuguese_br telef_a154ab2e:

    # tel "- С ними можно создать целый мир. Здесь определённо безопасно, и не случится ничего плохого. Как и хорошего, впрочем."
    tel "- Eu posso criar um mundo inteiro com eles. Aqui é seguro e nada de ruim acontecerá. Contudo, nada de bom acontecerá também."

# game/telef.rpy:162
translate portuguese_br telef_b6b644a9:

    # tel "- Мое пребывание здесь - это пустая трата времени. Я не заполняю пустоту, я - лишь её часть. И это лишает меня всякой надежды на спасение."
    tel "- Eu estar aqui é uma perda de tempo. Eu não preencho o vazio - sou uma parte dele. Isso faz com eu que perca a esperança de encontrar uma salvação."

# game/telef.rpy:165
translate portuguese_br telef_6974591b_1:

    # tel "- Мне должно быть все равно."
    tel "- Eu não deveria me importar."

# game/telef.rpy:168
translate portuguese_br telef_00ae3d4b_1:

    # tel "- Здесь пусто, и мне от этого ни хорошо, ни плохо."
    tel "- Aqui é vazio, e isso não me faz sentir melhor e nem pior."

# game/telef.rpy:171
translate portuguese_br telef_e2c78ebc:

    # tel "- Никто не виноват, что здесь даже двери не видно. Какой в них смысл вообще?"
    tel "- Não é culpa de ninguém que eu não consiga nem mesmo ver uma porta aqui. E por que haveria uma?"

# game/telef.rpy:174
translate portuguese_br telef_c73a444b:

    # tel "- Кажется, мне совсем не помогают. Им должно быть стыдно."
    tel "- Eu sinto como se ninguém estivesse me ajudando. Eles deveriam se envergonhar."

# game/telef.rpy:177
translate portuguese_br telef_b6ca2f7e:

    # tel "- Не хотелось бы признавать, но я тут одна."
    tel "- Eu não gostaria de ter que admitir isso, mas estou completamente sozinha aqui."

# game/telef.rpy:180
translate portuguese_br telef_ab7b08f9:

    # tel "- Ничего не могу с этим сделать."
    tel "- Não há nada que eu possa fazer sobre isso."

# game/telef.rpy:187
translate portuguese_br telef_3e6504e0:

    # piz "- Обратите внимание, что у нас проходит акция - четыре пиццы по цене двух!"
    piz "- E não se esqueça que temos uma oferta especial hoje: quatro pizzas pelo preço de duas!"

# game/telef.rpy:189
translate portuguese_br telef_b01fcae5:

    # tel "- Мне всё равно, что здесь пусто, слышите?! Да мне от этого ни хорошо, ни плохо!"
    tel "- Eu não ligo que este lugar seja vazio, ouviu?! Eu não me sinto melhor e nem pior com isso!"

# game/telef.rpy:192
translate portuguese_br telef_d12ea076:

    # tel "- Я одна."
    tel "- Estou completamente sozinha."

# game/telef.rpy:195
translate portuguese_br telef_3b62ce74:

    # tel "- В моей голове много мыслей, ими я ослепляю мир вокруг."
    tel "- A minha cabeça está cheia de pensamentos, e eles eclipsam o mundo ao meu redor."

# game/telef.rpy:198
translate portuguese_br telef_00952fc2:

    # tel "- Здесь не так много места, но по крайней мере безопасно."
    tel "- Este espaço é bem apertado, mas pelo menos é seguro."

# game/telef.rpy:201
translate portuguese_br telef_a3134265:

    # tel "- Хотя и мне тут никогда не будет хорошо."
    tel "- Apesar de que eu nunca me sentirei bem aqui."

# game/telef.rpy:204
translate portuguese_br telef_c080a9e5:

    # tel "- Значит, моё пребывание здесь - пустая трата времени?"
    tel "- Será que isso quer dizer que existir é uma perda de tempo?"

# game/telef.rpy:207
translate portuguese_br telef_bb5e0514:

    # tel "- Я должна решить, и мои мысли помогут мне."
    tel "- Eu preciso me decidir, e os meus pensamentos me ajudarão."

# game/telef.rpy:210
translate portuguese_br telef_579630b4:

    # tel "- Они направят к выходу... и тогда я смогу собой гордиться."
    tel "- Eles me guiarão para a saída... E eu poderei me sentir orgulhosa de mim mesma."

# game/telef.rpy:213
translate portuguese_br telef_78d815b7:

    # tel "- И тогда я смогу спастись."
    tel "- Eu conseguirei me salvar."

# game/telef.rpy:216
translate portuguese_br telef_08a33cd2_1:

    # tel "- Хотя..."
    tel "- Mas ao mesmo tempo..."

# game/telef.rpy:219
translate portuguese_br telef_b84fe9f0:

    # tel "- Уже как-то всё равно."
    tel "- Eu não me importo mais com isso."

# game/telef.rpy:222
translate portuguese_br telef_00ae3d4b_2:

    # tel "- Здесь пусто, и мне от этого ни хорошо, ни плохо."
    tel "- Este lugar é vazio, mas isso não me faz sentir melhor e nem pior."

# game/telef.rpy:225
translate portuguese_br telef_e9a5efe4:

    # tel "- Я одна, а в моей голове много мыслей. Можно сказать, целый мир."
    tel "- Estou completamente sozinha, mas a minha cabeça está cheia de pensamentos. Um mundo inteiro, pode-se dizer."

# game/telef.rpy:228
translate portuguese_br telef_baaec456:

    # tel "- Если очень постараться, он сможет заполнить всю пустоту вокруг!"
    tel "- Se eu me esforçar, eles poderão preencher todo o vazio ao meu redor!"

# game/telef.rpy:231
translate portuguese_br telef_08a33cd2_2:

    # tel "- Хотя..."
    tel "- Mas..."

# game/telef.rpy:234
translate portuguese_br telef_6bca4e1c:

    # tel "- Сколько бы я ни думала, окружение не менялось. Да, что-то происходило вне моей головы, но..."
    tel "- Não importa o quanto eu continue a pensar, os meus arredores não mudam. Sim, algo aconteceu fora da minha cabeça, mas..."

# game/telef.rpy:237
translate portuguese_br telef_38f2807a:

    # tel "- Что?"
    tel "- O que eu disse?"

# game/telef.rpy:240
translate portuguese_br telef_8e61e085:

    # tel "- Моим мыслям не хватает места."
    tel "- Não há muito espaço para os meus pensamentos."

# game/telef.rpy:243
translate portuguese_br telef_52047db9:

    # tel "- Оно уже чем-то заполнено..."
    tel "- A minha cabeça já está cheia de outra coisa..."

# game/telef.rpy:246
translate portuguese_br telef_b7f5fcf1:

    # tel "- Если вокруг ничего нет, здесь есть я."
    tel "- Mesmo que não haja nada ao meu redor, eu ainda estou aqui."

# game/telef.rpy:249
translate portuguese_br telef_bd4928d8:

    # tel "- А в моей голове много мыслей."
    tel "- E a minha cabeça está cheia de pensamentos."

# game/telef.rpy:252
translate portuguese_br telef_5f0c56b8:

    # tel "- Если очень постараться..."
    tel "- Se eu me esforçar..."

# game/telef.rpy:255
translate portuguese_br telef_5804bb80:

    # tel "- ..."
    tel "- ..."

# game/telef.rpy:258
translate portuguese_br telef_92e6ca5d:

    # tel "- Значит, мир на самом деле не пустой."
    tel "- Então o mundo não está mesmo vazio."

# game/telef.rpy:261
translate portuguese_br telef_1aa5a66b:

    # tel "- Я ничего не вижу."
    tel "- Eu não consigo ver nada."

# game/telef.rpy:272
translate portuguese_br telef_d1226ccf:

    # piz "- Время истекло, перезагрузите страницу."
    piz "- Sessão encerrada. Por favor, recarregue a página."

