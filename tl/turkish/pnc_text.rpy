# game/pnc_text.rpy:11
translate turkish backpack_38718438:

    # "Я опускаю глаза. Нелепый и потрепанный, мой школьный рюкзак словно кричит о своей бесполезности."
    "Kafamı aşağı eğdiğimde gözüme ilişen eski püskü okul çantam, resmen 'Hiçbir işe yaramıyorum!' diye bağırıyor."

# game/pnc_text.rpy:12
translate turkish backpack_2678b6c1:

    # "С другого угла он похож на набитое брюхо - его содержимое точно так же переваривается, разлагается и превращается в густую кашу."
    "Biraz yandan bakınca davul gibi bir göbeğe benziyor. İçindeki eşyalar da sanki öğütülerek yapışkan, vıcık vıcık bir maddeye dönüşüyor ve sindiriliyor."

# game/pnc_text.rpy:14
translate turkish backpack_61aaf7e3:

    # gg "- Классно я придумала, надо бы запомнить..."
    gg "- İlginç bir benzetme oldu, bunu unutmayayım."

translate turkish strings:
    # game/pnc_text.rpy:15
    old "(Совсем не классно.)"
    new "(Hiç de ilginç değil.)"

    # game/pnc_text.rpy:15
    old "(Совсем не классно. Мерзко и ужасно.)"
    new "(Hiç de ilginç değil. Saçma ve çirkin.)"

# game/pnc_text.rpy:21
translate turkish backpack_e615eecb:

    # gg "- А вот и нет - мой тебе ответ!"
    gg "- Ne düşündüğün umurumda değil!"

translate turkish strings:
    # game/pnc_text.rpy:22
    old "(Ты что, смеешься надо мной?)"
    new "(Bana mı gülüyorsun?)"

# game/pnc_text.rpy:27
translate turkish backpack_06036bad:

    # gg "- Обижаешь... ведь ты мне как родной! Хи-хи!"
    gg "- Yok canım... Biraz alınganlık ediyorsun bence. Ehehe!"

translate turkish strings:
    # game/pnc_text.rpy:28
    old "(Я не собираюсь продолжать этот цирк, поняла?)"
    new "(Bu şaklabanlığa bir son verelim, olur mu?)"

# game/pnc_text.rpy:32
translate turkish backpack_b5138861:

    # gg "- Поняла!"
    gg "- Olur!"

# game/pnc_text.rpy:37
translate turkish backpack_557726c8:

    # gg "- Эй, в этот раз я не специально!.."
    gg "- Hey, öyle demek istememiştim!"

translate turkish strings:
    # game/pnc_text.rpy:39
    old "(Лучше расскажи мне, что внутри твоего рюкзака.)"
    new "(Söyle bakalım, çantanda ne var?)"

# game/pnc_text.rpy:44
translate turkish backpack_9fc41a8b:

    # gg "- Да ничего особенного... книжки всякие, в основном."
    gg "- Hiç... okul kitapları falan işte."

# game/pnc_text.rpy:47
translate turkish backpack_d0f08302:

    # gg "- Все карандаши и тетради я оттуда вытащила, а остальное меня не интересует."
    gg "- Tüm kalemlerimi, defterlerimi çıkardım; geri kalan eşyalar ise olduğu gibi duruyor."

translate turkish strings:
    # game/pnc_text.rpy:50
    old "(Ты ведь когда-то ходила в школу, да?)"
    new "(Önceden okula gidiyordun, değil mi?)"

# game/pnc_text.rpy:54
translate turkish backpack_eceef613:

    # gg "- Ага, ходила. Отлично провела время, кстати!"
    gg "- Evet. Sahiden güzel günlerdi!"

translate turkish strings:
    # game/pnc_text.rpy:55
    old "(...ты точно поняла мой вопрос?)"
    new "(...sorumu anladığından emin misin?)"

# game/pnc_text.rpy:59
translate turkish backpack_e624daf9:

    # gg "- Думаешь, все в моей жизни должно быть печально и угрюмо? А вот и нет!"
    gg "- Hayatımın hüzün ve acıdan ibaret olduğunu sanıyorsan yanılıyorsun!"

translate turkish strings:
    # game/pnc_text.rpy:60
    old "(Ну ладно, ладно. Что тебе больше всего понравилось?)"
    new "(Pekala. Okulun en sevdiğin yanı neydi?)"

# game/pnc_text.rpy:64
translate turkish backpack_c92e01ee:

    # gg "- Хм-м-м..."
    gg "- Hımmm..."

# game/pnc_text.rpy:67
translate turkish backpack_79c4eff2:

    # gg "- Ну... В помещениях было очень светло, совсем не так, как дома."
    gg "- Sınıflar, evimin aksine epey aydınlıktı mesela."

translate turkish strings:
    # game/pnc_text.rpy:68
    old "(И все?)"
    new "(O kadarcık mı?)"

# game/pnc_text.rpy:72
translate turkish backpack_3d194e3c:

    # gg "- Да погоди ты! Дай вспомнить..."
    gg "- Acele ettirmesene! Hatırlamaya çalışıyorum."

# game/pnc_text.rpy:75
translate turkish backpack_c7d3b724:

    # gg "- Ну, кровати были мягкие... Да и кормили неплохо."
    gg "- Yemekleri lezzetliydi, yataklar da yumuşacıktı."

# game/pnc_text.rpy:78
translate turkish backpack_40cd7f87:

    # gg "- Между прочим, я всегда была на уроках! Остальные вечно прогуливали."
    gg "- Tüm derslere eksiksiz katılırdım, diğerleri gibi dersten kaçma huyum yoktu hiç!"

# game/pnc_text.rpy:81
translate turkish backpack_a6aff8dc:

    # gg "- Ох и досталось же им, наверно!"
    gg "- Öğretmenlerimin kaçanları bir güzel azarladığından eminim!"

# game/pnc_text.rpy:84
translate turkish backpack_bc809e1d:

    # "Я слегка улыбаюсь, предаваясь теплым воспоминаниям."
    "İç ısıtan anıları hatırlayıp tebessüm ediyorum."

translate turkish strings:
    # game/pnc_text.rpy:85
    old "(Ты ведь так и не закончила школу.)"
    new "(Ancak mezun değilsin sanırım.)"

# game/pnc_text.rpy:89
translate turkish backpack_b98b4ac4:

    # gg "- Ага."
    gg "- Maalesef."

translate turkish strings:
    # game/pnc_text.rpy:90
    old "(Помнишь свой последний день?)"
    new "(Okuldaki son gününü hatırlıyor musun?)"

# game/pnc_text.rpy:94
translate turkish backpack_d2c4cf06:

    # gg "- ..."
    gg "- ..."

# game/pnc_text.rpy:95
translate turkish backpack_a707915e:

    # gg "- День как день."
    gg "- Sıradan bir gündü."

# game/pnc_text.rpy:98
translate turkish backpack_94074f87:

    # gg "- Папа забрал меня пораньше - объяснил, что я уже выросла из школьной программы. Да я и сама это понимала, уж больно простыми были задания..."
    gg "- Babam beni normalden daha erken bir saatte gelip aldı ve bu sınıf için yaşımın çoktan geçtiğini söyledi. Bunu bir süre önce ben de fark etmiştim aslında, ödevler ve sorular aşırı derecede kolay geliyordu."

# game/pnc_text.rpy:99
translate turkish backpack_1e7bb71c:

    # gg "- Потом мы сели в машину и поехали домой. Дома нас встретила мама, мы втроем поужинали и разошлись по комнатам."
    gg "- Sonra arabaya binip eve döndük. Annem bizi karşıladı, akşam yemeğimizi yiyip odalarımıza dağıldık."

translate turkish strings:
    # game/pnc_text.rpy:100
    old "(А что было потом?)"
    new "(Peki ya sonra?)"

# game/pnc_text.rpy:104
translate turkish backpack_f52d7a56:

    # gg "- Не помню. Да и какая, в сущности, разница?"
    gg "- Sonrasını hatırlamıyorum. Hem hatırlasam ne fark eder?"

translate turkish strings:
    # game/pnc_text.rpy:100
    old "(Не похоже, что этот день хоть что-то значит для тебя.)"
    new "(Okuldaki son gününün senin için hiçbir önemi yok demek.)"

# game/pnc_text.rpy:109
translate turkish backpack_3ac67b90:

    # gg "- Говорю же, день как день."
    gg "- Dediğim gibi, sıradan bir gündü."

translate turkish strings:
    # game/pnc_text.rpy:110
    old "(Ладно.)"
    new "(Peki...)"

# game/pnc_text.rpy:115
translate turkish backpack_808e1266:

    # gg "- Вот и славно."
    gg "- Aynen."

translate turkish strings:
    # game/pnc_text.rpy:110
    old "(Расскажи еще раз.)"
    new "(Bir daha anlatsana.)"

# game/pnc_text.rpy:120
translate turkish backpack_54f27d0a:

    # gg "- У тебя что, с памятью плохо?"
    gg "- Balık hafızalı mısın?"

translate turkish strings:
    # game/pnc_text.rpy:121
    old "(Ну пожалуйста!)"
    new "(Lütfen!)"


# game/pnc_text.rpy:125
translate turkish backpack_37182073:

    # gg "- Ладно уж..."
    gg "- Eh, peki..."

# game/pnc_text.rpy:128
translate turkish backpack_7fc0b6b4:

    # gg "- В тот день папа забрал меня с учебы пораньше, объяснив это тем, что мне пора взрослеть."
    gg "- O gün babam erkenden gelip beni okuldan aldı ve bana artık büyümem gerektiğini söyledi."

# game/pnc_text.rpy:129
translate turkish backpack_326cf169:

    # gg "- Не то, чтобы я до конца понимала, что он имел в виду..."
    gg "- Ne demek istediğini tam anlayamamıştım ama..."

# game/pnc_text.rpy:130
translate turkish backpack_dad097f6:

    # gg "- Так или иначе, я не сопротивлялась. Мы сели в машину и поехали домой."
    gg "- Yine de hiç itiraz etmedim. Arabaya binip eve döndük."

# game/pnc_text.rpy:131
translate turkish backpack_5c8684eb:

    # gg "- Дома нас встретила мама, мы втроем поужинали и разошлись по комнатам."
    gg "- Kapıda bizi annem karşıladı, birlikte akşam yemeği yedik ve ardından odalarımıza geçtik."

# game/pnc_text.rpy:134
translate turkish backpack_2e83915f:

    # gg "- Доволен?"
    gg "- Şimdi gönlün oldu mu?" #THIS SENTENCE SHOULD BE TRANSLATED SO IT COULD BE ANSWERED WITH SIMPLY "YES" OR "NO"

# game/pnc_text.rpy:139
translate turkish backpack_0fa5da10:

    # gg "Вот и славно."
    gg "- Güzel."

# game/pnc_text.rpy:143
translate turkish backpack_d2c4cf06_1:

    # gg "- ..."
    gg "- ..."

# game/pnc_text.rpy:146
translate turkish backpack_f8e5dc31:

    # gg "- Папа забирал меня из школы силком, пока я кусалась и царапалась. Учителя не вмешивались; подобные сцены были для них обыденностью - мало ли в чем провинилась капризная девчонка?"
    gg "- Onu tırmalayıp ısırmama rağmen babam beni sürükleye sürükleye okuldan çıkardı. Öğretmenler hiç müdahale etmedi, neticede alışık oldukları bir durumdu. Kim bilir, küçük cadı yine ne yapmıştı?"

# game/pnc_text.rpy:147
translate turkish backpack_6f074fed:

    # gg "- Затем он затолкал меня в машину и мы молча ехали до самого дома."
    gg "- Sonra beni arabaya tıktı ve suspus bir şekilde eve döndük."

# game/pnc_text.rpy:148
translate turkish backpack_5c8684eb_1:

    # gg "- Дома нас встретила мама, мы втроем поужинали и разошлись по комнатам."
    gg "- Kapıda bizi annem karşıladı, birlikte akşam yemeği yedik ve ardından odalarımıza geçtik."

# game/pnc_text.rpy:151
translate turkish backpack_f4ea4fbc:

    # gg "- Прошу, давай не будем об этом больше..."
    gg "- Lütfen, artık kapatalım bu konuyu..."

translate turkish strings:
    # game/pnc_text.rpy:152
    old "(Нет, ты расскажешь мне еще раз.)"
    new "(Hayır, bir daha anlat.)"

# game/pnc_text.rpy:156
translate turkish backpack_d2c4cf06_2:

    # gg "- ..."
    gg "- ..."

# game/pnc_text.rpy:157
translate turkish backpack_d2c4cf06_3:

    # gg "- ..."
    gg "- ..."

# game/pnc_text.rpy:158
translate turkish backpack_63b32716:

    # gg "- По пути домой папа купил молоко."
    gg "- Babam eve dönerken süt aldı."

# game/pnc_text.rpy:161
translate turkish backpack_ec611f59:

    # gg "- Снова."
    gg "- Yine."

# game/pnc_text.rpy:164
translate turkish backpack_13c5cb72:

    # gg "- Как же я ненавижу молоко..."
    gg "- Sütten nefret ediyorum..."

# game/pnc_text.rpy:165
translate turkish backpack_2c86c5a7:

    # gg "- Мамы дома не было."
    gg "- Annem evde değildi..."

# game/pnc_text.rpy:168
translate turkish backpack_ec611f59_1:

    # gg "- Снова."
    gg "- Yine."

# game/pnc_text.rpy:171
translate turkish backpack_e5f17701:

    # gg "- Как же я ненавижу маму..."
    gg "- Annemden nefret ediyorum..."

# game/pnc_text.rpy:176
translate turkish backpack_eed923f3:

    # "Вдруг я чувствую чей-то взгляд на своей спине. Зная, что такие моменты ни в коем случае нельзя игнорировать, я резко оборачиваюсь."
    "O an arkamdan birinin bana baktığını hissediyorum. Bunun gibi anları asla es geçmeyen biri olarak bakışları hissettiğim yöne dönüyorum."

# game/pnc_text.rpy:177
translate turkish backpack_01440056:

    # "Но там ничего нет."
    "Fakat kimseyi göremiyorum."

translate turkish strings:
    # game/pnc_text.rpy:172
    old "(Что было дальше?)"
    new "(Sonra ne oldu?)"

# game/pnc_text.rpy:182
translate turkish backpack_fdeda4ab:

    # gg "- Все, что было дальше, произошло уже после того, как случилось кое-что, после чего произошло все, что было после этого."
    gg "- Ondan sonra olan her olay, olan bitenlerden sonra tüm bunların olmasına sebep olan olaylardan sonra oldu."

# game/pnc_text.rpy:185
translate turkish backpack_672cab95:

    # "Я вновь смотрю на рюкзак. Свет из окна отражается на мелких металлических деталях. А еще он отбрасывает тень - значит, он реален. К несчастью."
    "Yeniden çantama bakıyorum. Pencereden odama giren ışık, çantamın metal parçalarına yansıyor. Altına düşen gölge ise -ne yazık ki- çantamın gerçek olduğunu kanıtlıyor."

# game/pnc_text.rpy:188
translate turkish backpack_cda0aac6:

    # gg "- Ну и пусть, какое мне вообще дело!"
    gg "- Aman, bana ne artık!"

# game/pnc_text.rpy:191
translate turkish backpack_64a10fb8:

    # "Я едва не пинаю рюкзак в порыве внезапного гнева, но в последний момент беру себя в руки."
    "Ani bir öfkeyle çantamı tekmeleyeyazıyorum ama son anda kendimi tutuyorum."

# game/pnc_text.rpy:192
translate turkish backpack_853cfd12:

    # "Если сдвину его хоть на сантиметр, вся картина развалится и я ослепну. Сколько раз это уже происходило... не сосчитать."
    "Çantam, yerinden bir santim bile kıpırdayacak olursa dünya başıma yıkılır ve kör olurum. Daha önce bunu yaşadım, hem de sayısız kez..."

translate turkish strings:
    # game/pnc_text.rpy:193
    old "(Что значит 'ослепнешь'?)"
    new "(Ne demek 'kör olurum?')"

# game/pnc_text.rpy:197
translate turkish backpack_3052d71a:

    # gg "- Мне понадобились месяцы, чтобы выучить расположение каждого предмета в комнате. Именно поэтому я вижу все так четко и ясно."
    gg "- Odamdaki eşyaların yerini ezberlemek aylarımı aldı. Bu sayede onları bu kadar rahatça görebiliyor ve bulabiliyorum."

# game/pnc_text.rpy:200
translate turkish backpack_24c29394:

    # gg "- Тебе не понять."
    gg "- Anlamazsın."

translate turkish strings:
    # game/pnc_text.rpy:201
    old "(Посмотри под ноги.)"
    new "(Çantana bak.)"

# game/pnc_text.rpy:203
translate turkish backpack_585ebf61:

    # "Я опускаю глаза и вижу, как со стороны рюкзака ко мне ползет маленькое насекомое. Светится едва-едва, и даже взлететь не может... по всей видимости, этот светлячок очень устал."
    "Aşağı baktığımda çantamdan çıkmaya uğraşan ufak bir ateş böceği görüyorum. Işığı epey sönük ve uçamıyor bile, yorgunluktan olsa gerek."

# game/pnc_text.rpy:204
translate turkish backpack_28b7c84e:

    # "Я наклоняюсь, чтобы подобрать его."
    "Onu elime almak için eğiliyorum."

# game/pnc_text.rpy:205
translate turkish backpack_0b155769:

    # "От прикосновения светлячок ярко замерцал и вдруг взлетел!"
    "Kendisine dokunduğum gibi ışıklar saçmaya ve uçmaya başlıyor!"

# game/pnc_text.rpy:208
translate turkish backpack_875b757a:

    # gg "- Молодец, малыш! Так держать!"
    gg "- Aferin minik böcük! Harikasın!"

# game/pnc_text.rpy:211
translate turkish backpack_bf1a1939:

    # "Сделав победный круг по комнате, он на большой скорости понесся в мою сторону. Я зажмурилась в ожидании того, как светлячок залетит мне в ухо."
    "Odada sevinçle birkaç tur attıktan sonra hızla rotasını bana doğru çeviriyor. Ateş böceğinin kulağımdan içeri girmesini beklerken gözlerimi yumuyorum."

# game/pnc_text.rpy:212
translate turkish backpack_094d4a3b:

    # "Так и произошло; оказавшись внутри, он какое-то время продолжал жужжать у меня в черепе, а потом затих."
    "Ve dediğim gibi oluyor. İçeri girdikten sonra bir süre vızıldıyor, ardından susuyor."

# game/pnc_text.rpy:215
translate turkish backpack_c68f72e4:

    # gg "- Этот какой-то грустный..."
    gg "- Biraz üzgün görünüyordu..."

translate turkish strings:
    # game/pnc_text.rpy:216
    old "(Интересно, почему?)"
    new "(Neden acaba?)"

# game/pnc_text.rpy:220
translate turkish backpack_a097dd72:

    # gg "- Это неважно. Главное, что теперь он не одинок!"
    gg "- Artık bir önemi yok, çünkü yalnızlığına son verdik!"

translate turkish strings:
    # game/pnc_text.rpy:221
    old "(Ладно. Давай искать дальше?)"
    new "(Aynen öyle. Aramaya devam mı?)"

# game/pnc_text.rpy:244
translate turkish papers_cb8dd79e:

    # "Обычные тетрадные листы, приклеенные к стене на скотч. На них изображены картинки с цифрами - единственная информация, которую я воспринимаю без особых трудностей."
    "Bantla duvara yapıştırılmış defter sayfaları. Üzerindeki sayılar, zorlanmadan okuyabildiğim belki de tek şey."

translate turkish strings:
    # game/pnc_text.rpy:245
    old "(Дозировка и побочные эффекты?)"
    new "(İlaçlarının dozu ve yan etkileri mi?)"

# game/pnc_text.rpy:248
translate turkish papers_90766208:

    # gg "- Угу."
    gg "- Evet."

translate turkish strings:
    # game/pnc_text.rpy:249
    old "(Я думал, ты знаешь их наизусть.)"
    new "(Ezbere bildiğini sanıyordum.)"

# game/pnc_text.rpy:253
translate turkish papers_ea9753d4:

    # gg "- Да..."
    gg "- Ee..."

translate turkish strings:
    # game/pnc_text.rpy:256
    old "(Это ведь не твой почерк, верно?)"
    new "(Bunları sen yazmadın, değil mi?)"

# game/pnc_text.rpy:260
translate turkish papers_d2c4cf06:

    # gg "- ..."
    gg "- ..."

# game/pnc_text.rpy:263
translate turkish papers_e9c33d7f:

    # "Конечно же, нет. Обрывистые и неровные линии, корявые и некрасивые цифры... Не почерк; скорее, царапины от когтей."
    "Elbette hayır. Çarpık ve düzensiz çizgiler, çirkin ve özensiz rakamlar... Buna yazı denemez, daha çok pençe izlerini anımsatıyor." 

translate turkish strings:
    # game/pnc_text.rpy:264
    old "(Не забудь сказать спасибо маме.)"
    new "(Annene teşekkür etmelisin.)"

# game/pnc_text.rpy:268
translate turkish papers_c31fcb47:

    # gg "- Отстань!"
    gg "- Bana bilmişlik taslama!"

# game/pnc_text.rpy:271
translate turkish papers_cf0ae0d1:

    # "От моего крика листы забеспокоились, зашелестели; спустя секунду из-под одного лениво показался светлячок."
    "Bir çığlıkta sayfaların huzuruna son veriyorum. Kısa süre sonra aralarından bir ateş böceği çıkıveriyor."

# game/pnc_text.rpy:272
translate turkish papers_3f22d077:

    # "Деловито оглянувшись, он деловито вспорхнул и не менее деловито залетел мне в ухо."
    "Sağduyulu bir şekilde etrafına bakınıp sağduyulu bir şekilde havalanıyor ve sağduyulu kulağımdan içeri giriyor." 

# game/pnc_text.rpy:277
translate turkish papers_fc3f9e8b:

    # gg "- Давай искать дальше."
    gg "- Aramaya devam edelim."

# game/pnc_text.rpy:299
translate turkish bed_4400afce:

    # "Хи-хи, это мой спальный мешок! Мягкий и теплый; я уверена, что любое живое существо не отказалось бы провести в нем минутку-другую."
    "Ehehe, yumuşacık ve sıcacık uyku tulumum! Şunun içerisinde birkaç dakika dinlenmeye hiçbir canlının karşı koyamayacağından eminim."

# game/pnc_text.rpy:300
translate turkish bed_649f7dfb:

    # "Зарыться поглубже, прихватив с собой пару любимых вещей, закрыть глаза и..."
    "En sevdiği eşyalarlarla birlikte içine sokulup, gözlerini kapayıp..."

translate turkish strings:
    # game/pnc_text.rpy:301
    old "(Эй! Ты что, уже спишь?)"
    new "(Hey! Uyuya mı kaldın?)"

# game/pnc_text.rpy:304
translate turkish bed_8930ec26:

    # gg "- А?.."
    gg "- Ha?.."

# game/pnc_text.rpy:307
translate turkish bed_a8bbb4e1:

    # "Я слегка ударяю себя по щекам, чтобы прийти в чувство. Время уже далеко за полночь; в обычные дни я уже сплю как убитая. Но сейчас никак нельзя!.."
    "Kendime gelmek için yanaklarımı hafifçe tokatlıyorum. Saat çok geç olmuş. Normalde şu an kütük gibi uyuyor olmam gerekirdi ancak şimdi hiç sırası değil!.."

# game/pnc_text.rpy:310
translate turkish bed_fc3f9e8b:

    # gg "- Давай искать дальше."
    gg "- Hadi, aramaya devam edelim."

translate turkish strings:
    # game/pnc_text.rpy:311
    old "(Эй, а может внутри кто-то есть?)"
    new "(Uyku tulumunun içine baksana!)"

# game/pnc_text.rpy:315
translate turkish bed_f621a758:

    # gg "- Не-а. Моим мыслям несвойственно усыплять, скорее, наоборот: они всегда провоцируют бессонницу. И сегодня как раз такой день."
    gg "- Yok. Düşüncelerimin uykuyla pek işi olmaz; aksine her zaman uykusuzluğa sebep olur - tıpkı bu gece de olduğu gibi."

translate turkish strings:
    # game/pnc_text.rpy:316
    old "(Что?)"
    new "(Ne?)"

# game/pnc_text.rpy:320
translate turkish bed_1c6c319f:

    # gg "- Здесь искать бессмысленно, говорю."
    gg "- Diyorum ki uyku tulumuma bakmaya gerek yok."

# game/pnc_text.rpy:340
translate turkish clock_686cd361:

    # "Я гляжу на часы - время неумолимо движется."
    "Saate bakıyorum. Zaman su gibi akıp gidiyor."

# game/pnc_text.rpy:342
translate turkish clock_df7eb0c2:

    # gg "- Уже так поздно..."
    gg "- Saat çok geç olmuş..."

translate turkish strings:
    # game/pnc_text.rpy:343
    old "(Устала?)"
    new "(Yoruldun mu?)"

# game/pnc_text.rpy:347
translate turkish clock_27a18cb3:

    # gg "- Еще как..."
    gg "- Hem de nasıl..."

# game/pnc_text.rpy:350
translate turkish clock_33ee45a6:

    # "Я демонстративно громко зеваю и вытягиваю руки в стороны."
    "Ağzım yırtılacakmışçasına esniyor ve kollarımı yana doğru açıyorum."

# game/pnc_text.rpy:351
translate turkish clock_038f9fa3:

    # "Раз-два."
    "Bir, 'ki..."

# game/pnc_text.rpy:352
translate turkish clock_332f57b4:

    # "Затем поднимаю их над головой."
    "Ardından kollarımı havaya kaldırıyorum."

# game/pnc_text.rpy:353
translate turkish clock_557547f8:

    # "Три-четыре."
    "Üç, dört."

# game/pnc_text.rpy:354
translate turkish clock_6e34fd04:

    # "Может, небольшая гимнастика поможет взбодриться?"
    "Biraz jimnastik yapsam iyi gelir mi acaba?"

translate turkish strings:
    # game/pnc_text.rpy:355
    old "(Неплохая идея! Помнишь упражнения, которым тебя учили?)"
    new "(Bu harika bir fikir! Öğrendiğin egzersizleri hatırlıyor musun?)"

# game/pnc_text.rpy:359
translate turkish clock_649f3fc1:

    # gg "- Вроде, помню..."
    gg "- Sanırım..."

# game/pnc_text.rpy:362
translate turkish clock_8d94999f:

    # "Я неуверенно встаю в стойку; пятки вместе, носки врозь... Или как там было?"
    "Kararsızca bir duruşa geçiyorum. 'Topuklar bitişik, ayaklar V şeklinde' miydi... nasıldı?"

# game/pnc_text.rpy:365
translate turkish clock_a39e73c9:

    # gg "- Ладно, будь что будет. Засекай пять минут!"
    gg "- Aman, her neyse işte. Beş dakika süre tut!"

translate turkish strings:
    # game/pnc_text.rpy:366
    old "(Засек. Хотя у тебя часы прямо перед носом, вообще-то.)"
    new "(Karşında saat var ama yine de sen bilirsin.)"

# game/pnc_text.rpy:370
translate turkish clock_3866490e:

    # gg "- Я не могу слишком долго смотреть на стрелки."
    gg "- Akrep ve yelkovana fazla bakamıyorum."

# game/pnc_text.rpy:373
translate turkish clock_3629485d:

    # "Сначала они будто бы идут в обратном направлении, затем и вовсе исчезают..."
    "Bakarsam önce ters yöne hareket ediyorlar, ardından tümüyle yok oluyorlarmış gibi geliyor."

# game/pnc_text.rpy:374
translate turkish clock_a20cefa7:

    # "..."
    "..."

# game/pnc_text.rpy:375
translate turkish clock_8af69835:

    # "А после этого всегда происходит какая-нибудь ерунда."
    "Sonra da her zamanki saçmalıklar işte."

# game/pnc_text.rpy:376
translate turkish clock_37721a79:

    # "В последний раз мне померещилась пара глаз на циферблате..."
    "Geçen sefer saatin kadranında bir çift göz gördüm mesela..."

# game/pnc_text.rpy:377
translate turkish clock_44335f8e:

    # "А еще..."
    "Onun dışında..."

# game/pnc_text.rpy:378
translate turkish clock_912ad87c:

    # "Когда-то давно мне слышались голоса..."
    "Gaipten sesler duyduğum zamanlar da oldu..."

# game/pnc_text.rpy:379
translate turkish clock_38d6eb28:

    # "Они будто... звали на помощь?"
    "Sesler sanki... yardım çığlığına benziyordu."

# game/pnc_text.rpy:380
translate turkish clock_7dea574f:

    # "Ерунда, сущая ерунда."
    "Çok korkunçtu."

# game/pnc_text.rpy:381
translate turkish clock_dba34053:

    # "Ерунда же?"
    "Sence de öyle değil mi?"

# game/pnc_text.rpy:382
translate turkish clock_0f7c6a07:

    # "Ерунда."
    "Tüyler ürpertici."

# game/pnc_text.rpy:385
translate turkish clock_b35d4af1:

    # gg "- Ну что, засек время?"
    gg "- Ee, saymaya devam ediyor musun bakayım?"

translate turkish strings:
    # game/pnc_text.rpy:386
    old "(Боже, наконец-то...)"
    new "(Tanrım, hele şükür...)"

# game/pnc_text.rpy:390
translate turkish clock_213f59bc:

    # gg "- О чем ты?"
    gg "- Ne oldu?"

translate turkish strings:
    # game/pnc_text.rpy:391
    old "(Я уже полчаса не могу до тебя достучаться.)"
    new "(Yarım saattir sana sesimi duyurmaya çalışıyorum.)"

# game/pnc_text.rpy:395
translate turkish clock_8930ec26:

    # gg "- А?.."
    gg "- Ha?.."

translate turkish strings:
    # game/pnc_text.rpy:396
    old "(Забудь. Светлячка видишь?)"
    new "(Boş ver. Ateş böceği görüyor musun?)"

# game/pnc_text.rpy:400
translate turkish clock_1f91f806:

    # gg "- Н-нет..."
    gg "- Y-yok..."

translate turkish strings:
    # game/pnc_text.rpy:401
    old "(Тогда давай искать дальше.)"
    new "(O zaman aramaya devam edelim.)"

# game/pnc_text.rpy:422
translate turkish can_73aa1f9a:

    # "Приблизившись к мусорному баку, я с любопытством заглядываю внутрь."
    "Çöp kutusuna yaklaşıp meraklı gözlerle içine bakıyorum."

# game/pnc_text.rpy:423
translate turkish can_9cefa99d:

    # "Упаковки из-под лекарств, тетрадные листы и прочий мусор. Скука..."
    "İlaç kutuları, defter sayfaları, çer çöp... Sıkıcı."

# game/pnc_text.rpy:425
translate turkish can_602f184f:

    # gg "- Здесь ничего. И правильно, ни один уважающий себя светлячок не стал бы прятаться в мусорке!"
    gg "- Yok. Kendine saygısı olan hiçbir ateş böceği, çöp kutusuna saklanmaz zaten."

translate turkish strings:
    # game/pnc_text.rpy:426
    old "(Пожалуй, соглашусь.) "
    new "(Katılıyorum.)"

# game/pnc_text.rpy:448
translate turkish fan_352aa8f3:

    # gg "- Хи-хи!"
    gg "- Ehehe!"

translate turkish strings:
    # game/pnc_text.rpy:449
    old "(Что смешного?)"
    new "(Niye güldün?)"

# game/pnc_text.rpy:453
translate turkish fan_ac72e700:

    # gg "- Я представила себя светлячком, который видит перед собой огромный вентилятор."
    gg "- Ateş böceği olup dev bir vantilatöre baktığımı hayal ettim de..."

translate turkish strings:
    # game/pnc_text.rpy:454
    old "(Ну и?..)"
    new "(Ee?..)"

# game/pnc_text.rpy:458
translate turkish fan_e28ac19d:

    # gg "- Да я бы жуть как обзавидовалась!"
    gg "- Kulağa acıklı geliyor."

# game/pnc_text.rpy:461
translate turkish fan_f43e7afd:

    # gg "- Единственное, что не дает ему взлететь - это клетка, в которой он заперт... ну и провод."
    gg "- Düşünsene, etrafında uçmana engel olup seni hapseden bir kafes var, üstüne üstlük bir kabloya bağlısın."

# game/pnc_text.rpy:464
translate turkish fan_ecb0c3d8:

    # gg "- Он словно заключенный в тюрьме, если задуматься..."
    gg "- Mahkumsun yani bir bakıma."

# game/pnc_text.rpy:467
translate turkish fan_f0cb13c4:

    # gg "- Грустно это все."
    gg "- Çok üzücü."

translate turkish strings:
    # game/pnc_text.rpy:468
    old "(Ага.)"
    new "(Evet.)"

# game/pnc_text.rpy:472
translate turkish fan_fc3f9e8b:

    # gg "- Давай искать дальше."
    gg "- Neyse, biz aramaya devam edelim."

# game/pnc_text.rpy:492
translate turkish laptop_0178e4bf:

    # "Я смотрю на свой ноутбук. Из-за того, что я многие годы не прикасалась к нему, он покрыт слоем пыли толщиной в палец."
    "Bilgisayarıma bakıyorum. Yıllardır kullanmadığım için üzerinde parmağım kalınlığında toz birikmiş."

# game/pnc_text.rpy:493
translate turkish laptop_32e9c419:

    # "Очень странный предмет. Я его побаиваюсь..."
    "Acayip bir eşya, beni korkutuyor..."

translate turkish strings:
    # game/pnc_text.rpy:498
    old "(Вот и отлично. Рассказывай!)"
    new "(Aa, neden ki? Merak ettim!)"

# game/pnc_text.rpy:497
translate turkish laptop_369e40f2:

    # gg "- Это долгая и скучная история."
    gg "- Boş ver, uzun ve sıkıcı bir hikaye."

translate turkish strings:
    # game/pnc_text.rpy:503
    old "(Я настаиваю!)"
    new "(Ama lütfen!)"

# game/pnc_text.rpy:502
translate turkish laptop_7fd94592:

    # gg "- М-м..."
    gg "- Immm..."

# game/pnc_text.rpy:507
translate turkish laptop_5f0d51e5:

    # gg "- Я не помню, как он появился в моей комнате."
    gg "- Bunun odama nereden, nasıl geldiğini hatırlamıyorum."

# game/pnc_text.rpy:508
translate turkish laptop_d05dfac5:

    # gg "- Наверное, кто-то из родителей принес его сюда, потому что не нашлось другого места."
    gg "- Muhtemelen koyacak daha iyi bir yer bulamadıkları için ebeveynlerimden biri getirmiştir."

# game/pnc_text.rpy:509
translate turkish laptop_ca6f1421:

    # gg "- Мне не запрещали им пользоваться - наоборот, даже поощряли."
    gg "- Beni bilgisayar konusunda hiç kısıtlamadılar, hatta teşvik bile ettiler."

# game/pnc_text.rpy:512
translate turkish laptop_1826dfb6:

    # gg "- Еще бы, я целыми днями безвылазно сидела перед экраном! Игры, рисование, инженерный калькулятор, трехмерное моделирование..."
    gg "- Hâliyle vaktimin çoğunu ekran başında oyun oynayarak, resim çizerek; hesaplama ve 3D modelleme gibi uğraşlarla geçirdim."

# game/pnc_text.rpy:515
translate turkish laptop_b3ebc70c:

    # gg "- Столько развлечений!"
    gg "- Tam bir eğlence kutusu!"


translate turkish strings:
    # game/pnc_text.rpy:516
    old "(Занятные у тебя были хобби.)"
    new "(Çok güzel hobilere sahipmişsin.)"

# game/pnc_text.rpy:520
translate turkish laptop_87077ee0:

    # gg "- Ага, были... до выхода в сеть."
    gg "- Evet, sahiptim... ta ki internete girene kadar."

translate turkish strings:
    # game/pnc_text.rpy:521
    old "(М-м?)"
    new "(Ha?)"

# game/pnc_text.rpy:525
translate turkish laptop_30b90bb2:

    # gg "- Представь себе ситуацию: ты - хомячок, что живет под землей. У тебя есть все необходимое для комфортной жизни."
    gg "- Düşün ki yer altında yaşayan bir hamstersın ve huzurlu bir hayat sürmek için ihtiyacın olan her şeye sahipsin."

# game/pnc_text.rpy:528
translate turkish laptop_b730d7d5:

    # gg "- Представил?"
    gg "- Kafanda canlandı mı?"

translate turkish strings:
    # game/pnc_text.rpy:529
    old "(Твои аналогии как всегда на высоте.)"
    new "(Her zamanki gibi harika bir benzetme.)"

    # game/pnc_text.rpy:531
    old "(Ну хорошо, представил.)"
    new "(Pekala, canlandı.)"

# game/pnc_text.rpy:535
translate turkish laptop_fdaff107:

    # gg "- Итак, ты - хомячок, что живет под землей. У тебя есть все необходимое для комфортной жизни, да?"
    gg "- Süper, yer altında yaşayan bir hamstersın ve huzurlu bir hayat sürmek için ihtiyacın olan her şeye sahipsin, tamam mı?"

translate turkish strings:
    # game/pnc_text.rpy:536
    old "(Да...)"
    new "(Tamam...)"

# game/pnc_text.rpy:540
translate turkish laptop_5a413449:

    # gg "- Отлично! Значит, ситуация следующая: ты - хомячок, что живет..."
    gg "- Harika! Ancak mesele şu ki yer altında yaşayan bir hamstersın ve..."

translate turkish strings:
    # game/pnc_text.rpy:541
    old "(Ладно, я тебя понял. Хочешь поговорить о чем-то другом?)"
    new "(Tamam yahu, anladım. Devam edecek misin?)"

# game/pnc_text.rpy:545
translate turkish laptop_d2c4cf06:

    # gg "- ..."
    gg "- ..."

# game/pnc_text.rpy:548
translate turkish laptop_d254e5a2:

    # gg "- Угу..."
    gg "- Evet..."

translate turkish strings:
    # game/pnc_text.rpy:549
    old "(Все равно ведь вернешься к этой теме.)"
    new "(Dönüp dolaşıp aynı yere geliyorsun, devam et.)"

# game/pnc_text.rpy:558
translate turkish laptop_d2c4cf06_1:

    # gg "- ..."
    gg "- ..."

# game/pnc_text.rpy:561
translate turkish laptop_6000601f:

    # gg "- В один прекрасный день тебя выкапывают из твоей хомячьей норки и приносят в зоомагазин. Теперь клетка - твой новый дом."
    gg "- Her şeyin yolunda olduğu bir gün biri, toprağı kazıp seni yuvandan alıkoyuyor ve evcil hayvan dükkanına getirip bir kafese kapatıyor. Bu kafes, artık senin yeni evin."

# game/pnc_text.rpy:564
translate turkish laptop_03c88239:

    # gg "- Здесь гораздо удобнее и теплее, чем под землей."
    gg "- Yer altına kıyasla çok daha rahat ve sıcak bir yerden bahsediyoruz bu arada."

# game/pnc_text.rpy:567
translate turkish laptop_cc648f6c:

    # gg "- А самое главное - здесь у тебя много соседей. Их клетки - точные копии твоей; да и сами хомячки как две капли воды похожи на тебя - выходит, вы ничем друг от друга не отличаетесь."
    gg "- En önemlisi ise... burada bir sürü komşun var. Kafesleri tıpkı seninki gibi, dış görünüşleri de öyle - yani hepiniz tıpatıp aynısınız."

# game/pnc_text.rpy:570
translate turkish laptop_88bcc6b1:

    # gg "- Кроме того, что они были рождены в этом зоомагазине."
    gg "- Ancak onlar bu dükkanda doğup büyümüş, aranızdaki tek fark bu."

# game/pnc_text.rpy:573
translate turkish laptop_2497aa37:

    # gg "- Ты спросишь - но на что это указывает? А я тебе отвечу - да ни на что."
    gg "- Şimdi diyeceksin ki 'Bu kız ne demeye çalışıyor?' - bir şey demeye çalışmıyorum."

# game/pnc_text.rpy:576
translate turkish laptop_70f10b0e:

    # gg "- Я забыла, о чем шла речь..."
    gg "- Çünkü ne anlattığımı unuttum..."

translate turkish strings:
    # game/pnc_text.rpy:577
    old "(О, боже...)"
    new "(Tanrım...)"

# game/pnc_text.rpy:581
translate turkish laptop_7ee42079:

    # gg "- Ладно, давай начнем заново!"
    gg "- Pekala, baştan başlayayım!"

translate turkish strings:
    # game/pnc_text.rpy:582
    old "(В этот раз постарайся обойтись без дурацких примеров с хомяками.)"
    new "(Bu sefer saçma hamster benzetmene hiç girme.)"

# game/pnc_text.rpy:586
translate turkish laptop_3b77990a:

    # gg "- Ты же знаешь, что я не виновата."
    gg "- Öf, sen de..."

# game/pnc_text.rpy:589
translate turkish laptop_b061a70e:

    # gg "- Итак."
    gg "- Neyse."

# game/pnc_text.rpy:590
translate turkish laptop_3690dc5f:

    # gg "- У меня было очень много друзей в сети. Десятки, сотни... всех не сосчитать."
    gg "- İnternette bir sürü arkadaşım vardı - onlarca, hatta yüzlerce, sayamayacak kadar çok..."

# game/pnc_text.rpy:593
translate turkish laptop_f6f9494b:

    # gg "- Хотя, почему не сосчитать? Их было ровно триста семнадцать."
    gg "- Yine de oturup saydım: tam üç yüz on yedi arkadaşım vardı."

# game/pnc_text.rpy:596
translate turkish laptop_9ca563cd:

    # gg "- Впрочем, никто не считает точное количество хомячков, когда заходит в зоомагазин..."
    gg "- Evcil hayvan dükkanına giren biri, içerideki hamsterları saymaya zahmet etmez gerçi ama..."

translate turkish strings:
    # game/pnc_text.rpy:597
    old "(Эй, не отвлекайся!)"
    new "(Hey, odaklan!)"

# game/pnc_text.rpy:601
translate turkish laptop_b97a9039:

    # gg "- Ах да!"
    gg "- Ah, sağ ol!"

# game/pnc_text.rpy:604
translate turkish laptop_ee66ebc9:

    # gg "- Из трехсот семнадцати друзей шестьдесят восемь увлекались играми - прямо как я!"
    gg "- Üç yüz on yedi arkadaşımdan altmış sekizi tıpkı benim gibi oyunlarla ilgileniyordu!"

# game/pnc_text.rpy:605
translate turkish laptop_39f06a4e:

    # gg "- Еще сто тридцать друзей любили рисовать - ну в точности как я!"
    gg "- Yüz otuz tanesi resimle ilgiliydi, yine tıpkı benim gibi!"

# game/pnc_text.rpy:606
translate turkish laptop_be83ef93:

    # gg "- Оставшиеся сто девятнадцать друзей увлекались калькуляторами и трехмерной графикой в равной степени."
    gg "- Geri kalan yüz on dokuz tanesi ise yarı yarıya olmak üzere hesaplama ve 3D modellemeyle uğraşıyordu."

# game/pnc_text.rpy:609
translate turkish laptop_048d14d4:

    # gg "- И когда я говорю ‘в равной степени’, я не имею в виду ‘по пятьдесят девять с половиной друзей с каждой стороны’."
    gg "- Tabii 'yarı yarıya' derken iki tarafta da elli dokuz buçuk kişi olduğundan bahsetmiyorum."

# game/pnc_text.rpy:612
translate turkish laptop_ddb17af4:

    # gg "- Понимаешь?"
    gg "- Anladın mı?"

# game/pnc_text.rpy:615
translate turkish laptop_66951c3e:

    # gg "- Сто девятнадцать можно разделить пополам без проблем, но с друзьями математика работает по-другому... Ну что за напасть, а?"
    gg "- Sayıları eşit bölerken sorun yok ama söz konusu insanlar olunca matematik işe yaramıyor. Hayret bir şey."

translate turkish strings:
    # game/pnc_text.rpy:616
    old "(Давай ближе к делу.)"
    new "(Sadede gel.)"

# game/pnc_text.rpy:620
translate turkish laptop_6d94f79c:

    # gg "- Разумеется, я знала, что настоящих людей в сети не существует."
    gg "- Elbette internetteki kişilerin gerçek olmadığının farkındaydım."

# game/pnc_text.rpy:621
translate turkish laptop_09142f27:

    # gg "- И, выключая компьютер, я понимала, что все мои друзья умирают в тот же момент."
    gg "- Farkında olduğum bir diğer konu da bilgisayarımı kapattığımda tüm arkadaşlarımın öldüğüydü."

# game/pnc_text.rpy:624
translate turkish laptop_fd42c0ca:

    # gg "- И все же, я ни капли не беспокоилась..."
    gg "- Ama bu beni hiç üzmüyordu..."

# game/pnc_text.rpy:629
translate turkish laptop_35b3eb5c:

    # gg "- Знаешь, из чего состоят компьютерные программы? Это всего-навсего комбинация чисел."
    gg "- Bilgisayar programları nelerden oluşur, bilir misin? Devasa bir sayı kombinasyonundan."

# game/pnc_text.rpy:632
translate turkish laptop_ec2ec1d3:

    # gg "- Значит, и мои друзья - это числа. Не находишь это занятным?"
    gg "- Yani arkadaşlarım da sayılardan ibaretti. Gülünç..."

translate turkish strings:
    # game/pnc_text.rpy:633
    old "(Не особо.)"
    new "(Hiç de öyle değil.)"

translate turkish strings:
    # game/pnc_text.rpy:635
    old "(Почему ты называешь их друзьями?)"
    new "(Peki onları arkadaşın olarak görmenin sebebi neydi?)"

# game/pnc_text.rpy:639
translate turkish laptop_2fe59e50:

    # gg "- Ну как же! Все, кто разделяет мои интересы - мои друзья. И неважно, знают ли они о моем существовании или нет."
    gg "- Yani... Aynı ilgi alanını paylaştığımız kişiler arkadaşım sayılır. Varlığımdan haberdar olsalar da, olmasalar da öyleler. Tek sebebi bu."

# game/pnc_text.rpy:642
translate turkish laptop_a2053065:

    # gg "- Так вот! У каждой программы есть определенный алгоритм, задача - словом, математическая формула."
    gg "- Her neyse, diyordum ki... Her programın kendine özgü algoritması, amacı ve matematik formülü vardır."

# game/pnc_text.rpy:643
translate turkish laptop_d2b39157:

    # gg "- И если решить эту формулу, ты точно будешь знать, как программа поведет себя в тот или иной момент."
    gg "- O formülü çözebilirsen programın işleyişini de çözmüş olursun, yani öngörebilirsin."

translate turkish strings:
    # game/pnc_text.rpy:644
    old "(Чем дальше - тем меньше я понимаю, о чем ты.)"
    new "(Konu derinleştikçe anlamakta daha çok zorlanıyorum.)"

# game/pnc_text.rpy:648
translate turkish laptop_80add5f4:

    # gg "- Тебе не нужно что-либо понимать. Просто слушай."
    gg "- Senden anlamanı beklemiyorum, sadece dinle."

# game/pnc_text.rpy:651
translate turkish laptop_08543ea7:

    # "Я сажусь на пол, и экран ноутбука оказывается прямо у меня перед глазами. В нем я вижу лишь свое тусклое отражение и больше ничего."
    "Bilgisayarın önüne, yere oturuyorum. Ekranda yüzümün belli belirsiz yansımasını görebiliyorum."

# game/pnc_text.rpy:654
translate turkish laptop_6f1b1d71:

    # gg "- Человек из сети - это случайная картинка и случайный набор букв. Слова и поступки человека из сети - это программный код."
    gg "- İnternetteki kişiler, rastgele bir resim ve harf diziliminden ibaret. Bu kişilerin sözleri ve hareketleri de çalıştırılabilir birer kod."

# game/pnc_text.rpy:657
translate turkish laptop_d2c4cf06_2:

    # gg "- ..."
    gg "- ..."

# game/pnc_text.rpy:664
translate turkish laptop_d2c4cf06_3:

    # gg "- ..."
    gg "- ..."

# game/pnc_text.rpy:667
translate turkish laptop_c37d7625:

    # gg "- Однажды кое-кто появился. С тех пор компьютер все время включен."
    gg "- Bir gün karşıma biri çıkıverdi ve o günden itibaren bilgisayarım hep açık kaldı."

# game/pnc_text.rpy:670
translate turkish laptop_bf04f233:

    # gg "- В сети не бывает настоящих людей, но ему удавалось притворяться. В какой-то момент я позволила себя обмануть..."
    gg "- İnternetteki kişiler gerçek değil ama o, gerçekmiş gibi davranmakta fazlasıyla başarılıydı. Bir süre sonra nasıl olduysa beni kandırmasına izin verdim..."

translate turkish strings:
    # game/pnc_text.rpy:660
    old "(Дай мне знать, если тебе нужна передышка.)"
    new "(Soluklanmak istersen söyle lütfen.)"

translate turkish strings:
    # game/pnc_text.rpy:671
    old "(Эй, смотри!)"
    new "(Hey, baksana!)"

# game/pnc_text.rpy:675
translate turkish laptop_8930ec26:

    # gg "- А?.."
    gg "- Ha?.."

# game/pnc_text.rpy:678
translate turkish laptopff_744d5f7e:

    # "Вдруг из вентиляционной решетки ноутбука медленно выбирается светлячок. Я протягиваю руку; тот взбирается на ладонь, беспрестанно моргая."
    "Birden bilgisayarımın havalandırmasından bir ateş böceği çıkıveriyor. Elimi uzatıyorum, avucuma konuyor ve yanıp sönüyor."

translate turkish strings:
    # game/pnc_text.rpy:679
    old "(По-моему, он пытается что-то сказать.)"
    new "(Sanırım bir şey söylemeye çalışıyor.)"

# game/pnc_text.rpy:684
translate turkish laptopff_535e540c:

    # gg "- Я и сама вижу. Знать бы, что именно..."
    gg "- Farkındayım da keşke ne söylediğini anlayabilsem..."

translate turkish strings:
    # game/pnc_text.rpy:685
    old "(Похоже на шифр. Разве тебе не хочется его разгадать?)"
    new "(Şifreye benziyor - çözmek istemez misin?)"

# game/pnc_text.rpy:689
translate turkish laptopff_2f2a6c77:

    # gg "- Я передумала. Я на за что на свете не хочу знать, что он пытается сказать."
    gg "- Fikrimi değiştirdim. Ne söylemek istediğiyle ilgilenmiyorum artık."

# game/pnc_text.rpy:690
translate turkish laptopff_d9c14513:

    # "После этих слов светлячок на секунду гаснет."
    "Bu lafımın üstüne ateş böceği, bir anlığına sönüyor."

# game/pnc_text.rpy:691
translate turkish laptopff_dc2ada86:

    # "Затем, словно придя в себя, загорается вновь."
    "Ardından sanki aklı başına gelmiş gibi yeniden yanıyor."

# game/pnc_text.rpy:692
translate turkish laptopff_7662646e:

    # "Какое-то время он обдумывает дальнейшие действия, после чего поднимается в воздух и стремительно залетает ко мне в ухо."
    "Sonra ne yapacağını düşünüyor, kararını verince kanatlanıp kulağımdan içeri dalıveriyor."

# game/pnc_text.rpy:693
translate turkish laptopff_fc3f9e8b:

    # gg "- Давай искать дальше."
    gg "- Hadi, aramaya devam edelim."

translate turkish strings:
    # game/pnc_text.rpy:701
    old "(А как же твой рассказ?)"
    new "(Hikayene devam etmeyecek misin?)"

# game/pnc_text.rpy:705
translate turkish rasskaz_d2c4cf06:

    # gg "- ..."
    gg "- ..."

translate turkish strings:
    # game/pnc_text.rpy:706
    old "(Должно быть, ты злишься, что я прервал тебя. Извини.)"
    new "(Böldüğüm için bana kızmış olmalısın. Özür dilerim.)"

# game/pnc_text.rpy:710
translate turkish rasskaz_d2c4cf06_1:

    # gg "- ..."
    gg "- ..."

# game/pnc_text.rpy:713
translate turkish rasskaz_5f0715b8:

    # gg "- Если ты все сделаешь правильно, я закончу рассказ. Возможно..."
    gg "- Doğru yoldan devam edersen -belki- daha sonra hikayemin geri kalanını anlatırım..."

translate turkish strings:
    # game/pnc_text.rpy:714
    old "(Обещаешь?)"
    new "(Söz mü?)"

# game/pnc_text.rpy:718
translate turkish rasskaz_cc81ff2c:

    # gg "- Обещаю."
    gg "- Söz."

translate turkish strings:
    # game/pnc_text.rpy:719
    old "(А если забудешь?)"
    new "(Ya unutursan?)"

# game/pnc_text.rpy:721
translate turkish rasskaz_206e880f:

    # gg "- Тогда напомни мне. Кодовым словом, например."
    gg "- O zaman hatırlatırsın - bir anahtar sözcükle mesela."

translate turkish strings:
    # game/pnc_text.rpy:722
    old "(Каким же?)"
    new "(Ne anahtar sözcüğü?)"

# game/pnc_text.rpy:724
translate turkish rasskaz_d4a9506f:

    # gg "- Потом придумаю."
    gg "- Onu sonra düşüneceğim."

# game/pnc_text.rpy:727
translate turkish rasskaz_2e503c3b:

    # gg "- А сейчас - давай искать моих светлячков!"
    gg "- Şimdilik ateş böceklerimi aramaya devam edelim!"

# game/pnc_text.rpy:749
translate turkish notebook_73622d2a:

    # "Это моя тетрадь для рисунков. Половина страниц пустует - значит, хватит еще на пару лет."
    "Bu benim eskiz defterim. Sayfalarının yarısı boş, yani beni birkaç sene daha idare eder."

translate turkish strings:
    # game/pnc_text.rpy:750
    old "(Ты так редко рисуешь? Почему?)"
    new "(Ayda yılda bir resim çiziyorsun sanırım. Niye öyle?)"

# game/pnc_text.rpy:753
translate turkish notebook_2fdb1c40:

    # gg "- Разве не очевидно? Если закончатся страницы - придется покупать новую тетрадь."
    gg "- Tahmin etmek o kadar zor mu? Defterim biterse yenisini almam gerekir."

# game/pnc_text.rpy:754
translate turkish notebook_25c9dcf1:

    # gg "- До канцелярского магазина пешком не добраться, придется ехать на автобусе."
    gg "- En yakın kırtasiye de yürüme mesafesinde değil, sadece otobüsle gidebilirim."

# game/pnc_text.rpy:757
translate turkish notebook_0fdb62bd:

    # gg "- Ты вообще представляешь, каким кошмаром это может обернуться?"
    gg "- Bunun benim için ne denli bir kabusa dönüşebileceğinin farkındasın, değil mi?"

translate turkish strings:
    # game/pnc_text.rpy:758
    old "(Так, может, попросишь маму купить тебе тетрадь?)"
    new "(Annenden rica etsen sana defter almaz mı?)"

# game/pnc_text.rpy:762
translate turkish notebook_b5dc11a0:

    # gg "- Что купить? Кого попросить? Ты вообще умеешь расставлять акценты в речи?"
    gg "- Ne almaz mı? Kimden rica edeyim? Düzgün cümle kurmayı bilmiyor musun sen?"

translate turkish strings:
    # game/pnc_text.rpy:763
    old "(Не придуривайся. Лучше попроси маму купить тебе тетрадь.)"
    new "(Anlamazlıktan gelmeyi bırak. Annenden rica et, sana defter alsın, diyorum.)"

# game/pnc_text.rpy:767
translate turkish notebook_61128a51:

    # gg "- Лучше? То есть ты просишь от меня совершить сразу несколько действий, при этом говоря, что одно лучше другого?"
    gg "- Yani benden bir dizi eylemde bulunmamı ama bir yandan da ikisinden birini seçmemi mi istiyorsun?"

# game/pnc_text.rpy:770
translate turkish notebook_7b0afc12:

    # gg "- Тогда зачем мне выполнять то, которое хуже?"
    gg "- E o zaman hangi eylemde bulunacağıma nasıl karar vereceğim?"

# game/pnc_text.rpy:773
translate turkish notebook_3e4cfd0b:

    # gg "- Ты и пары слов связать не можешь, хи-хи!"
    gg "- Daha iki kelimeyi bir araya getiremiyorsun, ehehe!"

translate turkish strings:
    # game/pnc_text.rpy:774
    old "(Боже, как с тобой тяжело...)"
    new "(Ya sabır...)"

# game/pnc_text.rpy:778
translate turkish notebook_ff6dd08d:

    # gg "- Тебе недостает чуткости. Разве это моя вина?"
    gg "- Empati yoksunu olman benim suçum mu?"

# game/pnc_text.rpy:784
translate turkish notebook_a5db7b1c:

    # "Я подхожу чуть ближе к тетради, переступая через провода, спальный мешок, трещины в ламинате и отблески из окна."
    "Kabloların, uyku tulumumun, laminattaki çatlakların ve pencereden yere vuran ışığın üzerinden atlayıp eskiz defterime yaklaşıyorum."

# game/pnc_text.rpy:785
translate turkish notebook_508d510d:

    # "Тетрадь лежит на табуретке; с высоты моего взгляда кажется, что у табуретки недостает двух ножек. Опускаюсь на корточки - все ножки на месте."
    "Defterimin altındaki tabure, olduğum yerden bakınca iki ayağı eksikmiş gibi görünüyor. Çömelip tekrar baktığımda dört ayağının da yerinde olduğunu görüyorum."

# game/pnc_text.rpy:786
translate turkish notebook_dde63762:

    # "Могу ли я придумать интересную аллегорию?"
    "Buna ilginç bir benzetme bulabilir miyim acaba?"

translate turkish strings:
    # game/pnc_text.rpy:787
    old "(Давай без этого, а?)"
    new "(Ona hiç girmesek mi, ne dersin?)"

# game/pnc_text.rpy:789
translate turkish notebook_c146e361:

    # "Я поднимаюсь и смотрю на тетрадь в упор."
    "Doğrulup defterime göz gezdiriyorum."

# game/pnc_text.rpy:790
translate turkish notebook_bcd03463:

    # "Листы белоснежно чистые; последний рисунок похоронен на предыдущей странице. Так и должно быть."
    "Sayfaları inci gibi beyaz. Son çizimim, bir önceki sayfada üzeri örtülü vaziyette duruyor - en iyisi böyle kalsın."

translate turkish strings:
    # game/pnc_text.rpy:791
    old "(Жаль, мне бы хотелось взглянуть.)"
    new "(Tüh, ne çizdiğini görmek isterdim.)"

# game/pnc_text.rpy:795
translate turkish notebook_f01e6c1d:

    # gg "- В другой раз."
    gg "- Belki başka zaman."

# game/pnc_text.rpy:798
translate turkish notebook_8dcb67c3:

    # "Вдруг в комнату ворвался прохладный ветер - тетрадные листы зашелестели."
    "Ürpertici bir rüzgar, aniden pencereden içeri dolup sayfaları hışırdatmaya başlıyor."

# game/pnc_text.rpy:801
translate turkish notebook_705c7ef0:

    # gg "- Н-нет!.."
    gg "- Hayır!.."

# game/pnc_text.rpy:804
translate turkish notebook_ce173ba3:

    # "Я зажмуриваюсь."
    "Gözlerimi yumuyorum."

# game/pnc_text.rpy:805
translate turkish notebook_4a5bbcff:

    # "Отчетливый и характерный звук перелистываемых страниц отдается головной болью - я знаю, что сейчас произойдет..."
    "Rüzgarın çevirdiği sayfaların hışırtısı, baş ağrısını da tetikleyerek zihnimde yankılanıyor. Sanırım birazdan olacakları biliyorum."

# game/pnc_text.rpy:806
translate turkish notebook_a20cefa7:

    # "..."
    "..."

# game/pnc_text.rpy:807
translate turkish notebook_b092dc1b:

    # "Шелест прекратился, хотя ветер продолжал завывать из всех щелей. Это значит только одно - тетрадь открыта на первой странице."
    "Rüzgar şiddetle esmeye devam etse de sayfaların hışırtısı bir noktada son buluyor. Bu demek oluyor ki defterim, ilk sayfaya dönmüş."

# game/pnc_text.rpy:808
translate turkish notebook_1dec8145:

    # "Если я подожду еще немного, ветер захлопнет ее."
    "Biraz beklersem belki rüzgar defteri kapatır."

# game/pnc_text.rpy:809
translate turkish notebook_759776ee:

    # "Мне не придется смотреть... если я подожду еще немного."
    "Bakmama hiç gerek yok... biraz daha beklesem yeter."

# game/pnc_text.rpy:810
translate turkish notebook_f01278fc:

    # "Если я..."
    "Biraz daha..."

translate turkish strings:
    # game/pnc_text.rpy:811
    old "(Открой глаза.)"
    new "(Gözlerini aç.)"

# game/pnc_text.rpy:813
translate turkish notebook_827bf4c2:

    # gg "- Нет!"
    gg "- Olmaz!"

translate turkish strings:
    # game/pnc_text.rpy:814
    old "(Все хорошо, просто открой глаза.)"
    new "(Korkma, sıkıntı yok, beni dinle.)"

# game/pnc_text.rpy:816
translate turkish notebook_271f7539:

    # gg "- Ни за что! Я знаю, что ты врешь!"
    gg "- Asla olmaz! Yalan söylüyorsun!"

translate turkish strings:
    # game/pnc_text.rpy:817
    old "(Успокойся.)"
    new "(Sakin ol.)"

# game/pnc_text.rpy:819
translate turkish notebook_827bf4c2_1:

    # gg "- Нет!"
    gg "- Hayır!"

# game/pnc_text.rpy:822
translate turkish notebook_827bf4c2_2:

    # gg "- Нет!"
    gg "- Hayır!"

# game/pnc_text.rpy:825
translate turkish notebook_827bf4c2_3:

    # gg "- Нет!"
    gg "- Hayır!"

# game/pnc_text.rpy:828
translate turkish notebook_827bf4c2_4:

    # gg "- Нет!"
    gg "- Hayır!"

# game/pnc_text.rpy:831
translate turkish notebook_d2c4cf06:

    # gg "- ..."
    gg "- ..."

# game/pnc_text.rpy:834
translate turkish notebook_d2c4cf06_1:

    # gg "- ..."
    gg "- ..."

# game/pnc_text.rpy:837
translate turkish notebook_d2c4cf06_2:

    # gg "- ..."
    gg "- ..."

# game/pnc_text.rpy:838
translate turkish notebook_7e89ef29:

    # gg "- Ладно."
    gg "- Pekala."

# game/pnc_text.rpy:841
translate turkish notebook_9b2c1786:

    # "Я с опаской открываю глаза. Тетрадь все так же распахнута на середине; ни рисунков, ничего - листы по-прежнему чистые."
    "Gözlerimi yavaşça araladığımda defterimi bıraktığım gibi buluyorum. Resim falan yok, sayfalar hâlâ inci gibi beyaz."

# game/pnc_text.rpy:842
translate turkish notebook_57fd477a:

    # gg "- Померещилось?.."
    gg "- Az önce hayal mi gördüm ben?"

translate turkish strings:
    # game/pnc_text.rpy:843
    old "(Не знаю. Померещилось ли?)"
    new "(Bilmem. Sence?)"

# game/pnc_text.rpy:847
translate turkish notebook_094deede:

    # gg "- Ты же у нас все знаешь, вот и скажи мне!"
    gg "- Zeki olan sensin, senin söylemen lazım!"

translate turkish strings:
    # game/pnc_text.rpy:848
    old "(В следующий раз не закрывай глаза.)"
    new "(Bir dahakine lütfen gözlerini kapama.)"

# game/pnc_text.rpy:852
translate turkish notebook_558198df:

    # gg "- Что ты?.."
    gg "- Sen ne?.."

# game/pnc_text.rpy:855
translate turkish notebook_efe61eb0:

    # "Не успела я договорить, как тетрадные листы вновь зашевелились."
    "Cümlemi tamamlayamadan sayfalar yeniden hışırdamaya başlıyor."

translate turkish strings:
    # game/pnc_text.rpy:856
    old "(Не закрывай глаза!)"
    new "(Gözlerini kapama, dedim!)"

# game/pnc_text.rpy:860
translate turkish notebook_d0521114:

    # gg "- Не заставляй меня, мне же страшно!"
    gg "- Zorlama beni, korkuyorum!"

# game/pnc_text.rpy:865
translate turkish notebook_6372ec47:

    # "Шелест усиливается, листы приподнимаются - я могу разглядеть очертания рисунков на предыдущих страницах."
    "Hışırtı gittikçe şiddetleniyor ve sayfalar uçuşuyor - arka sayfalardaki çizimlerimin konturlarını görebiliyorum."

# game/pnc_text.rpy:866
translate turkish notebook_cf24a82c:

    # "Нет уж! Все, что было в прошлом, должно там и оставаться!"
    "Hayır! Geçmişte yaşanan her şey geçmişte kalmalı!"

translate turkish strings:
    # game/pnc_text.rpy:861
    old "(Верь мне.)"
    new "(Güven bana.)"

# game/pnc_text.rpy:869
translate turkish notebook_25767d3e:

    # gg "- Ты меня не убедил! Все, я закрываю глаза, слышишь?"
    gg "- Dayanamıyorum! Bu kadarı yeter, gözlerimi kapıyorum!"

# game/pnc_text.rpy:874
translate turkish notebook_64646323:

    # "Между страниц просачивается едва различимый свет. С каждым порывом ветра он становится все ярче и ярче..."
    "Sayfaların arasında sönük bir ışık beliriyor ve rüzgar her estiğinde daha da parlıyor..."

translate turkish strings:
    # game/pnc_text.rpy:870
    old "(Смотри, смотри же!)"
    new "(Şuna bak!)"

# game/pnc_text.rpy:877
translate turkish notebook_9a40790e:

    # gg "- Светлячок!"
    gg "- Ateş böceği!"

# game/pnc_text.rpy:880
translate turkish notebook_b496e578:

    # "Ветер вмиг прекращается. На секунду мир погружается в полную тишину, но лишь на секунду..."
    "Rüzgar birden kesiliyor. Dünya bir anlığına -ama sadece bir anlığına- mutlak sessizliğe gömülüyor..."

# game/pnc_text.rpy:881
translate turkish notebook_b8632a5e:

    # "Вечно преследующий меня шум неумолимо заполоняет все вокруг. Но сейчас это неважно!"
    "Zihnime musallat olan o ses, dört bir yanımı kuşatıyor ancak şu an bu hiç sorun değil!"

# game/pnc_text.rpy:884
translate turkish notebook_ca849c5e:

    # gg "- Боже, малыш! Я так перепугалась..."
    gg "- Şükürler olsun miniğim! Beni çok korkuttun..."

# game/pnc_text.rpy:887
translate turkish notebook_ba5348c8:

    # "В ответ светлячок моргает, после чего поднимается в воздух и с громким жужжанием влетает мне в ухо."
    "Ateş böceği yanıp sönüyor, kanatlanıyor ve vızıldayarak kulağıma giriyor."

# game/pnc_text.rpy:888
translate turkish notebook_72b512d0:

    # "Какое-то время он ищет подходящее место в моей голове, не прекращая жужжать, но потом затихает."
    "Bir süre kafamın içinde kendisine rahat bir yer arıyor, ardından vızıltı kesiliyor."

# game/pnc_text.rpy:891
translate turkish notebook_5794d60f:

    # gg "- Фух..."
    gg "- Uf..."

translate turkish strings:
    # game/pnc_text.rpy:892
    old "(Ты как, нормально?)"
    new "(İyi misin?)"

# game/pnc_text.rpy:896
translate turkish notebook_cf4086f9:

    # gg "- У нас мало времени, давай искать дальше."
    gg "- Vaktimiz daralıyor, aramaya devam etsek iyi olur."

# game/pnc_text.rpy:916
translate turkish pills_311114e8:

    # "Я смотрю на кучу лекарств и голова идет кругом. Я не хочу сейчас думать об этом, совсем не хочу..."
    "Bir yığın ilaç... Görüntüsü bile başımı döndürmeye yetiyor. Düşünmek istemiyorum, düşünmek..."

translate turkish strings:
    # game/pnc_text.rpy:917
    old "(Что с тобой?)"
    new "(Bir şey mi oldu?)"

# game/pnc_text.rpy:920
translate turkish pills_73c963bb:

    # gg "- Сегодня я едва не пропустила курс. Что за безрассудство! Я ведь могла умереть..."
    gg "- Az kalsın bugünkü dozumu atlıyordum. Ne kadar sorumsuzca bir hareketti! Ölebilirdim..."

translate turkish strings:
    # game/pnc_text.rpy:921
    old "(Эй, успокойся. Ты уже все исправила.)"
    new "(Hey, sakin ol. Bu meseleyi çoktan hallettin.)"

# game/pnc_text.rpy:925
translate turkish pills_4ca8d596:

    # gg "- Да, по твоему приказу!"
    gg "- Evet, senin söylemenle!.."

translate turkish strings:
    # game/pnc_text.rpy:926
    old "(Это обвинение?)"
    new "(Hedef ben miyim yani?)"

# game/pnc_text.rpy:930
translate turkish pills_d08b4fbc:

    # gg "- Конечно же нет! Только это меня и спасло."
    gg "- Hayır ya! Neticede beni sen kurtardın."

translate turkish strings:
    # game/pnc_text.rpy:931
    old "(Что ж... вполне здравая мысль.)"
    new "(Yani... olması gereken buydu.)"

translate turkish strings:
    # game/pnc_text.rpy:926
    old "(Все могло быть гораздо хуже.)"
    new "(Beterin beteri var, derler.)"

# game/pnc_text.rpy:938
translate turkish pills_21c1bac1:

    # gg "- Ага..."
    gg "- Evet..."

translate turkish strings:
    # game/pnc_text.rpy:921
    old "(Ты и так умрешь, чего волноваться?)"
    new "(Vaktin gelince öleceksin zaten, niye canını sıkıyorsun ki?)"

# game/pnc_text.rpy:943
translate turkish pills_29ef1128:

    # gg "- Ой, и правда!"
    gg "- Ah, haklısın!"

# game/pnc_text.rpy:946
translate turkish pills_d2c4cf06:

    # gg "- ..."
    gg "- ..."

# game/pnc_text.rpy:950
translate turkish pills_30a63250:

    # "Я тяжело вздыхаю, подхожу ближе и протягиваю руку..."
    "Derin bir iç çekip ilaç kutularına yaklaşıyor ve elimi uzatıyorum..."

# game/pnc_text.rpy:953
translate turkish pills_282e87f2:

    # gg "- Ух ты, тепло!"
    gg "- Vay be, sıcacık!"

# game/pnc_text.rpy:956
translate turkish pills_d8114ff1:

    # "Не успели слова вылететь из моего рта, как одна из баночек перевернулась; из нее градом посыпались таблетки, а затем..."
    "Söz ağzımdan çıktığı gibi kutulardan biri devriliyor, içindeki haplar dökülüyor ve beraberinde..."

# game/pnc_text.rpy:959
translate turkish pills_0225fb97:

    # gg "- Светлячок! Ура!"
    gg "- Ateş böceği! Yaşasın!"

# game/pnc_text.rpy:962
translate turkish pills_b0537a94:

    # "Сделав пару кругов над моей макушкой, он наконец садится на протянутую руку. Спешно пробежав по ней до плеча, светлячок заползает прямо мне в ухо - ум слегка проясняется."
    "Kafamın etrafında daireler çizdikten sonra avucuma konuyor. Sonra kolumdan omzuma tırmanıyor, kulağımdan içeri giriyor ve sayesinde zihnim biraz daha huzura kavuşuyor."

# game/pnc_text.rpy:982
translate turkish umbrella_6177059b:

    # "От зонта веет едва ощутимой прохладой. Немудрено, ведь только он защищает меня от грозовых туч, что иногда собираются под потолком."
    "Şemsiyemde hafif bir 'havalılık' seziyorum; beni odamın içerisinde biriken fırtına bulutlarından koruyan yegane şey olduğu için sanırım..."

# game/pnc_text.rpy:983
translate turkish umbrella_7211d4a7:

    # "Какое счастье, что он справляется с этим даже без моего участия!"
    "Bensiz de başının çaresine bakabildiğini görmek gurur verici!"

# game/pnc_text.rpy:985
translate turkish umbrella_e9ea09c8:

    # gg "- И все же, светлячок не станет прятаться в подобном месте. Иначе он простудится и не сможет летать!"
    gg "- Yine de bir ateş böceğinin gelip buraya saklanacağını sanmıyorum. Üşütür, uçamaz yoksa!"

translate turkish strings:
    # game/pnc_text.rpy:986
    old "(И ты не хочешь проверить?)"
    new "(Yine de bakmak istemez misin?)"

# game/pnc_text.rpy:990
translate turkish umbrella_2c1f3804:

    # gg "- Зачем? Я точно знаю - здесь мы ничего не найдем."
    gg "- Ne gerek var? İçinin boş olduğundan eminim."

translate turkish strings:
    # game/pnc_text.rpy:986
    old "(Ладно. Давай искать дальше.)"
    new "(Pekala. Aramaya devam edelim.)"

# game/pnc_text.rpy:1019
translate turkish tumba_b9934e56:

    # gg "- Это вряд ли. Все ящики намертво заперты."
    gg "- Hiç sanmam. Tüm çekmeceler kilitli."

translate turkish strings:
    # game/pnc_text.rpy:1020
    old "(А если...)"
    new "(Peki ya...)"

# game/pnc_text.rpy:1022
translate turkish tumba_fc1c9c4f:

    # gg "- Я не хочу даже думать о том, что внутри. Невесть чего вообразить можно!"
    gg "- İçinde ne olduğunu düşünmek bile istemiyorum. Kafamda neler neler kurarım sonra!"

translate turkish strings:
    # game/pnc_text.rpy:1048
    old "(Ладно, давай поищем где-нибудь еще.)"
    new "(Tamam, diğer eşyalarına bakalım.)"

# game/pnc_text.rpy:1045
translate turkish towel_acd71dda:

    # "Я обращаю свой взгляд к неприметной полке рядом с зеркалом. На ней стоит стакан с зубной щеткой, а рядом висит маленькое полотенце. Прелесть!"
    "Bakışlarımı aynanın yanında usulca duran rafa yöneltiyorum. Rafta diş fırçamı koyduğum bardak var, yanında da küçük bir havlu asılı. Ne şirin bir görüntü!"

# game/pnc_text.rpy:1047
translate turkish towel_1a28ab52:

    # gg "- Мои светлячки умные, хорошие и не станут туда лезть - у них есть понятия о личной гигиене!"
    gg "- Benim ateş böceklerim akıllı ve usludur bir kere. Kişisel bakım eşyalarıma dokunmamaları gerektiğini bilirler!"

# game/pnc_text.rpy:1068
translate turkish plants_b2dcd22e:

    # gg "- Точно! Насекомые же любят опылять цветы и все такое!"
    gg "- Tabii ya! Böcekler polen yaymayı, çiçekleri falan çok sever!"

translate turkish strings:
    # game/pnc_text.rpy:1069
    old "(Эм-м... типа того.)"
    new "(Im... Evet, sanırım.)"

# game/pnc_text.rpy:1073
translate turkish plants_37284d6f:

    # "Я подхожу вплотную к полке с цветами. Принюхиваюсь - от листьев пахнет пылью и картоном. И еще смертью."
    "Saksıların bulunduğu raflara yaklaşıyor ve çiçeklerimi kokluyorum: toz, karton, bir de... ölüm kokuyor."

translate turkish strings:
    # game/pnc_text.rpy:1074
    old "(Ты в курсе, что цветы давно высохли?)"
    new "(Kuruyup gitmişler, farkındasın, değil mi?)"
    
translate turkish strings:
    # game/pnc_text.rpy:1076
    old "(Вряд ли мертвый цветок может привлечь насекомое.)"
    new "(Böceklerin ölü çiçeklere geleceğini pek sanmam.)"

# game/pnc_text.rpy:1080
translate turkish plants_d40b9e9e:

    # gg "- Тут, знаешь ли, выбирать не приходится."
    gg "- Yani ama şu an daha iyi bir fikrim yok."

# game/pnc_text.rpy:1083
translate turkish plants_eb554241:

    # gg "- Хотя... ты прав. Давай искать дальше."
    gg "- Yine de... haklısın. Aramaya devam edelim."

translate turkish strings:
    # game/pnc_text.rpy:1084
    old "(Почему бы просто их не выбросить?)"
    new "(Niye onları çöpe atmıyorsun?)"

# game/pnc_text.rpy:1088
translate turkish plants_bb89c88c:

    # gg "- Ты что, совсем меня не слушал?"
    gg "- Saatlerdir kulağın nerede senin?"

# game/pnc_text.rpy:1093
translate turkish plants_d2c4cf06:

    # gg "- ..."
    gg "- ..."

# game/pnc_text.rpy:1111
translate turkish cond_5ae0230c:

    # "Я поднимаю глаза высоко-высоко к потолку."
    "Kafamı kaldırıp epey yüksek, tavana yakın bir yere bakıyorum."

# game/pnc_text.rpy:1112
translate turkish cond_3bb16f8c:

    # "Из кондиционера доносится топот множества маленьких лапок."
    "Sayısız küçük ayağın klimanın içerisinde tıpış tıpış gezdiğini duyabiliyorum."

# game/pnc_text.rpy:1114
translate turkish cond_ce0adfe1:

    # gg "- Ну вот..."
    gg "- Ah, peki..."

translate turkish strings:
    # game/pnc_text.rpy:1115
    old "(Что такое?)"
    new "(Ne oldu?)"

# game/pnc_text.rpy:1119
translate turkish cond_f224b446:

    # gg "- Светлячки не дружат с тараканами. Надо поискать в другом месте."
    gg "- Ateş böceklerinin hamam böcekleriyle arası pek iyi değildir, o yüzden diğer taraflara baksak iyi olur."

translate turkish strings:
    # game/pnc_text.rpy:1120
    old "(Боже, откуда там тараканы?)"
    new "(Hamam böcekleri de nereden çıktı şimdi?)"

# game/pnc_text.rpy:1124
translate turkish cond_86021029:

    # gg "- Ты уже забыл?"
    gg "- Ne çabuk unuttun?!"

# game/pnc_text.rpy:1125
translate turkish cond_1e339c58:

    # gg "- Сам же сказал мне представить, будто мои мысли - это тараканы."
    gg "- Düşüncelerimi hamam böceklerine benzetmemi söyleyen sendin ya."

translate turkish strings:
    # game/pnc_text.rpy:1126
    old "(Да, но...)"
    new "(Evet de...)"

# game/pnc_text.rpy:1130
translate turkish cond_911b6235:

    # gg "- Затем они стали светлячками, да... Но тараканы ведь не могут просто взять и исчезнуть!"
    gg "- Sonradan ateş böceğine dönüştüler, tamam ama... Hamam böcekleri öylece ortadan kaybolmadı işte!"

# game/pnc_text.rpy:1133
translate turkish cond_c734e0a6:

    # gg "- Вот они и нашли себе местечко."
    gg "- Yani burada kalanlar oldu."

# game/pnc_text.rpy:1136
translate turkish cond_a474b417:

    # gg "- Понял?"
    gg "- Şimdi anladın mı?"

translate turkish strings:
    # game/pnc_text.rpy:1137
    old "(Понял.)"
    new "(Anladım.)"
translate turkish strings:
    # game/pnc_text.rpy:1137
    old "(Не понял.)"
    new "(Anlamadım.)"
translate turkish strings:
    # game/pnc_text.rpy:1137
    old "(Сделаю вид, что понял.)"
    new "(Anlamış gibi yapacağım.)"

# game/pnc_text.rpy:1165
translate turkish bulbs_ebc87901:

    # gg "- Ты серьезно?"
    gg "- Ciddi misin?"

translate turkish strings:
    # game/pnc_text.rpy:1166
    old "(А что не так?)"
    new "(Ne oldu?)"

# game/pnc_text.rpy:1168
translate turkish bulbs_30c3bd25:

    # gg "- Сам подумай: стали бы светлячки лететь на свет?"
    gg "- Aklını kullan, ateş böcekleri neden ışığa gelsin ki?"

# game/pnc_text.rpy:1169
translate turkish bulbs_c15c589f:

    # gg "- Мне кажется, они вполне самодостаточны в этом плане."
    gg "- O konuda kendi kendilerine yetebilen canlılar sonuçta."

# game/pnc_text.rpy:1170
translate turkish bulbs_d2c4cf06:

    # gg "- ..."
    gg "- ..."

# game/pnc_text.rpy:1173
translate turkish bulbs_6f05c6bd:

    # gg "- Если только они целенаправленно не хотят снизить себе самооценку."
    gg "- Tabii bilerek kendi özgüvenlerini sarsmak istiyorlarsa orası ayrı."

# game/pnc_text.rpy:1176
translate turkish bulbs_cb7a643e:

    # gg "- Хм-м..."
    gg "- Hımmm..."

# game/pnc_text.rpy:1196
translate turkish vent_ac59bddc:

    # gg "- Отсюда так просто не выбраться... Хи-хи..."
    gg "- Oraya girmesi kolay ama çıkması biraz... Ehehe."

translate turkish strings:
    # game/pnc_text.rpy:1216
    old "(А это что?)"
    new "(Bunlar da ne?)"

# game/pnc_text.rpy:1219
translate turkish posters_9d2cceaf:

    # gg "- Ах, это..."
    gg "- Ah, bunlar..."

# game/pnc_text.rpy:1222
translate turkish posters_badaf50e:

    # gg "- Это фотографии моих самых счастливых моментов!"
    gg "- Bunlar en güzel anılarımın fotoğrafları!"

translate turkish strings:
    # game/pnc_text.rpy:1223
    old "(На них ведь ничего нет...)"
    new "(Ama hiçbir şey göremiyorum...)"

# game/pnc_text.rpy:1227
translate turkish posters_62804578:

    # gg "- Я так долго смотрела на них, что буквально сожгла взглядом, хи-хи!"
    gg "- Çünkü onlara o kadar sert baktım ki hepsi yanıp soldu, ehehe!"

# game/pnc_text.rpy:1228
translate turkish posters_c0104c7b:

    # gg "- Теперь они просто закрывают трещины в стенах."
    gg "- Artık sadece duvardaki çatlakları örtmeye yarıyorlar."

translate turkish strings:
    # game/pnc_text.rpy:1229
    old "(Трещины?)"
    new "(Ne çatlağı?)"

# game/pnc_text.rpy:1233
translate turkish posters_0639eea2:

    # gg "- Неважно. Дальше искать будем или как?"
    gg "- Boş versene. Aramaya devam edecek miyiz, ne yapacağız?"

translate turkish strings:
    # game/pnc_text.rpy:1234
    old "(Будем, будем...)"
    new "(Edeceğiz elbette...)"

# game/pnc_text.rpy:1254
translate turkish smth_7b670ab8:

    # gg "- Что это?"
    gg "- Bu ne?"

# game/pnc_text.rpy:1275
translate turkish shkaf_be2fa242:

    # "Я запрокидываю голову и чуть не падаю. Шкаф висит под самым потолком - метров сто от пола, не меньше."
    "Kafamı arkaya eğiyor ve az kalsın düşüyorum. Tavanın hemen altındaki dolap, yaklaşık yüz metre yükseklikte asılı duruyor."

# game/pnc_text.rpy:1277
translate turkish shkaf_8ee16e1e:

    # gg "- Издеваешься?.."
    gg "- Komik, değil mi?"

# game/pnc_text.rpy:1278
translate turkish shkaf_597bb54a:

    # gg "- Хоть это и моя комната, но многое здесь предназначено отнюдь не для меня."
    gg "- Oda, benim odam ama maalesef içerisindeki her şeyi rahatlıkla kullanamıyorum."

# game/pnc_text.rpy:1281
translate turkish shkaf_3d885d51:

    # gg "- Ну и ладно!"
    gg "- Neyse!"

# game/pnc_text.rpy:1284
translate turkish shkaf_d4166c15:

    # gg "- Мне вообще плевать!"
    gg "- Umurumda da değil zaten!"

# game/pnc_text.rpy:1285
translate turkish shkaf_db2e8cc7:

    # gg "- Да-да, плевать! И еще как!"
    gg "- Evet, değil! Hem de hiç!"

# game/pnc_text.rpy:1286
translate turkish shkaf_9fbd832c:

    # gg "- Вообще все равно! И я нисколько не переживаю!"
    gg "- Hiç ama hiç! Ayrıca hiç üzülmüyorum da!"

# game/pnc_text.rpy:1287
translate turkish shkaf_2ecec224:

    # gg "- Даже самую малость! Даже крупицу от самой малости!"
    gg "- Birazcık bile! Hatta bir gıdım bile!"

# game/pnc_text.rpy:1288
translate turkish shkaf_a267440e:

    # gg "- Даже на одну тысячную процента не переживаю! Вот настолько мне все равно!"
    gg "- Yüzde bir bile! İşte o kadar umurumda değil!"


# game/pnc_text.rpy:1293
translate turkish shkaf_ed736609:

    # gg "- Эй! Ты еще до конца не дослушал, насколько мне все равно..."
    gg "- Hey! Ne kadar umurumda olmadığını anlatmayı henüz bitirmedim..."

translate turkish strings:
    # game/pnc_text.rpy:1294
    old "(Начиная с этой секунды, я тебя игнорирую.)"
    new "(Artık seni duymazdan geleceğim.)"

# game/pnc_text.rpy:1298
translate turkish shkaf_44bd970c:

    # gg "- Ну уж нет!"
    gg "- Hayır, öyle bir şey yapamazsın!"

translate turkish strings:
    # game/pnc_text.rpy:1299
    old "(Тогда веди себя нормально.)"
    new "(O zaman aklını başına topla.)"

# game/pnc_text.rpy:1303
translate turkish shkaf_d2c4cf06:

    # gg "- ..."
    gg "- ..."
