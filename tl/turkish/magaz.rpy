# TODO: Translation updated at 2021-08-30 23:57

# game/magaz.rpy:63
translate turkish magaz_2bd1e715:

    # nm "Я просыпаюсь на деревянной лавке; перед глазами - узкая и слабо освещенная аллея. До боли знакомая дорога... где же я могла ее видеть?"
    nm "Gözümü ahşap bir bankta açıyorum, loş bir ara sokaktayım. Burası bana bir yerden tanıdık geliyor ama... acaba nereden?"

# game/magaz.rpy:64
translate turkish magaz_aad6796c:

    # trm "- Ну наконец-то..."
    trm "- Hele şükür..."

# game/magaz.rpy:70
translate turkish magaz_5b9565ac:

    # nm "Сбоку разносится голос. Я поворачиваюсь и вижу перед собой мальчика с крайне странным выражением лица."
    nm "Yan taraftan bir ses duyuyorum. Kafamı sesin geldiği yöne çevirdiğimde tuhaf bakışlı bir çocukla göz göze geliyorum."

# game/magaz.rpy:76
translate turkish magaz_5c56715c:

    # trm "- Ты опоздала!"
    trm "- Geç kaldın!"

# game/magaz.rpy:78
translate turkish magaz_d9ca71a8:

    # ggm "- Эм-м-м... а ты кто?"
    ggm "- Hı... Sen de kimsin?"

# game/magaz.rpy:79
translate turkish magaz_c96f65e3:

    # nm "Мальчик удивленно моргнул."
    nm "Çocuk şaşkınlıkla gözlerini kırpıyor."

# game/magaz.rpy:81
translate turkish magaz_9b91e7ea:

    # trm "- Так мы с тобой далеко не уйдем. Попробуй заново."
    trm "- Bu şekilde hiçbir yere varamayız. Hadi bir daha..."

# game/magaz.rpy:82
translate turkish magaz_92df8506:

    # nm "Затем он набирает полную грудь воздуха."
    nm "Derin bir nefes alıp tekrarlıyor."

# game/magaz.rpy:83
translate turkish magaz_21e45af1:

    # trm "- Ты! Опоздала!"
    trm "- Geç! Kal-dın!"

# game/magaz.rpy:85
translate turkish magaz_9dec254e:

    # nm "Я непонимающе смотрю на него. Он непонимающе смотрит на меня."
    nm "Ona bön bön bakıyorum, o da bana aynı şekilde bakıyor."

# game/magaz.rpy:86
translate turkish magaz_60af0f3c:

    # ggm "- И-извини?.."
    ggm "- A-affedersin?"

# game/magaz.rpy:88
translate turkish magaz_400b60e9:

    # nm "Мальчик довольно кивнул."
    nm "Çocuk memnuniyetle kafa sallıyor."

# game/magaz.rpy:89
translate turkish magaz_77916ef1:

    # trm "- Вот, уже лучше."
    trm "- İşte şimdi oldu."

# game/magaz.rpy:90
translate turkish magaz_e9fa80ce:

    # trm "- Имя-то у тебя есть? Меня вот Треской звать!"
    trm "- Senin adın ne? Benimkisi Treska!"

# game/magaz.rpy:92
translate turkish magaz_24605459:

    # nm "Я оценивающе оглядываю наглеца. Совсем маленький, а уже лезет с такими вопросами!"
    nm "Arsız velede dik dik bakıyorum. Bacak kadar boyuyla bana sorduğu soruya bak!"

# game/magaz.rpy:93
translate turkish magaz_e9fe9f8b:

    # ggm "- Не твое дело..."
    ggm "- Sana ne?"

# game/magaz.rpy:94
translate turkish magaz_dfb8a18f:

    # ggm "- И вообще!.. Мне кто-нибудь скажет, что я тут делаю?"
    ggm "- Hem ayrıca... Biri bana burada ne aradığımı söyleyebilir mi?"

# game/magaz.rpy:96
translate turkish magaz_279aff48:

    # trm "- Эй, это невежливо! Будто тут есть кто-то еще..."
    trm "- Ayıp ediyorsun! Etrafta benden başka biri var da sanki..."

# game/magaz.rpy:98
translate turkish magaz_0619fa6f:

    # nm "..."
    nm "..."

# game/magaz.rpy:100
translate turkish magaz_a899a5fc:

    # trm "- Тебе совсем ничего не рассказали? Вот я все знаю, например!"
    trm "- Hiçbir şeyden haberin yok mu senin? Benim her şeyden haberim var!"

# game/magaz.rpy:102
translate turkish magaz_1d4b75d7:

    # ggm "- О чем?"
    ggm "- Ne gibi?"

# game/magaz.rpy:104
translate turkish magaz_bf91ae6e:

    # trm "- Ты обязана проводить меня в магазин!"
    trm "- Mesela beni markete götürmen gerekiyor!"

# game/magaz.rpy:105
translate turkish magaz_aef4f109:

    # nm "После этих слов Треска встал в победную позу."
    nm "Bu sözlerin ardından Treska, sevinç dolu bir poz veriyor."

# game/magaz.rpy:107
translate turkish magaz_81f8ed24:

    # ggm "- Еще чего..."
    ggm "- Hayatta olmaz..."

# game/magaz.rpy:109
translate turkish magaz_8decfd91:

    # trm "- Ты ведь понимаешь, что отказ не принимается?"
    trm "- Götürmekten başka bir seçeneğin olduğunu kim söyledi?"

# game/magaz.rpy:111
translate turkish magaz_efc3c766:

    # ggm "- Многовато ты о себе возомнил."
    ggm "- Bana bak velet, haddini aşıyorsun artık!"

# game/magaz.rpy:113
translate turkish magaz_c4e65e33:

    # trm "- Я серьезно."
    trm "- Ciddiyim."

# game/magaz.rpy:114
translate turkish magaz_7516ceb4:

    # trm "- Это, как бы, не мне решать."
    trm "- Hem buna ben karar vermedim."

# game/magaz.rpy:115
translate turkish magaz_1eeae098:

    # trm "- Думаешь, я в восторге от такой компании?"
    trm "- Yoksa sana çok mu meraklı olduğumu sanıyorsun?"

# game/magaz.rpy:117
translate turkish magaz_f10d9bff:

    # nm "Какой-то он странный. То веселый, то грустный, то громкий, то тихий. Ненормальный какой-то. И имя дурацкое."
    nm "Tuhaf bir çocuk. Bir mutlu, bir mutsuz; bir bağırıyor, bir susuyor. Deli midir, nedir? İsmi de 'tırışka' zaten."

# game/magaz.rpy:119
translate turkish magaz_9d1124ad:

    # trm "- Мы идем или как?"
    trm "- Ee, gitsek mi artık?"

# game/magaz.rpy:121
translate turkish magaz_22b68094:

    # ggm "- Ты иди, а мне подумать надо."
    ggm "- Sen git, benim düşünmem lazım."

# game/magaz.rpy:123
translate turkish magaz_93798464:

    # trm "- Я бы с радостью, да только дороги не знаю..."
    trm "- Gitmeyi çok isterdim ama... yolu bilmiyorum."

# game/magaz.rpy:124
translate turkish magaz_75266a4b:

    # nm "Треска хитро улыбается. Я с досадой кусаю губы."
    nm "Treska karşımda pişmiş kelle gibi sırıtıyor. Bıkkınlıkla dudak büzüyorum."

# game/magaz.rpy:126
translate turkish magaz_5e5cae60:

    # ggm "- Буду с тобой честна - ты мне совсем не нравишься."
    ggm "- Açık konuşayım, senden hiç hoşlanmadım."

# game/magaz.rpy:127
translate turkish magaz_989f8e80:

    # nm "В ответ он лишь заливается смехом."
    nm "Bunu duyunca kahkahayı basıyor."

# game/magaz.rpy:131
translate turkish magaz_6c52dd99:

    # trm "- Зато ты мне - очень!"
    trm "- Ben senden hoşlandım ama - hem de çok!"

# game/magaz.rpy:132
translate turkish magaz_80189b02:

    # nm "После этого он с уверенностью хватает меня за руку - я и рта не успеваю открыть."
    nm "Ben daha ağzımı açmaya fırsat bulamadan arsızca elime yapışıyor."

# game/magaz.rpy:133
translate turkish magaz_b9406d79:

    # trm "- Веди!"
    trm "- Hadi!"

# game/magaz.rpy:146
translate turkish magaz_03d48903:

    # nm "Дорога до магазина прошла нормально, если не считать того, что Треска шел заметно быстрее."
    nm "Treska'nın hızına yetişememem haricinde yolda hiçbir sıkıntı çıkmıyor."

# game/magaz.rpy:147
translate turkish magaz_7f15f214:

    # nm "И наоборот - в какие-то моменты он резко останавливался и начинал идти назад, внимательно глядя себе под ноги."
    nm "Bazen aniden duraksayıp geri geri yürüdüğü, adım attığı her yeri dikkatle incelediği de oluyor tabii."

# game/magaz.rpy:148
translate turkish magaz_eaf9b630:

    # nm "В итоге дорога заняла гораздо больше времени, чем могла бы."
    nm "Nihayetinde kısacık yolda oyalana oyalana markete varıyoruz."

# game/magaz.rpy:154
translate turkish magaz_cf29981f:

    # nm "Оказавшись у дверей магазина, мы видим перед собой вывеску."
    nm "Marketin kapısına geldiğimizde gözümüze bir levha ilişiyor."

# game/magaz.rpy:155
translate turkish magaz_214bc86e:

    # nm "'Магазин закрывается через 20 минут!'"
    nm "'Marketimiz 20 dakika sonra kapanacaktır!'"

# game/magaz.rpy:156
translate turkish magaz_ba5d0e53:

    # ggm "- И взбрело же кому-то в голову таким образом обозначить часы работы своего магазина..."
    ggm "- Çalışma saatlerini bu şekilde duyurmak hangi akıllının fikriydi acaba?"

# game/magaz.rpy:157
translate turkish magaz_3b104fbf:

    # trm "- Наверно, у них для этого специальный человек есть. Каждые пять минут бегает и меняет табличку. Удобно же!"
    trm "- Market çalışanları beş dakikada bir gelip bu levhayı güncelliyor olmalı. Şaşırdın mı yoksa?"

# game/magaz.rpy:158
translate turkish magaz_603668ed:

    # ggm "- Шутишь, что ли?"
    ggm "- Benimle dalga mı geçiyorsun sen?"

# game/magaz.rpy:159
translate turkish magaz_72395cef:

    # trm "- Да!"
    trm "- Evet!"

# game/magaz.rpy:160
translate turkish magaz_b706ff96:

    # ggm "- До чего же ты надоедливый..."
    ggm "- Gıcık velet..."

# game/magaz.rpy:161
translate turkish magaz_4e875e76:

    # trm "- Всяко лучше, чем быть занудой! Тебе, кстати, лет-то сколько?"
    trm "- Eh, sıkıcı olmaktan iyidir! Bu arada, kaç yaşındasın sen?"

# game/magaz.rpy:162
translate turkish magaz_56bd5b0c:

    # ggm "- Не твое дело."
    ggm "- Yaşımdan sana ne?"

# game/magaz.rpy:163
translate turkish magaz_7dc314bf:

    # trm "- А-а-а... а зовут как?"
    trm "- A-a... Peki adını söyler misin?"

# game/magaz.rpy:164
translate turkish magaz_b5ef0b03:

    # ggm "- Не твое дело!"
    ggm "- Sana ne, dedim!"

# game/magaz.rpy:165
translate turkish magaz_4f29a999:

    # nm "Я уже готова была дать мелкому поганцу подзатыльник, как вдруг за стеклом появляется жуткого вида человек. В руках он держит картонную табличку с надписью 'До закрытия магазина 15 минут!'"
    nm "Şımarık bücüre okkalı bir tokat atasım gelmişken kapının arkasında ürkünç bir adam beliriyor, elinde ise 'Marketimiz 15 dakika sonra kapanacaktır!' yazılı bir levha var."

# game/magaz.rpy:166
translate turkish magaz_491606b9:

    # trm "- Пойдем, чего стоишь?"
    trm "- Hadisene, ne duruyorsun?"

# game/magaz.rpy:167
translate turkish magaz_b3e070b9:

    # ggm "- А? Д-да..."
    ggm "- Ha? Ta-tamam..."

# game/magaz.rpy:177
translate turkish magaz_bda9d19f:

    # nm "В очередной раз проходя мимо длинного ряда с консервными банками, мы поняли, что заблудились."
    nm "Upuzun bir konserve gıda reyonundan tekrar tekrar geçtikten sonra kaybolduğumuzu fark ediyoruz."

# game/magaz.rpy:178
translate turkish magaz_fab2588c:

    # ggm "- Поверить не могу, что ты не знаешь, где продается молоко."
    ggm "- Sütlerin yerini bilmediğine inanamıyorum."

# game/magaz.rpy:179
translate turkish magaz_d2bc0976:

    # trm "- Я... эм-м-м..."
    trm "- Ben... ee..."

# game/magaz.rpy:180
translate turkish magaz_fa0c299d:

    # ggm "- Может, спросим кого-нибудь?"
    ggm "- Birilerine mi sorsak?"

# game/magaz.rpy:181
translate turkish magaz_72bfe8b3:

    # trm "- Давай!"
    trm "- Olur!"

# game/magaz.rpy:182
translate turkish magaz_cd2f6b76:

    # ggm "- Эй, постой!.."
    ggm "- Hey, bekle!.."

# game/magaz.rpy:183
translate turkish magaz_449dcf56:

    # nm "Треска отпустил мою руку и уверенно зашагал к одному из немногочисленных посетителей магазина. Тот стоял спиной к нам, что-то сосредоточенно рассматривая на прилавке."
    nm "Treska elimi bırakıp ilk gördüğü müşterinin peşine takılıyor. Adamın sırtı bize dönük, pürdikkat reyondaki ürünleri inceliyor."

# game/magaz.rpy:184
translate turkish magaz_d1671cc2:

    # trm "- Здрасьте, а можно!.."
    trm "- Merhaba, acaba!.."

# game/magaz.rpy:185
translate turkish magaz_7b64269c:

    # nm "Последнюю часть вопроса я не расслышала - как и ответ на него. Но мой непутевый друг внезапно застыл как вкопанный, глядя прямо в глаза посетителя магазина. Я поспешила подойти к ним."
    nm "Ne sorunun devamını, ne de yanıtını duyabiliyorum. Bunun üstüne yaramaz dostum birdenbire adamın gözlerine bakarak donakalıyor. Telaşla yanlarına gidiyorum."

# game/magaz.rpy:191
translate turkish magaz_73ff8128:

    # mm "- Это ваш?"
    mm "- Çocuk sizin mi?"

# game/magaz.rpy:192
translate turkish magaz_fbc1a18a:

    # nm "Посетитель обратился ко мне. В его голосе явно слышалось отвращение, а на лице застыла презрительная гримаса."
    nm "Adam benimle konuşuyor ancak kibiri yüzünden okunuyor ve konuşmasından resmen küstahlık akıyor."

# game/magaz.rpy:203
translate turkish magaz_a3ef7e99:

    # ggm "- Я... эм-м..."
    ggm "- Şey... Ben..."

# game/magaz.rpy:204
translate turkish magaz_2f529462:

    # mm "- Если так, то будьте добры - уберите его подальше."
    mm "- Sizin ise lütfen alın şunu başımdan."

# game/magaz.rpy:205
translate turkish magaz_6277046c:

    # ggm "- Д-да, извините..."
    ggm "- T-tabii, affedersiniz..."

# game/magaz.rpy:206
translate turkish magaz_5ffc47dc:

    # nm "Я хватаю Треску за руку и спешу увести в сторону - тот все глядит на посетителя, открыв рот и выпучив глаза. И дрожит."
    nm "Treska'nın eline yapışıp onu derhal oradan uzaklaştırıyorum. Ağzı açık, gözleri pörtlemiş, tir tir titriyor fakat bir türlü adamdan gözlerini alamıyor."

# game/magaz.rpy:216
translate turkish magaz_5a6e2c0e:

    # nm "Лишь когда мы свернули за угол, Треска успокоился."
    nm "Reyonu terk edip köşeyi döndüğümüzde biraz olsun sakinlemeyi başarıyor."

# game/magaz.rpy:217
translate turkish magaz_c7dd33e3:

    # ggm "- Ну и как это понимать?"
    ggm "- Ne oldu az önce?"

# game/magaz.rpy:218
translate turkish magaz_a38d3841:

    # trm "- Я... я так перепугался!.. Он сказал..."
    trm "- Çok... çok korktum!.. Bana dedi ki..."

# game/magaz.rpy:219
translate turkish magaz_72d73855:

    # ggm "- Что?"
    ggm "- Ne dedi?"

# game/magaz.rpy:220
translate turkish magaz_b9c8f9d0:

    # trm "- НЕТ, ТОЛЬКО НЕ ОПЯТЬ!"
    trm "- YİNE Mİ?! HAYIR!"

# game/magaz.rpy:221
translate turkish magaz_32dc5f00:

    # nm "Внезапно Треска завопил как сумасшедший. Я зажимаю ему рот ладонью; его лицо буквально горит, а сам он плачет."
    nm "Treska birden deli gibi bağırmaya başlıyor. Elimle ağzını kapatıyorum; yüzü resmen yanıyor, gözleri ve yanakları da sırılsıklam olmuş."

# game/magaz.rpy:222
translate turkish magaz_08dc37af:

    # ggm "- Ты можешь вести себя нормально?"
    ggm "- Sakin olur musun?"

# game/magaz.rpy:223
translate turkish magaz_b551f5ad:

    # trm "- Т-ты не понимаешь..."
    trm "- A-ama anlamıyorsun..."

# game/magaz.rpy:224
translate turkish magaz_96ec9ded:

    # ggm "- Ну конечно, что я вообще могу понимать!"
    ggm "- Anlamıyorum tabii, anlayamıyorum!"

# game/magaz.rpy:225
translate turkish magaz_66e633dd:

    # ggm "- Вот только приставать к людям - это неправильно. Этого, видимо, не понимаешь ты."
    ggm "- Yine de başkalarına bu şekilde rahatsızlık vermek çok ayıp bir davranış. Sen de bunu anlamıyorsun."

# game/magaz.rpy:226
translate turkish magaz_a70710db:

    # trm "- Ты злая!.. Хнык.."
    trm "- Çok kabasın!.. Ühü..."

# game/magaz.rpy:227
translate turkish magaz_d45f1565:

    # ggm "- Я?.."
    ggm "- Ben mi?.."

# game/magaz.rpy:233
translate turkish magaz_828f1904:

    # nm "Оттолкнув меня, Треска убежал прочь."
    nm "Treska elimi itip yanımdan kaçıyor."

# game/magaz.rpy:239
translate turkish magaz_ce7396de:

    # ggm "- Блин."
    ggm "- Eşek sıpası."

# game/magaz.rpy:240
translate turkish magaz_0e1cb3a1:

    # nm "Краем глаза я замечаю, как работник магазина вешает на дверь новую табличку."
    nm "Göz ucuyla market çalışanının girişteki levhayı yeniden değiştirdiğine tanık oluyorum."

# game/magaz.rpy:246
translate turkish magaz_15b5e8ae:

    # ggm "- Вот ты где!"
    ggm "- İşte, buldum seni!"

# game/magaz.rpy:247
translate turkish magaz_f896812e:

    # nm "Я встречаю Треску у кассы. До этого я успела сбегать в молочный отдел, предварительно узнав, где он находится."
    nm "Treska'yı kasanın önünde dikilirken buluyorum. Buraya gelmeden önce -yerini sonunda bulabildim- süt reyonuna da uğradım."

# game/magaz.rpy:248
translate turkish magaz_d51b64cb:

    # mm "- Эй, шевелись!"
    mm "- Hadisene evladım!"

# game/magaz.rpy:249
translate turkish magaz_9ee11605:

    # nm "Недовольный голос раздался с конца длинной очереди, что образовалась позади Трески. Я протискиваюсь к нему."
    nm "Treska'nın arkasındaki upuzun kasa sırasından öfkeli bir ses yükseliyor. Kalabalığı yararak ona doğru ilerliyorum."

# game/magaz.rpy:250
translate turkish magaz_d71944d4:

    # ggm "- Что случилось?"
    ggm "- Ne oldu?"

# game/magaz.rpy:251
translate turkish magaz_271d3bbb:

    # nm "Мальчик не отвечает. Смотрит себе под ноги, едва слышно хныкая, а кассир коршуном нависает над ним. Между ними лежит пакет молока."
    nm "Boynu bükük, tek kelime dahi etmeden burnunu çekip duruyor. Kasiyer, Treska'ya dik dik bakıyor; aralarındaki tezgahta ise bir kutu süt var."

# game/magaz.rpy:252
translate turkish magaz_73ff8128_1:

    # mm "- Это ваш?"
    mm "- Çocuk sizin mi?"

# game/magaz.rpy:253
translate turkish magaz_7cf04c09:

    # ggm "- Мой."
    ggm "- Evet."

# game/magaz.rpy:254
translate turkish magaz_630ff660:

    # mm "- В следующий раз оставьте его дома."
    mm "- Bir dahaki sefere onu evde bırakın."

# game/magaz.rpy:255
translate turkish magaz_cc8f5d69:

    # nm "Люди в очереди согласно кивают."
    nm "Sıradakiler hep birlikte onaylarcasına kafa sallıyor."

# game/magaz.rpy:256
translate turkish magaz_4c8b218b:

    # mm "- Оплатите стоимость товара."
    mm "- Ödemenizi alayım."

# game/magaz.rpy:257
translate turkish magaz_6bad1905:

    # ggm "- Да, конечно..."
    ggm "- Tabii..."

# game/magaz.rpy:258
translate turkish magaz_04ace94f:

    # mm "- И издержку за ожидание!"
    mm "- Bekleme ücretini de alayım!"

# game/magaz.rpy:259
translate turkish magaz_1676dc10:

    # ggm "- Ч-что?"
    ggm "- N-ne?"

# game/magaz.rpy:260
translate turkish magaz_7be05a24:

    # mm "- Вы слышали."
    mm "- Dediğimi duydunuz."

# game/magaz.rpy:261
translate turkish magaz_9428ac7b:

    # ggm "- Я-то слышала, но это же неслыханно!"
    ggm "- Duydum duymasına da öyle şey mi olurmuş?!"

# game/magaz.rpy:266
translate turkish magaz_4daaff38:

    # nm "Вдруг Треска начинает хихикать."
    nm "Treska birden kikirdemeye başlıyor."

# game/magaz.rpy:267
translate turkish magaz_84a35435:

    # mm "- И за то, что ваш сын придурок, тоже заплатите!"
    mm "- Oğlunuzun geri zekalı oluşunun bedelini de ödemeyi unutmayın!"

# game/magaz.rpy:268
translate turkish magaz_d3f5b609:

    # ggm "- Н-но..."
    ggm "- A-ama..."

# game/magaz.rpy:269
translate turkish magaz_7be05a24_1:

    # mm "- Вы слышали."
    mm "- 'Ama'sı yok."

# game/magaz.rpy:270
translate turkish magaz_fe838a88:

    # ggm "- Знаете, что?!.."
    ggm "- Baksana sen!.."

# game/magaz.rpy:271
translate turkish magaz_ed507361:

    # nm "В гневе я бросаю кассиру смятую купюру гораздо большего номинала, чем требовалось - даже с учетом всех идиотских надбавок - хватаю пакет молока и круто разворачиваюсь."
    nm "Saydığı bütün o anlamsız ücretleri de hesaba katarak, elimle buruşturduğum banknotu hışımla kasiyere fırlatıyorum. Süt kutusunu da alıp Treska'ya dönüyorum."

# game/magaz.rpy:272
translate turkish magaz_8433e4f1:

    # ggm "- Мы уходим, Треска!"
    ggm "- Gidiyoruz Treska!"

# game/magaz.rpy:278
translate turkish magaz_07f73956:

    # nm "Всю дорогу из магазина мы шли молча. В какой-то момент мы незаметно для себя свернули вправо и оказались у автозаправки - тогда-то Треска и решил нарушить молчание."
    nm "Dönüşte ikimizden de çıt çıkmıyor. Bir süre yürüdükten sonra tesadüf eseri bir benzin istasyonunun oradan geçiyoruz. İşte o noktada Treska, sessizliğini bozuyor."

# game/magaz.rpy:279
translate turkish magaz_11b4592c:

    # trm "- Любишь мороженое?"
    trm "- Dondurma sever misin?"

# game/magaz.rpy:280
translate turkish magaz_4cd3ac67:

    # ggm "- Нет."
    ggm "- Hayır."

# game/magaz.rpy:281
translate turkish magaz_ef883331:

    # trm "- Ладно..."
    trm "- Peki..."

# game/magaz.rpy:282
translate turkish magaz_0a0e5a9c:

    # nm "Я смотрю в поникшее лицо мальчика - на секунду в его глазах блеснул огонек и тут же погас."
    nm "Treska'nın gözlerine baktığımda anlık bir kıvılcımın parlayıp söndüğünü görüyorum."

# game/magaz.rpy:283
translate turkish magaz_8734db3e:

    # trm "- Знаешь..."
    trm "- Farkında mısın?.."

# game/magaz.rpy:284
translate turkish magaz_f6ae2c25:

    # nm "Он уверенно сворачивает с тропы прямо на автомобильную дорогу. Я провожаю его недоуменным взглядом."
    nm "Yanımdan ayrılıp cesurca ana yola doğru ilerlemeye başlıyor. Şaşkınlıkla arkasından bakakalıyorum."

# game/magaz.rpy:296
translate turkish magaz_1f80669a:

    # trm "- Похоже, ты мне совсем не помогаешь."
    trm "- Bana hiç yardımcı olmuyorsun."

# game/magaz.rpy:297
translate turkish magaz_783d379e:

    # nm "В глазах Трески вновь блестит озорной огонек..."
    nm "Treska'nın gözleri, afacan bir kıvılcımla yeniden parlıyor..."

