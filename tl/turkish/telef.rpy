# game/telef.rpy:207
translate turkish telef_bb5e0514:

    # tel "- Я должна решить, и мои мысли помогут мне."
    tel "- Karar vermeliyim; düşüncelerim bana bu konuda köstek değil, destek olacak."

# game/telef.rpy:210
translate turkish telef_579630b4:

    # tel "- Они направят к выходу... и тогда я смогу собой гордиться."
