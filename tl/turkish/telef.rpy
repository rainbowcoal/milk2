# game/telef.rpy:36
translate turkish telef_0fb4b444:

    # piz "- Добрый день, спасибо, что выбрали нашу пиццерию!"
    piz "Merhaba, bizi ve pizzalarımızı tercih ettiğiniz için teşekkür ederiz!"

# game/telef.rpy:38
translate turkish telef_ad65ab06:

    # tel "- Знаете, здесь так пусто... Впрочем, мне от этого ни хорошо, ни плохо."
    tel "- Burası bomboş bir yer... Ancak bu beni ne iyi, ne de kötü hissettiriyor."

# game/telef.rpy:41
translate turkish telef_9641db4c:

    # tel "- Я совсем одна, и в то же время вроде бы нет - в голове много мыслей, с которыми уж точно не соскучишься."
    tel "- Yapayalnızım ama bir yandan da değilmişim gibi hissediyorum. Kafam düşüncelerle dolu, beni sürekli meşgul tutuyorlar."

# game/telef.rpy:44
translate turkish telef_3fa36954:

    # tel "- С ними можно создать целый мир. Уверена, если очень постараться, он заполнит всю пустоту вокруг!"
    tel "- Onlardan bambaşka bir dünya yaratabilirim. Yeterince çabalarsam beni saran bu boşluğu doldurabilirim!"

# game/telef.rpy:47
translate turkish telef_08a33cd2:

    # tel "- Хотя..."
    tel "- Gerçi..."

# game/telef.rpy:50
translate turkish telef_8e730ebd:

    # tel "- Сколько бы я ни думала, окружение не менялось. Да, что-то происходило в моей голове, но по-прежнему оставалось в ее пределах."
    tel "- Ne kadar düşünürsem düşüneyim, bu boşluk hiç dolmuyor. Evet, zihnimde bir şeyler oluyor ama sadece orada olduğuyla kalıyor."

# game/telef.rpy:53
translate turkish telef_1e072587:

    # tel "- Не то чтобы я как-то сдерживала это... Может, оно само боялось выходить?"
    tel "- Onları bastırmaya da uğraşmadım aslında hiç ama... Belki de dışarıya çıkmaya korkuyorlardır, he?"

# game/telef.rpy:60
translate turkish telef_cbfe431f:

    # piz "- Какую пиццу вы хотели бы заказать?"
    piz "- Siparişinizi alabilir miyim?"

# game/telef.rpy:62
translate turkish telef_93e9366a:

    # tel "- Так вот! В любом случае, в моей голове не так много места, где можно было бы развернуться."
    tel "- Her neyse! Zihnim, düşüncelerimin rahatlıkla gezebileceği kadar geniş değil."

# game/telef.rpy:65
translate turkish telef_6b32b2a4:

    # tel "- Так что каждая мысль наворачивала бессмысленный и беспощадный круг, безнадежно возвращаясь в начало."
    tel "- Bu yüzden her düşüncem anlamsızca ve merhametsizce zihnimde tur atıyor, dönüp dolaşıp başa sarıyor."

# game/telef.rpy:68
translate turkish telef_50d3a2e6:

    # tel "- А ведь когда-то должен быть конец. Нельзя блуждать так вечно. Как вы считаете?"
    tel "- Ama bunun bir sonu olmalı. Sonsuza dek öylece dolaşamazsınız ki. Ne bekliyordunuz?"

# game/telef.rpy:71
translate turkish telef_dc7ad40c:

    # tel "- Конечно, звучит это очень страшно, но не страшнее постоянного существования в пустоте."
    tel "- Biliyorum, kulağa korkutucu geliyor ancak sürekli bir boşluğun içerisinde yaşamak, bundan daha korkunç."

# game/telef.rpy:74
translate turkish telef_6ff2f2e7:

    # tel "- Здесь определенно безопасно, и не случится ничего плохого. Как и хорошего, впрочем."
    tel "- Burası tekin bir yer, burada asla kötü şeyler olmaz. İyi şeyler de olmaz gerçi."

# game/telef.rpy:82
translate turkish telef_81b16851:

    # piz "- Обратите внимание, что у нас проходит акция - три пиццы по цене двух!"
    piz "- Sınırlı bir süre için geçerli 'üç al, iki öde' kampanyamızdan yararlanabilirsiniz!"

# game/telef.rpy:84
translate turkish telef_a7ed4e99:

    # tel "- Да... Наверное, ничего хорошего в одних и тех же мыслях нет. Да и какой в них смысл вообще?"
    tel "- Evet... Tekrar tekrar aynı şeyleri düşünmenin bir faydası yok. Ne diye kafamı yoruyorum ki?"

# game/telef.rpy:87
translate turkish telef_2257250d:

    # tel "- Я могла бы сбежать отсюда, но, кажется, мои же мысли мне совсем не помогают."
    tel "- Buradan kaçıp kurtulabilirdim ama düşüncelerim bana destek değil, köstek oluyor sanki."

# game/telef.rpy:90
translate turkish telef_656cea78:

    # tel "- Им должно быть стыдно... Наверное."
    tel "- Yazıklar olsun..."

# game/telef.rpy:93
translate turkish telef_6796371b:

    # tel "- Никто не виноват, что здесь даже двери не видно. С ней было бы гораздо проще!"
    tel "- Bir çıkar yol bulamamam kimsenin suçu değil. Bulabilsem hayat ne güzel olurdu!"

# game/telef.rpy:96
translate turkish telef_2379eeca:

    # tel "- Я пыталась её найти - и это пустая трата времени."
    tel "- Aramadım da değil ama tamamen zaman kaybından ibaretti."

# game/telef.rpy:99
translate turkish telef_d2a7bb09:

    # tel "- Сколько ни ходи, ничего не находится (ой, игра слов!), и это лишает меня всякой надежды на спасение."
    tel "- Neresinden tutsam elimde kalıyor (aha, kelime oyunu!) ve bu durum, kurtuluşa beslediğim son umut kırıntılarını da silip süpürüyor."

# game/telef.rpy:106
translate turkish telef_dfb41c51:

    # piz "- Также у нас есть система скидок для новых клиентов. Подробней можно узнать в личном кабинете!"
    piz "- Yeni müşterilerimiz için ilk siparişte geçerli kampanyaları hesabınızdan görüntüleyebilirsiniz!"

# game/telef.rpy:108
translate turkish telef_ca637c50:

    # tel "- Вам не кажется, что моё пребывание здесь - это пустая трата времени? Какой в этом смысл?"
    tel "- Burada bulunmam da zaman kaybı değil mi sence? Ne anlamı var ki?"

# game/telef.rpy:111
translate turkish telef_57a0318a:

    # tel "- Я могу просто думать. И то, мои мысли такие же бессмысленные и пустые, как всё вокруг."
    tel "- Sürekli düşünüp dursam bile düşüncelerim, etrafımdaki her şey kadar anlamsız ve boş."

# game/telef.rpy:114
translate turkish telef_a0f1d467:

    # tel "- Значит ли это, что я не заполняю пустоту, а просто являюсь её частью?"
    tel "- Bu, boşluğu doldurmadığım, sadece onun bir parçası olduğum anlamına gelmez mi?"

# game/telef.rpy:117
translate turkish telef_4afd3358:

    # tel "- Зачем мне тогда чувствовать себя? Знать, что я существую?"
    tel "- Öyleyse hisler beslemenin, yaşadığımı bilmenin maksadı ne?"

# game/telef.rpy:120
translate turkish telef_8d654971:

    # tel "- Впрочем, я даже не уверена насчёт этого."
    tel "- Gerçi bundan pek emin değilim."

# game/telef.rpy:123
translate turkish telef_e0d77aa7:

    # tel "- В этом месте всегда ни холодно, ни горячо. Вообще никак."
    tel "- Burası yılın dört mevsimi ne sıcak, ne de soğuk olur."

# game/telef.rpy:126
translate turkish telef_12086626:

    # tel "- И в то же время, если подумать о тепле, я согреваюсь."
    tel "- Ancak sıcağı düşünmek içimi ısıtır mesela."

# game/telef.rpy:129
translate turkish telef_94d3c3d2:

    # tel "- Может, этот мир полностью зависит от моих мыслей?"
    tel "- Belki de bu dünyada olup biten her şey, düşüncelerimin bir yansımasıdır!?"

# game/telef.rpy:132
translate turkish telef_f6724c1b:

    # tel "- Не хотелось бы признавать, что я полностью пуста."
    tel "- Öyleyse bomboş biri olduğumu bilmek gücüme gider."

# game/telef.rpy:135
translate turkish telef_3050aa69:

    # tel "- Ведь все исчезло не по моей вине? Да?"
    tel "- Her şeyin yok olmasının sorumlusu ben olamam herhalde, değil mi?!"

# game/telef.rpy:138
translate turkish telef_79831019:

    # tel "- Разве я не могу просто приспособиться и привыкнуть к ничему вокруг, раз ничего не могу с этим сделать?"
    tel "- Bu konuda elimden bir şey gelmediğine göre burada yaşamayı denesem, tüm bunlara ayak uydurabilir miyim acaba?"

# game/telef.rpy:145
translate turkish telef_f2990826:

    # piz "- Вы уже готовы сделать заказ?"
    piz "- Siparişinize karar verdiniz mi?"

# game/telef.rpy:147
translate turkish telef_eb595c33:

    # tel "- Да. Правильно."
    tel "- Evet. Karar verdim."

# game/telef.rpy:150
translate turkish telef_6974591b:

