# game/telef.rpy:201
translate turkish telef_a3134265:

    # tel "- Хотя и мне тут никогда не будет хорошо."
    tel "-  Pek geniş olmadığı ve burada asla iyi hissedemeyeceğim gerçeğini göz ardı edemiyorum."

# game/telef.rpy:204
translate turkish telef_c080a9e5:

    # tel "- Значит, моё пребывание здесь - пустая трата времени?"
