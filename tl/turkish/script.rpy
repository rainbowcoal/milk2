    # gg "- По-моему, ничего странного."
    gg "- Tabii bunu garipsemiyorum."

# game/script.rpy:1239
translate turkish balcony_727b343d:

#тут должен быть вопрос "как ты себя чувствуешь?"

    # gg "- Я определенно себя чувствую. Иногда большего и не надо."
    gg "- İçimde tarifi olmayan bir his var. Bazen bunun varlığı bile yetiyor insana."

translate turkish strings:
    # game/script.rpy:1240
    old "(И все же, тебе тревожно. Я прав?)"
    new "(Yine de hâlâ endişelisin, değil mi?)"
    
# game/script.rpy:1242
translate turkish balcony_e6eb9e25:

    # gg "- Разумеется. Более того - я в абсолютном ужасе. Но разве это так заметно?"
    gg "- Ne yazık ki, hatta ve hatta dehşet içerisindeyim. O kadar belli ediyor muyum?"

translate turkish strings:
    # game/script.rpy:1243
    old "(Ты смотришь куда угодно, но не вверх.)"
    new "(Yukarıya bakmamak için elinden geleni yapıyorsun da...)"
# game/script.rpy:1245
translate turkish balcony_9d2cceaf:

    # gg "- Ах, это..."
    gg "- Ah, o mu?.."

# game/script.rpy:1246
translate turkish balcony_344ec585:

    # gg "- Я ведь тебе рассказывала, верно?"
    gg "- Sana ondan bahsettiğimi hatırlıyorum."

translate turkish strings:
    # game/script.rpy:1247
    old "(О чем?)"
    new "(O da ne?)"
# game/script.rpy:1249
translate turkish balcony_5d9aea77:

    # gg "- Да так, пустяки."
    gg "- Ufak tefek bir şey işte."

translate turkish strings:
    # game/script.rpy:1250
    old "(Разве могут пустяки вызывать ужас?)"
    new "(Ufak tefek bir şey seni niye bu kadar korkutuyor?)"
# game/script.rpy:1252
translate turkish balcony_b32a0bf7:

    # gg "- Это... сложно описать."
    gg "- Bunu açıklaması biraz... güç."

# game/script.rpy:1253
translate turkish balcony_ef0fd9d5:

    # "Я взбираюсь на металлические перила и свешиваю ноги вниз."
    "Demir korkuluklara tırmanıp bacaklarımı aşağı sarkıtıyorum."

# game/script.rpy:1254
translate turkish balcony_3e7b79d9:

    # "Один за другим бросаю в бездну короткие взгляды - та отвечает мне рассерженным ледяным дыханием."
    "Dipsizliğe ara ara ürkek bakışlar atıyorum, o da bana hırçın ve buz gibi nefesiyle karşılık veriyor."

# game/script.rpy:1255
translate turkish balcony_067566ed:

    # "Так мы и общаемся. Будто старинные друзья."
    "Biz de böyle anlaşıyoruz işte, tıpkı iki eski dost gibi."

# game/script.rpy:1256
translate turkish balcony_ef030281:

    # gg "- Иногда мне кажется, что весь мир притворяется ненормальным."
    gg "- Bazen tüm dünya deli taklidi yapıyormuş gibi geliyor."

# game/script.rpy:1257
translate turkish balcony_b10fcdd5:

    # gg "- Он будто бы хочет убедить меня в чем-то, чего на самом деле нет."
    gg "- Sanki beni var olmayan bir şeyin varlığına ikna etmeye çabalarcasına..."

translate turkish strings:
    # game/script.rpy:1258
    old "(Странно, не находишь?)"
    new "(Çok garip, değil mi?)"
# game/script.rpy:1260
translate turkish balcony_dc3a6a30:

    # gg "- Да, но..."
    gg "- Evet ama..."

# game/script.rpy:1261
translate turkish balcony_6f79190d:

    # gg "- В то же время... Я даже немного рада этому."
    gg "- Bir yandan da... bundan kısmen memnuniyet duyduğumu söyleyebilirim."

# game/script.rpy:1262
translate turkish balcony_d144836c:

    # gg "- Все вокруг создано лишь для меня. Создано обманывать, запутывать, сбивать с толку..."
    gg "- Etrafımdaki her şey benim için yaratılmış gibi; beni kandırmak, yanıltmak, şaşırtmak için..."

# game/script.rpy:1263
translate turkish balcony_55810e11:

    # gg "- Если это правда, выходит, не такая уж я и сумасшедшая?"
    gg "- Eğer öyleyse bu, deli olmadığım anlamına gelmez mi?"

translate turkish strings:
    # game/script.rpy:1264
    old "(Считать это правдой и есть сумасшествие.)"
    new "(Buna inanıyor olman deliliğin ta kendisi.)"
# game/script.rpy:1266
translate turkish balcony_7744fdf5:

    # gg "- Наверное."
    gg "- Sanırım haklısın."

# game/script.rpy:1267
translate turkish balcony_a20cefa7:

    # "..."
    "..."

# game/script.rpy:1268
translate turkish balcony_48687508:

    # "Очередной ураган проносится по стенкам котла, разбивая в пыль стекла и сметая бетонный налет. Меня он лишь нежно гладит, взъерошивая волосы."
    "Ani bir rüzgar, içinde bulunduğum kazanın duvarlarını dövüyor, camları tuzla buz edip beton kırıntılarını savuruyor. Ben ise sadece saçlarımı dalgalandıran hafif bir esinti hissediyorum."

# game/script.rpy:1276
translate turkish fall_db020311:

    # gg "- Я так и не придумала кодовое слово..."
    gg "- Hâlâ bir anahtar sözcük bulamadım..."

translate turkish strings:
    # game/script.rpy:1277
    old "(Ты ведь и сама вспомнила о своем обещании. Значит, кодовое слово уже не нужно.)"
    new "(Ama söz verdin, artık anahtar sözcüğe falan ihtiyacımız yok.)"
# game/script.rpy:1279
translate turkish fall_c721f2ec:

    # gg "- Не люблю, когда так происходит. Хочу вспоминать о некоторых вещах только тогда, когда хочется."
    gg "- Bazı şeyleri istediğim zaman hatırlayabilsem keşke. Hatırlayamamak sinir bozucu."

translate turkish strings:
    # game/script.rpy:1280
    old "(Тем не менее, ты обещала.)"
    new "(Yine de bir söz verdin.)"
# game/script.rpy:1282
translate turkish fall_4ae32b2e:

    # gg "- Я сдержу обещание. Просто имей в виду, что с этой секунды каждое слово будет приносить мне боль."
    gg "- Ve sözümü tutacağım - ancak şunu bil, şu vakitten sonra ağzımdan çıkan her bir sözcük bana zulüm olacak."

# game/script.rpy:1283
translate turkish fall_8ba04f43:

    # "Я наклоняюсь вниз и мысленно падаю в пропасть. Ровно две минуты до того, как я разобьюсь."
    "Aşağı sarkıp dipsiz boşluğa düştüğümü hayal ediyorum. Huzura kavuşmak için tam iki dakikam var."

# game/script.rpy:1314
translate turkish fall_6e7ffcd9:

    # gg "- У меня был друг в сети. Лучший друг! Даже несмотря на то, что его набор букв вместо имени был не самым клевым."
    gg "- İnternette bir arkadaşım vardı. Gerçek ismi yerine kullandığı harf kombinasyonu kulağa pek hoş gelmese de kendisi benim en iyi arkadaşımdı!"

# game/script.rpy:1315
translate turkish fall_04ef6841:

    # gg "- Да и набор пикселей вместо фотографии был скучным и непривлекательным..."
    gg "- Kendi fotoğrafı yerine kullandığı piksel kombinasyonu da banal ve çirkindi ayrıca."

# game/script.rpy:1316
translate turkish fall_05fead8a:

    # gg "- Это ведь странно и неправильно - нарушать правила нахождения в сети. Зачем он это делал?"
    gg "- İnternet aleminin kurallarını çiğnemek bence çok garip ve yanlış. Niye böyle yapıyordu acaba?"

# game/script.rpy:1317
translate turkish fall_4bcbf580:

    # gg "- Может, в его коде не хватало нескольких строк?"
    gg "- Belki de kodu birkaç satır eksikti, kim bilir?"

translate turkish strings:
    # game/script.rpy:1318
    old "(Я не совсем понимаю, о чем ты.)"
    new "(Demek istediğini pek anlayamadım.)"
    
# game/script.rpy:1320
translate turkish fall_f66a60bd:

    # gg "- Я бы могла рассказать тебе об этих правилах."
    gg "- Sana kurallardan bahsedebilirdim."

# game/script.rpy:1321
translate turkish fall_16920eb1:

    # gg "- Их невозможно нигде отыскать, но я-то умная и сама во всем разобралась!"
    gg "- Normalde hiçbir yerde yazmaz ama ben zeki olduğum için bir şekilde çözdüm!"

# game/script.rpy:1322
translate turkish fall_6dddc581:

    # gg "- Однако же..."
    gg "- Ancak..."

# game/script.rpy:1323
translate turkish fall_02dee236:

    # gg "- Я не уверена, стоит ли их озвучивать."
    gg "- Bildiklerimi paylaşmalı mıyım, emin değilim."

# game/script.rpy:1326
translate turkish fall_f86b348e:

    # gg "- Когда я пытаюсь произнести вслух то, что на уме - запросто могу где-то ошибиться."
    gg "- Düşüncelerimi söze aktarırken kolaylıkla hata yapabiliyorum."

# game/script.rpy:1327
translate turkish fall_e14d8490:

    # gg "- Одна ошибка - и все сказанное дальше полностью противоречит моим мыслям."
    gg "- Tek bir hata yapayım, sonrasında da kendimle çelişmeye devam ediyorum."

# game/script.rpy:1328
translate turkish fall_dbf33c3d:

    # gg "- И в итоге я сама себя разубеждаю."
    gg "- Ve bunu fark ettiğim an pes ediyorum."

# game/script.rpy:1329
translate turkish fall_d0ee67f8:

    # gg "- А я этого не хочу!"
    gg "- Ama böyle olmasını istemiyorum!"

translate turkish strings:
    # game/script.rpy:1330
    old "(По твоей логике лучше вообще никогда рта не открывать.)"
    new "(Ona bakarsan böyle olmaması için çeneni ebediyen kapalı tutman gerekir.)"
    
# game/script.rpy:1332
translate turkish fall_90c701a6:

    # gg "- Конечно! Это моя мечта!"
    gg "- Evet! Benim de hayalim o zaten!"

# game/script.rpy:1333
translate turkish fall_ef2b79ea:

    # gg "- Не открывать рта, не вставать с кровати, ничего не видеть и не слышать..."
    gg "- Çenemi kapamak, yatağımdan hiç çıkmamak, hiçbir şeyi görmemek, duymamak..."

# game/script.rpy:1334
translate turkish fall_d5bd69aa:

    # gg "- Лишь сны, сны... ах, ну почему все так ужасно?"
    gg "- Hayal aleminde gezmek... ah, hayat neden bu kadar berbat?"

translate turkish strings:
    # game/script.rpy:1335
    old "(Не отвлекайся. Так что же твой друг?)"
    new "(Dikkatini topla - arkadaşından bahsediyordun hani.)"
    
# game/script.rpy:1337
translate turkish fall_068b19d2:

    # gg "- Друг?"
    gg "- Arkadaşım?"

# game/script.rpy:1338
translate turkish fall_de9236f7:

    # gg "- Ах, да..."
    gg "- Ah, doğru..."

# game/script.rpy:1339
translate turkish fall_eb3b671b:

    # gg "- Он... и хватило же наглости!.."
    gg "- Kendisi... o kadar yüzsüzdü ki!.."

translate turkish strings:
    # game/script.rpy:1340
    old "(Ну же, собери мысли в кучу.)"
    new "(Dikkatini topla, hadi.)"
# game/script.rpy:1342
translate turkish fall_3e166794:

    # gg "- Он каким-то образом заставил меня поверить, будто он настоящий."
    gg "- Nasıl başardıysa beni gerçek olduğuna inandırdı."

# game/script.rpy:1343
translate turkish fall_9b6a13df:

    # gg "- Расписывал мне чью-то жизнь в мельчайших подробностях, выдавая за свою."
    gg "- Başkalarının hayatını sanki kendininmiş gibi en ince detayına kadar anlattı bana."

# game/script.rpy:1344
translate turkish fall_b2950fc7:

    # gg "- И, разумеется, ждал того же и от меня."
    gg "- Benden de aynısını yapmamı istedi."

# game/script.rpy:1345
translate turkish fall_67ffc7a0:

    # gg "- Ну я и рассказала ему все-все о себе. Ничего не утаила."
    gg "- Tabii ben de bütün dürüstlüğümle ona kendimden, her şeyimden bahsettim."

# game/script.rpy:1346
translate turkish fall_d72da0b3:

    # "Я крепко стискиваю зубы. Ветер нещадно хлещет по лицу, разрезает кожу на неровные полосы, словно тонкую ткань."
    "Dişlerimi gıcırdatıyorum. Rüzgar yüzümü acımasızca tartaklıyor ve tenimi tıpkı ince bir kumaş parçası gibi biçimsizce kesiyor."

# game/script.rpy:1347
translate turkish fall_c046a810:

    # gg "- Он знал обо мне больше, чем кто-либо в мире."
    gg "- Şu dünyada beni ondan daha iyi tanıyan biri yoktu."

# game/script.rpy:1348
translate turkish fall_3e696f84:

    # gg "- И знаешь, что он сделал?"
    gg "- Peki sonra ne yaptı, biliyor musun?" #THIS SENTENCE SHOULD BE TRANSLATED SO IT COULD BE ANSWERED WITH SIMPLY "YES" OR "NO"

# game/script.rpy:1351
translate turkish fall_8ebb7d3e:

    # gg "- Ха-ха..."
    gg "- Ahaha..."

# game/script.rpy:1352
translate turkish fall_89d47646:

    # gg "- Натравить на меня сотни ботов, должно быть, очень весело."
    gg "- Beni taciz etmek için hesabıma bot atmak eğlendirmiş olmalı."

# game/script.rpy:1353
translate turkish fall_b1494d20:

    # gg "- А главное, все от этого только выигрывают."
    gg "- Ve işin daha ilginci, bu hepimizin işine yaradı."

# game/script.rpy:1354
translate turkish fall_293f6639:

    # gg "- Они появляются тут и там. Довольно простой код, не требующих особых усилий для выполнения - неудивительно, что алгоритм присуждает эту модель поведения с большей вероятностью, чем прочие из списка."
    gg "- Sıfır eforla çalışan basit kod kırıntıları, onları her yerde görmek mümkün. Algoritmanın listedeki diğer kalıplardan çok bunu seçmesi hiç şaşırtıcı değil."

# game/script.rpy:1355
translate turkish fall_a2d7e645:

    # gg "- Генераторы текстов и видеороликов тут же принимаются за работу. Мое имя всплывает в сети все чаще и чаще."
    gg "- Yapay zekayla çalışan algoritmik metin ve video oluşturucular yüzünden adım, gitgide daha fazla insanın karşısına çıkmaya başladı."

# game/script.rpy:1356
translate turkish fall_40939d2a:

    # gg "- Это невыносимо."
    gg "- Can sıkıcı bir olay."

# game/script.rpy:1357
translate turkish fall_706a6e0e:

    # gg "- Невыносимо."
    gg "- Çok can sıkıcı."

# game/script.rpy:1358
translate turkish fall_97c3fe1a:

    # gg "- Из-за каждого угла, с балконов, крыш, подвалов, стен, потолков я всегда ощущаю пристальные взгляды множества глаз."
    gg "- Her köşeden, her balkondan, tavandan, çatıdan, duvardan... Meraklı gözlerin her daim üzerimde olduğunun zaten farkındayım."

# game/script.rpy:1359
translate turkish fall_114f66a0:

    # gg "- А теперь - и с экранов."
    gg "- Bu yetmezmiş gibi şimdi de beni ekranlarından gözetlemeye devam ediyorlar."

# game/script.rpy:1360
translate turkish fall_a1594cd8:

    # gg "- Но я положу этому конец. Я давно решила."
    gg "- Ama buna bir son vereceğim. Kararımı çoktan verdim."

# game/script.rpy:1361
translate turkish fall_63878067:

    # gg "- Хотя... Возможно, я решила сделать это только..."
    gg "- Hatta... bunu tam da şimdi..."

# game/script.rpy:1369
translate turkish fall_7ccfd918:

    # "Мое тело наконец обрушивается на землю, разлетаясь, словно фарфор, на миллионы мелких частиц."
    "Vücudum yere çakılıp porselen bir tabak gibi milyonlarca ufak parçaya ayrılıyor."

# game/script.rpy:1371
translate turkish fall_b96349c6:

    # "Уже вторая смерть за сегодня."
    "Bugün ikinciye ölüyorum artık."

# game/script.rpy:1375
translate turkish nofall_decc57b3:

    # gg "- Мне холодно, пойдем внутрь."
    gg "- Üşüdüm, hadi içeri geçelim."

# game/script.rpy:1395
translate turkish nofall_e7bfe7ca:

    # "Я вернулась в комнату. К счастью, она совсем не изменилась за те минуты, что я была за её пределами."
    "Tekrar odamdayım. Neyse ki ben balkondayken hiçbir şey yerinden kıpırdamamış."

# game/script.rpy:1397
translate turkish nofall_4e43e68b:

    # "Ни секунды не думая, я подхожу к ноутбуку и с силой выдергиваю кабель из розетки."
    "Hemen bilgisayarımın yanına gidip tereddüt etmeden fişini çekiyorum."

# game/script.rpy:1401
translate turkish nofall_37875b61:

    # gg "- Вот и все."
    gg "- İşte bu kadar."

# game/script.rpy:1402
translate turkish nofall_5675f48a:

    # "Вот и все."
    "Bu kadar."
    
translate turkish strings:
    # game/script.rpy:1403
    old "(Вот и все.)"
    new "(Bu kadar.)"
    
    # game/script.rpy:1411
    old "(Что будешь делать?)"
    new "(Şimdi ne yapacaksın?)"
    
# game/script.rpy:1416
translate turkish room_8139d3e3:

    # gg "- Что за глупый вопрос?"
    gg "- Sence ne yapabilirim?"

# game/script.rpy:1417
translate turkish room_9920cc55:

    # gg "- Спать, конечно же."
    gg "- Tabii ki de uyuyacağım."

# game/script.rpy:1420
translate turkish room_269ca6e8:

    # gg "- Надеяться, что завтра наступит через год или десять."
    gg "- Umarım yarını görmek, senelerce nasip olmaz."

# game/script.rpy:1423
translate turkish room_48115f70:

    # gg "- Представлять, будто я где-то вне своей оболочки, и при этом я - это все еще я. Немыслимо, как молоко вне пакета. И все же..."
    gg "- Benliğimi koruyup aynı zamanda kendimi fani bedenimin ötesinde hayal ederek uyumak...  çok garip - tıpkı süt kutusunun dışındaki süt gibi. Yine de..."

translate turkish strings:
    # game/script.rpy:1424
    old "(И все же?..)"
    new "(Yine de?..)"
    
# game/script.rpy:1428
translate turkish room_46fc17ca:

    # gg "- Необязательно говорить вслух, чтобы я понимала, что ты переживаешь за меня."
    gg "- Beni düşündüğünü belli etmek için sesli konuşmak zorunda değilsin."

# game/script.rpy:1429
translate turkish room_b0c4f51c:

    # gg "- Ведь я и так это знаю."
    gg "- Onun zaten farkındayım."

# game/script.rpy:1432
translate turkish room_e90031c5:

    # gg "- Также я знаю, что у нас осталось совсем немного времени."
    gg "- Bu arada çok az vaktimiz kaldığının da farkındayım."

translate turkish strings:
    # game/script.rpy:1433
    old "(Ты не станешь пить еще одну таблетку.)"
    new "(Bugünlük başka ilaç içme, olur mu?)"
    
# game/script.rpy:1437
translate turkish room_7de67075:

    # gg "- Разумеется. Более того, я не стану пить ее и завтра."
    gg "- İçmeyeceğim zaten, hatta yarın da içmeyeceğim."

# game/script.rpy:1440
translate turkish room_593f021e:

    # gg "- И послезавтра."
    gg "- Öbür gün de..."

# game/script.rpy:1443
translate turkish room_1530f895:

    # gg "- И вообще никогда."
    gg "- Bir daha asla."

translate turkish strings:
    # game/script.rpy:1444
    old "(Прощаемся, выходит?)"
    new "(Vedalaşıyor muyuz o zaman?)"
    
# game/script.rpy:1448
translate turkish room_d2c4cf06:

    # gg "- ..."
    gg "- ..."

# game/script.rpy:1451
translate turkish room_0080ca73:

    # gg "- Нет..."
    gg "- Hayır..."

# game/script.rpy:1452
translate turkish room_bfc80253:

    # gg "- У меня будет еще одна просьба... совсем крохотная."
    gg "- Senden son bir iyilik isteyeceğim... küçücük, minnacık bir iyilik."

translate turkish strings:
    # game/script.rpy:1453
    old "(Какая же?)"
    new "(Neymiş o?)"
    
# game/script.rpy:1457
translate turkish room_34c59097:

    # gg "- Я сегодня слишком много наговорила. Многое хотелось бы навсегда забыть."
    gg "- Bugün sana çok şey anlattım ve anlattıklarımın arasından sonsuza dek unutmak istediğim birçok şey oldu."

# game/script.rpy:1460
translate turkish room_e3d97ead:

    # gg "- Я не виню тебя, просто... Было ли это так необходимо?"
    gg "- Tabii ki seni suçlamıyorum ama... Tüm bunlara cidden gerek var mıydı?"

translate turkish strings:
    # game/script.rpy:1461
    old "(Вот завтра и узнаешь.)"
    new "(Yarın görürsün.)"

# game/script.rpy:1465
translate turkish room_e685f7a8:

    # gg "- Нет, я так не усну."
    gg "- Hayır, yoksa uyku tutmaz."

translate turkish strings:
    # game/script.rpy:1466
    old "(Хорошо, так что за просьба?)"
    new "(Pekala, ne iyilik isteyeceksin?)"
    
# game/script.rpy:1470
translate turkish room_61f95837:

    # gg "- Я... м-м..."
    gg "- Ben, şey..."

# game/script.rpy:1473
translate turkish room_68dca3ff:

    # "Я нервно чешу запястья и прикусываю губу."
    "Sıkkınlıkla bileklerimi kaşıyor ve alt dudağımı ısırıyorum."

translate turkish strings:
    # game/script.rpy:1474
    old "(Постой, ты что... боишься мне сказать?)"
    new "(Yoksa... söylemeye korkuyor musun?)"

# game/script.rpy:1478
translate turkish room_76c5c726:

    # gg "- Да!"
    gg "- Evet!"

# game/script.rpy:1481
translate turkish room_c2c02deb:

    # gg "- А еще я боюсь, что произойдет что-то очень плохое, если я скажу!"
    gg "- Söylersem kötü bir şey olmasından korkuyorum!"

# game/script.rpy:1484
translate turkish room_f14d41aa:

    # gg "- А еще я боюсь, что из-за того, что произойдет что-то плохое, произойдет что-то гораздо, гораздо хуже!"
    gg "- Kötü bir şey olursa peşinden çok daha kötü bir şey olmasından da korkuyorum!"

translate turkish strings:
    # game/script.rpy:1485
    old "(Да понял я!)"
    new "(Tamam, anladım!)"

    # game/script.rpy:1487
    old "(И все же не отстану, пока не скажешь.)"
    new "(Ağzındaki baklayı çıkarana dek bir yere gitmiyorum.)"
    
# game/script.rpy:1493
translate turkish room_78810b60:

    # gg "- Зануда..."
    gg "- Zorba yine iş başında..."

translate turkish strings:
    # game/script.rpy:1494
    old "(Нет, ты!)"
    new "(Sensin o!)"
    
# game/script.rpy:1517
translate turkish room_de40471b:

    # "Я неуклюже забираюсь в спальный мешок. Внизу комнаты очень прохладно; и пусть электрический обогреватель работает изо всех сил, я, тем не менее, спешу скорей укутаться."
    "Uyku tulumuma sokuluyorum. Odamın zemini epey soğuk. Elektrikli ısıtıcım beni ısıtmak için elinden geleni yaparken bir yandan da battaniyeme sarınıyorum."

# game/script.rpy:1520
translate turkish room_47a7d25c:

    # gg "- Мне грустно из-за того, что сны больше не приходят."
    gg "- Artık rüya göremediğim için çok üzülüyorum."

# game/script.rpy:1521
translate turkish room_541ac548:

    # gg "- Ни за что не поверишь, как я поначалу справлялась с этим."
    gg "- İlkten bununla nasıl baş ettiğimi sana anlatsam asla inanmazsın."

translate turkish strings:
    # game/script.rpy:1522
    old "(Конечно, поверю.)"
    new "(Elbette inanırım.)"
    
# game/script.rpy:1524
translate turkish room_16ce1f16:

    # gg "- Я знаю. Это была шутка."
    gg "- Biliyorum, şaka yaptım."

# game/script.rpy:1525
translate turkish room_5691257a:

    # gg "- Так вот - я умывалась, чистила зубы, ложилась и начинала воображать, будто я вижу сон. При этом я, конечно же, совсем не спала и поутру вечно клевала носом."
    gg "- Neyse işte. Yüzümü yıkadım, dişlerimi fırçaladım, yere uzanıp rüya gördüğümü hayal etmeye başladım. Bir türlü uyku tutmuyor, sabahları da uykusuzluğum yüzümden okunuyordu."

# game/script.rpy:1526
translate turkish room_59d116a9:

    # gg "- После недели бессонных ночей я стала себя странно чувствовать и начала видеть всякое..."
    gg "- Uykusuz geçen koca bir haftanın sonunda tuhaf hissetmeye ve sanrılar görmeye başladım..."

# game/script.rpy:1527
translate turkish room_0b2b5f9d:

    # gg "- Парящие в воздухе буквы, странные силуэты, появляющиеся в самых неожиданных местах. Выпученные глаза с дрожащими бледными зрачками... Страшно, знаешь ли!"
    gg "- Havada harfler uçuşuyor, hiç beklenmedik yerlerde acayip karaltılar beliriyordu. Titrek ve solgun göz bebeklerine sahip pörtlek gözler falan... Korkunçtu işte!"

# game/script.rpy:1528
translate turkish room_d0f92d40:

    # gg "- Однажды я чуть не умерла. Просто упала посреди комнаты и какое-то время не могла пошевелиться. А силуэты, буквы и глаза нависли надо мной и осуждающе шипели."
    gg "- Sonra bir gün az kalsın ölüyordum. Odanın ortasında olduğum yere yığılıverdim ve bir süre donakaldım. Gördüğüm karaltılar, harfler ve gözler üstüme gelip tıslamaya başladı."

# game/script.rpy:1529
translate turkish room_e275b366:

    # gg "- Это было ужасно."
    gg "- Korkunçtu."

# game/script.rpy:1530
translate turkish room_87ac3140:

    # gg "- И... заслуженно, что ли?"
    gg "- Ama belki de... hak ettiğim buydu."

# game/script.rpy:1531
translate turkish room_8c2610d5:

    # gg "- Я будто была поймана на самой большой в мире лжи. Да, должно быть, так и было."
    gg "- Dünyanın en büyük yalanına kanmış gibiydim. Aynen, tıpkı böyle hissettim."

# game/script.rpy:1532
translate turkish room_71231f48:

    # gg "- После этого я прекратила."
    gg "- Sonra ise duruldum."

# game/script.rpy:1533
translate turkish room_a98bf790:

    # gg "- А силуэты, буквы и глаза остались жить тут - понравилось, видимо!"
    gg "- Ancak karaltılar, harfler ve gözler -burayı sevmiş olmalılar ki- kaybolmadılar!"

# game/script.rpy:1534
translate turkish room_0fb6bf67:

    # gg "- Вечно ходят за мной по пятам, подглядывают... А я их побаиваюсь и не могу даже слова поперек сказать."
    gg "- Sürekli beni izliyor, beni gözetliyorlar... Normalde korktuğum için onlara asla sesimi çıkaramazdım."

# game/script.rpy:1535
translate turkish room_771ceae3:

    # gg "- Но сегодня..."
    gg "- Ama bugün..."

# game/script.rpy:1536
translate turkish room_b780befe:

    # gg "- Сегодня..."
    gg "- Bugün..."

translate turkish strings:
    # game/script.rpy:1537
    old "(Ну?)"
    new "(Ee?)"
    
# game/script.rpy:1539
translate turkish room_d4a15ee5:

    # gg "- Я..."
    gg "- Ben..."

translate turkish strings:
    # game/script.rpy:1540
    old "(Ты все еще боишься мне сказать?)"
    new "(Hâlâ söylemeye korkuyor musun?)"
    
# game/script.rpy:1542
translate turkish room_ea92e2c1:

    # gg "- Конечно, они же слушают!"
    gg "- Yani! Bizi dinliyorlar!"

translate turkish strings:
    # game/script.rpy:1543
    old "(Объясни на пальцах.)"
    new "(El işaretleriyle anlatmayı dene.)"
    
# game/script.rpy:1545
translate turkish room_524f741b:

    # gg "- Ладно!"
    gg "- Olur!"

# game/script.rpy:1548
translate turkish room_e3a26920:

    # "Я принимаюсь беспорядочно, но оттого не менее воодушевленно вертеть пальцами, выстраивая сложные фигуры."
    "Hevesle ellerimi bükerek, parmaklarımı katlayarak karmaşık işaretler oluşturuyorum."

translate turkish strings:
    # game/script.rpy:1549
    old "(Ты хочешь, чтобы я... рассказал тебе историю перед сном?)"
    new "(Uyumadan önce sana... masal anlatmamı ister misin?)"
    
# game/script.rpy:1551
translate turkish room_aaa6ed3d:

    # gg "- Тш-ш-ш-ш!"
    gg "- Şşşşş!"

# game/script.rpy:1554
translate turkish room_f1f76ee9:

    # gg "- Я что, зря тут стараюсь? Тебя ведь услышат!"
    gg "- Sessiz olmak için ne kadar uğraştığımı görmüyor musun? Duyacaklar bizi!"

translate turkish strings:
    # game/script.rpy:1555
    old "(Расслабься, никто тебя не слышит.)"
    new "(Sakin ol, bizi kimsenin duyacağı yok.)"
    
# game/script.rpy:1557
translate turkish room_d2c4cf06_1:

    # gg "- ..."
    gg "- ..."

# game/script.rpy:1559
translate turkish room_deb15c30:

    # gg "- Ну так что?"
    gg "- Ee, ne diyorsun?"

translate turkish strings:
    # game/script.rpy:1560
    old "(Я бы с радостью, но я совсем не знаю, как их рассказывать.)"
    new "(Çok isterim ama bunu onlara nasıl söyleyeceğimi hiç bilmiyorum.)"
    
# game/script.rpy:1562
translate turkish room_3a0ed07d:

    # gg "- Ой, да это очень просто!"
    gg "- Ah, inan, çok basit!"

# game/script.rpy:1563
translate turkish room_18998f65:

    # gg "- Просто говори о чем угодно без остановки."
    gg "- Hiç susmadan konuş, yeter."

translate turkish strings:
    # game/script.rpy:1564
    old "(Звучит нелепо.)"
    new "(Bu çok saçma.)"

    # game/script.rpy:1567
    old "(А еще бессмысленно.)"
    new "(Ve anlamsız.)"
    
# game/script.rpy:1566
translate turkish room_0bef18b7:

    # gg "- И вовсе нет!"
    gg "- Değil işte!"

# game/script.rpy:1569
translate turkish room_f6a122b0:

    # gg "- Да что ты вообще понимаешь?"
    gg "- Sen ne anlarsın ki?"

translate turkish strings:   
    # game/script.rpy:1570
    old "(Достаточно, чтобы понять, что мы лишь впустую потратим время.)"
    new "(Kıymetli vaktimizi boşa harcıyoruz.)"

    # game/script.rpy:1572
    old "(Давай сосредоточимся на чем-нибудь действительно важном.)"
    new "(Bunun yerine daha önemli şeylere vakit ayırmaya ne dersin?)"

# game/script.rpy:1574
translate turkish room_b35942a8:

    # gg "- Скукотища..."
    gg "- Sıkıcııı..."

translate turkish strings:  
    # game/script.rpy:1578
    old "(Закрывай глаза.)"
    new "(Gözlerini kapa.)"

# game/script.rpy:1577
translate turkish room_6ec9d9f0:

    # gg "- Ладно..."
    gg "- Tamam, tamam..."



# game/script.rpy:1620
translate turkish newscene_1_3b7684ac:

    # gg "- Ты нашел всех светлячков! Здорово!"
    gg "- Tüm ateş böceklerini buldun! Harika!"

# game/script.rpy:1623
translate turkish newscene_1_22941486:

    # gg "- Вроде бы..."
    gg "- Sanırım..."
