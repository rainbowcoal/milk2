# game/magaz.rpy:63
translate japanese magaz_2bd1e715:

    # nm "Я просыпаюсь на деревянной лавке; перед глазами - узкая и слабо освещенная аллея. До боли знакомая дорога... где же я могла ее видеть?"
    nm "木製のベンチの上で目が覚めた。目の前は、ぼんやりとあかりが灯った狭い路地。やけに見慣れた道だ…どこで見たのだろう？"

# game/magaz.rpy:64
translate japanese magaz_aad6796c:

    # trm "- Ну наконец-то..."
    trm "- やっとだ…"

# game/magaz.rpy:70
translate japanese magaz_5b9565ac:

    # nm "Сбоку разносится голос. Я поворачиваюсь и вижу перед собой мальчика с крайне странным выражением лица."
    nm "向こう側から声がした。振り向くとなんだかおかしな表情を浮かべた少年がいた。"

# game/magaz.rpy:76
translate japanese magaz_5c56715c:

    # trm "- Ты опоздала!"
    trm "- 遅いよ！"

# game/magaz.rpy:78
translate japanese magaz_d9ca71a8:

    # ggm "- Эм-м-м... а ты кто?"
    ggm "- えっと…誰？"

# game/magaz.rpy:79
translate japanese magaz_c96f65e3:

    # nm "Мальчик удивленно моргнул."
    nm "少年は戸惑った様子で目をパチパチさせた。"

# game/magaz.rpy:81
translate japanese magaz_9b91e7ea:

    # trm "- Так мы с тобой далеко не уйдем. Попробуй заново."
    trm "- そんなんじゃダメだよ。やり直し。"

# game/magaz.rpy:82
translate japanese magaz_92df8506:

    # nm "Затем он набирает полную грудь воздуха."
    nm "そう言って少年は深く息を吸った。"

# game/magaz.rpy:83
translate japanese magaz_21e45af1:

    # trm "- Ты! Опоздала!"
    trm "- チ！コ！ク！だよ！"

# game/magaz.rpy:85
translate japanese magaz_9dec254e:

    # nm "Я непонимающе смотрю на него. Он непонимающе смотрит на меня."
    nm "少年を見つめながら、混乱していた。彼も見つめ返してきた、また混乱した。"

# game/magaz.rpy:86
translate japanese magaz_60af0f3c:

    # ggm "- И-извини?.."
    ggm "- ご…ごめん…？"

# game/magaz.rpy:88
translate japanese magaz_400b60e9:

    # nm "Мальчик довольно кивнул."
    nm "少年は満足げにうなずいた。"

# game/magaz.rpy:89
translate japanese magaz_77916ef1:

    # trm "- Вот, уже лучше."
    trm "- ほらね？そっちの方がずっといいよ。"

# game/magaz.rpy:90
translate japanese magaz_e9fa80ce:

    # trm "- Имя-то у тебя есть? Меня вот Треской звать!"
    trm "- 名前は？ボクはトレスカ！"

# game/magaz.rpy:92
translate japanese magaz_24605459:

    # nm "Я оценивающе оглядываю наглеца. Совсем маленький, а уже лезет с такими вопросами!"
    nm "見定めるように少年を見つめた。まだ小さいのに、こんな質問で私に迫ってくる！"

# game/magaz.rpy:93
translate japanese magaz_e9fe9f8b:

    # ggm "- Не твое дело..."
    ggm "- 関係ないでしょ…"

# game/magaz.rpy:94
translate japanese magaz_dfb8a18f:

    # ggm "- И вообще!.. Мне кто-нибудь скажет, что я тут делаю?"
    ggm "- それから…！私はここで何をしているのか、誰か教えてくれないかな？"

# game/magaz.rpy:96
translate japanese magaz_279aff48:

    # trm "- Эй, это невежливо! Будто тут есть кто-то еще..."
    trm "- ねぇ、それって失礼だよ！まるでボク以外にも誰かいるみたいにさ…"

# game/magaz.rpy:98
translate japanese magaz_0619fa6f:

    # nm "..."
    nm "…"

# game/magaz.rpy:100
translate japanese magaz_a899a5fc:

    # trm "- Тебе совсем ничего не рассказали? Вот я все знаю, например!"
    trm "- 何も教えてもらわなかったの？ボクはね、全部知ってるよ！"

# game/magaz.rpy:102
translate japanese magaz_1d4b75d7:

    # ggm "- О чем?"
    ggm "- 何を？"

# game/magaz.rpy:104
translate japanese magaz_bf91ae6e:

    # trm "- Ты обязана проводить меня в магазин!"
    trm "- 君にはボクを店まで連れてくっていう義務がある！"

# game/magaz.rpy:105
translate japanese magaz_aef4f109:

    # nm "После этих слов Треска встал в победную позу."
    nm "トレスカはそう言って勝利のポーズを決めた。"

# game/magaz.rpy:107
translate japanese magaz_81f8ed24:

    # ggm "- Еще чего..."
    ggm "- なんでそんなこと…"

# game/magaz.rpy:109
translate japanese magaz_8decfd91:

    # trm "- Ты ведь понимаешь, что отказ не принимается?"
    trm "- 拒否権はないって分かってるでしょ？"

# game/magaz.rpy:111
translate japanese magaz_efc3c766:

    # ggm "- Многовато ты о себе возомнил."
    ggm "- ねぇ、あなた自分のことばっかりじゃない？"

# game/magaz.rpy:113
translate japanese magaz_c4e65e33:

    # trm "- Я серьезно."
    trm "- ボクは真剣だよ。"

# game/magaz.rpy:114
translate japanese magaz_7516ceb4:

    # trm "- Это, как бы, не мне решать."
    trm "- 決めたのはボクじゃない。"

# game/magaz.rpy:115
translate japanese magaz_1eeae098:

    # trm "- Думаешь, я в восторге от такой компании?"
    trm "- 君がついてきてくれて、ポク喜んでると思う？"

# game/magaz.rpy:117
translate japanese magaz_f10d9bff:

    # nm "Какой-то он странный. То веселый, то грустный, то громкий, то тихий. Ненормальный какой-то. И имя дурацкое."
    nm "少年はおかしい。嬉しい、悲しい、うるさい、静かをずっと行ったり来たりしている。変なやつだ。名前もおかしい。"

# game/magaz.rpy:119
translate japanese magaz_9d1124ad:

    # trm "- Мы идем или как?"
    trm "- 行くの、どうするの？"

# game/magaz.rpy:121
translate japanese magaz_22b68094:

    # ggm "- Ты иди, а мне подумать надо."
    ggm "- 行って来ればいいよ、私は考えないと。"

# game/magaz.rpy:123
translate japanese magaz_93798464:

    # trm "- Я бы с радостью, да только дороги не знаю..."
    trm "- そうしたいところだけど、道が分からないんだ…"

# game/magaz.rpy:124
translate japanese magaz_75266a4b:

    # nm "Треска хитро улыбается. Я с досадой кусаю губы."
    nm "トレスカはずるい笑顔を向けてきた。私はイラっとして下唇を噛む。"

# game/magaz.rpy:126
translate japanese magaz_5e5cae60:

    # ggm "- Буду с тобой честна - ты мне совсем не нравишься."
    ggm "- 正直言うとね、私あなたが好きじゃない。"

# game/magaz.rpy:127
translate japanese magaz_989f8e80:

    # nm "В ответ он лишь заливается смехом."
    nm "少年は笑い飛ばした。"

# game/magaz.rpy:131
translate japanese magaz_6c52dd99:

    # trm "- Зато ты мне - очень!"
    trm "- ボクは君が好き！"

# game/magaz.rpy:132
translate japanese magaz_80189b02:

    # nm "После этого он с уверенностью хватает меня за руку - я и рта не успеваю открыть."
    nm "少年は躊躇うことなく私の手を取った。言い返す隙もなかった。"

# game/magaz.rpy:133
translate japanese magaz_b9406d79:

    # trm "- Веди!"
    trm "-道を教えて！"

# game/magaz.rpy:146
translate japanese magaz_03d48903:

    # nm "Дорога до магазина прошла нормально, если не считать того, что Треска шел заметно быстрее."
    nm "店までは問題なく行けたけれど、トレスカは歩くのがかなり速かった。"

# game/magaz.rpy:147
translate japanese magaz_7f15f214:

    # nm "И наоборот - в какие-то моменты он резко останавливался и начинал идти назад, внимательно глядя себе под ноги."
    nm "その割には、時々急に立ち止まって、来た道を戻ったり、足元の地面を観察したりもしていた。"

# game/magaz.rpy:148
translate japanese magaz_eaf9b630:

    # nm "В итоге дорога заняла гораздо больше времени, чем могла бы."
    nm "結局、長旅になってしまった。"

# game/magaz.rpy:154
translate japanese magaz_cf29981f:

    # nm "Оказавшись у дверей магазина, мы видим перед собой вывеску."
    nm "店のドアの前で、看板に挨拶をされた。"

# game/magaz.rpy:155
translate japanese magaz_214bc86e:

    # nm "'Магазин закрывается через 20 минут!'"
    nm "「閉店まであと20分！」"

# game/magaz.rpy:156
translate japanese magaz_ba5d0e53:

    # ggm "- И взбрело же кому-то в голову таким образом обозначить часы работы своего магазина..."
    ggm "- こんな風に営業時間を知らせるなんて誰が考えついたんだろう…？"

# game/magaz.rpy:157
translate japanese magaz_3b104fbf:

    # trm "- Наверно, у них для этого специальный человек есть. Каждые пять минут бегает и меняет табличку. Удобно же!"
    trm "- ここに特別なスタッフをあてたのかもしれないね。5分ごとに看板の文字を変える要員。便利だね！"

# game/magaz.rpy:158
translate japanese magaz_603668ed:

    # ggm "- Шутишь, что ли?"
    ggm "- 冗談でしょ？"

# game/magaz.rpy:159
translate japanese magaz_72395cef:

    # trm "- Да!"
    trm "- うん！"

# game/magaz.rpy:160
translate japanese magaz_b706ff96:

    # ggm "- До чего же ты надоедливый..."
    ggm "- ほんとイライラする…"

# game/magaz.rpy:161
translate japanese magaz_4e875e76:

    # trm "- Всяко лучше, чем быть занудой! Тебе, кстати, лет-то сколько?"
    trm "- つまらないよりいいでしょ！ところで君は何歳？"

# game/magaz.rpy:162
translate japanese magaz_56bd5b0c:

    # ggm "- Не твое дело."
    ggm "- あなたには関係ない。"

# game/magaz.rpy:163
translate japanese magaz_7dc314bf:

    # trm "- А-а-а... а зовут как?"
    trm "- あーぁ。名前は？"

# game/magaz.rpy:164
translate japanese magaz_b5ef0b03:

    # ggm "- Не твое дело!"
    ggm "- 関係ない！"

# game/magaz.rpy:165
translate japanese magaz_4f29a999:

    # nm "Я уже готова была дать мелкому поганцу подзатыльник, как вдруг за стеклом появляется жуткого вида человек. В руках он держит картонную табличку с надписью 'До закрытия магазина 15 минут!'"
    nm "思わずガキをひっぱたきそうになったけど、怖そうな男の人がガラスごしに見えた。「閉店まであと15分！」と書いた段ボールの看板を持っていた。"

# game/magaz.rpy:166
translate japanese magaz_491606b9:

    # trm "- Пойдем, чего стоишь?"
    trm "- 行こう、何を待ってるの？"

# game/magaz.rpy:167
translate japanese magaz_b3e070b9:

    # ggm "- А? Д-да..."
    ggm "- え？あぁ…"

# game/magaz.rpy:177
translate japanese magaz_bda9d19f:

    # nm "В очередной раз проходя мимо длинного ряда с консервными банками, мы поняли, что заблудились."
    nm "缶詰コーナーの長い列を二度横切ったところで、迷子になったことに気づく。"

# game/magaz.rpy:178
translate japanese magaz_fab2588c:

    # ggm "- Поверить не могу, что ты не знаешь, где продается молоко."
    ggm "- 牛乳売り場の場所が分からないなんて信じられない。"

# game/magaz.rpy:179
translate japanese magaz_d2bc0976:

    # trm "- Я... эм-м-м..."
    trm "- ボク…えっと…"

# game/magaz.rpy:180
translate japanese magaz_fa0c299d:

    # ggm "- Может, спросим кого-нибудь?"
    ggm "- 誰かに聞いてみる？"

# game/magaz.rpy:181
translate japanese magaz_72bfe8b3:

    # trm "- Давай!"
    trm "- そうしよう！"

# game/magaz.rpy:182
translate japanese magaz_cd2f6b76:

    # ggm "- Эй, постой!.."
    ggm "- ねぇ、待って…！"

# game/magaz.rpy:183
translate japanese magaz_449dcf56:

    # nm "Треска отпустил мою руку и уверенно зашагал к одному из немногочисленных посетителей магазина. Тот стоял спиной к нам, что-то сосредоточенно рассматривая на прилавке."
    nm "トレスカは私の手をはなし、少ないお客さんの一人めがけて自信ありげに突き進んだ。その人は私たちに背を向けて、棚の方を見ていた。"

# game/magaz.rpy:184
translate japanese magaz_d1671cc2:

    # trm "- Здрасьте, а можно!.."
    trm "- すみません、あの…！"

# game/magaz.rpy:185
translate japanese magaz_7b64269c:

    # nm "Последнюю часть вопроса я не расслышала - как и ответ на него. Но мой непутевый друг внезапно застыл как вкопанный, глядя прямо в глаза посетителя магазина. Я поспешила подойти к ним."
    nm "質問の後半も、もらった回答も聞こえない。でも能天気な少年はその場で固まり、その人をまっすぐに見ている。私は彼の方へ急いだ。"

# game/magaz.rpy:191
translate japanese magaz_73ff8128:

    # mm "- Это ваш?"
    mm "- 君のツレか？"

# game/magaz.rpy:192
translate japanese magaz_fbc1a18a:

    # nm "Посетитель обратился ко мне. В его голосе явно слышалось отвращение, а на лице застыла презрительная гримаса."
    nm "お客さんが私に話しかけてきた。その人は蔑むような目で、鬱陶しそうに話した。"

# game/magaz.rpy:203
translate japanese magaz_a3ef7e99:

    # ggm "- Я... эм-м..."
    ggm "- 私は…えっと…"

# game/magaz.rpy:204
translate japanese magaz_2f529462:

    # mm "- Если так, то будьте добры - уберите его подальше."
    mm "- どこかに連れてってくれないか。"

# game/magaz.rpy:205
translate japanese magaz_6277046c:

    # ggm "- Д-да, извините..."
    ggm "- は、はい、すみません…"

# game/magaz.rpy:206
translate japanese magaz_5ffc47dc:

    # nm "Я хватаю Треску за руку и спешу увести в сторону - тот все глядит на посетителя, открыв рот и выпучив глаза. И дрожит."
    nm "私はトレスカの手をつかんで引っ張った。彼はまだ目も口も開いたまま、お客さんの方を見ている。それに震えている。"

# game/magaz.rpy:216
translate japanese magaz_5a6e2c0e:

    # nm "Лишь когда мы свернули за угол, Треска успокоился."
    nm "角を曲がった辺りでやっと、トレスカは落ち着いた。"

# game/magaz.rpy:217
translate japanese magaz_c7dd33e3:

    # ggm "- Ну и как это понимать?"
    ggm "- 何があったの？"

# game/magaz.rpy:218
translate japanese magaz_a38d3841:

    # trm "- Я... я так перепугался!.. Он сказал..."
    trm "- ボク…すごく怖くなったんだ…！あの人がこう言って…"

# game/magaz.rpy:219
translate japanese magaz_72d73855:

    # ggm "- Что?"
    ggm "- 何？"

# game/magaz.rpy:220
translate japanese magaz_b9c8f9d0:

    # trm "- НЕТ, ТОЛЬКО НЕ ОПЯТЬ!"
    trm "- もう嫌だ、やめて！"

# game/magaz.rpy:221
translate japanese magaz_32dc5f00:

    # nm "Внезапно Треска завопил как сумасшедший. Я зажимаю ему рот ладонью; его лицо буквально горит, а сам он плачет."
    nm "トレスカは突然狂ったように叫び出した。私は彼の口を押さえた。顔を真っ赤にして、彼は泣いていた。"

# game/magaz.rpy:222
translate japanese magaz_08dc37af:

    # ggm "- Ты можешь вести себя нормально?"
    ggm "- 普通にしてくれない？"

# game/magaz.rpy:223
translate japanese magaz_b551f5ad:

    # trm "- Т-ты не понимаешь..."
    trm "- き…君には分からないよ…"

# game/magaz.rpy:224
translate japanese magaz_96ec9ded:

    # ggm "- Ну конечно, что я вообще могу понимать!"
    ggm "- 当然でしょ、私には何にも分からない！"

# game/magaz.rpy:225
translate japanese magaz_66e633dd:

    # ggm "- Вот только приставать к людям - это неправильно. Этого, видимо, не понимаешь ты."
    ggm "- でも他人を困らせるのは間違ってるでしょ。そこは理解しないと、そうでしょ。"

# game/magaz.rpy:226
translate japanese magaz_a70710db:

    # trm "- Ты злая!.. Хнык.."
    trm "- 意地悪…！ぐす…"

# game/magaz.rpy:227
translate japanese magaz_d45f1565:

    # ggm "- Я?.."
    ggm "- 誰、私が…？"

# game/magaz.rpy:233
translate japanese magaz_828f1904:

    # nm "Оттолкнув меня, Треска убежал прочь."
    nm "トレスカは私を突き飛ばして走っていった。"

# game/magaz.rpy:239
translate japanese magaz_ce7396de:

    # ggm "- Блин."
    ggm "- くそ。"

# game/magaz.rpy:240
translate japanese magaz_0e1cb3a1:

    # nm "Краем глаза я замечаю, как работник магазина вешает на дверь новую табличку."
    nm "視界の端、ドアのそばで、店のスタッフが新しい看板をかかげているのが見えた。"

# game/magaz.rpy:246
translate japanese magaz_15b5e8ae:

    # ggm "- Вот ты где!"
    ggm "- ここにいたのね！"

# game/magaz.rpy:247
translate japanese magaz_f896812e:

    # nm "Я встречаю Треску у кассы. До этого я успела сбегать в молочный отдел, предварительно узнав, где он находится."
    nm "レジにトレスカがいた。私はそこに行く前に牛乳コーナーにたどり着いていた。"

# game/magaz.rpy:248
translate japanese magaz_d51b64cb:

    # mm "- Эй, шевелись!"
    mm "- おい、どけよ！"

# game/magaz.rpy:249
translate japanese magaz_9ee11605:

    # nm "Недовольный голос раздался с конца длинной очереди, что образовалась позади Трески. Я протискиваюсь к нему."
    nm "トレスカの後ろに続く長い行列から怒った声が聞こえる。私は彼の方に詰め寄った。"

# game/magaz.rpy:250
translate japanese magaz_d71944d4:

    # ggm "- Что случилось?"
    ggm "- 何があったの？"

# game/magaz.rpy:251
translate japanese magaz_271d3bbb:

    # nm "Мальчик не отвечает. Смотрит себе под ноги, едва слышно хныкая, а кассир коршуном нависает над ним. Между ними лежит пакет молока."
    nm "少年は答えない。うつむいてすすり泣いている。レジのスタッフが彼の頭上にそびえ立つ。二人の間には牛乳の袋。"

# game/magaz.rpy:252
translate japanese magaz_73ff8128_1:

    # mm "- Это ваш?"
    mm "- ツレかい？"

# game/magaz.rpy:253
translate japanese magaz_7cf04c09:

    # ggm "- Мой."
    ggm "- そうです。"

# game/magaz.rpy:254
translate japanese magaz_630ff660:

    # mm "- В следующий раз оставьте его дома."
    mm "- 次来るときは家に置いてきな。"

# game/magaz.rpy:255
translate japanese magaz_cc8f5d69:

    # nm "Люди в очереди согласно кивают."
    nm "列に並んでいた人たちが賛同してうなずいた。"

# game/magaz.rpy:256
translate japanese magaz_4c8b218b:

    # mm "- Оплатите стоимость товара."
    mm "- お会計を。"

# game/magaz.rpy:257
translate japanese magaz_6bad1905:

    # ggm "- Да, конечно..."
    ggm "- はい、そうですよね…"

# game/magaz.rpy:258
translate japanese magaz_04ace94f:

    # mm "- И издержку за ожидание!"
    mm "- 待機時間料金もな！"

# game/magaz.rpy:259
translate japanese magaz_1676dc10:

    # ggm "- Ч-что?"
    ggm "- な…何て？"

# game/magaz.rpy:260
translate japanese magaz_7be05a24:

    # mm "- Вы слышали."
    mm "- 聞こえただろう。"

# game/magaz.rpy:261
translate japanese magaz_9428ac7b:

    # ggm "- Я-то слышала, но это же неслыханно!"
    ggm "- はい、でもそんなの聞いたことがなくて！"

# game/magaz.rpy:266
translate japanese magaz_4daaff38:

    # nm "Вдруг Треска начинает хихикать."
    nm "トレスカは突然くすくす笑い始めた。"

# game/magaz.rpy:267
translate japanese magaz_84a35435:

    # mm "- И за то, что ваш сын придурок, тоже заплатите!"
    mm "- このチビは知恵が遅れているみたいだな！"

# game/magaz.rpy:268
translate japanese magaz_d3f5b609:

    # ggm "- Н-но..."
    ggm "- で、でも…"

# game/magaz.rpy:269
translate japanese magaz_7be05a24_1:

    # mm "- Вы слышали."
    mm "- 聞こえただろう。"

# game/magaz.rpy:270
translate japanese magaz_fe838a88:

    # ggm "- Знаете, что?!.."
    ggm "- だからそれって…？！"

# game/magaz.rpy:271
translate japanese magaz_ed507361:

    # nm "В гневе я бросаю кассиру смятую купюру гораздо большего номинала, чем требовалось - даже с учетом всех идиотских надбавок - хватаю пакет молока и круто разворачиваюсь."
    nm "私は怒りにまかせて、手数料を差し引いたとしても多すぎるくらいの紙幣をレジに向かって投げつけた。それから牛乳の袋を手に取り、踵を返す。"

# game/magaz.rpy:272
translate japanese magaz_8433e4f1:

    # ggm "- Мы уходим, Треска!"
    ggm "- 行くよ、トレスカ！"

# game/magaz.rpy:278
translate japanese magaz_07f73956:

    # nm "Всю дорогу из магазина мы шли молча. В какой-то момент мы незаметно для себя свернули вправо и оказались у автозаправки - тогда-то Треска и решил нарушить молчание."
    nm "帰り道は黙ったままだった。ガソリンスタンドの角を右に曲がった。そこでトレスカは沈黙を破った。"

# game/magaz.rpy:279
translate japanese magaz_11b4592c:

    # trm "- Любишь мороженое?"
    trm "- アイスクリームは好き？"

# game/magaz.rpy:280
translate japanese magaz_4cd3ac67:

    # ggm "- Нет."
    ggm "- 好きじゃない。"

# game/magaz.rpy:281
translate japanese magaz_ef883331:

    # trm "- Ладно..."
    trm "- そっか…"

# game/magaz.rpy:282
translate japanese magaz_0a0e5a9c:

    # nm "Я смотрю в поникшее лицо мальчика - на секунду в его глазах блеснул огонек и тут же погас."
    nm "少年の顔を見た。瞳に一瞬光が揺らめき、そして消える。"

# game/magaz.rpy:283
translate japanese magaz_8734db3e:

    # trm "- Знаешь..."
    trm "- あのさ…"

# game/magaz.rpy:284
translate japanese magaz_f6ae2c25:

    # nm "Он уверенно сворачивает с тропы прямо на автомобильную дорогу. Я провожаю его недоуменным взглядом."
    nm "少年は道に背を向け、決意を胸に高速道路の方へ歩みを進める。私は戸惑いながら彼の背を見つめる。"

# game/magaz.rpy:296
translate japanese magaz_1f80669a:

    # trm "- Похоже, ты мне совсем не помогаешь."
    trm "- 君はボクのこと、全く助けてくれないんだね。"

# game/magaz.rpy:297
translate japanese magaz_783d379e:

    # nm "В глазах Трески вновь блестит озорной огонек..."
    nm "またトレスカの瞳の中で光が揺れる…"

