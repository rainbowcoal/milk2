    new "（落ち着いて、誰にも聞こえないよ。）"
    
# game/script.rpy:1557
translate japanese room_d2c4cf06_1:

    # gg "- ..."
    gg "- …"

# game/script.rpy:1559
translate japanese room_deb15c30:

    # gg "- Ну так что?"
    gg "- それで、どうなの…？"

translate japanese strings:
    # game/script.rpy:1560
    old "(Я бы с радостью, но я совсем не знаю, как их рассказывать.)"
    new "（もちろん話すよ、でも何を話せばいいか分からない。）"
    
