# game/pnc_text.rpy:11
translate japanese backpack_38718438:

    # "Я опускаю глаза. Нелепый и потрепанный, мой школьный рюкзак словно кричит о своей бесполезности."
    "視線を落とす。使い古された学校のカバンが、自分の役立たずさを訴えようとしている。"

# game/pnc_text.rpy:12
translate japanese backpack_2678b6c1:

    # "С другого угла он похож на набитое брюхо - его содержимое точно так же переваривается, разлагается и превращается в густую кашу."
    "別の角度から見るとなんだか膨れたお腹みたい。中身が逆流して、分解して、ぐちゃぐちゃでベトベトの物質に変わるのだ。"

# game/pnc_text.rpy:14
translate japanese backpack_61aaf7e3:

    # gg "- Классно я придумала, надо бы запомнить..."
    gg "- いい感じの情景だね、覚えておかなきゃ…"

translate japanese strings:
    # game/pnc_text.rpy:15
    old "(Совсем не классно.)"
    new "（全くいい感じじゃないよ。）"

    # game/pnc_text.rpy:15
    old "(Совсем не классно. Мерзко и ужасно.)"
    new "（全くいい感じじゃないよ。意味不明だしグロいよ。）"

# game/pnc_text.rpy:21
translate japanese backpack_e615eecb:

    # gg "- А вот и нет - мой тебе ответ!"
    gg "- そこにいたんだ、気にしてないけどね！"

translate japanese strings:
    # game/pnc_text.rpy:22
    old "(Ты что, смеешься надо мной?)"
    new "（私のことを笑ってたの？）"

# game/pnc_text.rpy:27
translate japanese backpack_06036bad:

    # gg "- Обижаешь... ведь ты мне как родной! Хи-хи!"
    gg "- え？そんなこと…結局あなたは私のペットじゃないからね！えへへ！"

translate japanese strings:
    # game/pnc_text.rpy:28
    old "(Я не собираюсь продолжать этот цирк, поняла?)"
    new "（もう意味不明なことに付き合うつもりはないよ。）"

# game/pnc_text.rpy:32
translate japanese backpack_b5138861:

    # gg "- Поняла!"
    gg "- 分かったよ！"

# game/pnc_text.rpy:37
translate japanese backpack_557726c8:

    # gg "- Эй, в этот раз я не специально!.."
    gg "- ねぇ、今回のはわざとじゃなかったの…！"

translate japanese strings:
    # game/pnc_text.rpy:39
    old "(Лучше расскажи мне, что внутри твоего рюкзака.)"
    new "（それはいいからカバンの中身を見せて。）"

# game/pnc_text.rpy:44
translate japanese backpack_9fc41a8b:

    # gg "- Да ничего особенного... книжки всякие, в основном."
    gg "- 何も特別なものは…大体は本だよ。"

# game/pnc_text.rpy:47
translate japanese backpack_d0f08302:

    # gg "- Все карандаши и тетради я оттуда вытащила, а остальное меня не интересует."
    gg "- ペンやノートを全部出してみた。他に興味がそそられるものはない。"

translate japanese strings:
    # game/pnc_text.rpy:50
    old "(Ты ведь когда-то ходила в школу, да?)"
    new "（前は学校に行ってたんだよね？）"

# game/pnc_text.rpy:54
translate japanese backpack_eceef613:

    # gg "- Ага, ходила. Отлично провела время, кстати!"
    gg "- うん、行ってたよ。超楽しかった！"

translate japanese strings:
    # game/pnc_text.rpy:55
    old "(...ты точно поняла мой вопрос?)"
    new "（…本当に質問の意味分かってる？）"

# game/pnc_text.rpy:59
translate japanese backpack_e624daf9:

    # gg "- Думаешь, все в моей жизни должно быть печально и угрюмо? А вот и нет!"
    gg "- 私の人生は何もかも散々だって思ってるの？それはね、違うんだよ！"

translate japanese strings:
    # game/pnc_text.rpy:60
    old "(Ну ладно, ладно. Что тебе больше всего понравилось?)"
    new "（そっかそっか。何が一番楽しかった？）"

# game/pnc_text.rpy:64
translate japanese backpack_c92e01ee:

    # gg "- Хм-м-м..."
    gg "- うーん…"

# game/pnc_text.rpy:67
translate japanese backpack_79c4eff2:

    # gg "- Ну... В помещениях было очень светло, совсем не так, как дома."
    gg "- 教室がすごく明るかった、家とは違って。"

translate japanese strings:
    # game/pnc_text.rpy:68
    old "(И все?)"
    new "（それだけ？）"

# game/pnc_text.rpy:72
translate japanese backpack_3d194e3c:

    # gg "- Да погоди ты! Дай вспомнить..."
    gg "- 急かさないでよ！思い出すから…"

# game/pnc_text.rpy:75
translate japanese backpack_c7d3b724:

    # gg "- Ну, кровати были мягкие... Да и кормили неплохо."
    gg "- えっとね、ベッドがふわふわだった…給食もおいしかった。"

# game/pnc_text.rpy:78
translate japanese backpack_40cd7f87:

    # gg "- Между прочим, я всегда была на уроках! Остальные вечно прогуливали."
    gg "- そういえばね、私授業に全部出てたんだよ！他の子はいつもサボってた。"

# game/pnc_text.rpy:81
translate japanese backpack_a6aff8dc:

    # gg "- Ох и досталось же им, наверно!"
    gg "- ひどく叱られただろうね！"

# game/pnc_text.rpy:84
translate japanese backpack_bc809e1d:

    # "Я слегка улыбаюсь, предаваясь теплым воспоминаниям."
    "私は微笑んで、温かい思い出に吸い込まれていった。"

translate japanese strings:
    # game/pnc_text.rpy:85
    old "(Ты ведь так и не закончила школу.)"
    new "（でも卒業はしなかったんだね。）"

# game/pnc_text.rpy:89
translate japanese backpack_b98b4ac4:

    # gg "- Ага."
    gg "- うん。"

translate japanese strings:
    # game/pnc_text.rpy:90
    old "(Помнишь свой последний день?)"
    new "（最後の日のことって覚えてる？）"

# game/pnc_text.rpy:94
translate japanese backpack_d2c4cf06:

    # gg "- ..."
    gg "- …"

# game/pnc_text.rpy:95
translate japanese backpack_a707915e:

    # gg "- День как день."
    gg "- 普通の日だったよ。"

# game/pnc_text.rpy:98
translate japanese backpack_94074f87:

    # gg "- Папа забрал меня пораньше - объяснил, что я уже выросла из школьной программы. Да я и сама это понимала, уж больно простыми были задания..."
    gg "- パパがいつもより早めに迎えに来てくれた。私の年齢に学校のカリキュラムが合っていないって。私も少し前に気づいてたんだよ、課題が簡単すぎたから…"

# game/pnc_text.rpy:99
translate japanese backpack_1e7bb71c:

    # gg "- Потом мы сели в машину и поехали домой. Дома нас встретила мама, мы втроем поужинали и разошлись по комнатам."
    gg "- それから車に乗って家に帰った。ママが出迎えてくれて、夕飯を食べて部屋に戻ったの。"

translate japanese strings:
    # game/pnc_text.rpy:100
    old "(А что было потом?)"
    new "（そこで何があったの？）"

# game/pnc_text.rpy:104
translate japanese backpack_f52d7a56:

    # gg "- Не помню. Да и какая, в сущности, разница?"
    gg "-  覚えてない。大事なことなの？"

translate japanese strings:
    # game/pnc_text.rpy:100
    old "(Не похоже, что этот день хоть что-то значит для тебя.)"
    new "（あなたはその日に特別な意味があるなんて思ってないんだろうね。）"

# game/pnc_text.rpy:109
translate japanese backpack_3ac67b90:

    # gg "- Говорю же, день как день."
    gg "- さっきも言ったけど、普通の日だったんだよ。"

translate japanese strings:
    # game/pnc_text.rpy:110
    old "(Ладно.)"
    new "（なるほど…）"

# game/pnc_text.rpy:115
translate japanese backpack_0fa5da10:

    # gg "- Вот и славно."
    gg "- そうだよ。"

translate japanese strings:
    # game/pnc_text.rpy:110
    old "(Расскажи еще раз.)"
    new "（もう一度話して。）"

# game/pnc_text.rpy:120
translate japanese backpack_54f27d0a:

    # gg "- У тебя что, с памятью плохо?"
    gg "- 記憶力なさすぎない？"

translate japanese strings:
    # game/pnc_text.rpy:121
    old "(Ну пожалуйста!)"
    new "（お願い！）"


# game/pnc_text.rpy:125
translate japanese backpack_37182073:

    # gg "- Ладно уж..."
    gg "- え、分かった…"

# game/pnc_text.rpy:128
translate japanese backpack_7fc0b6b4:

    # gg "- В тот день папа забрал меня с учебы пораньше, объяснив это тем, что мне пора взрослеть."
    gg "- あの日、パパがいつもより早めに迎えに来てくれて、もっと大人になりなさいって言った。"

# game/pnc_text.rpy:129
translate japanese backpack_326cf169:

    # gg "- Не то, чтобы я до конца понимала, что он имел в виду..."
    gg "- パパの言うことを完全に理解できたわけじゃないけど…"

# game/pnc_text.rpy:130
translate japanese backpack_dad097f6:

    # gg "- Так или иначе, я не сопротивлялась. Мы сели в машину и поехали домой."
    gg "- とりあえず、私は抵抗しなかった。車に乗って家に帰った。"

# game/pnc_text.rpy:131
translate japanese backpack_5c8684eb:

    # gg "- Дома нас встретила мама, мы втроем поужинали и разошлись по комнатам."
    gg "- ママが出迎えてくれて、夕飯を一緒に食べて、それぞれの部屋に戻った。"

# game/pnc_text.rpy:134
translate japanese backpack_2e83915f:

    # gg "- Доволен?"
    gg "- これで満足？" #THIS SENTENCE SHOULD BE TRANSLATED SO IT COULD BE ANSWERED WITH SIMPLY "YES" OR "NO"

# game/pnc_text.rpy:139
translate japanese backpack_808e1266:

    # gg "Вот и славно."
    gg "- よかった。"

# game/pnc_text.rpy:143
translate japanese backpack_d2c4cf06_1:

    # gg "- ..."
    gg "- …"

# game/pnc_text.rpy:146
translate japanese backpack_f8e5dc31:

    # gg "- Папа забирал меня из школы силком, пока я кусалась и царапалась. Учителя не вмешивались; подобные сцены были для них обыденностью - мало ли в чем провинилась капризная девчонка?"
    gg "- パパが来て、学校の建物から引きずり出されて、私は噛んだり引っ掻いたりして抵抗した。先生たちは見てるだけだった。いつものことだったからね…子ども一人が何をしたかなんてどうでもいいんでしょ？"

# game/pnc_text.rpy:147
translate japanese backpack_6f074fed:

    # gg "- Затем он затолкал меня в машину и мы молча ехали до самого дома."
    gg "- 私は車に押し込まれて、静まり返った車で家に向かった。"

# game/pnc_text.rpy:148
translate japanese backpack_5c8684eb_1:

    # gg "- Дома нас встретила мама, мы втроем поужинали и разошлись по комнатам."
    gg "- ママが出迎えてくれて、夕飯を一緒に食べてそれぞれの部屋に戻った。"

# game/pnc_text.rpy:151
translate japanese backpack_f4ea4fbc:

    # gg "- Прошу, давай не будем об этом больше..."
    gg "- お願い、もうこの話はやめよう…"

translate japanese strings:
    # game/pnc_text.rpy:152
    old "(Нет, ты расскажешь мне еще раз.)"
    new "（いや、もう一度話して。）"

# game/pnc_text.rpy:156
translate japanese backpack_d2c4cf06_2:

    # gg "- ..."
    gg "- …"

# game/pnc_text.rpy:157
translate japanese backpack_d2c4cf06_3:

    # gg "- ..."
    gg "- …"

# game/pnc_text.rpy:158
translate japanese backpack_63b32716:

    # gg "- По пути домой папа купил молоко."
    gg "- パパが帰り道に牛乳を買った。"

# game/pnc_text.rpy:161
translate japanese backpack_ec611f59:

    # gg "- Снова."
    gg "- まただよ。"

# game/pnc_text.rpy:164
translate japanese backpack_13c5cb72:

    # gg "- Как же я ненавижу молоко..."
    gg "- 私牛乳が大っ嫌い。"

# game/pnc_text.rpy:165
translate japanese backpack_2c86c5a7:

    # gg "- Мамы дома не было."
    gg "- ママは家にいなかった。"

# game/pnc_text.rpy:168
translate japanese backpack_ec611f59_1:

    # gg "- Снова."
    gg "- まただよ。"

# game/pnc_text.rpy:171
translate japanese backpack_e5f17701:

    # gg "- Как же я ненавижу маму..."
    gg "- 私ママが大っ嫌い。"

# game/pnc_text.rpy:176
translate japanese backpack_eed923f3:

    # "Вдруг я чувствую чей-то взгляд на своей спине. Зная, что такие моменты ни в коем случае нельзя игнорировать, я резко оборачиваюсь."
    "突然、背中に視線を感じた。この瞬間を無視してはならないことが分かった。振り返る。"

# game/pnc_text.rpy:177
translate japanese backpack_01440056:

    # "Но там ничего нет."
    "そこには何もいなかった。"

translate japanese strings:
    # game/pnc_text.rpy:172
    old "(Что было дальше?)"
    new "（その後はどうなったの？）"

# game/pnc_text.rpy:182
translate japanese backpack_fdeda4ab:

    # gg "- Все, что было дальше, произошло уже после того, как случилось кое-что, после чего произошло все, что было после этого."
    gg "- 次に起こることは全て、何かの後に起こったことで、何かが起こった後に、それが全ての出来事につながっていく。"

# game/pnc_text.rpy:185
translate japanese backpack_672cab95:

    # "Я вновь смотрю на рюкзак. Свет из окна отражается на мелких металлических деталях. А еще он отбрасывает тень - значит, он реален. К несчастью."
    "もう一度カバンを見た。窓から部屋に差し込む光で金属部分が光っている。その下には陰もできていて、リアルなものだってことを示している。悲しいな。"

# game/pnc_text.rpy:188
translate japanese backpack_cda0aac6:

    # gg "- Ну и пусть, какое мне вообще дело!"
    gg "- 何でもいい、どうせ気にしてないからさ！"

# game/pnc_text.rpy:191
translate japanese backpack_64a10fb8:

    # "Я едва не пинаю рюкзак в порыве внезапного гнева, но в последний момент беру себя в руки."
    "突然怒りが湧いてきてカバンを蹴り上げそうになったが、間一髪でやめられた。"

# game/pnc_text.rpy:192
translate japanese backpack_853cfd12:

    # "Если сдвину его хоть на сантиметр, вся картина развалится и я ослепну. Сколько раз это уже происходило... не сосчитать."
    "1ミリでも動かしたら、全体像が崩壊して私の目は見えなくなる。何度も同じ目に合っている…数えきれないほど。"

translate japanese strings:
    # game/pnc_text.rpy:193
    old "(Что значит 'ослепнешь'?)"
    new "（どういう意味、見えなくなるって？）"

# game/pnc_text.rpy:197
translate japanese backpack_3052d71a:

    # gg "- Мне понадобились месяцы, чтобы выучить расположение каждого предмета в комнате. Именно поэтому я вижу все так четко и ясно."
    gg "- 部屋中にあるものの場所を覚えるのに数か月費やしたの。だから今はっきりくっきりと部屋のものが見えるんだよ。"

# game/pnc_text.rpy:200
translate japanese backpack_24c29394:

    # gg "- Тебе не понять."
    gg "- 分からないでしょうね。"

translate japanese strings:
    # game/pnc_text.rpy:201
    old "(Посмотри под ноги.)"
    new "（足元を見て。）"

# game/pnc_text.rpy:203
translate japanese backpack_585ebf61:

    # "Я опускаю глаза и вижу, как со стороны рюкзака ко мне ползет маленькое насекомое. Светится едва-едва, и даже взлететь не может... по всей видимости, этот светлячок очень устал."
    "視線を落とすと、小さな昆虫が私のカバンから出てこっちに向かっている。光はかすかで、もう飛ぶこともできないようだ…このホタルはすごく疲れているみたい。"

# game/pnc_text.rpy:204
translate japanese backpack_28b7c84e:

    # "Я наклоняюсь, чтобы подобрать его."
    "かがんで手に取ろうとした。"

# game/pnc_text.rpy:205
translate japanese backpack_0b155769:

    # "От прикосновения светлячок ярко замерцал и вдруг взлетел!"
    "私が触れた途端ホタルは強く光を放って飛び立った！"

# game/pnc_text.rpy:208
translate japanese backpack_875b757a:

    # gg "- Молодец, малыш! Так держать!"
    gg "- その調子だよ！よくやったよ！"

# game/pnc_text.rpy:211
translate japanese backpack_bf1a1939:

    # "Сделав победный круг по комнате, он на большой скорости понесся в мою сторону. Я зажмурилась в ожидании того, как светлячок залетит мне в ухо."
    "勝利の飛行を見せたあと、ホタルは私の方へすごいスピードで向かってきた。私は目を閉じ、ホタルが耳に入ってくる予感がした。"

# game/pnc_text.rpy:212
translate japanese backpack_094d4a3b:

    # "Так и произошло; оказавшись внутри, он какое-то время продолжал жужжать у меня в черепе, а потом затих."
    "その通りになった。ホタルが中に入ってきて、少しの間羽を震わせたあと、静かになった。"

# game/pnc_text.rpy:215
translate japanese backpack_c68f72e4:

    # gg "- Этот какой-то грустный..."
    gg "- なんだか悲しいね…"

translate japanese strings:
    # game/pnc_text.rpy:216
    old "(Интересно, почему?)"
    new "（どうしてなの…）"

# game/pnc_text.rpy:220
translate japanese backpack_a097dd72:

    # gg "- Это неважно. Главное, что теперь он не одинок!"
    gg "- 問題ない。大事なのは、あの子がもうひとりぼっちじゃないってこと！"

translate japanese strings:
    # game/pnc_text.rpy:221
    old "(Ладно. Давай искать дальше?)"
    new "（そうだね。もう少し探す？）"

# game/pnc_text.rpy:244
translate japanese papers_cb8dd79e:

    # "Обычные тетрадные листы, приклеенные к стене на скотч. На них изображены картинки с цифрами - единственная информация, которую я воспринимаю без особых трудностей."
    "いつも使っているノートの1ページがガムテープで貼りつけられている。数字が書いてある。これが唯一、問題なく取り込める情報だ。"

translate japanese strings:
    # game/pnc_text.rpy:245
    old "(Дозировка и побочные эффекты?)"
    new "（用法・用量と副作用？）"

# game/pnc_text.rpy:248
translate japanese papers_90766208:

    # gg "- Угу."
    gg "- うん。"

translate japanese strings:
    # game/pnc_text.rpy:249
    old "(Я думал, ты знаешь их наизусть.)"
    new "（暗記してると思ってた。）"

# game/pnc_text.rpy:253
translate japanese papers_ea9753d4:

    # gg "- Да..."
    gg "- そうだね…"

translate japanese strings:
    # game/pnc_text.rpy:256
    old "(Это ведь не твой почерк, верно?)"
    new "（あなたの字じゃないよね？）"

# game/pnc_text.rpy:260
translate japanese papers_d2c4cf06:

    # gg "- ..."
    gg "- …"

# game/pnc_text.rpy:263
translate japanese papers_e9c33d7f:

    # "Конечно же, нет. Обрывистые и неровные линии, корявые и некрасивые цифры... Не почерк; скорее, царапины от когтей."
    "もちろん違う。ガタガタで、線からはみ出していて、醜い数字…これは文字じゃない、もはや爪痕だ。"

translate japanese strings:
    # game/pnc_text.rpy:264
    old "(Не забудь сказать спасибо маме.)"
    new "（ママに感謝しないとね。）"

# game/pnc_text.rpy:268
translate japanese papers_c31fcb47:

    # gg "- Отстань!"
    gg "- あなたの助言は要らない！"

# game/pnc_text.rpy:271
translate japanese papers_cf0ae0d1:

    # "От моего крика листы забеспокоились, зашелестели; спустя секунду из-под одного лениво показался светлячок."
    "私が叫ぶと紙がひらひらと揺れた。そして、紙の下からホタルが出てきた。"

# game/pnc_text.rpy:272
translate japanese papers_3f22d077:

    # "Деловито оглянувшись, он деловито вспорхнул и не менее деловито залетел мне в ухо."
    "ホタルは事務的な様子であたりを見渡した後、事務的に飛んで、私の事務的な耳に入ってきた。" 

# game/pnc_text.rpy:277
translate japanese papers_fc3f9e8b:

    # gg "- Давай искать дальше."
    gg "- ホタル探し、続けよう。"

# game/pnc_text.rpy:299
translate japanese bed_4400afce:

    # "Хи-хи, это мой спальный мешок! Мягкий и теплый; я уверена, что любое живое существо не отказалось бы провести в нем минутку-другую."
    "えへへ、これは私の寝袋！ふわふわで温かいの。ここで1分でも長く過ごしたいって誘惑に勝てる生物はきっといないよ。"

# game/pnc_text.rpy:300
translate japanese bed_649f7dfb:

    # "Зарыться поглубже, прихватив с собой пару любимых вещей, закрыть глаза и..."
    "お気に入りのアイテムをいくつか持って入って、目を閉じて、それから…"

translate japanese strings:
    # game/pnc_text.rpy:301
    old "(Эй! Ты что, уже спишь?)"
    new "（ねぇ！寝落ちしたの？）"

# game/pnc_text.rpy:304
translate japanese bed_8930ec26:

    # gg "- А?.."
    gg "- え…？"

# game/pnc_text.rpy:307
translate japanese bed_a8bbb4e1:

    # "Я слегка ударяю себя по щекам, чтобы прийти в чувство. Время уже далеко за полночь; в обычные дни я уже сплю как убитая. Но сейчас никак нельзя!.."
    "意識を戻すために自分の頬を軽くはたいた。もう夜も深い。いつもなら丸太みたいに眠りこけてる時間だ。でも、今は、ダメだ…！"

# game/pnc_text.rpy:310
translate japanese bed_fc3f9e8b:

    # gg "- Давай искать дальше."
    gg "- 探し続けよう。"

translate japanese strings:
    # game/pnc_text.rpy:311
    old "(Эй, а может внутри кто-то есть?)"
    new "（ねぇ、中になにかあるかな？）"

# game/pnc_text.rpy:315
translate japanese bed_f621a758:

    # gg "- Не-а. Моим мыслям несвойственно усыплять, скорее, наоборот: они всегда провоцируют бессонницу. И сегодня как раз такой день."
    gg "- ないね。私の思考には眠りにつくっていう機能がないの。逆に、いつも不眠症になるんだよ。今夜みたいにね。"

translate japanese strings:
    # game/pnc_text.rpy:316
    old "(Что?)"
    new "（何？）"

# game/pnc_text.rpy:320
translate japanese bed_1c6c319f:

    # gg "- Здесь искать бессмысленно, говорю."
    gg "- ここを探しても意味はないって言ったの。"

# game/pnc_text.rpy:340
translate japanese clock_686cd361:

    # "Я гляжу на часы - время неумолимо движется."
    "目覚まし時計を見る。時間は止まることなく進み続ける。"

# game/pnc_text.rpy:342
translate japanese clock_df7eb0c2:

    # gg "- Уже так поздно..."
    gg "- もう遅いね…"

translate japanese strings:
    # game/pnc_text.rpy:343
    old "(Устала?)"
    new "（疲れた？）"

# game/pnc_text.rpy:347
translate japanese clock_27a18cb3:

    # gg "- Еще как..."
    gg "- そう見えるでしょ…"

# game/pnc_text.rpy:350
translate japanese clock_33ee45a6:

    # "Я демонстративно громко зеваю и вытягиваю руки в стороны."
    "芝居がかったあくびをしながら伸びをする。"

# game/pnc_text.rpy:351
translate japanese clock_038f9fa3:

    # "Раз-два."
    "いち、に。"

# game/pnc_text.rpy:352
translate japanese clock_332f57b4:

    # "Затем поднимаю их над головой."
    "両手を上にあげてみた。"

# game/pnc_text.rpy:353
translate japanese clock_557547f8:

    # "Три-четыре."
    "さん、し。"

# game/pnc_text.rpy:354
translate japanese clock_6e34fd04:

    # "Может, небольшая гимнастика поможет взбодриться?"
    "体を動かしたらリフレッシュできるかも？"

translate japanese strings:
    # game/pnc_text.rpy:355
    old "(Неплохая идея! Помнишь упражнения, которым тебя учили?)"
    new "（なるほどね！習った体操とか覚えてる？）"

# game/pnc_text.rpy:359
translate japanese clock_649f3fc1:

    # gg "- Вроде, помню..."
    gg "- 多分…"

# game/pnc_text.rpy:362
translate japanese clock_8d94999f:

    # "Я неуверенно встаю в стойку; пятки вместе, носки врозь... Или как там было?"
    "躊躇いながら体を動かす。どうだっけ…かかとを引っ付けて、つま先は外向き？"

# game/pnc_text.rpy:365
translate japanese clock_a39e73c9:

    # gg "- Ладно, будь что будет. Засекай пять минут!"
    gg "- なんでもいいや、これでいこう。5分測って！"

translate japanese strings:
    # game/pnc_text.rpy:366
    old "(Засек. Хотя у тебя часы прямо перед носом, вообще-то.)"
    new "（分かった。目の前に時計あるけどね。）"

# game/pnc_text.rpy:370
translate japanese clock_3866490e:

    # gg "- Я не могу слишком долго смотреть на стрелки."
    gg "- 針を長く見てられないの。"

# game/pnc_text.rpy:373
translate japanese clock_3629485d:

    # "Сначала они будто бы идут в обратном направлении, затем и вовсе исчезают..."
    "最初は間違った方向に動いていくように見えてきて、それから完全に消える…"

# game/pnc_text.rpy:374
translate japanese clock_a20cefa7:

    # "..."
    "…"

# game/pnc_text.rpy:375
translate japanese clock_8af69835:

    # "А после этого всегда происходит какая-нибудь ерунда."
    "それで全部めちゃめちゃになる。"

# game/pnc_text.rpy:376
translate japanese clock_37721a79:

    # "В последний раз мне померещилась пара глаз на циферблате..."
    "前は時計の文字盤に目がついているのが見えた。"

# game/pnc_text.rpy:377
translate japanese clock_44335f8e:

    # "А еще..."
    "それから…"

# game/pnc_text.rpy:378
translate japanese clock_912ad87c:

    # "Когда-то давно мне слышались голоса..."
    "昔はよく声が聞こえた…"

# game/pnc_text.rpy:379
translate japanese clock_38d6eb28:

    # "Они будто... звали на помощь?"
    "彼らは…助けを求めていたのだろうか？"

# game/pnc_text.rpy:380
translate japanese clock_7dea574f:

    # "Ерунда, сущая ерунда."
    "めちゃくちゃだ、本当に。"

# game/pnc_text.rpy:381
translate japanese clock_dba34053:

    # "Ерунда же?"
    "めちゃくちゃだったでしょう？"

# game/pnc_text.rpy:382
translate japanese clock_0f7c6a07:

    # "Ерунда."
    "めちゃくちゃ。"

# game/pnc_text.rpy:385
translate japanese clock_b35d4af1:

    # gg "- Ну что, засек время?"
    gg "- ねぇ、時間測ってくれてる？"

translate japanese strings:
    # game/pnc_text.rpy:386
    old "(Боже, наконец-то...)"
    new "（はぁ、やっとだよ…）"

# game/pnc_text.rpy:390
translate japanese clock_213f59bc:

    # gg "- О чем ты?"
    gg "- どういうこと？"

translate japanese strings:
    # game/pnc_text.rpy:391
    old "(Я уже полчаса не могу до тебя достучаться.)"
    new "（30分も話しかけてたんだよ。）"

# game/pnc_text.rpy:395
translate japanese clock_8930ec26:

    # gg "- А?.."
    gg "- そう…？"

translate japanese strings:
    # game/pnc_text.rpy:396
    old "(Забудь. Светлячка видишь?)"
    new "（忘れて。ホタルはいる？）"

# game/pnc_text.rpy:400
translate japanese clock_1f91f806:

    # gg "- Н-нет..."
    gg "- い、いや…"

translate japanese strings:
    # game/pnc_text.rpy:401
    old "(Тогда давай искать дальше.)"
    new "（じゃあ捜索を続けようか。）"

# game/pnc_text.rpy:422
translate japanese can_73aa1f9a:

    # "Приблизившись к мусорному баку, я с любопытством заглядываю внутрь."
    "ゴミ箱に近づいて、興味本位で中をのぞいた。"

# game/pnc_text.rpy:423
translate japanese can_9cefa99d:

    # "Упаковки из-под лекарств, тетрадные листы и прочий мусор. Скука..."
    "薬の箱、ノートの紙きれ、他のガラクタ。つまらない…"

# game/pnc_text.rpy:425
translate japanese can_602f184f:

    # gg "- Здесь ничего. И правильно, ни один уважающий себя светлячок не стал бы прятаться в мусорке!"
    gg "- ここには何もないね。確かに、自尊心のあるホタルはゴミの山なんかに隠れないよ！"

translate japanese strings:
    # game/pnc_text.rpy:426
    old "(Пожалуй, соглашусь.) "
    new "（完全に同意だね。）"

# game/pnc_text.rpy:448
translate japanese fan_352aa8f3:

    # gg "- Хи-хи!"
    gg "- えへへ！"

translate japanese strings:
    # game/pnc_text.rpy:449
    old "(Что смешного?)"
    new "（何がおもしろいの？）"

# game/pnc_text.rpy:453
translate japanese fan_ac72e700:

    # gg "- Я представила себя светлячком, который видит перед собой огромный вентилятор."
    gg "-自分がね、おっきな扇風機をじっと見つめているホタルになったところを想像したの。"

translate japanese strings:
    # game/pnc_text.rpy:454
    old "(Ну и?..)"
    new "（それで…？）"

# game/pnc_text.rpy:458
translate japanese fan_e28ac19d:

    # gg "- Да я бы жуть как обзавидовалась!"
    gg "- すっごくうらやましくなった！"

# game/pnc_text.rpy:461
translate japanese fan_f43e7afd:

    # gg "- Единственное, что не дает ему взлететь - это клетка, в которой он заперт... ну и провод."
    gg "- 飛ぶことを妨げてるのはケージと…ケーブルか。"

# game/pnc_text.rpy:464
translate japanese fan_ecb0c3d8:

    # gg "- Он словно заключенный в тюрьме, если задуматься..."
    gg "- 考えてみたら囚人と変わらないよね。"

# game/pnc_text.rpy:467
translate japanese fan_f0cb13c4:

    # gg "- Грустно это все."
    gg "- すごく悲しい。"

translate japanese strings:
    # game/pnc_text.rpy:468
    old "(Ага.)"
    new "（そうだね。）"

# game/pnc_text.rpy:472
translate japanese fan_fc3f9e8b:

    # gg "- Давай искать дальше."
    gg "- 探索を続けよう。"

# game/pnc_text.rpy:492
translate japanese laptop_0178e4bf:

    # "Я смотрю на свой ноутбук. Из-за того, что я многие годы не прикасалась к нему, он покрыт слоем пыли толщиной в палец."
    "ノートパソコンを見た。何年も触っていないから何層ものホコリに覆われていて、指くらいの厚さになっている。"

# game/pnc_text.rpy:493
translate japanese laptop_32e9c419:

    # "Очень странный предмет. Я его побаиваюсь..."
    "奇妙なものだ。怖い。"

translate japanese strings:
    # game/pnc_text.rpy:498
    old "(Вот и отлично. Рассказывай!)"
    new "（すごいね。色々教えてよ！）"

# game/pnc_text.rpy:497
translate japanese laptop_369e40f2:

    # gg "- Это долгая и скучная история."
    gg "- 長くてつまんないよ。"

translate japanese strings:
    # game/pnc_text.rpy:503
    old "(Я настаиваю!)"
    new "（話して！）"

# game/pnc_text.rpy:502
translate japanese laptop_7fd94592:

    # gg "- М-м..."
    gg "- うーん…"

# game/pnc_text.rpy:507
translate japanese laptop_5f0d51e5:

    # gg "- Я не помню, как он появился в моей комнате."
    gg "- どうやって部屋に現れたのかは覚えてない。"

# game/pnc_text.rpy:508
translate japanese laptop_d05dfac5:

    # gg "- Наверное, кто-то из родителей принес его сюда, потому что не нашлось другого места."
    gg "- 置く場所に困った親が持ってきたのかな。"

# game/pnc_text.rpy:509
translate japanese laptop_ca6f1421:

    # gg "- Мне не запрещали им пользоваться - наоборот, даже поощряли."
    gg "- 使うことを禁止されなかった。むしろ、使いなさいって勧められたの。"

# game/pnc_text.rpy:512
translate japanese laptop_1826dfb6:

    # gg "- Еще бы, я целыми днями безвылазно сидела перед экраном! Игры, рисование, инженерный калькулятор, трехмерное моделирование..."
    gg "- それでね、私、画面の前で一日中過ごすようになったの！ゲーム、イラスト、工学計算、3Dモデリング…"

# game/pnc_text.rpy:515
translate japanese laptop_b3ebc70c:

    # gg "- Столько развлечений!"
    gg "- 楽しいことがたくさんあった！"


translate japanese strings:
    # game/pnc_text.rpy:516
    old "(Занятные у тебя были хобби.)"
    new "（おもしろい趣味を持ってたんだね。）"

# game/pnc_text.rpy:520
translate japanese laptop_87077ee0:

    # gg "- Ага, были... до выхода в сеть."
    gg "- そうなの…ウェブに入るまではね。"

translate japanese strings:
    # game/pnc_text.rpy:521
    old "(М-м?)"
    new "（ん？）"

# game/pnc_text.rpy:525
translate japanese laptop_30b90bb2:

    # gg "- Представь себе ситуацию: ты - хомячок, что живет под землей. У тебя есть все необходимое для комфортной жизни."
    gg "- 想像してみて。あなたは地下に住むハムスター。快適に暮らすために必要なものは全部持ってる。"

# game/pnc_text.rpy:528
translate japanese laptop_b730d7d5:

    # gg "- Представил?"
    gg "- 想像した？"

translate japanese strings:
    # game/pnc_text.rpy:529
    old "(Твои аналогии как всегда на высоте.)"
    new "（いつものことだけど、あなたの例えは細かいね。）"

    # game/pnc_text.rpy:531
    old "(Ну хорошо, представил.)"
    new "（うん、想像できた。）"

# game/pnc_text.rpy:535
translate japanese laptop_fdaff107:

    # gg "- Итак, ты - хомячок, что живет под землей. У тебя есть все необходимое для комфортной жизни, да?"
    gg "- じゃあ、あなたは地下に住むハムスターね。快適に暮らすために必要なものは全部持ってるの。"

translate japanese strings:
    # game/pnc_text.rpy:536
    old "(Да...)"
    new "(（うん…）"

# game/pnc_text.rpy:540
translate japanese laptop_5a413449:

    # gg "- Отлично! Значит, ситуация следующая: ты - хомячок, что живет..."
    gg "- いいね！で、状況はこう…あなたはハムスターで…"

translate japanese strings:
    # game/pnc_text.rpy:541
    old "(Ладно, я тебя понял. Хочешь поговорить о чем-то другом?)"
    new "（うん、わかったよ。何か他のことを話せない？）"

# game/pnc_text.rpy:545
translate japanese laptop_d2c4cf06:

    # gg "- ..."
    gg "- …"

# game/pnc_text.rpy:548
translate japanese laptop_d254e5a2:

    # gg "- Угу..."
    gg "- そうだね…"

translate japanese strings:
    # game/pnc_text.rpy:549
    old "(Все равно ведь вернешься к этой теме.)"
    new "（結局はその話に戻るんだろうけど。）"

# game/pnc_text.rpy:558
translate japanese laptop_d2c4cf06_1:

    # gg "- ..."
    gg "- ..."

# game/pnc_text.rpy:561
translate japanese laptop_6000601f:

    # gg "- В один прекрасный день тебя выкапывают из твоей хомячьей норки и приносят в зоомагазин. Теперь клетка - твой новый дом."
    gg "- ある晴れた日、誰かが地下の家からあなたを掘り出してペットショップに連れていくの。あなたの家はケージになった。"

# game/pnc_text.rpy:564
translate japanese laptop_03c88239:

    # gg "- Здесь гораздо удобнее и теплее, чем под землей."
    gg "- 地下に比べるとずっとあたたかくて、快適なの。"

# game/pnc_text.rpy:567
translate japanese laptop_cc648f6c:

    # gg "- А самое главное - здесь у тебя много соседей. Их клетки - точные копии твоей; да и сами хомячки как две капли воды похожи на тебя - выходит, вы ничем друг от друга не отличаетесь."
    gg "- 一番大事なのがね…ここにはたくさん隣人がいるってこと。彼らのケージはあなたのと同じ。他のハムスターもあなたと同じ見た目なの。つまり全部おんなじなの。"

# game/pnc_text.rpy:570
translate japanese laptop_88bcc6b1:

    # gg "- Кроме того, что они были рождены в этом зоомагазине."
    gg "- ただ一つだけ違うのが、彼らはショップで生まれたってこと。"

# game/pnc_text.rpy:573
translate japanese laptop_2497aa37:

    # gg "- Ты спросишь - но на что это указывает? А я тебе отвечу - да ни на что."
    gg "- あなたは聞くの、それが何を意味してるのって。私が答えてあげるんだよ、何にも意味はないよって。"

# game/pnc_text.rpy:576
translate japanese laptop_70f10b0e:

    # gg "- Я забыла, о чем шла речь..."
    gg "- 何の話をしてたんだっけ…"

translate japanese strings:
    # game/pnc_text.rpy:577
    old "(О, боже...)"
    new "（嘘でしょ…）"

# game/pnc_text.rpy:581
translate japanese laptop_7ee42079:

    # gg "- Ладно, давай начнем заново!"
    gg "- よし、初めからやろっか！"

translate japanese strings:
    # game/pnc_text.rpy:582
    old "(В этот раз постарайся обойтись без дурацких примеров с хомяками.)"
    new "（今回は、変なハムスター話はやめようか。）"

# game/pnc_text.rpy:586
translate japanese laptop_3b77990a:

    # gg "- Ты же знаешь, что я не виновата."
    gg "- 私が悪いわけじゃないでしょ。"

# game/pnc_text.rpy:589
translate japanese laptop_b061a70e:

    # gg "- Итак."
    gg "- さて。"

# game/pnc_text.rpy:590
translate japanese laptop_3690dc5f:

    # gg "- У меня было очень много друзей в сети. Десятки, сотни... всех не сосчитать."
    gg "- オンライン友だちがたくさんいたの。何十人、何百人…数えきれないほどね。"

# game/pnc_text.rpy:593
translate japanese laptop_f6f9494b:

    # gg "- Хотя, почему не сосчитать? Их было ровно триста семнадцать."
    gg "- あれ、数えられるか？ぴったり317人だった。"

# game/pnc_text.rpy:596
translate japanese laptop_9ca563cd:

    # gg "- Впрочем, никто не считает точное количество хомячков, когда заходит в зоомагазин..."
    gg "- でもね、ペットショップに入るときにハムスターの数をきちんと数えてる人なんていないと思うの…"

translate japanese strings:
    # game/pnc_text.rpy:597
    old "(Эй, не отвлекайся!)"
    new "（ねぇ、話がそれてるよ！）"

# game/pnc_text.rpy:601
translate japanese laptop_b97a9039:

    # gg "- Ах да!"
    gg "- あぁ、そうだった！"

# game/pnc_text.rpy:604
translate japanese laptop_ee66ebc9:

    # gg "- Из трехсот семнадцати друзей шестьдесят восемь увлекались играми - прямо как я!"
    gg "- 317人の友だちのうち、68人がゲーム好きだったの、私と同じでね！"

# game/pnc_text.rpy:605
translate japanese laptop_39f06a4e:

    # gg "- Еще сто тридцать друзей любили рисовать - ну в точности как я!"
    gg "- 130人はイラストを描くのが好きだった、私と同じでね！"

# game/pnc_text.rpy:606
translate japanese laptop_be83ef93:

    # gg "- Оставшиеся сто девятнадцать друзей увлекались калькуляторами и трехмерной графикой в равной степени."
    gg "- 残りの119人は同等に、計算とか3Dモデリングが好きだった。"

# game/pnc_text.rpy:609
translate japanese laptop_048d14d4:

    # gg "- И когда я говорю ‘в равной степени’, я не имею в виду ‘по пятьдесят девять с половиной друзей с каждой стороны’."
    gg "- 「同等に」って言ったけど、それぞれ59人ずつって意味ではないからね。"

# game/pnc_text.rpy:612
translate japanese laptop_ddb17af4:

    # gg "- Понимаешь?"
    gg "- 理解した？"

# game/pnc_text.rpy:615
translate japanese laptop_66951c3e:

    # gg "- Сто девятнадцать можно разделить пополам без проблем, но с друзьями математика работает по-другому... Ну что за напасть, а?"
    gg "- 数字は問題なく同等に分割できるけど、友だちのことになると数学はそううまく機能しないからね…大きな難問だよね。"

translate japanese strings:
    # game/pnc_text.rpy:616
    old "(Давай ближе к делу.)"
    new "（結論を教えて。）"

# game/pnc_text.rpy:620
translate japanese laptop_6d94f79c:

    # gg "- Разумеется, я знала, что настоящих людей в сети не существует."
    gg "- 当然だけど、ウェブ上に本物の人間はいないことは分かってた。"

# game/pnc_text.rpy:621
translate japanese laptop_09142f27:

    # gg "- И, выключая компьютер, я понимала, что все мои друзья умирают в тот же момент."
    gg "- それに、私がパソコンの電源を落とした瞬間に友だちはみんな死ぬってことも分かってた。"

# game/pnc_text.rpy:624
translate japanese laptop_fd42c0ca:

    # gg "- И все же, я ни капли не беспокоилась..."
    gg "- それでも少しも不安じゃなかった…"

# game/pnc_text.rpy:629
translate japanese laptop_35b3eb5c:

    # gg "- Знаешь, из чего состоят компьютерные программы? Это всего-навсего комбинация чисел."
    gg "- コンピュータのプログラムが何で構成されてるか知ってる？ただの数字の組み合わせなんだよ。"

# game/pnc_text.rpy:632
translate japanese laptop_ec2ec1d3:

    # gg "- Значит, и мои друзья - это числа. Не находишь это занятным?"
    gg "- つまり私の友達も数字ってことなんだよ。おもしろくない？"

translate japanese strings:
    # game/pnc_text.rpy:633
    old "(Не особо.)"
    new "（あんまり。）"

translate japanese strings:
    # game/pnc_text.rpy:635
    old "(Почему ты называешь их друзьями?)"
    new "（どうして友だちって呼ぶの？）"

# game/pnc_text.rpy:639
translate japanese laptop_2fe59e50:

    # gg "- Ну как же! Все, кто разделяет мои интересы - мои друзья. И неважно, знают ли они о моем существовании или нет."
    gg "- だって…！共通の趣味があったら友だちでしょ。友だちが私の存在を知ってるかどうかはどうでもいい。"

# game/pnc_text.rpy:642
translate japanese laptop_a2053065:

    # gg "- Так вот! У каждой программы есть определенный алгоритм, задача - словом, математическая формула."
    gg "- とにかく…、さっきも言ったけど…！プログラムにはそれぞれアルゴリズムと目的があって、数式があるの。"

# game/pnc_text.rpy:643
translate japanese laptop_d2b39157:

    # gg "- И если решить эту формулу, ты точно будешь знать, как программа поведет себя в тот или иной момент."
    gg "- その数式を解いたら、いつでもプログラムの挙動を予測できるようになるの。"

translate japanese strings:
    # game/pnc_text.rpy:644
    old "(Чем дальше - тем меньше я понимаю, о чем ты.)"
    new "（話が進むにつれて分からなくなってきたよ。）"

# game/pnc_text.rpy:648
translate japanese laptop_80add5f4:

    # gg "- Тебе не нужно что-либо понимать. Просто слушай."
    gg "- 理解する必要はないよ、いいから聞いてて。"

# game/pnc_text.rpy:651
translate japanese laptop_08543ea7:

    # "Я сажусь на пол, и экран ноутбука оказывается прямо у меня перед глазами. В нем я вижу лишь свое тусклое отражение и больше ничего."
    "床に腰を下ろすと目の前にパソコンの画面が現れた。映っているのは私のうす暗い顔だけ。"

# game/pnc_text.rpy:654
translate japanese laptop_6f1b1d71:

    # gg "- Человек из сети - это случайная картинка и случайный набор букв. Слова и поступки человека из сети - это программный код."
    gg "- ウェブ上の人なんてただの適当な画像と適当な文字列でしょ。ウェブ上の人からのメッセージや行動は実行可能なコード。"

# game/pnc_text.rpy:657
translate japanese laptop_d2c4cf06_2:

    # gg "- ..."
    gg "- …"

# game/pnc_text.rpy:664
translate japanese laptop_d2c4cf06_3:

    # gg "- ..."
    gg "- …"

# game/pnc_text.rpy:667
translate japanese laptop_c37d7625:

    # gg "- Однажды кое-кто появился. С тех пор компьютер все время включен."
    gg "- いつだったか、ある人が現れたの。そのときから私のパソコンは常にオンになってた。"

# game/pnc_text.rpy:670
translate japanese laptop_bf04f233:

    # gg "- В сети не бывает настоящих людей, но ему удавалось притворяться. В какой-то момент я позволила себя обмануть..."
    gg "- ウェブ上にリアルな人はいないけど、彼はリアルのふりをするのがうまかったの。いつからか、私は騙されるようになった…"

translate japanese strings:
    # game/pnc_text.rpy:660
    old "(Дай мне знать, если тебе нужна передышка.)"
    new "（しんどくなったら言ってね。）"

translate japanese strings:
    # game/pnc_text.rpy:671
    old "(Эй, смотри!)"
    new "（ねぇ、見て！）"

# game/pnc_text.rpy:675
translate japanese laptop_8930ec26:

    # gg "- А?.."
    gg "- ん…？"

# game/pnc_text.rpy:678
translate japanese laptopff_744d5f7e:

    # "Вдруг из вентиляционной решетки ноутбука медленно выбирается светлячок. Я протягиваю руку; тот взбирается на ладонь, беспрестанно моргая."
    "突然、パソコンの通気口からホタルがゆっくりと這い出てきた。手を伸ばす。ホタルは私の手のひらに乗り、絶え間なく羽を動かした。"

translate japanese strings:
    # game/pnc_text.rpy:679
    old "(По-моему, он пытается что-то сказать.)"
    new "（何か言おうとしてるんじゃない。）"

# game/pnc_text.rpy:684
translate japanese laptopff_535e540c:

    # gg "- Я и сама вижу. Знать бы, что именно..."
    gg "- そうみたいだね。ただ、内容が分からない…"

translate japanese strings:
    # game/pnc_text.rpy:685
    old "(Похоже на шифр. Разве тебе не хочется его разгадать?)"
    new "（なんかサイファーみたい。解いてみたくない？）"

# game/pnc_text.rpy:689
translate japanese laptopff_2f2a6c77:

    # gg "- Я передумала. Я на за что на свете не хочу знать, что он пытается сказать."
    gg "- 気が変わった。この子が言いたがってることを分かろうとなんて全く思わない。"

# game/pnc_text.rpy:690
translate japanese laptopff_d9c14513:

    # "После этих слов светлячок на секунду гаснет."
    "それからホタルは一瞬光るのをやめた。"

# game/pnc_text.rpy:691
translate japanese laptopff_dc2ada86:

    # "Затем, словно придя в себя, загорается вновь."
    "それから、意識がふと戻ったみたいにまた光り始めた。"

# game/pnc_text.rpy:692
translate japanese laptopff_7662646e:

    # "Какое-то время он обдумывает дальнейшие действия, после чего поднимается в воздух и стремительно залетает ко мне в ухо."
    "ホタルはしばらく次の行動を考えていて、飛び上がって私の耳に猛スピードで入ってきた。"

# game/pnc_text.rpy:693
translate japanese laptopff_fc3f9e8b:

    # gg "- Давай искать дальше."
    gg "- 探索を続けよう。"

translate japanese strings:
    # game/pnc_text.rpy:701
    old "(А как же твой рассказ?)"
    new "（話の続きは？）"

# game/pnc_text.rpy:705
translate japanese rasskaz_d2c4cf06:

    # gg "- ..."
    gg "- …"

translate japanese strings:
    # game/pnc_text.rpy:706
    old "(Должно быть, ты злишься, что я прервал тебя. Извини.)"
    new "（私が邪魔したから怒ってるんでしょ。ごめん。）"

# game/pnc_text.rpy:710
translate japanese rasskaz_d2c4cf06_1:

    # gg "- ..."
    gg "- …"

# game/pnc_text.rpy:713
translate japanese rasskaz_5f0715b8:

    # gg "- Если ты все сделаешь правильно, я закончу рассказ. Возможно..."
    gg "- あなたがちゃんとしてくれたら、私は話し終えられる。きっとね…"

translate japanese strings:
    # game/pnc_text.rpy:714
    old "(Обещаешь?)"
    new "（約束する？）"

# game/pnc_text.rpy:718
translate japanese rasskaz_cc81ff2c:

    # gg "- Обещаю."
    gg "- 約束する。"

translate japanese strings:
    # game/pnc_text.rpy:719
    old "(А если забудешь?)"
    new "（忘れちゃったら？）"

# game/pnc_text.rpy:721
translate japanese rasskaz_206e880f:

    # gg "- Тогда напомни мне. Кодовым словом, например."
    gg "- 思い出させて。例えば合言葉とかでさ。"

translate japanese strings:
    # game/pnc_text.rpy:722
    old "(Каким же?)"
    new "（どんな合言葉？）"

# game/pnc_text.rpy:724
translate japanese rasskaz_d4a9506f:

    # gg "- Потом придумаю."
    gg "- 考えておく。"

# game/pnc_text.rpy:727
translate japanese rasskaz_2e503c3b:

    # gg "- А сейчас - давай искать моих светлячков!"
    gg "- 今は、ホタルの探索の続きをしよう！"

# game/pnc_text.rpy:749
translate japanese notebook_73622d2a:

    # "Это моя тетрадь для рисунков. Половина страниц пустует - значит, хватит еще на пару лет."
    "私のスケッチブック。半分くらいのページが真っ白だ、あと数年は使い続けられる。"

translate japanese strings:
    # game/pnc_text.rpy:750
    old "(Ты так редко рисуешь? Почему?)"
    new "（たまにしか描かないの？どうして？）"

# game/pnc_text.rpy:753
translate japanese notebook_2fdb1c40:

    # gg "- Разве не очевидно? Если закончатся страницы - придется покупать новую тетрадь."
    gg "- 簡単じゃない？使い切っちゃったら、新しいスケッチブックを買わなきゃいけないでしょ。"

# game/pnc_text.rpy:754
translate japanese notebook_25c9dcf1:

    # gg "- До канцелярского магазина пешком не добраться, придется ехать на автобусе."
    gg "- 文具店には歩いていけないから、バスに乗らないといけない。"

# game/pnc_text.rpy:757
translate japanese notebook_0fdb62bd:

    # gg "- Ты вообще представляешь, каким кошмаром это может обернуться?"
    gg "- それがどんな悪夢に変わるかわかる？"

translate japanese strings:
    # game/pnc_text.rpy:758
    old "(Так, может, попросишь маму купить тебе тетрадь?)"
    new "（じゃあ、ママにお願いして買ってもらうのはどう？）"

# game/pnc_text.rpy:762
translate japanese notebook_b5dc11a0:

    # gg "- Что купить? Кого попросить? Ты вообще умеешь расставлять акценты в речи?"
    gg "- 買ってもらう？誰にお願いするって？もうちょっと論理的な話をしてくれないかな？"

translate japanese strings:
    # game/pnc_text.rpy:763
    old "(Не придуривайся. Лучше попроси маму купить тебе тетрадь.)"
    new "（ごまかさないで。代わりにママにノートを買ってもらえばいいじゃない。）"

# game/pnc_text.rpy:767
translate japanese notebook_61128a51:

    # gg "- Лучше? То есть ты просишь от меня совершить сразу несколько действий, при этом говоря, что одно лучше другого?"
    gg "- 代わりに？つまり私に一連の行動を起こしてほしいくせに、その代わりの行動をしろって言ってるの？"

# game/pnc_text.rpy:770
translate japanese notebook_7b0afc12:

    # gg "- Тогда зачем мне выполнять то, которое хуже?"
    gg "- どっちの行動を取るかはどうやって決めればいいの？"

# game/pnc_text.rpy:773
translate japanese notebook_3e4cfd0b:

    # gg "- Ты и пары слов связать не можешь, хи-хи!"
    gg "- 論理が破綻してるよ！"

translate japanese strings:
    # game/pnc_text.rpy:774
    old "(Боже, как с тобой тяжело...)"
    new "（まったく、あきれた…）"

# game/pnc_text.rpy:778
translate japanese notebook_ff6dd08d:

    # gg "- Тебе недостает чуткости. Разве это моя вина?"
    gg "- あなたには情が足りてないね。私のせい？"

# game/pnc_text.rpy:784
translate japanese notebook_a5db7b1c:

    # "Я подхожу чуть ближе к тетради, переступая через провода, спальный мешок, трещины в ламинате и отблески из окна."
    "スケッチブックに歩み寄り、リング、ひび割れたラミネート、窓の反射を踏み越える。"

# game/pnc_text.rpy:785
translate japanese notebook_508d510d:

    # "Тетрадь лежит на табуретке; с высоты моего взгляда кажется, что у табуретки недостает двух ножек. Опускаюсь на корточки - все ножки на месте."
    "スケッチブックは椅子に置いてある。私の背丈からは椅子の足が2本足りていないように見える。かがんでもう一度見た。足は全部そろっていた。"

# game/pnc_text.rpy:786
translate japanese notebook_dde63762:

    # "Могу ли я придумать интересную аллегорию?"
    "私はおもしろい寓話を考えつくことができるのだろうか？"

translate japanese strings:
    # game/pnc_text.rpy:787
    old "(Давай без этого, а?)"
    new "（あ、そっちに行くのはやめておこう、ね？）"

# game/pnc_text.rpy:789
translate japanese notebook_c146e361:

    # "Я поднимаюсь и смотрю на тетрадь в упор."
    "立ち上がり、数センチ先にあるスケッチブックを観察する。"

# game/pnc_text.rpy:790
translate japanese notebook_bcd03463:

    # "Листы белоснежно чистые; последний рисунок похоронен на предыдущей странице. Так и должно быть."
    "紙の色は純白。最後のイラストは前のページに埋もれている。これがあるべき姿。"

translate japanese strings:
    # game/pnc_text.rpy:791
    old "(Жаль, мне бы хотелось взглянуть.)"
    new "（残念、見てみたかった。）"

# game/pnc_text.rpy:795
translate japanese notebook_f01e6c1d:

    # gg "- В другой раз."
    gg "- また今度ね。"

# game/pnc_text.rpy:798
translate japanese notebook_8dcb67c3:

    # "Вдруг в комнату ворвался прохладный ветер - тетрадные листы зашелестели."
    "突然冷たい空気が部屋にヒュっと入り込んできて、ページがハラハラとめくれた。"

# game/pnc_text.rpy:801
translate japanese notebook_705c7ef0:

    # gg "- Н-нет!.."
    gg "- 待って…！"

# game/pnc_text.rpy:804
translate japanese notebook_ce173ba3:

    # "Я зажмуриваюсь."
    "目を閉じる。"

# game/pnc_text.rpy:805
translate japanese notebook_4a5bbcff:

    # "Отчетливый и характерный звук перелистываемых страниц отдается головной болью - я знаю, что сейчас произойдет..."
    "ページがめくれる独特の音が頭痛をともなって頭に反響する。この後何が起こるかは分かっている…"

# game/pnc_text.rpy:806
translate japanese notebook_a20cefa7:

    # "..."
    "…"

# game/pnc_text.rpy:807
translate japanese notebook_b092dc1b:

    # "Шелест прекратился, хотя ветер продолжал завывать из всех щелей. Это значит только одно - тетрадь открыта на первой странице."
    "風はまだあちこちでひゅうひゅうと吹いているけれど、ページがめくれる音は止んだ。ということはつまり、ノートの最初のページが開いた状態になっている。"

# game/pnc_text.rpy:808
translate japanese notebook_1dec8145:

    # "Если я подожду еще немного, ветер захлопнет ее."
    "もう少し待てば、風がノートを閉じてくれる。"

# game/pnc_text.rpy:809
translate japanese notebook_759776ee:

    # "Мне не придется смотреть... если я подожду еще немного."
    "私が見る必要はない…もう少し待ちさえすれば。"

# game/pnc_text.rpy:810
translate japanese notebook_f01278fc:

    # "Если я..."
    "待っていれば…"

translate japanese strings:
    # game/pnc_text.rpy:811
    old "(Открой глаза.)"
    new "（目を開けて。）"

# game/pnc_text.rpy:813
translate japanese notebook_827bf4c2:

    # gg "- Нет!"
    gg "- 嫌だ！"

translate japanese strings:
    # game/pnc_text.rpy:814
    old "(Все хорошо, просто открой глаза.)"
    new "（大丈夫、目を開けてみて。）"

# game/pnc_text.rpy:816
translate japanese notebook_271f7539:

    # gg "- Ни за что! Я знаю, что ты врешь!"
    gg "- 絶対に嫌！嘘ついてるんでしょ！"

translate japanese strings:
    # game/pnc_text.rpy:817
    old "(Успокойся.)"
    new "（落ち着いて。）"

# game/pnc_text.rpy:819
translate japanese notebook_827bf4c2_1:

    # gg "- Нет!"
    gg "- 無理！"

# game/pnc_text.rpy:822
translate japanese notebook_827bf4c2_2:

    # gg "- Нет!"
    gg "- 無理！"

# game/pnc_text.rpy:825
translate japanese notebook_827bf4c2_3:

    # gg "- Нет!"
    gg "- 無理！"

# game/pnc_text.rpy:828
translate japanese notebook_827bf4c2_4:

    # gg "- Нет!"
    gg "- 無理！"

# game/pnc_text.rpy:831
translate japanese notebook_d2c4cf06:

    # gg "- ..."
    gg "- …"

# game/pnc_text.rpy:834
translate japanese notebook_d2c4cf06_1:

    # gg "- ..."
    gg "- …"

# game/pnc_text.rpy:837
translate japanese notebook_d2c4cf06_2:

    # gg "- ..."
    gg "- …"

# game/pnc_text.rpy:838
translate japanese notebook_7e89ef29:

    # gg "- Ладно."
    gg "- 分かった。"

# game/pnc_text.rpy:841
translate japanese notebook_9b2c1786:

    # "Я с опаской открываю глаза. Тетрадь все так же распахнута на середине; ни рисунков, ничего - листы по-прежнему чистые."
    "最大の注意を払いつつ目を開けた。ノートの真ん中あたりのページが開いていた。何も描かれていない。そのページはまだ真っ白だ。"

# game/pnc_text.rpy:842
translate japanese notebook_57fd477a:

    # gg "- Померещилось?.."
    gg "- 私が想像したの…？"

translate japanese strings:
    # game/pnc_text.rpy:843
    old "(Не знаю. Померещилось ли?)"
    new "（分からない。した？）"

# game/pnc_text.rpy:847
translate japanese notebook_094deede:

    # gg "- Ты же у нас все знаешь, вот и скажи мне!"
    gg "- あなたの方が頭いいでしょ、教えてよ！"

translate japanese strings:
    # game/pnc_text.rpy:848
    old "(В следующий раз не закрывай глаза.)"
    new "（次は目を閉じないで。）"

# game/pnc_text.rpy:852
translate japanese notebook_558198df:

    # gg "- Что ты?.."
    gg "- 何を…？"

# game/pnc_text.rpy:855
translate japanese notebook_efe61eb0:

    # "Не успела я договорить, как тетрадные листы вновь зашевелились."
    "言葉を終えられなかった。またページがめくれ始めたのだ。"

translate japanese strings:
    # game/pnc_text.rpy:856
    old "(Не закрывай глаза!)"
    new "（目を閉じないで！）"

# game/pnc_text.rpy:860
translate japanese notebook_d0521114:

    # gg "- Не заставляй меня, мне же страшно!"
    gg "- 強制しないで、怖いの！"

# game/pnc_text.rpy:865
translate japanese notebook_6372ec47:

    # "Шелест усиливается, листы приподнимаются - я могу разглядеть очертания рисунков на предыдущих страницах."
    "パラパラと音が大きくなっていき、ノートの1ページが持ち上げられ…もう少しで前のページのイラストの輪郭が見えそうだ。"

# game/pnc_text.rpy:866
translate japanese notebook_cf24a82c:

    # "Нет уж! Все, что было в прошлом, должно там и оставаться!"
    "最悪！過去のものは全て過去に留まるべきだ！"

translate japanese strings:
    # game/pnc_text.rpy:861
    old "(Верь мне.)"
    new "（私を信じて。）"

# game/pnc_text.rpy:869
translate japanese notebook_25767d3e:

    # gg "- Ты меня не убедил! Все, я закрываю глаза, слышишь?"
    gg "- あなたの言うことなんて聞かないんだから！目は閉じるよ！"

# game/pnc_text.rpy:874
translate japanese notebook_64646323:

    # "Между страниц просачивается едва различимый свет. С каждым порывом ветра он становится все ярче и ярче..."
    "かろうじて見える光が紙から浸透してくる。風が吹くたびにどんどん、どんどん明るくなって…"

translate japanese strings:
    # game/pnc_text.rpy:870
    old "(Смотри, смотри же!)"
    new "（見て、ほら見て！）"

# game/pnc_text.rpy:877
translate japanese notebook_9a40790e:

    # gg "- Светлячок!"
    gg "- ホタルだ！"

# game/pnc_text.rpy:880
translate japanese notebook_b496e578:

    # "Ветер вмиг прекращается. На секунду мир погружается в полную тишину, но лишь на секунду..."
    "風はすぐに止んだ。一瞬にして、世界は完璧な静寂へと沈んだ。ほんの一瞬だけ…"

# game/pnc_text.rpy:881
translate japanese notebook_b8632a5e:

    # "Вечно преследующий меня шум неумолимо заполоняет все вокруг. Но сейчас это неважно!"
    "いつも私につきまとってくるザワザワが周囲に充満している。でももう気にしない！"

# game/pnc_text.rpy:884
translate japanese notebook_ca849c5e:

    # gg "- Боже, малыш! Я так перепугалась..."
    gg "- はぁあ、あのホタル…本当に怖かった。"

# game/pnc_text.rpy:887
translate japanese notebook_ba5348c8:

    # "В ответ светлячок моргает, после чего поднимается в воздух и с громким жужжанием влетает мне в ухо."
    "ホタルは羽を震わせ、飛び上がって耳に入ってきた。ずっと大きな音を立てていた。"

# game/pnc_text.rpy:888
translate japanese notebook_72b512d0:

    # "Какое-то время он ищет подходящее место в моей голове, не прекращая жужжать, но потом затихает."
    "私の頭の中で居心地のいい場所を探している様子だったが、しばらくして音が落ち着いた。"

# game/pnc_text.rpy:891
translate japanese notebook_5794d60f:

    # gg "- Фух..."
    gg "- ふぅ…"

translate japanese strings:
    # game/pnc_text.rpy:892
    old "(Ты как, нормально?)"
    new "（大丈夫？）"

# game/pnc_text.rpy:896
translate japanese notebook_cf4086f9:

    # gg "- У нас мало времени, давай искать дальше."
    gg "- 時間が無くなってきてるから探索を続けようか。"

# game/pnc_text.rpy:916
translate japanese pills_311114e8:

    # "Я смотрю на кучу лекарств и голова идет кругом. Я не хочу сейчас думать об этом, совсем не хочу..."
    "薬の山に目をやるとめまいがする。考えたくない、考え…"

translate japanese strings:
    # game/pnc_text.rpy:917
    old "(Что с тобой?)"
    new "（どうしたの？）"

# game/pnc_text.rpy:920
translate japanese pills_73c963bb:

    # gg "- Сегодня я едва не пропустила курс. Что за безрассудство! Я ведь могла умереть..."
    gg "- 今日の薬を飲まずにいるところだった。無謀すぎるでしょ！死んでたかもしれないよ…"

translate japanese strings:
    # game/pnc_text.rpy:921
    old "(Эй, успокойся. Ты уже все исправила.)"
    new "（ねぇ、落ち着いて。もう解決したでしょ。）"

# game/pnc_text.rpy:925
translate japanese pills_4ca8d596:

    # gg "- Да, по твоему приказу!"
    gg "- そうだよ、あなたが命令したからね！"

translate japanese strings:
    # game/pnc_text.rpy:926
    old "(Это обвинение?)"
    new "（責めてるの？）"

# game/pnc_text.rpy:930
translate japanese pills_d08b4fbc:

    # gg "- Конечно же нет! Только это меня и спасло."
    gg "- そんなはずないでしょ！そのおかげで救われたんだから。"

translate japanese strings:
    # game/pnc_text.rpy:931
    old "(Что ж... вполне здравая мысль.)"
    new "（うん…そうだよね。）"

translate japanese strings:
    # game/pnc_text.rpy:926
    old "(Все могло быть гораздо хуже.)"
    new "（もっと悪い状態になってたかもしれないよね。）"

# game/pnc_text.rpy:938
translate japanese pills_21c1bac1:

    # gg "- Ага..."
    gg "- うん…"

translate japanese strings:
    # game/pnc_text.rpy:921
    old "(Ты и так умрешь, чего волноваться?)"
    new "（でもどうせいつかは死ぬでしょ、何が不安なの？）"

# game/pnc_text.rpy:943
translate japanese pills_29ef1128:

    # gg "- Ой, и правда!"
    gg "- その通りだよね！"

# game/pnc_text.rpy:946
translate japanese pills_d2c4cf06:

    # gg "- ..."
    gg "- …"

# game/pnc_text.rpy:950
translate japanese pills_30a63250:

    # "Я тяжело вздыхаю, подхожу ближе и протягиваю руку..."
    "深いため息をつき、近づいて手を伸ばす…"

# game/pnc_text.rpy:953
translate japanese pills_282e87f2:

    # gg "- Ух ты, тепло!"
    gg "- わ、あったかい！"

# game/pnc_text.rpy:956
translate japanese pills_d8114ff1:

    # "Не успели слова вылететь из моего рта, как одна из баночек перевернулась; из нее градом посыпались таблетки, а затем..."
    "その言葉が私の口から放たれた瞬間、瓶が一つひっくり返った。薬がこぼれ出てきて、それから…"

# game/pnc_text.rpy:959
translate japanese pills_0225fb97:

    # gg "- Светлячок! Ура!"
    gg "- ホタルだ！やった！"

# game/pnc_text.rpy:962
translate japanese pills_b0537a94:

    # "Сделав пару кругов над моей макушкой, он наконец садится на протянутую руку. Спешно пробежав по ней до плеча, светлячок заползает прямо мне в ухо - ум слегка проясняется."
    "ホタルは頭上を何周か飛び回ったあと、私の手のひらに着地した。ササっと腕に登り、肩に到達すると、そのまま耳に入った。頭が少しスッキリした。"

# game/pnc_text.rpy:982
translate japanese umbrella_6177059b:

    # "От зонта веет едва ощутимой прохладой. Немудрено, ведь только он защищает меня от грозовых туч, что иногда собираются под потолком."
    "かすかに冷気を発する傘。言うまでもなく、天井あたりに群がる雷雲から私を守ってくれるのはこれだけだ。"

# game/pnc_text.rpy:983
translate japanese umbrella_7211d4a7:

    # "Какое счастье, что он справляется с этим даже без моего участия!"
    "私の力なしでそんなことができるなんて、なんともありがたい！"

# game/pnc_text.rpy:985
translate japanese umbrella_e9ea09c8:

    # gg "- И все же, светлячок не станет прятаться в подобном месте. Иначе он простудится и не сможет летать!"
    gg "- でも、ホタルはそんな場所に隠れないよ。風邪をひいて飛べなくなっちゃうでしょ！"

translate japanese strings:
    # game/pnc_text.rpy:986
    old "(И ты не хочешь проверить?)"
    new "（確かめてみたくないの？）"

# game/pnc_text.rpy:990
translate japanese umbrella_2c1f3804:

    # gg "- Зачем? Я точно знаю - здесь мы ничего не найдем."
    gg "- どうして？何もいないことは分かってるんだよ。"

translate japanese strings:
    # game/pnc_text.rpy:986
    old "(Ладно. Давай искать дальше.)"
    new "（分かった。探索を続けよう。）"

# game/pnc_text.rpy:1019
translate japanese tumba_b9934e56:

    # gg "- Это вряд ли. Все ящики намертво заперты."
    gg "- 嘘でしょ。全部閉まってる。"

translate japanese strings:
    # game/pnc_text.rpy:1020
    old "(А если...)"
    new "（もし…）"

# game/pnc_text.rpy:1022
translate japanese tumba_fc1c9c4f:

    # gg "- Я не хочу даже думать о том, что внутри. Невесть чего вообразить можно!"
    gg "- 中に何があるの考えたくもない。何を想像しちゃうか分からないもん！"

translate japanese strings:
    # game/pnc_text.rpy:1048
    old "(Ладно, давай поищем где-нибудь еще.)"
    new "（分かった、他を探そう。）"

# game/pnc_text.rpy:1045
translate japanese towel_acd71dda:

    # "Я обращаю свой взгляд к неприметной полке рядом с зеркалом. На ней стоит стакан с зубной щеткой, а рядом висит маленькое полотенце. Прелесть!"
    "鏡のそばにひっそりとたたずむ棚に視線を移す。歯ブラシを立てたコップと小さなタオルが置いてある。最高の眺めだ！"

# game/pnc_text.rpy:1047
translate japanese towel_1a28ab52:

    # gg "- Мои светлячки умные, хорошие и не станут туда лезть - у них есть понятия о личной гигиене!"
    gg "- 私のホタルたちは賢くていい子なの、そこには入らないよ。衛生面には気を付けてくれるからね！"

# game/pnc_text.rpy:1068
translate japanese plants_b2dcd22e:

    # gg "- Точно! Насекомые же любят опылять цветы и все такое!"
    gg "- ほら！昆虫は花を受粉させたりするでしょ！"

translate japanese strings:
    # game/pnc_text.rpy:1069
    old "(Эм-м... типа того.)"
    new "（まぁ…、うん、そうだね？）"

# game/pnc_text.rpy:1073
translate japanese plants_37284d6f:

    # "Я подхожу вплотную к полке с цветами. Принюхиваюсь - от листьев пахнет пылью и картоном. И еще смертью."
    "花壇に近づいてみる。においをかいだ。葉から匂ってくるのはホコリと段ボール。それから死。"

translate japanese strings:
    # game/pnc_text.rpy:1074
    old "(Ты в курсе, что цветы давно высохли?)"
    new "（とうの昔に枯れてるよね？）"
    
translate japanese strings:
    # game/pnc_text.rpy:1076
    old "(Вряд ли мертвый цветок может привлечь насекомое.)"
    new "（枯れた植物でも昆虫は寄ってくるのかな。）"

# game/pnc_text.rpy:1080
translate japanese plants_d40b9e9e:

    # gg "- Тут, знаешь ли, выбирать не приходится."
    gg "- ま、他に選択肢もないでしょ。"

# game/pnc_text.rpy:1083
translate japanese plants_eb554241:

    # gg "- Хотя... ты прав. Давай искать дальше."
    gg "- うん…あなたが正しかったね。探索を続けよう。"

translate japanese strings:
    # game/pnc_text.rpy:1084
    old "(Почему бы просто их не выбросить?)"
    new "（どうして捨てないの？）"

# game/pnc_text.rpy:1088
translate japanese plants_bb89c88c:

    # gg "- Ты что, совсем меня не слушал?"
    gg "- 私の話全部聞いてなかったの？"

# game/pnc_text.rpy:1093
translate japanese plants_d2c4cf06:

    # gg "- ..."
    gg "- …"

# game/pnc_text.rpy:1111
translate japanese cond_5ae0230c:

    # "Я поднимаю глаза высоко-высоко к потолку."
    "視線を上げて、天井近くを見つめる。"

# game/pnc_text.rpy:1112
translate japanese cond_3bb16f8c:

    # "Из кондиционера доносится топот множества маленьких лапок."
    "エアコンの中で数えきれないほどの小さな足が行進している音が聞こえる。"

# game/pnc_text.rpy:1114
translate japanese cond_ce0adfe1:

    # gg "- Ну вот..."
    gg "- そうだね…"

translate japanese strings:
    # game/pnc_text.rpy:1115
    old "(Что такое?)"
    new "（どうしたの？）"

# game/pnc_text.rpy:1119
translate japanese cond_f224b446:

    # gg "- Светлячки не дружат с тараканами. Надо поискать в другом месте."
    gg "- ホタルはゴキブリとは仲良くなれない。他を探そう。"

translate japanese strings:
    # game/pnc_text.rpy:1120
    old "(Боже, откуда там тараканы?)"
    new "（どうしてそこにゴキブリがいるの？）"

# game/pnc_text.rpy:1124
translate japanese cond_86021029:

    # gg "- Ты уже забыл?"
    gg "- 忘れたの？"

# game/pnc_text.rpy:1125
translate japanese cond_1e339c58:

    # gg "- Сам же сказал мне представить, будто мои мысли - это тараканы."
    gg "- あなたが最初に思考をゴキブリだと思えって言ったんでしょ。"

translate japanese strings:
    # game/pnc_text.rpy:1126
    old "(Да, но...)"
    new "（うん、そうだけど…）"

# game/pnc_text.rpy:1130
translate japanese cond_911b6235:

    # gg "- Затем они стали светлячками, да... Но тараканы ведь не могут просто взять и исчезнуть!"
    gg "- それからホタルになったけど…ゴキブリはそんな簡単に消えないよ！"

# game/pnc_text.rpy:1133
translate japanese cond_c734e0a6:

    # gg "- Вот они и нашли себе местечко."
    gg "- だからここを占拠したの。"

# game/pnc_text.rpy:1136
translate japanese cond_a474b417:

    # gg "- Понял?"
    gg "- 分かった？"

translate japanese strings:
    # game/pnc_text.rpy:1137
    old "(Понял.)"
    new "（うん。）"
translate japanese strings:
    # game/pnc_text.rpy:1137
    old "(Не понял.)"
    new "（分からない。）"
translate japanese strings:
    # game/pnc_text.rpy:1137
    old "(Сделаю вид, что понял.)"
    new "（分かった気になった。）"

# game/pnc_text.rpy:1165
translate japanese bulbs_ebc87901:

    # gg "- Ты серьезно?"
    gg "- 本当に？"

translate japanese strings:
    # game/pnc_text.rpy:1166
    old "(А что не так?)"
    new "（どうしたの？）"

# game/pnc_text.rpy:1168
translate japanese bulbs_30c3bd25:

    # gg "- Сам подумай: стали бы светлячки лететь на свет?"
    gg "- 考えてたの。ホタルはどうして光に集まるんだろうって。"

# game/pnc_text.rpy:1169
translate japanese bulbs_c15c589f:

    # gg "- Мне кажется, они вполне самодостаточны в этом плане."
    gg "- その点では自給自足できてるんじゃないかなって。"

# game/pnc_text.rpy:1170
translate japanese bulbs_d2c4cf06:

    # gg "- ..."
    gg "- …"

# game/pnc_text.rpy:1173
translate japanese bulbs_6f05c6bd:

    # gg "- Если только они целенаправленно не хотят снизить себе самооценку."
    gg "- わざと自己肯定感を下げようとしてる、とかだったらいいのにな…"

# game/pnc_text.rpy:1176
translate japanese bulbs_cb7a643e:

    # gg "- Хм-м..."
    gg "- うーん…"

# game/pnc_text.rpy:1196
translate japanese vent_ac59bddc:

    # gg "- Отсюда так просто не выбраться... Хи-хи..."
    gg "- ここを出るのは簡単じゃないね…えへへ…"

translate japanese strings:
    # game/pnc_text.rpy:1216
    old "(А это что?)"
    new "（あれは何？）"

# game/pnc_text.rpy:1219
translate japanese posters_9d2cceaf:

    # gg "- Ах, это..."
    gg "- あぁ、あれ…"

# game/pnc_text.rpy:1222
translate japanese posters_badaf50e:

    # gg "- Это фотографии моих самых счастливых моментов!"
    gg "- あれは最高の思い出がつまった写真だよ！"

translate japanese strings:
    # game/pnc_text.rpy:1223
    old "(На них ведь ничего нет...)"
    new "（何も映ってないよ…）"

# game/pnc_text.rpy:1227
translate japanese posters_62804578:

    # gg "- Я так долго смотрела на них, что буквально сожгла взглядом, хи-хи!"
    gg "- 集中して見つめすぎて焦がしちゃったの、えへへ！"

# game/pnc_text.rpy:1228
translate japanese posters_c0104c7b:

    # gg "- Теперь они просто закрывают трещины в стенах."
    gg "- 今となっては壁のひびを隠してくれてるだけだね。"

translate japanese strings:
    # game/pnc_text.rpy:1229
    old "(Трещины?)"
    new "（ひび？）"

# game/pnc_text.rpy:1233
translate japanese posters_0639eea2:

    # gg "- Неважно. Дальше искать будем или как?"
    gg "- 忘れて。探索を続ける？どうする？"

translate japanese strings:
