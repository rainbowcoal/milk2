    new "（为什么？）"
# game/script.rpy:970
translate chinese dnow_d2c4cf06:

    # gg "- ..."
    gg "- ……"

# game/script.rpy:973
translate chinese dnow_d2c4cf06_1:

    # gg "- ..."
    gg "- ……"

translate chinese strings:
    # game/script.rpy:975
