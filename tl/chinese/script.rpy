# game/script.rpy:854
translate chinese choice1_f9f7fabe:

    # gg "- Ну-у, не издевайся! Ты ведь обещал со мной говорить!"
    gg "- 拜托了，快说呀，别再这样欺负我了！你不是都答应了会多跟我说说话的吗！"

translate chinese strings:
    # game/script.rpy:856
    old "(О чем ты думала тогда, на полу?)"
    new "（你躺在地上的时候，脑子里在想什么？）"    
# game/script.rpy:860
translate chinese choice1_72107bd9:

    # gg "- Что ты имеешь в виду? Ты как никто другой должен это знать."
    gg "- 你这是什么意思？还问我在想什么……你不是应该比谁都清楚吗？"

translate chinese strings:
    # game/script.rpy:862
    old "(В том и дело, что я понятия не имею. Это... странно.)"
    new "（问题就出在这里。我真的完全不知道。这也……太奇怪了。）"
# game/script.rpy:864
