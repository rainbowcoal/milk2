    old "(Это так по-детски...)"
    new "（这也太幼稚了吧……）"
# game/script.rpy:1022
translate chinese dnow_404b2d65:

    # gg "- А знаешь, что самое классное?"
    gg "- 你知道最好玩的地方是什么吗？"

# game/script.rpy:1025
translate chinese dnow_018481c6:

    # gg "- Что этим займешься ты!"
    gg "- 那就是——由你来点击！锵锵！"

translate chinese strings:
    # game/script.rpy:1027
    old "(Ну уж нет.)"
    new "（我不要。）"
# game/script.rpy:1032
translate chinese dnow_02b45ca5:

    # gg "- А вот и да!"
    gg "- 就要！"

# game/script.rpy:1035
translate chinese dnow_e18ec4be:

