    gg "- 真没礼貌！"

translate chinese strings:
    # game/script.rpy:975
    old "(Не хочешь - не говори...)"
    new "（你要是不想说的话也可以不说……）"
# game/script.rpy:986
translate chinese dnow_1a408a1d:

    # gg "- Не хочу и не скажу!"
    gg "- 唔，我就是不想说，而且我也不会跟你说的！"

translate chinese strings:
    # game/script.rpy:988
    old "(Что ж, ладно. Выходит, нам надо найти крохотных насекомых среди кучи хлама, при этом не сдвинув ничего даже на сантиметр?)"
    new "（好吧。那就是说，有好几只小虫子躲进了这堆垃圾山里，我们要把它们全给找出来，还不能动任何东西？）"
    
# game/script.rpy:993
translate chinese dnow_76c5c726:

    # gg "- Да!"
    gg "- 没错！"

# game/script.rpy:999
translate chinese dnow_d2c4cf06_2:

    # gg "- ..."
    gg "- ……"

translate chinese strings:
    # game/script.rpy:995
    old "(Ну и ну.)"
    new "(天呐。)"
# game/script.rpy:1003
translate chinese dnow_1c7eb231:

    # gg "- У меня есть идея!.."
    gg "- 啊，我有个主意……！"

# game/script.rpy:1004
translate chinese dnow_f6217dc7:

    # gg "- В прошлый раз я была персонажем визуальной новеллы, и это помогло мне справиться с задачей. Теперь я хочу быть персонажем квеста!"
    gg "- 上次我把自己想象成一个视觉小说里的人物，然后就成功把牛奶给买回来了。那这次，我要把自己想象成一个点击解谜游戏里的人物！"

# game/script.rpy:1007
translate chinese dnow_1508e200:

    # gg "- Знаешь... Там бывают эпизоды, когда ты просто смотришь на разные предметы и что-то обязательно происходит!"
    gg "- 那种游戏就是……你点击不同的物品，就会触发不同的事件！就是那种！"

# game/script.rpy:1010
translate chinese dnow_7ed4e67e:

    # gg "- Здорово же!"
    gg "- 听起来很好玩对不对！"

translate chinese strings:
    # game/script.rpy:1012
    old "(А как же те вещи, которыми ты пользуешься регулярно? Их ты тоже отказываешь трогать?)"
    new "（那你平时经常要用的东西呢？难道就那么放着？）"
# game/script.rpy:1016
translate chinese dnow_f374ad70:

    # gg "- Так даже интересней!"
    gg "- 弄成点击解谜游戏才更有意思嘛！"

translate chinese strings:
