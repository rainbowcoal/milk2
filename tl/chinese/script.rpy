    new "（你是打算现编一个理由出来吗？）"
# game/script.rpy:979
translate chinese dnow_ce73d993:

    # gg "- Я?.. Н-нет, ничего подобного!"
    gg "- 哈啊，谁啊，我吗……？不，当然不是啦！"

translate chinese strings:
    # game/script.rpy:980
    old "(Кажется, ты забыла поставить свой мыслеблок - тебя всю насквозь видно.)"
    new "（你大概是忘了竖起思维屏障了，你脑子里在想什么我都能看得一清二楚咯。）"
# game/script.rpy:984
translate chinese dnow_d88ada95:

