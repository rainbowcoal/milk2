# TODO: Translation updated at 2021-08-30 23:57

# game/magaz.rpy:63
translate chinese magaz_2bd1e715:

    # nm "Я просыпаюсь на деревянной лавке; перед глазами - узкая и слабо освещенная аллея. До боли знакомая дорога... где же я могла ее видеть?"
    nm "我在一张长木椅上醒了过来，面前是一条又窄又暗的小路……诶，这条路怎么看起来这么眼熟啊……我是在哪里见过来着？"

# game/magaz.rpy:64
translate chinese magaz_aad6796c:

    # trm "- Ну наконец-то..."
    trm "- 终于……"

# game/magaz.rpy:70
translate chinese magaz_5b9565ac:

    # nm "Сбоку разносится голос. Я поворачиваюсь и вижу перед собой мальчика с крайне странным выражением лица."
    nm "旁边冷不丁地响起了一个声音。我赶紧转过身去，结果发现说话的是个没见过的小男孩，而且他脸上还挂着诡异的表情。"

# game/magaz.rpy:76
translate chinese magaz_5c56715c:

    # trm "- Ты опоздала!"
    trm "- 你迟到咯！"

# game/magaz.rpy:78
translate chinese magaz_d9ca71a8:

    # ggm "- Эм-м-м... а ты кто?"
    ggm "- 呃……你是谁啊？"

# game/magaz.rpy:79
translate chinese magaz_c96f65e3:

    # nm "Мальчик удивленно моргнул."
    nm "男孩眨了眨眼睛，看起来很疑惑的样子。"

# game/magaz.rpy:81
translate chinese magaz_9b91e7ea:

    # trm "- Так мы с тобой далеко не уйдем. Попробуй заново."
    trm "- 这样我们哪里都去不了啊。再试一次吧。"

# game/magaz.rpy:82
translate chinese magaz_92df8506:

    # nm "Затем он набирает полную грудь воздуха."
    nm "然后他就深吸了一口气。"

# game/magaz.rpy:83
translate chinese magaz_21e45af1:

    # trm "- Ты! Опоздала!"
    trm "- 你！迟！到！咯！"

# game/magaz.rpy:85
translate chinese magaz_9dec254e:

    # nm "Я непонимающе смотрю на него. Он непонимающе смотрит на меня."
    nm "我完全搞不清是什么状况，只能疑惑地盯着他，结果他也是一脸疑惑地盯着我。"

# game/magaz.rpy:86
translate chinese magaz_60af0f3c:

    # ggm "- И-извини?.."
    ggm "- 抱、抱歉，这是……？"

# game/magaz.rpy:88
translate chinese magaz_400b60e9:

    # nm "Мальчик довольно кивнул."
    nm "男孩点了点头，看起来很满意。"

# game/magaz.rpy:89
translate chinese magaz_77916ef1:

    # trm "- Вот, уже лучше."
    trm "- 看到没？现在好多了吧。"

# game/magaz.rpy:90
translate chinese magaz_e9fa80ce:

    # trm "- Имя-то у тебя есть? Меня вот Треской звать!"
    trm "- 对了，你叫什么名字啊？啊，我叫特列斯卡！"

# game/magaz.rpy:92
translate chinese magaz_24605459:

    # nm "Я оценивающе оглядываю наглеца. Совсем маленький, а уже лезет с такими вопросами!"
    nm "我打量了一下这个小混蛋。哼，这家伙年纪这么小就敢跟我说这种话！"

# game/magaz.rpy:93
translate chinese magaz_e9fe9f8b:

    # ggm "- Не твое дело..."
    ggm "- 干嘛告诉你……"

# game/magaz.rpy:94
translate chinese magaz_dfb8a18f:

    # ggm "- И вообще!.. Мне кто-нибудь скажет, что я тут делаю?"
    ggm "- 啊对了……！现在到底是什么情况啊，谁能告诉我一下？"

# game/magaz.rpy:96
translate chinese magaz_279aff48:

    # trm "- Эй, это невежливо! Будто тут есть кто-то еще..."
    trm "- 喂，你这样好没礼貌哦！这里明明就我们两个人而已……"

# game/magaz.rpy:98
translate chinese magaz_0619fa6f:

    # nm "..."
    nm "……"

# game/magaz.rpy:100
translate chinese magaz_a899a5fc:

    # trm "- Тебе совсем ничего не рассказали? Вот я все знаю, например!"
    trm "- 他们没跟你说吗？唔，但是我可什么都知道哦！比如说呢……"

# game/magaz.rpy:102
translate chinese magaz_1d4b75d7:

    # ggm "- О чем?"
    ggm "- 什么啊？"

# game/magaz.rpy:104
translate chinese magaz_bf91ae6e:

    # trm "- Ты обязана проводить меня в магазин!"
    trm "- 就是，你要负责送我去商店！"

# game/magaz.rpy:105
translate chinese magaz_aef4f109:

    # nm "После этих слов Треска встал в победную позу."
    nm "特列斯卡说着摆出了一个胜利的姿势。"

# game/magaz.rpy:107
translate chinese magaz_81f8ed24:

    # ggm "- Еще чего..."
    ggm "- 我才不要……"

# game/magaz.rpy:109
translate chinese magaz_8decfd91:

    # trm "- Ты ведь понимаешь, что отказ не принимается?"
    trm "- 你应该知道拒绝也没用吧？"

# game/magaz.rpy:111
translate chinese magaz_efc3c766:

    # ggm "- Многовато ты о себе возомнил."
    ggm "- 呵，你不是很自以为是吗？"

# game/magaz.rpy:113
translate chinese magaz_c4e65e33:

    # trm "- Я серьезно."
    trm "- 我没跟你开玩笑。"

# game/magaz.rpy:114
translate chinese magaz_7516ceb4:

    # trm "- Это, как бы, не мне решать."
    trm "- 这事又不是我决定的。"

# game/magaz.rpy:115
translate chinese magaz_1eeae098:

    # trm "- Думаешь, я в восторге от такой компании?"
    trm "- 再说了，你以为我喜欢让你送我去哦？"

# game/magaz.rpy:117
translate chinese magaz_f10d9bff:

    # nm "Какой-то он странный. То веселый, то грустный, то громкий, то тихий. Ненормальный какой-то. И имя дурацкое."
    nm "这家伙真奇怪。他一下开心，一下难过，一下叽叽喳喳说个不停，一下又什么都不说了，简直就是个疯子嘛，而且他的名字也好傻。"

# game/magaz.rpy:119
translate chinese magaz_9d1124ad:

    # trm "- Мы идем или как?"
    trm "- 那我们到底要不要去？"

# game/magaz.rpy:121
translate chinese magaz_22b68094:

    # ggm "- Ты иди, а мне подумать надо."
    ggm "- 你可以先走，我要想一下。"

# game/magaz.rpy:123
translate chinese magaz_93798464:

    # trm "- Я бы с радостью, да только дороги не знаю..."
    trm "- 我倒是想啊，但是我不知道怎么走……"

# game/magaz.rpy:124
translate chinese magaz_75266a4b:

    # nm "Треска хитро улыбается. Я с досадой кусаю губы."
    nm "特列斯卡狡猾地笑了起来。我只好沮丧地咬了咬下嘴唇。"

# game/magaz.rpy:126
translate chinese magaz_5e5cae60:

    # ggm "- Буду с тобой честна - ты мне совсем не нравишься."
    ggm "- 老实说，我一点也不喜欢你。"

# game/magaz.rpy:127
translate chinese magaz_989f8e80:

    # nm "В ответ он лишь заливается смехом."
    nm "他听了以后忽然大笑起来。"

# game/magaz.rpy:131
translate chinese magaz_6c52dd99:

    # trm "- Зато ты мне - очень!"
    trm "- 但是我挺喜欢你的！"

# game/magaz.rpy:132
translate chinese magaz_80189b02:

    # nm "После этого он с уверенностью хватает меня за руку - я и рта не успеваю открыть."
    nm "说完，他立马就牵住了我的手，速度快到我都还没来得及反驳他。"

# game/magaz.rpy:133
translate chinese magaz_b9406d79:

    # trm "- Веди!"
    trm "- 快带路吧！"

# game/magaz.rpy:146
translate chinese magaz_03d48903:

    # nm "Дорога до магазина прошла нормально, если не считать того, что Треска шел заметно быстрее."
    nm "去商店的路上还算顺利，就是特列斯卡走得比我快很多。"

# game/magaz.rpy:147
translate chinese magaz_7f15f214:

    # nm "И наоборот - в какие-то моменты он резко останавливался и начинал идти назад, внимательно глядя себе под ноги."
    nm "但是他有时会突然停下来，然后倒退几步，认真盯着脚下的地面。"

# game/magaz.rpy:148
translate chinese magaz_eaf9b630:

    # nm "В итоге дорога заняла гораздо больше времени, чем могла бы."
    nm "结果就是，本来只要走一会儿就好了，我们硬是走了好久才到。"

# game/magaz.rpy:154
translate chinese magaz_cf29981f:

    # nm "Оказавшись у дверей магазина, мы видим перед собой вывеску."
    nm "好不容易到了商店门口，我们发现面前有一个告示牌。"

# game/magaz.rpy:155
translate chinese magaz_214bc86e:

    # nm "'Магазин закрывается через 20 минут!'"
    nm "“我们还剩20分钟就要关门了！”上面这样写着。"

# game/magaz.rpy:156
translate chinese magaz_ba5d0e53:

    # ggm "- И взбрело же кому-то в голову таким образом обозначить часы работы своего магазина..."
    ggm "- 这样标注营业时间的吗……究竟是哪个天才想出来的鬼点子？"

# game/magaz.rpy:157
translate chinese magaz_3b104fbf:

    # trm "- Наверно, у них для этого специальный человек есть. Каждые пять минут бегает и меняет табличку. Удобно же!"
    trm "- 啊，说不定他们专门找人负责这个，每隔5分钟就会换一次告示牌。这样的话就还挺方便的！"

# game/magaz.rpy:158
translate chinese magaz_603668ed:

    # ggm "- Шутишь, что ли?"
    ggm "- 你这是在开玩笑吗？"

# game/magaz.rpy:159
translate chinese magaz_72395cef:

    # trm "- Да!"
    trm "- 对！"

# game/magaz.rpy:160
translate chinese magaz_b706ff96:

    # ggm "- До чего же ты надоедливый..."
    ggm "- 你好烦啊……"

# game/magaz.rpy:161
translate chinese magaz_4e875e76:

    # trm "- Всяко лучше, чем быть занудой! Тебе, кстати, лет-то сколько?"
    trm "- 烦也总比无聊好嘛！对了，你多大了？"

# game/magaz.rpy:162
translate chinese magaz_56bd5b0c:

    # ggm "- Не твое дело."
    ggm "- 不关你的事。"

# game/magaz.rpy:163
translate chinese magaz_7dc314bf:

    # trm "- А-а-а... а зовут как?"
    trm "- 啊、啊、啊……那……你叫什么名字呢？"

# game/magaz.rpy:164
translate chinese magaz_b5ef0b03:

    # ggm "- Не твое дело!"
    ggm "- 不关你的事！"

# game/magaz.rpy:165
translate chinese magaz_4f29a999:

    # nm "Я уже готова была дать мелкому поганцу подзатыльник, как вдруг за стеклом появляется жуткого вида человек. В руках он держит картонную табличку с надписью 'До закрытия магазина 15 минут!'"
    nm "我刚想狠狠揍这个小兔崽子一顿，结果玻璃后面忽然出现了一张可怕的人脸！他手里拿着一个硬纸板做的告示牌，上面写着“我们还有15分钟就要关门了！”"

# game/magaz.rpy:166
translate chinese magaz_491606b9:

    # trm "- Пойдем, чего стоишь?"
    trm "- 你还在等什么，走啊？"

# game/magaz.rpy:167
translate chinese magaz_b3e070b9:

    # ggm "- А? Д-да..."
    ggm "- 啊？嗯……"

# game/magaz.rpy:177
translate chinese magaz_bda9d19f:

    # nm "В очередной раз проходя мимо длинного ряда с консервными банками, мы поняли, что заблудились."
    nm "我们走过了一排货架，上面全是罐头；又走过一排货架，结果上面放的还是罐头。这时候我们才发觉自己迷路了。"

# game/magaz.rpy:178
translate chinese magaz_fab2588c:

    # ggm "- Поверить не могу, что ты не знаешь, где продается молоко."
    ggm "- 你竟然不知道牛奶放在哪里？真是难以置信。"

# game/magaz.rpy:179
translate chinese magaz_d2bc0976:

    # trm "- Я... эм-м-м..."
    trm "- 我……呃……"

# game/magaz.rpy:180
translate chinese magaz_fa0c299d:

    # ggm "- Может, спросим кого-нибудь?"
    ggm "- 说不定找个人问问比较好？"

# game/magaz.rpy:181
translate chinese magaz_72bfe8b3:

    # trm "- Давай!"
    trm "- 没错！"

# game/magaz.rpy:182
translate chinese magaz_cd2f6b76:

    # ggm "- Эй, постой!.."
    ggm "- 喂，你等等……！"

# game/magaz.rpy:183
translate chinese magaz_449dcf56:

    # nm "Треска отпустил мою руку и уверенно зашагал к одному из немногочисленных посетителей магазина. Тот стоял спиной к нам, что-то сосредоточенно рассматривая на прилавке."
    nm "特列斯卡放开了我的手，自信满满地向前面的陌生人走去。商店里的客人不多，那个陌生人就是其中一个。这会儿他正背对着我们站着，全神贯注地看着货架上的东西。"

# game/magaz.rpy:184
translate chinese magaz_d1671cc2:

    # trm "- Здрасьте, а можно!.."
    trm "- 你好，请问……！"

# game/magaz.rpy:185
translate chinese magaz_7b64269c:

    # nm "Последнюю часть вопроса я не расслышала - как и ответ на него. Но мой непутевый друг внезапно застыл как вкопанный, глядя прямо в глаза посетителя магазина. Я поспешила подойти к ним."
    nm "我听不见他后面的话，也听不见那个客人是怎么回答他的。我只能看见那个没用的家伙呆呆地站在原地，盯着那个客人的眼睛。我怕出事，赶紧走了过去。"

# game/magaz.rpy:191
translate chinese magaz_73ff8128:

    # mm "- Это ваш?"
    mm "- 他是跟你一起的吗？"

# game/magaz.rpy:192
translate chinese magaz_fbc1a18a:

    # nm "Посетитель обратился ко мне. В его голосе явно слышалось отвращение, а на лице застыла презрительная гримаса."
    nm "那个客人对我说道。他说话的时候一脸的不屑和反感。"

# game/magaz.rpy:203
translate chinese magaz_a3ef7e99:

    # ggm "- Я... эм-м..."
    ggm "- 我……呃……"

# game/magaz.rpy:204
translate chinese magaz_2f529462:

    # mm "- Если так, то будьте добры - уберите его подальше."
    mm "- 如果是的话，麻烦你把他带走。"

# game/magaz.rpy:205
translate chinese magaz_6277046c:

    # ggm "- Д-да, извините..."
    ggm "- 好、好的，实在对不起……"

# game/magaz.rpy:206
translate chinese magaz_5ffc47dc:

    # nm "Я хватаю Треску за руку и спешу увести в сторону - тот все глядит на посетителя, открыв рот и выпучив глаза. И дрожит."
    nm "我抓起特列斯卡的手，赶紧牵着他走开了，可他边走还边望着那个客人。他嘴巴张得大大的，眼睛瞪得都快掉出来了，而且还浑身发抖。"

# game/magaz.rpy:216
translate chinese magaz_5a6e2c0e:

    # nm "Лишь когда мы свернули за угол, Треска успокоился."
    nm "等我们走到了拐角的地方，他才终于冷静下来。"

# game/magaz.rpy:217
translate chinese magaz_c7dd33e3:

    # ggm "- Ну и как это понимать?"
    ggm "- 怎么了你？"

# game/magaz.rpy:218
translate chinese magaz_a38d3841:

    # trm "- Я... я так перепугался!.. Он сказал..."
    trm "- 我……我好害怕啊……！他说……"

# game/magaz.rpy:219
translate chinese magaz_72d73855:

    # ggm "- Что?"
    ggm "- 什么？"

# game/magaz.rpy:220
translate chinese magaz_b9c8f9d0:

    # trm "- НЕТ, ТОЛЬКО НЕ ОПЯТЬ!"
    trm "- 不，不要，我不要再听到了！"

# game/magaz.rpy:221
translate chinese magaz_32dc5f00:

    # nm "Внезапно Треска завопил как сумасшедший. Я зажимаю ему рот ладонью; его лицо буквально горит, а сам он плачет."
    nm "特列斯卡忽然像是疯了一样大喊大叫，我赶紧捂住他的嘴。他脸上发烫，眼泪也流了下来。"

# game/magaz.rpy:222
translate chinese magaz_08dc37af:

    # ggm "- Ты можешь вести себя нормально?"
    ggm "- 你能不能正常点啊？"

# game/magaz.rpy:223
translate chinese magaz_b551f5ad:

    # trm "- Т-ты не понимаешь..."
    trm "- 你、你不会明白的……"

# game/magaz.rpy:224
translate chinese magaz_96ec9ded:

    # ggm "- Ну конечно, что я вообще могу понимать!"
    ggm "- 我不明白，我当然不明白了，我什么都不明白！"

# game/magaz.rpy:225
translate chinese magaz_66e633dd:

    # ggm "- Вот только приставать к людям - это неправильно. Этого, видимо, не понимаешь ты."
    ggm "- 但是你吵到其他人了，这是不对的！看来你不明白这一点啊。"

# game/magaz.rpy:226
translate chinese magaz_a70710db:

    # trm "- Ты злая!.. Хнык.."
    trm "- 你好过分……！呜呜……"

# game/magaz.rpy:227
translate chinese magaz_d45f1565:

    # ggm "- Я?.."
    ggm "- 哈啊，我过分……？"

# game/magaz.rpy:233
translate chinese magaz_828f1904:

    # nm "Оттолкнув меня, Треска убежал прочь."
    nm "特列斯卡猛地把我推开，自己跑掉了。"

# game/magaz.rpy:239
translate chinese magaz_ce7396de:

    # ggm "- Блин."
    ggm "- 可恶！"

# game/magaz.rpy:240
translate chinese magaz_0e1cb3a1:

    # nm "Краем глаза я замечаю, как работник магазина вешает на дверь новую табличку."
    nm "我斜眼瞥见商店的工作人员又在门上挂了新的牌子。"

# game/magaz.rpy:246
translate chinese magaz_15b5e8ae:

    # ggm "- Вот ты где!"
    ggm "- 找到你了！"

# game/magaz.rpy:247
translate chinese magaz_f896812e:

    # nm "Я встречаю Треску у кассы. До этого я успела сбегать в молочный отдел, предварительно узнав, где он находится."
    nm "我终于在收银台找到了特列斯卡。还好我刚刚找到了牛奶，拿上就跑了过来。"

# game/magaz.rpy:248
translate chinese magaz_d51b64cb:

    # mm "- Эй, шевелись!"
    mm "- 喂，你，快点啊！"

# game/magaz.rpy:249
translate chinese magaz_9ee11605:

    # nm "Недовольный голос раздался с конца длинной очереди, что образовалась позади Трески. Я протискиваюсь к нему."
    nm "我听到旁边的队伍里有人生气地喊了一句，转头一看，特列斯卡站在那，背后排了好长的一条队。我赶忙挤了过去。"

# game/magaz.rpy:250
translate chinese magaz_d71944d4:

    # ggm "- Что случилось?"
    ggm "- 怎么了？"

# game/magaz.rpy:251
translate chinese magaz_271d3bbb:

    # nm "Мальчик не отвечает. Смотрит себе под ноги, едва слышно хныкая, а кассир коршуном нависает над ним. Между ними лежит пакет молока."
    nm "可是没人回答我。特列斯卡低头盯着自己的脚，不时抽几下鼻子。他面前的收银员比他要高不少，两个人中间放着一袋牛奶。"

# game/magaz.rpy:252
translate chinese magaz_73ff8128_1:

    # mm "- Это ваш?"
    mm "- 他是跟你一起的吗？"

# game/magaz.rpy:253
translate chinese magaz_7cf04c09:

    # ggm "- Мой."
    ggm "- 嗯。"

# game/magaz.rpy:254
translate chinese magaz_630ff660:

    # mm "- В следующий раз оставьте его дома."
    mm "- 下次别带他出来了。"

# game/magaz.rpy:255
translate chinese magaz_cc8f5d69:

    # nm "Люди в очереди согласно кивают."
    nm "长队里的其他人也纷纷点头表示同意。"

# game/magaz.rpy:256
translate chinese magaz_4c8b218b:

    # mm "- Оплатите стоимость товара."
    mm "- 请付钱。"

# game/magaz.rpy:257
translate chinese magaz_6bad1905:

    # ggm "- Да, конечно..."
    ggm "- 啊，好的……"

# game/magaz.rpy:258
translate chinese magaz_04ace94f:

    # mm "- И издержку за ожидание!"
    mm "- 还有等候费！"

# game/magaz.rpy:259
translate chinese magaz_1676dc10:

    # ggm "- Ч-что?"
    ggm "- 什、什么？"

# game/magaz.rpy:260
translate chinese magaz_7be05a24:

    # mm "- Вы слышали."
    mm "- 你听到了吧，等候费！"

# game/magaz.rpy:261
translate chinese magaz_9428ac7b:

    # ggm "- Я-то слышала, но это же неслыханно!"
    ggm "- 我是听到了，但是这什么费啊，从来没听说过！"

# game/magaz.rpy:266
translate chinese magaz_4daaff38:

    # nm "Вдруг Треска начинает хихикать."
    nm "特列斯卡忽然间咯咯笑了起来。"

# game/magaz.rpy:267
translate chinese magaz_84a35435:

    # mm "- И за то, что ваш сын придурок, тоже заплатите!"
    mm "- 因为你儿子是个弱智！要我们忍这么一个弱智，你不得给点补偿吗！"

# game/magaz.rpy:268
translate chinese magaz_d3f5b609:

    # ggm "- Н-но..."
    ggm "- 但、但是……"

# game/magaz.rpy:269
translate chinese magaz_7be05a24_1:

    # mm "- Вы слышали."
    mm "- 我说了，因为他是个弱智！"

# game/magaz.rpy:270
translate chinese magaz_fe838a88:

    # ggm "- Знаете, что?!.."
    ggm "- 你知道个什么啊……？！"

# game/magaz.rpy:271
translate chinese magaz_ed507361:

    # nm "В гневе я бросаю кассиру смятую купюру гораздо большего номинала, чем требовалось - даже с учетом всех идиотских надбавок - хватаю пакет молока и круто разворачиваюсь."
    nm "我气急了，直接扔了一张钞票给收银员，然后拿上牛奶转身就走。就算是算上那个什么愚蠢的等候费，刚刚那张钞票也肯定够了！别说够了，还多了不少呢！"

# game/magaz.rpy:272
translate chinese magaz_8433e4f1:

    # ggm "- Мы уходим, Треска!"
    ggm "- 特列斯卡，回去了！"

# game/magaz.rpy:278
translate chinese magaz_07f73956:

    # nm "Всю дорогу из магазина мы шли молча. В какой-то момент мы незаметно для себя свернули вправо и оказались у автозаправки - тогда-то Треска и решил нарушить молчание."
    nm "回去的路上，我们谁也没说话。走着走着，我们不知不觉地往右边走了，最后走到了一个加油站。这时候，特列斯卡决定打破沉默。"

# game/magaz.rpy:279
translate chinese magaz_11b4592c:

    # trm "- Любишь мороженое?"
    trm "- 你喜欢冰淇淋吗？"

# game/magaz.rpy:280
translate chinese magaz_4cd3ac67:

    # ggm "- Нет."
    ggm "- 不喜欢。"

# game/magaz.rpy:281
translate chinese magaz_ef883331:

    # trm "- Ладно..."
    trm "- 好吧……"

# game/magaz.rpy:282
translate chinese magaz_0a0e5a9c:

    # nm "Я смотрю в поникшее лицо мальчика - на секунду в его глазах блеснул огонек и тут же погас."
    nm "我看了看他的脸。特列斯卡眼中有一束光，可是闪了一会儿之后就消失了。"

# game/magaz.rpy:283
translate chinese magaz_8734db3e:

    # trm "- Знаешь..."
    trm "- 对了……"

# game/magaz.rpy:284
translate chinese magaz_f6ae2c25:

    # nm "Он уверенно сворачивает с тропы прямо на автомобильную дорогу. Я провожаю его недоуменным взглядом."
    nm "他转身离开这条小路，毅然决然地往高速公路走去。我疑惑地盯着他的背影。"

# game/magaz.rpy:296
translate chinese magaz_1f80669a:

    # trm "- Похоже, ты мне совсем не помогаешь."
    trm "- 看来，你根本就没有帮到我啊。"

# game/magaz.rpy:297
translate chinese magaz_783d379e:

    # nm "В глазах Трески вновь блестит озорной огонек..."
    nm "特列斯卡的眼中再次亮起了一束调皮的光，那光在闪烁、闪烁……"

