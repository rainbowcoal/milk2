    # gg "- Не молчи..."
    gg "- Powiedz coś..."

# game/script.rpy:502
translate polish choice1_73925250:

    # "Я чувствую, как слезы стекают по щекам, задерживаются на подбородке, а затем... Затем падают на мою одежду, прожигая в ней дыры."
    "Czuję, jak łzy spływają mi po policzkach, lądują na brodzie, a potem... Potem spadają na moje ubrania, wypalając w nich dziury."

translate polish strings:
    # game/script.rpy:504
    old "(Недолго ты продержалась. Что ж, ожидаемо.)"
    new "(Nie wytrzymałaś długo. Cóż, to było do przewidzenia.)"    
    
# game/script.rpy:508
