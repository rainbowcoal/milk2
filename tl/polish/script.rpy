    new "(Nie ma sprawy. Przynajmniej nie zapomnę tej nieszczęsnej, smarkatej dziewczyny przez długi czas.)"

    # game/script.rpy:449
    old "(Которая только и делает, что постоянно ноет.)"
    new "(Która nic nie robi, tylko cały czas marudzi.)"
    
# game/script.rpy:472
translate polish choice1_1c8a74b8:

    # gg "- Даже не пытайся испортить мне настроение! Пока мы вместе, я хочу веселиться, ясно?"
    gg "- Nawet nie próbuj psuć mi nastroju! Dopóki jesteśmy razem, chcę się dobrze bawić, jasne?"

translate polish strings:
