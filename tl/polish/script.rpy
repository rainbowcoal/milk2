# game/script.rpy:1253
translate polish balcony_ef0fd9d5:

    # "Я взбираюсь на металлические перила и свешиваю ноги вниз."
    "Wspinam się na metalową barierkę i zwisam nogami w dół."

# game/script.rpy:1254
translate polish balcony_3e7b79d9:

    # "Один за другим бросаю в бездну короткие взгляды - та отвечает мне рассерженным ледяным дыханием."
    "Po kolei rzucam krótkie spojrzenia w otchłań - ona odpowiada mi gniewnym, lodowatym oddechem."

# game/script.rpy:1255
translate polish balcony_067566ed:

    # "Так мы и общаемся. Будто старинные друзья."
    "Tak się właśnie porozumiewamy. Tak jak starzy przyjaciele."

# game/script.rpy:1256
translate polish balcony_ef030281:

    # gg "- Иногда мне кажется, что весь мир притворяется ненормальным."
    gg "- Czasami wydaje mi się, że cały świat udaje, że jest nienormalny."

# game/script.rpy:1257
translate polish balcony_b10fcdd5:

    # gg "- Он будто бы хочет убедить меня в чем-то, чего на самом деле нет."
    gg "- Jakby chciał mnie przekonać o czymś, czego tak naprawdę nie ma."

translate polish strings:
    # game/script.rpy:1258
    old "(Странно, не находишь?)"
    new "(Dziwne, nie sądzisz?)"
# game/script.rpy:1260
translate polish balcony_dc3a6a30:

    # gg "- Да, но..."
    gg "- Tak, ale..."

# game/script.rpy:1261
translate polish balcony_6f79190d:

    # gg "- В то же время... Я даже немного рада этому."
    gg "- W tym samym czasie... Nawet trochę się z tego cieszę."

# game/script.rpy:1262
translate polish balcony_d144836c:

    # gg "- Все вокруг создано лишь для меня. Создано обманывать, запутывать, сбивать с толку..."
    gg "- Wszystko wokół mnie jest stworzone tylko dla mnie. Zaprojektowane, by oszukać, zmylić, zdezorientować..."

# game/script.rpy:1263
translate polish balcony_55810e11:

    # gg "- Если это правда, выходит, не такая уж я и сумасшедшая?"
    gg "- Jeśli to prawda, to chyba nie jestem aż tak szalona, prawda?"

translate polish strings:
    # game/script.rpy:1264
    old "(Считать это правдой и есть сумасшествие.)"
    new "(Myślenie, że to prawda jest szalone.)"
# game/script.rpy:1266
translate polish balcony_7744fdf5:

    # gg "- Наверное."
    gg "- Pewnie tak."

# game/script.rpy:1267
translate polish balcony_a20cefa7:

    # "..."
    "..."

# game/script.rpy:1268
translate polish balcony_48687508:

    # "Очередной ураган проносится по стенкам котла, разбивая в пыль стекла и сметая бетонный налет. Меня он лишь нежно гладит, взъерошивая волосы."
    "Kolejna burza przetacza się przez ściany kotła, roztrzaskując szkło w pył i zmiatając betonowy osad. Głaszcze mnie delikatnie, szarpiąc moje włosy."

# game/script.rpy:1276
translate polish fall_db020311:

    # gg "- Я так и не придумала кодовое слово..."
    gg "- Wciąż nie wymyśliłam szyfru..."

translate polish strings:
    # game/script.rpy:1277
    old "(Ты ведь и сама вспомнила о своем обещании. Значит, кодовое слово уже не нужно.)"
    new "(Pamiętałaś o swojej obietnicy, prawda? Więc nie potrzebujesz już tego szyfru.)"
# game/script.rpy:1279
translate polish fall_c721f2ec:

    # gg "- Не люблю, когда так происходит. Хочу вспоминать о некоторых вещах только тогда, когда хочется."
    gg "- Nie lubię, gdy tak się dzieje. Chcę pamiętać o pewnych rzeczach tylko wtedy, kiedy mam na to ochotę."

translate polish strings:
    # game/script.rpy:1280
    old "(Тем не менее, ты обещала.)"
    new "(Niemniej jednak, obiecałaś.)"
# game/script.rpy:1282
translate polish fall_4ae32b2e:

    # gg "- Я сдержу обещание. Просто имей в виду, что с этой секунды каждое слово будет приносить мне боль."
    gg "- Dotrzymam obietnicy. Tylko pamiętaj, że od tej pory każde słowo będzie mnie bolało."

# game/script.rpy:1283
translate polish fall_8ba04f43:

    # "Я наклоняюсь вниз и мысленно падаю в пропасть. Ровно две минуты до того, как я разобьюсь."
    "Pochylam się i mentalnie spadam w otchłań. Dokładnie dwie minuty przed moim upadkiem."

# game/script.rpy:1314
translate polish fall_6e7ffcd9:

    # gg "- У меня был друг в сети. Лучший друг! Даже несмотря на то, что его набор букв вместо имени был не самым клевым."
    gg "- Miałam przyjaciela w internecie. Najlepszego przyjaciela! Był najlepszy nawet jeśli zamiast imienia używał mieszankę losowych liter."

# game/script.rpy:1315
translate polish fall_04ef6841:

    # gg "- Да и набор пикселей вместо фотографии был скучным и непривлекательным..."
    gg "- A zamiast zdjęcia używał zlepki pikseli, która była nudna i nieatrakcyjna..."

# game/script.rpy:1316
translate polish fall_05fead8a:

    # gg "- Это ведь странно и неправильно - нарушать правила нахождения в сети. Зачем он это делал?"
    gg "- To dziwne i złe łamać zasady bycia online. Dlaczego miałby to robić?"

# game/script.rpy:1317
translate polish fall_4bcbf580:

    # gg "- Может, в его коде не хватало нескольких строк?"
    gg "- Może w jego kodzie brakowało kilku wersów?"

translate polish strings:
    # game/script.rpy:1318
    old "(Я не совсем понимаю, о чем ты.)"
    new "(Nie do końca wiem, co masz na myśli.)"
    
# game/script.rpy:1320
translate polish fall_f66a60bd:

    # gg "- Я бы могла рассказать тебе об этих правилах."
    gg "- Mogłabym ci opowiedzieć o tych zasadach."

# game/script.rpy:1321
translate polish fall_16920eb1:

    # gg "- Их невозможно нигде отыскать, но я-то умная и сама во всем разобралась!"
    gg "- Nie da się ich nigdzie znaleźć, ale jestem sprytna i sama to rozpracowałam!"

# game/script.rpy:1322
translate polish fall_6dddc581:

    # gg "- Однако же..."
    gg "- Jednak..."

# game/script.rpy:1323
translate polish fall_02dee236:

    # gg "- Я не уверена, стоит ли их озвучивать."
    gg "- Nie jestem pewna, czy warto o nich mówić."

# game/script.rpy:1326
translate polish fall_f86b348e:

    # gg "- Когда я пытаюсь произнести вслух то, что на уме - запросто могу где-то ошибиться."
    gg "- Kiedy próbuję powiedzieć na głos to, co chodzi mi po głowie, łatwo mogę się pomylić."

# game/script.rpy:1327
translate polish fall_e14d8490:

    # gg "- Одна ошибка - и все сказанное дальше полностью противоречит моим мыслям."
    gg "- Jeden błąd i wszystko, co zostało powiedziane dalej, całkowicie zaprzecza mojemu myśleniu."

# game/script.rpy:1328
translate polish fall_dbf33c3d:

    # gg "- И в итоге я сама себя разубеждаю."
    gg "- I w końcu sama się zniechęcam."

# game/script.rpy:1329
translate polish fall_d0ee67f8:

    # gg "- А я этого не хочу!"
    gg "- A ja tego nie chcę!"

translate polish strings:
    # game/script.rpy:1330
    old "(По твоей логике лучше вообще никогда рта не открывать.)"
    new "(Zgodnie z twoją logiką, lepiej w ogóle nie otwierać ust.)"
    
# game/script.rpy:1332
translate polish fall_90c701a6:

    # gg "- Конечно! Это моя мечта!"
    gg "- Oczywiście! To moje marzenie!"

# game/script.rpy:1333
translate polish fall_ef2b79ea:

    # gg "- Не открывать рта, не вставать с кровати, ничего не видеть и не слышать..."
    gg "- Nie otwierać ust, nie wstawać z łóżka, nie widzieć i nie słyszeć niczego..."

# game/script.rpy:1334
translate polish fall_d5bd69aa:

    # gg "- Лишь сны, сны... ах, ну почему все так ужасно?"
    gg "- Tylko sny, sny... ah, dlaczego wszystko jest takie okrutne?"

translate polish strings:
    # game/script.rpy:1335
    old "(Не отвлекайся. Так что же твой друг?)"
    new "(Nie rozpraszaj się. Więc co się stało z twoim przyjacielem?)"
    
# game/script.rpy:1337
translate polish fall_068b19d2:

    # gg "- Друг?"
    gg "- Przyjacielem?"

# game/script.rpy:1338
translate polish fall_de9236f7:

    # gg "- Ах, да..."
    gg "- Ah, no tak..."

# game/script.rpy:1339
translate polish fall_eb3b671b:

    # gg "- Он... и хватило же наглости!.."
    gg "- On... miał czelność!.."

translate polish strings:
    # game/script.rpy:1340
    old "(Ну же, собери мысли в кучу.)"
    new "(Weź się już w garść.)"
# game/script.rpy:1342
translate polish fall_3e166794:

    # gg "- Он каким-то образом заставил меня поверить, будто он настоящий."
    gg "- W jakiś sposób przekonał mnie, że jest prawdziwy."

# game/script.rpy:1343
translate polish fall_9b6a13df:

    # gg "- Расписывал мне чью-то жизнь в мельчайших подробностях, выдавая за свою."
    gg "- Bardzo szczegółowo opowiadał mi o czyimś życiu, udając, że to jego własne."

# game/script.rpy:1344
translate polish fall_b2950fc7:

    # gg "- И, разумеется, ждал того же и от меня."
    gg "- I, oczywiście, oczekiwał tego samego ode mnie."

# game/script.rpy:1345
translate polish fall_67ffc7a0:

    # gg "- Ну я и рассказала ему все-все о себе. Ничего не утаила."
    gg "- Opowiedziałam mu więc wszystko o sobie. Niczego nie ukryłam."

# game/script.rpy:1346
translate polish fall_d72da0b3:

    # "Я крепко стискиваю зубы. Ветер нещадно хлещет по лицу, разрезает кожу на неровные полосы, словно тонкую ткань."
    "Zaciskam mocno zęby. Wiatr wieje niemiłosiernie po mojej twarzy, tnąc skórę w poszarpane paski niczym cienką tkaninę."

# game/script.rpy:1347
translate polish fall_c046a810:

    # gg "- Он знал обо мне больше, чем кто-либо в мире."
    gg "- Wiedział o mnie więcej niż ktokolwiek inny na świecie."

# game/script.rpy:1348
translate polish fall_3e696f84:

    # gg "- И знаешь, что он сделал?"
    gg "- I wiesz co on zrobił?"

# game/script.rpy:1351
translate polish fall_8ebb7d3e:

    # gg "- Ха-ха..."
    gg "- Ha-ha..."

# game/script.rpy:1352
translate polish fall_89d47646:

    # gg "- Натравить на меня сотни ботов, должно быть, очень весело."
    gg "- Nasłanie na mnie setek botów musi być niezłą zabawą."

# game/script.rpy:1353
translate polish fall_b1494d20:

    # gg "- А главное, все от этого только выигрывают."
    gg "- A co najważniejsze, wszyscy na tym korzystają."

# game/script.rpy:1354
translate polish fall_293f6639:

    # gg "- Они появляются тут и там. Довольно простой код, не требующих особых усилий для выполнения - неудивительно, что алгоритм присуждает эту модель поведения с большей вероятностью, чем прочие из списка."
    gg "- Pojawiają się tu i tam. Dość prosty kod, niewymagający wiele wysiłku do wykonania - nic dziwnego, że algorytm przyznaje temu zachowaniu większe prawdopodobieństwo niż innym na liście."

# game/script.rpy:1355
translate polish fall_a2d7e645:

    # gg "- Генераторы текстов и видеороликов тут же принимаются за работу. Мое имя всплывает в сети все чаще и чаще."
    gg "- Generatory tekstu i wideo natychmiast przystępują do pracy. Moje nazwisko pojawia się coraz częściej w sieci."

# game/script.rpy:1356
translate polish fall_40939d2a:

    # gg "- Это невыносимо."
    gg "- To nie do wytrzymania."

# game/script.rpy:1357
translate polish fall_706a6e0e:

    # gg "- Невыносимо."
    gg "- Nie do wytrzymania."

# game/script.rpy:1358
translate polish fall_97c3fe1a:

    # gg "- Из-за каждого угла, с балконов, крыш, подвалов, стен, потолков я всегда ощущаю пристальные взгляды множества глаз."
    gg "- Z każdego kąta, z balkonów, dachów, piwnic, ścian, sufitów, zawsze czuję na sobie spojrzenia wielu oczu."

# game/script.rpy:1359
translate polish fall_114f66a0:

    # gg "- А теперь - и с экранов."
    gg "- A teraz - jeszcze z ekranów."

# game/script.rpy:1360
translate polish fall_a1594cd8:

    # gg "- Но я положу этому конец. Я давно решила."
    gg "- Ale skończę z tym. Już dawno temu podjęłam decyzję."

# game/script.rpy:1361
translate polish fall_63878067:

    # gg "- Хотя... Возможно, я решила сделать это только..."
    gg "- Chociaż... Może właśnie się na to zdecydowałam, tylko..."

# game/script.rpy:1369
translate polish fall_7ccfd918:

    # "Мое тело наконец обрушивается на землю, разлетаясь, словно фарфор, на миллионы мелких частиц."
    "Moje ciało w końcu upada na ziemię, roztrzaskując się jak porcelana na miliony drobnych cząsteczek."

# game/script.rpy:1371
translate polish fall_b96349c6:

    # "Уже вторая смерть за сегодня."
    "To już druga śmierć dzisiaj."

# game/script.rpy:1375
translate polish nofall_decc57b3:

    # gg "- Мне холодно, пойдем внутрь."
    gg "- Jest mi zimno, chodźmy do środka."

# game/script.rpy:1395
translate polish nofall_e7bfe7ca:

    # "Я вернулась в комнату. К счастью, она совсем не изменилась за те минуты, что я была за её пределами."
    "Wróciłam do pokoju. Na szczęście przez te kilka minut, które spędziłam na zewnątrz, nic się nie zmieniło."

# game/script.rpy:1397
translate polish nofall_4e43e68b:

    # "Ни секунды не думая, я подхожу к ноутбуку и с силой выдергиваю кабель из розетки."
    "Nie zastanawiając się ani chwili, podchodzę do laptopa i siłą odłączam kabel od gniazdka."

# game/script.rpy:1401
translate polish nofall_37875b61:

    # gg "- Вот и все."
    gg "- To tyle."

# game/script.rpy:1402
translate polish nofall_5675f48a:

    # "Вот и все."
    "To tyle."
    
translate polish strings:
    # game/script.rpy:1403
    old "(Вот и все.)"
    new "(To tyle.)"
    
    # game/script.rpy:1411
    old "(Что будешь делать?)"
    new "(Co zamierzasz robić?)"
    
# game/script.rpy:1416
translate polish room_8139d3e3:

    # gg "- Что за глупый вопрос?"
    gg "- Co to za głupie pytanie?"

# game/script.rpy:1417
translate polish room_9920cc55:

    # gg "- Спать, конечно же."
    gg "- Oczywiście, że spać."

# game/script.rpy:1420
translate polish room_269ca6e8:

    # gg "- Надеяться, что завтра наступит через год или десять."
    gg "- Mieć nadzieję, że jutro nadejdzie za rok lub dziesięć."

# game/script.rpy:1423
translate polish room_48115f70:

    # gg "- Представлять, будто я где-то вне своей оболочки, и при этом я - это все еще я. Немыслимо, как молоко вне пакета. И все же..."
    gg "- Wyobrażam sobie, że jestem gdzieś poza moją skorupą, a jednak wciąż jestem sobą. Nie do pomyślenia, jak mleko poza kartonem. A jednak..."

translate polish strings:
    # game/script.rpy:1424
    old "(И все же?..)"
    new "(A jednak?..)"
    
# game/script.rpy:1428
translate polish room_46fc17ca:

    # gg "- Необязательно говорить вслух, чтобы я понимала, что ты переживаешь за меня."
    gg "- Nie musisz mówić tego na głos, żebym zrozumiała, że się o mnie martwisz."

# game/script.rpy:1429
translate polish room_b0c4f51c:

    # gg "- Ведь я и так это знаю."
    gg "- Przecież ja to już wiem."

# game/script.rpy:1432
translate polish room_e90031c5:

    # gg "- Также я знаю, что у нас осталось совсем немного времени."
    gg "- Wiem też, że nie zostało nam wiele czasu."

translate polish strings:
    # game/script.rpy:1433
    old "(Ты не станешь пить еще одну таблетку.)"
    new "(Nie weźmiesz kolejnej tabletki.)"
    
# game/script.rpy:1437
translate polish room_7de67075:

    # gg "- Разумеется. Более того, я не стану пить ее и завтра."
    gg "- Oczywiście, że tak. Co więcej, jutro też nie będę jej brała."

# game/script.rpy:1440
translate polish room_593f021e:

    # gg "- И послезавтра."
    gg "- I pojutrze też."

# game/script.rpy:1443
translate polish room_1530f895:

    # gg "- И вообще никогда."
    gg "- I w ogóle nigdy."

translate polish strings:
    # game/script.rpy:1444
    old "(Прощаемся, выходит?)"
    new "(Żegnamy się, co?)"
    
# game/script.rpy:1448
translate polish room_d2c4cf06:

    # gg "- ..."
    gg "- ..."

# game/script.rpy:1451
translate polish room_0080ca73:

    # gg "- Нет..."
    gg "- Nie..."

# game/script.rpy:1452
translate polish room_bfc80253:

    # gg "- У меня будет еще одна просьба... совсем крохотная."
    gg "- Mam jeszcze jedną prośbę... bardzo malutką."

translate polish strings:
    # game/script.rpy:1453
    old "(Какая же?)"
    new "(Jaką?)"
    
# game/script.rpy:1457
translate polish room_34c59097:

    # gg "- Я сегодня слишком много наговорила. Многое хотелось бы навсегда забыть."
    gg "- Za dużo dziś powiedziałam. Jest wiele rzeczy, o których chciałabym zapomnieć na zawsze."

# game/script.rpy:1460
translate polish room_e3d97ead:

    # gg "- Я не виню тебя, просто... Было ли это так необходимо?"
    gg "- Nie winię cię, tylko... Czy to było naprawdę konieczne?"

translate polish strings:
    # game/script.rpy:1461
    old "(Вот завтра и узнаешь.)"
    new "(Jutro się dowiesz.)"

# game/script.rpy:1465
translate polish room_e685f7a8:

    # gg "- Нет, я так не усну."
    gg "- Nie, nie będę mogła wtedy spać."

translate polish strings:
    # game/script.rpy:1466
    old "(Хорошо, так что за просьба?)"
    new "(Dobra, więc co to za prośba?)"
    
# game/script.rpy:1470
translate polish room_61f95837:

    # gg "- Я... м-м..."
    gg "- Ja... em-m..."

# game/script.rpy:1473
translate polish room_68dca3ff:

    # "Я нервно чешу запястья и прикусываю губу."
    "Nerwowo drapię się po nadgarstkach i przygryzam wargę."

translate polish strings:
    # game/script.rpy:1474
    old "(Постой, ты что... боишься мне сказать?)"
    new "(Czekaj, czy ty... boisz się mi powiedzieć?)"

# game/script.rpy:1478
translate polish room_76c5c726:

    # gg "- Да!"
    gg "- Tak!"

# game/script.rpy:1481
translate polish room_c2c02deb:

    # gg "- А еще я боюсь, что произойдет что-то очень плохое, если я скажу!"
    gg "- Boję się też, że jeśli powiem, to stanie się coś bardzo złego!"

# game/script.rpy:1484
translate polish room_f14d41aa:

    # gg "- А еще я боюсь, что из-за того, что произойдет что-то плохое, произойдет что-то гораздо, гораздо хуже!"
    gg "- Boję się też, że skoro stanie się coś złego, to stanie się coś o wiele, wiele gorszego!"

translate polish strings:
    # game/script.rpy:1485
    old "(Да понял я!)"
    new "(No dobra, dobra rozumiem!)"

    # game/script.rpy:1487
    old "(И все же не отстану, пока не скажешь.)"
    new "(Ale nie zrezygnuję, dopóki mi nie powiesz.)"
    
# game/script.rpy:1493
translate polish room_78810b60:

    # gg "- Зануда..."
    gg "- Nudziarz..."

translate polish strings:
    # game/script.rpy:1494
    old "(Нет, ты!)"
    new "(No chyba ty!)"
    
# game/script.rpy:1517
translate polish room_de40471b:

    # "Я неуклюже забираюсь в спальный мешок. Внизу комнаты очень прохладно; и пусть электрический обогреватель работает изо всех сил, я, тем не менее, спешу скорей укутаться."
    "Wdrapuję się niezdarnie do śpiwora. Na dole jest bardzo chłodno; i chociaż grzejnik elektryczny pracuje tak mocno, jak tylko może, nadal spieszę się, by się owinąć."

# game/script.rpy:1520
translate polish room_47a7d25c:

    # gg "- Мне грустно из-за того, что сны больше не приходят."
    gg "- Smutno mi, bo sny już od dawna się nie pojawiają."

# game/script.rpy:1521
translate polish room_541ac548:

    # gg "- Ни за что не поверишь, как я поначалу справлялась с этим."
    gg "- Nigdy nie uwierzysz, jak sobie z tym radziłam na początku."

translate polish strings:
    # game/script.rpy:1522
    old "(Конечно, поверю.)"
    new "(Co ty? Uwierze ci.)"
    
# game/script.rpy:1524
translate polish room_16ce1f16:

    # gg "- Я знаю. Это была шутка."
    gg "- Wiem. To była ironia."

# game/script.rpy:1525
translate polish room_5691257a:

    # gg "- Так вот - я умывалась, чистила зубы, ложилась и начинала воображать, будто я вижу сон. При этом я, конечно же, совсем не спала и поутру вечно клевала носом."
    gg "- Myłam więc twarz, myłam zęby, kładłam się i wyobrażałam sobie, że śnię. Oczywiście w ogóle nie spałam, a rano ciągle dziobałam się w nos."

# game/script.rpy:1526
translate polish room_59d116a9:

    # gg "- После недели бессонных ночей я стала себя странно чувствовать и начала видеть всякое..."
    gg "- Po tygodniu bezsennych nocy, zaczęłam się dziwnie czuć i widzieć różne rzeczy..."

# game/script.rpy:1527
translate polish room_0b2b5f9d:

    # gg "- Парящие в воздухе буквы, странные силуэты, появляющиеся в самых неожиданных местах. Выпученные глаза с дрожащими бледными зрачками... Страшно, знаешь ли!"
    gg "- Litery unoszące się w powietrzu, dziwne sylwetki pojawiające się w najbardziej nieoczekiwanych miejscach. Wyłupiaste oczy z drżącymi, bladymi źrenicami... Straszne, wiesz!"

# game/script.rpy:1528
translate polish room_d0f92d40:

    # gg "- Однажды я чуть не умерла. Просто упала посреди комнаты и какое-то время не могла пошевелиться. А силуэты, буквы и глаза нависли надо мной и осуждающе шипели."
    gg "- Raz prawie umarłam. Po prostu upadłam na środek pokoju i przez chwilę nie mogłam się ruszyć. Sylwetki, litery i oczy unosiły się nade mną i syczały osądzająco."

# game/script.rpy:1529
translate polish room_e275b366:

    # gg "- Это было ужасно."
    gg "- To było okropne."

# game/script.rpy:1530
translate polish room_87ac3140:

    # gg "- И... заслуженно, что ли?"
    gg "- Czy ja na to zasłużyłam?"

# game/script.rpy:1531
translate polish room_8c2610d5:

    # gg "- Я будто была поймана на самой большой в мире лжи. Да, должно быть, так и было."
    gg "- Czułam się tak, jakbym została przyłapana na największym kłamstwie świata. Tak, chyba tak było."

# game/script.rpy:1532
translate polish room_71231f48:

    # gg "- После этого я прекратила."
    gg "- Po tym, przestałam."

# game/script.rpy:1533
translate polish room_a98bf790:

    # gg "- А силуэты, буквы и глаза остались жить тут - понравилось, видимо!"
    gg "- A sylwetki, litery i oczy nadal tu żyją - spodobało im się, najwyraźniej!"

# game/script.rpy:1534
translate polish room_0fb6bf67:

    # gg "- Вечно ходят за мной по пятам, подглядывают... А я их побаиваюсь и не могу даже слова поперек сказать."
    gg "- Zawsze za mną chodzą, podglądają mnie... A ja się ich boję i nie mogę nawet słowa powiedzieć przeciwko nim."

# game/script.rpy:1535
translate polish room_771ceae3:

    # gg "- Но сегодня..."
    gg "- Ale dzisiaj..."

# game/script.rpy:1536
translate polish room_b780befe:

    # gg "- Сегодня..."
    gg "- Dzisiaj..."

translate polish strings:
    # game/script.rpy:1537
    old "(Ну?)"
    new "(Dzisiaj co?)"
    
# game/script.rpy:1539
translate polish room_d4a15ee5:

    # gg "- Я..."
    gg "- Ja..."

translate polish strings:
    # game/script.rpy:1540
    old "(Ты все еще боишься мне сказать?)"
    new "(Wciąż boisz się mi powiedzieć?)"
    
# game/script.rpy:1542
translate polish room_ea92e2c1:

    # gg "- Конечно, они же слушают!"
    gg "- Oczywiście, przecież słuchają!"

translate polish strings:
    # game/script.rpy:1543
    old "(Объясни на пальцах.)"
    new "(Może mi to zobrazujesz?)"
    
# game/script.rpy:1545
translate polish room_524f741b:

    # gg "- Ладно!"
    gg "- Dobra!"

# game/script.rpy:1548
translate polish room_e3a26920:

    # "Я принимаюсь беспорядочно, но оттого не менее воодушевленно вертеть пальцами, выстраивая сложные фигуры."
    "Zaczynam bezładnie machać palcami, ale nie mniej entuzjastycznie, budując skomplikowane kształty."

translate polish strings:
    # game/script.rpy:1549
    old "(Ты хочешь, чтобы я... рассказал тебе историю перед сном?)"
    new "(Czy chcesz, żebym... opowiedział ci bajkę na dobranoc?)"
    
# game/script.rpy:1551
translate polish room_aaa6ed3d:

    # gg "- Тш-ш-ш-ш!"
    gg "- Ćś-ś-ś-ś!"

# game/script.rpy:1554
translate polish room_f1f76ee9:

    # gg "- Я что, зря тут стараюсь? Тебя ведь услышат!"
    gg "- Czy ja tu próbuję na darmo? Przecież oni słyszą!"

translate polish strings:
    # game/script.rpy:1555
    old "(Расслабься, никто тебя не слышит.)"
    new "(Spokojnie, nikt cię nie słyszy.)"
    
# game/script.rpy:1557
translate polish room_d2c4cf06_1:

    # gg "- ..."
    gg "- ..."

# game/script.rpy:1559
translate polish room_deb15c30:

    # gg "- Ну так что?"
    gg "- No więc co?"

translate polish strings:
    # game/script.rpy:1560
    old "(Я бы с радостью, но я совсем не знаю, как их рассказывать.)"
    new "(Bardzo bym chciał, ale nie umiem.)"
    
# game/script.rpy:1562
translate polish room_3a0ed07d:

    # gg "- Ой, да это очень просто!"
    gg "- Oh, to jest bardzo proste!"

# game/script.rpy:1563
translate polish room_18998f65:

    # gg "- Просто говори о чем угодно без остановки."
    gg "- Po prostu rozmawiaj o czymkolwiek bez przerwy."

translate polish strings:
    # game/script.rpy:1564
    old "(Звучит нелепо.)"
    new "(To brzmi absurdalnie.)"

    # game/script.rpy:1567
    old "(А еще бессмысленно.)"
    new "(Jest to również bezsensowne.)"
    
# game/script.rpy:1566
translate polish room_0bef18b7:

    # gg "- И вовсе нет!"
    gg "- Wcale nie!"

# game/script.rpy:1569
translate polish room_f6a122b0:

    # gg "- Да что ты вообще понимаешь?"
    gg "- Co ty w ogóle wiesz?"

translate polish strings:   
    # game/script.rpy:1570
    old "(Достаточно, чтобы понять, что мы лишь впустую потратим время.)"
    new "(Dużo czego, by rozumieć, że tylko tracimy czas.)"

    # game/script.rpy:1572
    old "(Давай сосредоточимся на чем-нибудь действительно важном.)"
    new "(Skupmy się na czymś naprawdę ważnym.)"

# game/script.rpy:1574
translate polish room_b35942a8:

    # gg "- Скукотища..."
    gg "- Ale nudy..."

translate polish strings:  
    # game/script.rpy:1578
    old "(Закрывай глаза.)"
    new "(Zamknij oczy.)"

# game/script.rpy:1577
translate polish room_6ec9d9f0:

    # gg "- Ладно..."
    gg "- Okej..."



# game/script.rpy:1620
translate polish newscene_1_3b7684ac:

    # gg "- Ты нашел всех светлячков! Здорово!"
    gg "- Znalazłeś wszystkie świetliki! Wspaniale!"

# game/script.rpy:1623
translate polish newscene_1_22941486:

    # gg "- Вроде бы..."
    gg "- Chyba..."






















































































































































































































































