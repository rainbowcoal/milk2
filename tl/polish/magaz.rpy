# game/magaz.rpy:63
translate polish magaz_2bd1e715:

    # nm "Я просыпаюсь на деревянной лавке; перед глазами - узкая и слабо освещенная аллея. До боли знакомая дорога... где же я могла ее видеть?"
    nm "Budzę się na drewnianej ławce, przed oczami mam wąską i słabo oświetloną uliczkę. Droga jest boleśnie znajoma... gdzie mogłam to zobaczyć?"

# game/magaz.rpy:64
translate polish magaz_aad6796c:

    # trm "- Ну наконец-то..."
    trm "- Nareszcie..."

# game/magaz.rpy:70
translate polish magaz_5b9565ac:

    # nm "Сбоку разносится голос. Я поворачиваюсь и вижу перед собой мальчика с крайне странным выражением лица."
    nm "Z boku dobiega głos. Odwracam się i widzę przed sobą chłopaka z bardzo dziwnym wyrazem twarzy."

# game/magaz.rpy:76
translate polish magaz_5c56715c:

    # trm "- Ты опоздала!"
    trm "- Spóźniłaś się!"

# game/magaz.rpy:78
translate polish magaz_d9ca71a8:

    # ggm "- Эм-м-м... а ты кто?"
    ggm "- Em-m-m... kim jesteś?"

# game/magaz.rpy:79
translate polish magaz_c96f65e3:

    # nm "Мальчик удивленно моргнул."
    nm "Chłopak mrugnął zaskoczony."

# game/magaz.rpy:81
translate polish magaz_9b91e7ea:

    # trm "- Так мы с тобой далеко не уйдем. Попробуй заново."
    trm "- W ten sposób daleko nie zajdziemy. Spróbuj jeszcze raz."

# game/magaz.rpy:82
translate polish magaz_92df8506:

    # nm "Затем он набирает полную грудь воздуха."
    nm "Następnie bierze głęboki wdech."

# game/magaz.rpy:83
translate polish magaz_21e45af1:

    # trm "- Ты! Опоздала!"
    trm "- Ty! Spóźniłaś się!"

# game/magaz.rpy:85
translate polish magaz_9dec254e:

    # nm "Я непонимающе смотрю на него. Он непонимающе смотрит на меня."
    nm "Patrzymy na siebie niezrozumiale."

# game/magaz.rpy:86
translate polish magaz_60af0f3c:

    # ggm "- И-извини?.."
    ggm "- P-przepraszam?.."

# game/magaz.rpy:88
translate polish magaz_400b60e9:

    # nm "Мальчик довольно кивнул."
    nm "Chłopiec przytaknął z zadowoleniem."

# game/magaz.rpy:89
translate polish magaz_77916ef1:

    # trm "- Вот, уже лучше."
    trm "- Tak już lepiej."

# game/magaz.rpy:90
translate polish magaz_e9fa80ce:

    # trm "- Имя-то у тебя есть? Меня вот Треской звать!"
    trm "- Czy masz jakieś imię? Mam na imię Treska!"

# game/magaz.rpy:92
translate polish magaz_24605459:

    # nm "Я оценивающе оглядываю наглеца. Совсем маленький, а уже лезет с такими вопросами!"
    nm "Patrzę na zuchwalca oceniającym wzrokiem. Jest taki młody, a już zadaje mi pytania!"

# game/magaz.rpy:93
translate polish magaz_e9fe9f8b:

    # ggm "- Не твое дело..."
    ggm "- Nie twój interes..."

# game/magaz.rpy:94
translate polish magaz_dfb8a18f:

    # ggm "- И вообще!.. Мне кто-нибудь скажет, что я тут делаю?"
    ggm "- A zresztą!.. Czy ktoś mi powie, co ja tu robię?"

# game/magaz.rpy:96
translate polish magaz_279aff48:

    # trm "- Эй, это невежливо! Будто тут есть кто-то еще..."
    trm "- Ej, to niegrzeczne! Jakby był tu ktoś jeszcze..."

# game/magaz.rpy:98
translate polish magaz_0619fa6f:

    # nm "..."
    nm "..."

# game/magaz.rpy:100
translate polish magaz_a899a5fc:

    # trm "- Тебе совсем ничего не рассказали? Вот я все знаю, например!"
    trm "- Nic ci nie powiedzieli? Ja na przykład wiem wszystko!"

# game/magaz.rpy:102
translate polish magaz_1d4b75d7:

    # ggm "- О чем?"
    ggm "- O czym mieli mi powiedzieć?"

# game/magaz.rpy:104
translate polish magaz_bf91ae6e:

    # trm "- Ты обязана проводить меня в магазин!"
    trm "- Musisz mnie zaprowadzić do sklepu!"

# game/magaz.rpy:105
translate polish magaz_aef4f109:

    # nm "После этих слов Треска встал в победную позу."
    nm "Po tych słowach Treska stanął w triumfalnej pozie."

# game/magaz.rpy:107
translate polish magaz_81f8ed24:

    # ggm "- Еще чего..."
    ggm "- Nie ma szans..."

# game/magaz.rpy:109
translate polish magaz_8decfd91:

    # trm "- Ты ведь понимаешь, что отказ не принимается?"
    trm "- Zdajesz sobie sprawę, że odmowa nie jest akceptowana, prawda?"

# game/magaz.rpy:111
translate polish magaz_efc3c766:

    # ggm "- Многовато ты о себе возомнил."
    ggm "- Za dużo sobie pozwalasz."

# game/magaz.rpy:113
translate polish magaz_c4e65e33:

    # trm "- Я серьезно."
    trm "- Mówię poważnie."

# game/magaz.rpy:114
translate polish magaz_7516ceb4:

    # trm "- Это, как бы, не мне решать."
    trm "- Nie ja o tym decyduję."

# game/magaz.rpy:115
translate polish magaz_1eeae098:

    # trm "- Думаешь, я в восторге от такой компании?"
    trm "- Czy myślisz, że cieszę się z twojego towarzystwa?"

# game/magaz.rpy:117
translate polish magaz_f10d9bff:

    # nm "Какой-то он странный. То веселый, то грустный, то громкий, то тихий. Ненормальный какой-то. И имя дурацкое."
    nm "On jest trochę dziwny. Jest wesoły i smutny, głośny i cichy. Jakiś nienormalny. A jego imię jest głupie."

# game/magaz.rpy:119
translate polish magaz_9d1124ad:

    # trm "- Мы идем или как?"
    trm "- Idziemy czy co?"

# game/magaz.rpy:121
translate polish magaz_22b68094:

    # ggm "- Ты иди, а мне подумать надо."
    ggm "- Ty idź, ja muszę się zastanowić."

# game/magaz.rpy:123
translate polish magaz_93798464:

    # trm "- Я бы с радостью, да только дороги не знаю..."
    trm "- Bardzo bym chciał, ale nie znam drogi..."

# game/magaz.rpy:124
translate polish magaz_75266a4b:

    # nm "Треска хитро улыбается. Я с досадой кусаю губы."
    nm "Treska uśmiechnął się chytrze. Gryzę wargę z irytacji."

# game/magaz.rpy:126
translate polish magaz_5e5cae60:

    # ggm "- Буду с тобой честна - ты мне совсем не нравишься."
    ggm "- Będę z tobą szczera - nie lubię cię."

# game/magaz.rpy:127
translate polish magaz_989f8e80:

    # nm "В ответ он лишь заливается смехом."
    nm "On w odpowiedzi po prostu wybuchnął śmiechem."

# game/magaz.rpy:131
translate polish magaz_6c52dd99:

    # trm "- Зато ты мне - очень!"
    trm "- Za to ja cię lubię!"

# game/magaz.rpy:132
translate polish magaz_80189b02:

    # nm "После этого он с уверенностью хватает меня за руку - я и рта не успеваю открыть."
    nm "Następnie z poczuciem pewności siebie łapie mnie za rękę, zanim zdążę otworzyć usta."

# game/magaz.rpy:133
translate polish magaz_b9406d79:

    # trm "- Веди!"
    trm "- Prowadź!"

# game/magaz.rpy:146
translate polish magaz_03d48903:

    # nm "Дорога до магазина прошла нормально, если не считать того, что Треска шел заметно быстрее."
    nm "Droga do sklepu była w porządku, z wyjątkiem tego, że Treska szedł wyraźnie szybciej."

# game/magaz.rpy:147
translate polish magaz_7f15f214:

    # nm "И наоборот - в какие-то моменты он резко останавливался и начинал идти назад, внимательно глядя себе под ноги."
    nm "Chociaż, w pewnych momentach zatrzymywał się gwałtownie i szedł do tyłu, patrząc uważnie pod nogi."

# game/magaz.rpy:148
translate polish magaz_eaf9b630:

    # nm "В итоге дорога заняла гораздо больше времени, чем могла бы."
    nm "Podróż trwała znacznie dłużej niż mogłaby."

# game/magaz.rpy:154
translate polish magaz_cf29981f:

    # nm "Оказавшись у дверей магазина, мы видим перед собой вывеску."
    nm "Po wejściu do sklepu widzimy przed sobą napis."

# game/magaz.rpy:155
translate polish magaz_214bc86e:

    # nm "'Магазин закрывается через 20 минут!'"
    nm "'Sklep zamyka się za 20 minut!'"

# game/magaz.rpy:156
translate polish magaz_ba5d0e53:

    # ggm "- И взбрело же кому-то в голову таким образом обозначить часы работы своего магазина..."
    ggm "- Czy ktoś naprawdę w ten sposób ogłasza zamknięcie sklepu..."

# game/magaz.rpy:157
translate polish magaz_3b104fbf:

    # trm "- Наверно, у них для этого специальный человек есть. Каждые пять минут бегает и меняет табличку. Удобно же!"
    trm "- Prawdopodobnie mają do tego specjalną osobę, która co pięć minut biega i zmienia tabliczkę. Genialne!"

# game/magaz.rpy:158
translate polish magaz_603668ed:

    # ggm "- Шутишь, что ли?"
    ggm "- Żartujesz, prawda?"

# game/magaz.rpy:159
translate polish magaz_72395cef:

    # trm "- Да!"
    trm "- Tak!"

# game/magaz.rpy:160
translate polish magaz_b706ff96:

    # ggm "- До чего же ты надоедливый..."
    ggm "- Jaki ty jesteś wkurzający..."

# game/magaz.rpy:161
translate polish magaz_4e875e76:

    # trm "- Всяко лучше, чем быть занудой! Тебе, кстати, лет-то сколько?"
    trm "- To lepsze niż bycie nudziarzem! A tak przy okazji, ile masz lat?"

# game/magaz.rpy:162
translate polish magaz_56bd5b0c:

    # ggm "- Не твое дело."
    ggm "- Nie twój interes."

# game/magaz.rpy:163
translate polish magaz_7dc314bf:

    # trm "- А-а-а... а зовут как?"
    trm "- E-e-e... A jak masz na imię?"

# game/magaz.rpy:164
translate polish magaz_b5ef0b03:

    # ggm "- Не твое дело!"
    ggm "- Nie twój interes!"

# game/magaz.rpy:165
translate polish magaz_4f29a999:

    # nm "Я уже готова была дать мелкому поганцу подзатыльник, как вдруг за стеклом появляется жуткого вида человек. В руках он держит картонную табличку с надписью 'До закрытия магазина 15 минут!'"
    nm "Już miałam dać temu małemu gnojkowi klapsa w twarz, gdy nagle za szybą pojawił się przerażająco wyglądający mężczyzna. Trzymał kartonową tabliczkę z napisem '15 minut do zamknięcia sklepu!'"

# game/magaz.rpy:166
translate polish magaz_491606b9:

    # trm "- Пойдем, чего стоишь?"
    trm "- Chodź, na co czekasz?"

# game/magaz.rpy:167
translate polish magaz_b3e070b9:

    # ggm "- А? Д-да..."
    ggm "-A? T-tak..."

# game/magaz.rpy:177
translate polish magaz_bda9d19f:

    # nm "В очередной раз проходя мимо длинного ряда с консервными банками, мы поняли, что заблудились."
    nm "Po raz kolejny, przechodząc obok długiego rzędu blaszanych puszek, zdaliśmy sobie sprawę, że się zgubiliśmy."

# game/magaz.rpy:178
translate polish magaz_fab2588c:

    # ggm "- Поверить не могу, что ты не знаешь, где продается молоко."
    ggm "- Nie mogę uwierzyć, że nie wiesz, gdzie sprzedaje się mleko."

# game/magaz.rpy:179
translate polish magaz_d2bc0976:

    # trm "- Я... эм-м-м..."
    trm "-Ja... e-e-eh..."

# game/magaz.rpy:180
translate polish magaz_fa0c299d:

    # ggm "- Может, спросим кого-нибудь?"
    ggm "- Może kogoś zapytamy?"

# game/magaz.rpy:181
translate polish magaz_72bfe8b3:

    # trm "- Давай!"
    trm "- Dawaj!"

# game/magaz.rpy:182
translate polish magaz_cd2f6b76:

    # ggm "- Эй, постой!.."
    ggm "- Ej, czekaj!.."

# game/magaz.rpy:183
translate polish magaz_449dcf56:

    # nm "Треска отпустил мою руку и уверенно зашагал к одному из немногочисленных посетителей магазина. Тот стоял спиной к нам, что-то сосредоточенно рассматривая на прилавке."
    nm "Treska puścił moją rękę i śmiało ruszył w stronę jednego z nielicznych klientów sklepu. Stał tyłem do nas, przyglądając się ladzie."

# game/magaz.rpy:184
translate polish magaz_d1671cc2:

    # trm "- Здрасьте, а можно!.."
    trm "- Witam, czy mogę?.."

# game/magaz.rpy:185
translate polish magaz_7b64269c:

    # nm "Последнюю часть вопроса я не расслышала - как и ответ на него. Но мой непутевый друг внезапно застыл как вкопанный, глядя прямо в глаза посетителя магазина. Я поспешила подойти к ним."
    nm "Nie słyszałeam ostatniej części pytania - ani odpowiedzi. Ale mój krnąbrny przyjaciel nagle zamarł, patrząc prosto w oczy klienta. Pospieszyłam do nich."

# game/magaz.rpy:191
translate polish magaz_73ff8128:

    # mm "- Это ваш?"
    mm "- On jest z Panią?"

# game/magaz.rpy:192
translate polish magaz_fbc1a18a:

    # nm "Посетитель обратился ко мне. В его голосе явно слышалось отвращение, а на лице застыла презрительная гримаса."
    nm "Klient zwrócił się do mnie. Jego głos był wyraźnie zdegustowany, a twarz pogardliwa."

# game/magaz.rpy:203
translate polish magaz_a3ef7e99:

    # ggm "- Я... эм-м..."
    ggm "- Ja... e-em..."

# game/magaz.rpy:204
translate polish magaz_2f529462:

    # mm "- Если так, то будьте добры - уберите его подальше."
    mm "- Jeśli tak, to uprzejmie proszę - niech Pani go stąd zabierze."

# game/magaz.rpy:205
translate polish magaz_6277046c:

    # ggm "- Д-да, извините..."
    ggm "- T-tak, przepraszam..."

# game/magaz.rpy:206
translate polish magaz_5ffc47dc:

    # nm "Я хватаю Треску за руку и спешу увести в сторону - тот все глядит на посетителя, открыв рот и выпучив глаза. И дрожит."
    nm "Chwytam Treskę za rękę i odsuwam go - on wciąż patrzy na klienta z otwartymi ustami i wytrzeszczonymi oczami."

# game/magaz.rpy:216
translate polish magaz_5a6e2c0e:

    # nm "Лишь когда мы свернули за угол, Треска успокоился."
    nm "Dopiero gdy skręciliśmy za róg, Treska się uspokoił."

# game/magaz.rpy:217
translate polish magaz_c7dd33e3:

    # ggm "- Ну и как это понимать?"
    ggm "- Co to miało znaczyć?"

# game/magaz.rpy:218
translate polish magaz_a38d3841:

    # trm "- Я... я так перепугался!.. Он сказал..."
    trm "- Ja... tak się przestraszyłem! On powiedział..."

# game/magaz.rpy:219
translate polish magaz_72d73855:

    # ggm "- Что?"
    ggm "- Co?"

# game/magaz.rpy:220
translate polish magaz_b9c8f9d0:

    # trm "- НЕТ, ТОЛЬКО НЕ ОПЯТЬ!"
    trm "- NIE, TYLKO NIE ZNOWU!"

# game/magaz.rpy:221
translate polish magaz_32dc5f00:

    # nm "Внезапно Треска завопил как сумасшедший. Я зажимаю ему рот ладонью; его лицо буквально горит, а сам он плачет."
    nm "Nagle Treska wrzasnął jak szalony. Ściskam dłonią jego usta; jego twarz dosłownie płonie, a on sam płacze."

# game/magaz.rpy:222
translate polish magaz_08dc37af:

    # ggm "- Ты можешь вести себя нормально?"
    ggm "- Czy potrafisz zachowywać się normalnie?"

# game/magaz.rpy:223
translate polish magaz_b551f5ad:

    # trm "- Т-ты не понимаешь..."
    trm "- T-ty nie rozumiesz..."

# game/magaz.rpy:224
translate polish magaz_96ec9ded:

    # ggm "- Ну конечно, что я вообще могу понимать!"
    ggm "- No tak, bo przecież nic nie rozumiem!"

# game/magaz.rpy:225
translate polish magaz_66e633dd:

    # ggm "- Вот только приставать к людям - это неправильно. Этого, видимо, не понимаешь ты."
    ggm "- Poza tym, czepianie się ludzi nie jest normalne, i ty tego nie rozumiesz."

# game/magaz.rpy:226
translate polish magaz_a70710db:

    # trm "- Ты злая!.. Хнык.."
    trm "- Jesteś wredna!.."

# game/magaz.rpy:227
translate polish magaz_d45f1565:

    # ggm "- Я?.."
    ggm "- Ja?.."

# game/magaz.rpy:233
translate polish magaz_828f1904:

    # nm "Оттолкнув меня, Треска убежал прочь."
    nm "Odepchnąwszy mnie, Treska uciekł."

# game/magaz.rpy:239
translate polish magaz_ce7396de:

    # ggm "- Блин."
    ggm "- Cholera."

# game/magaz.rpy:240
translate polish magaz_0e1cb3a1:

    # nm "Краем глаза я замечаю, как работник магазина вешает на дверь новую табличку."
    nm "Kątem oka dostrzegam, że pracownik sklepu zawiesza na drzwiach nowy szyld."

# game/magaz.rpy:246
translate polish magaz_15b5e8ae:

    # ggm "- Вот ты где!"
    ggm "- Tu jesteś!"

# game/magaz.rpy:247
translate polish magaz_f896812e:

    # nm "Я встречаю Треску у кассы. До этого я успела сбегать в молочный отдел, предварительно узнав, где он находится."
    nm "Spotykam Treskę przy kasie. Zanim to zrobiłam, zdążyłam wrócic z działu z nabiałem, po tym jak dowiedziałam się gdzie on jest."

# game/magaz.rpy:248
translate polish magaz_d51b64cb:

    # mm "- Эй, шевелись!"
    mm "- Ej, rusz się!"

# game/magaz.rpy:249
translate polish magaz_9ee11605:

    # nm "Недовольный голос раздался с конца длинной очереди, что образовалась позади Трески. Я протискиваюсь к нему."
    nm "Z końca długiej kolejki, która utworzyła się za Treską, dobiegł niezadowolony głos. Przepycham się w jego stronę."

# game/magaz.rpy:250
translate polish magaz_d71944d4:

    # ggm "- Что случилось?"
    ggm "- Co się stało?"

# game/magaz.rpy:251
translate polish magaz_271d3bbb:

    # nm "Мальчик не отвечает. Смотрит себе под ноги, едва слышно хныкая, а кассир коршуном нависает над ним. Между ними лежит пакет молока."
    nm "Chłopiec nie odpowiada. Patrzy w dół na swoje stopy, cicho szlochając, podczas gdy kasjerka góruje nad nim. Pomiędzy nimi leży karton mleka."

# game/magaz.rpy:252
translate polish magaz_73ff8128_1:

    # mm "- Это ваш?"
    mm "- On jest z Panią?"

# game/magaz.rpy:253
translate polish magaz_7cf04c09:

    # ggm "- Мой."
    ggm "- Tak."

# game/magaz.rpy:254
translate polish magaz_630ff660:

    # mm "- В следующий раз оставьте его дома."
    mm "- Następnym razem niech Pani zostawi go w domu."

# game/magaz.rpy:255
translate polish magaz_cc8f5d69:

    # nm "Люди в очереди согласно кивают."
    nm "Ludzie w kolejce przytakują."

# game/magaz.rpy:256
translate polish magaz_4c8b218b:

    # mm "- Оплатите стоимость товара."
    mm "- Proszę zapłacić za zakupy."

# game/magaz.rpy:257
translate polish magaz_6bad1905:

    # ggm "- Да, конечно..."
    ggm "- Tak, oczywiście..."

# game/magaz.rpy:258
translate polish magaz_04ace94f:

    # mm "- И издержку за ожидание!"
    mm "- I koszt za stracony czas!"

# game/magaz.rpy:259
translate polish magaz_1676dc10:

    # ggm "- Ч-что?"
    ggm "- C-co?"

