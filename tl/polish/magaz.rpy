    # ggm "- Нет."
    ggm "- Nie."

# game/magaz.rpy:281
translate polish magaz_ef883331:

    # trm "- Ладно..."
    trm "- Okej..."

# game/magaz.rpy:282
translate polish magaz_0a0e5a9c:

    # nm "Я смотрю в поникшее лицо мальчика - на секунду в его глазах блеснул огонек и тут же погас."
    nm "Patrzę w pogrążoną smutkiem twarz chłopca - w jego oczach na sekundę rozbłysło światło, po czym zgasło."

# game/magaz.rpy:283
translate polish magaz_8734db3e:

    # trm "- Знаешь..."
    trm "- Wiesz..."

# game/magaz.rpy:284
translate polish magaz_f6ae2c25:

    # nm "Он уверенно сворачивает с тропы прямо на автомобильную дорогу. Я провожаю его недоуменным взглядом."
    nm "Pewny siebie skręca z drogi i wychodzi na jezdnię. Podążam za nim zdziwionym wzrokiem."

# game/magaz.rpy:296
translate polish magaz_1f80669a:

    # trm "- Похоже, ты мне совсем не помогаешь."
    trm "- Wygląda na to, że w ogóle mi nie pomagasz."

# game/magaz.rpy:297
translate polish magaz_783d379e:

    # nm "В глазах Трески вновь блестит озорной огонек..."
    nm "W oczach Treski znów zabłysło złośliwe światło..."

