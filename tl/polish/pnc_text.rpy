# game/pnc_text.rpy:11
translate polish backpack_38718438:

    # "Я опускаю глаза. Нелепый и потрепанный, мой школьный рюкзак словно кричит о своей бесполезности."
    "Spuszczam wzrok. Absurdalny i tandetny, mój plecak szkolny krzyczy o swojej bezużyteczności."

# game/pnc_text.rpy:12
translate polish backpack_2678b6c1:

    # "С другого угла он похож на набитое брюхо - его содержимое точно так же переваривается, разлагается и превращается в густую кашу."
    "Z innej strony wygląda jak wypchany brzuch - jego zawartość tak samo się trawi, rozklada i zamienia się w gęstą papkę."

# game/pnc_text.rpy:14
translate polish backpack_61aaf7e3:

    # gg "- Классно я придумала, надо бы запомнить..."
    gg "- Fajnie to wymyśliłam, muszę to zapamiętać..."

translate polish strings:
    # game/pnc_text.rpy:15
    old "(Совсем не классно.)"
    new "(Wcale nie fajne.)"

    # game/pnc_text.rpy:15
    old "(Совсем не классно. Мерзко и ужасно.)"
    new "(Wcale nie fajne. Paskudne i obrzydliwe.)"

# game/pnc_text.rpy:21
translate polish backpack_e615eecb:

    # gg "- А вот и нет - мой тебе ответ!"
    gg "- Nieprawda!"

translate polish strings:
    # game/pnc_text.rpy:22
    old "(Ты что, смеешься надо мной?)"
    new "(Czy ty się ze mnie nabijasz?)"

# game/pnc_text.rpy:27
translate polish backpack_06036bad:

    # gg "- Обижаешь... ведь ты мне как родной! Хи-хи!"
    gg "- Obrażasz mnie... przecież jesteś dla mnie jak członek rodziny! Hi-hi!"

translate polish strings:
    # game/pnc_text.rpy:28
    old "(Я не собираюсь продолжать этот цирк, поняла?)"
    new "(Nie mam zamiaru przedłużać tego cyrku, rozumiesz?)"

# game/pnc_text.rpy:32
translate polish backpack_b5138861:

    # gg "- Поняла!"
    gg "- Rozumiem!"

# game/pnc_text.rpy:37
translate polish backpack_557726c8:

    # gg "- Эй, в этот раз я не специально!.."
    gg "- Ej, tym razem nie zrobiłam tego specjalnie!"

translate polish strings:
    # game/pnc_text.rpy:39
    old "(Лучше расскажи мне, что внутри твоего рюкзака.)"
    new "(Lepiej powiedz mi, co jest w twoim plecaku.)"

# game/pnc_text.rpy:44
translate polish backpack_9fc41a8b:

    # gg "- Да ничего особенного... книжки всякие, в основном."
    gg "- Nic nadzwyczajnego... głównie książki."

# game/pnc_text.rpy:47
translate polish backpack_d0f08302:

    # gg "- Все карандаши и тетради я оттуда вытащила, а остальное меня не интересует."
    gg "- Wyniosłam stamtąd wszystkie ołówki i zeszyty, a reszta mnie nie interesuje."

translate polish strings:
    # game/pnc_text.rpy:50
    old "(Ты ведь когда-то ходила в школу, да?)"
    new "(Chodziłaś kiedyś do szkoły, prawda?)"

# game/pnc_text.rpy:54
translate polish backpack_eceef613:

    # gg "- Ага, ходила. Отлично провела время, кстати!"
    gg "- Chodziłam. Świetnie się bawiłam, nawiasem mówiąc!"

translate polish strings:
    # game/pnc_text.rpy:55
    old "(...ты точно поняла мой вопрос?)"
    new "(...czy dobrze zrozumiałaś moje pytanie?)"

# game/pnc_text.rpy:59
translate polish backpack_e624daf9:

    # gg "- Думаешь, все в моей жизни должно быть печально и угрюмо? А вот и нет!"
    gg "- Czy uważasz, że wszystko w moim życiu powinno być smutne i ponure? Wcale nie!"

translate polish strings:
    # game/pnc_text.rpy:60
    old "(Ну ладно, ладно. Что тебе больше всего понравилось?)"
    new "(Dobra, okej. Co Ci się najbardziej spodobało?)"

# game/pnc_text.rpy:64
translate polish backpack_c92e01ee:

    # gg "- Хм-м-м..."
    gg "- Hm-m-m..."

# game/pnc_text.rpy:67
translate polish backpack_79c4eff2:

    # gg "- Ну... В помещениях было очень светло, совсем не так, как дома."
    gg "- Cóż... Pokoje były bardzo jasne, zupełnie nie tak jak w domu."

translate polish strings:
    # game/pnc_text.rpy:68
    old "(И все?)"
    new "(I tyle?)"

# game/pnc_text.rpy:72
translate polish backpack_3d194e3c:

    # gg "- Да погоди ты! Дай вспомнить..."
    gg "- Chwileczkę! Daj mi sobie przypomnieć..."

# game/pnc_text.rpy:75
translate polish backpack_c7d3b724:

    # gg "- Ну, кровати были мягкие... Да и кормили неплохо."
    gg "- Cóż, były miękkie łóżka... Jedzenie też nie było złe."

# game/pnc_text.rpy:78
translate polish backpack_40cd7f87:

    # gg "- Между прочим, я всегда была на уроках! Остальные вечно прогуливали."
    gg "- Przy okazji, zawsze byłam na lekcjach! Inni ciągle wagarowali."

# game/pnc_text.rpy:81
translate polish backpack_a6aff8dc:

    # gg "- Ох и досталось же им, наверно!"
    gg "- Oh, na pewno im się za to dostało!"

# game/pnc_text.rpy:84
translate polish backpack_bc809e1d:

    # "Я слегка улыбаюсь, предаваясь теплым воспоминаниям."
    "Uśmiechnęłam się lekko, oddając się miłym wspomnieniom."

translate polish strings:
    # game/pnc_text.rpy:85
    old "(Ты ведь так и не закончила школу.)"
    new "(Nie skończyłaś szkoły, co?)"

# game/pnc_text.rpy:89
translate polish backpack_b98b4ac4:

    # gg "- Ага."
    gg "- Ta."

translate polish strings:
    # game/pnc_text.rpy:90
    old "(Помнишь свой последний день?)"
    new "(Pamiętasz swój ostatni dzień?)"

# game/pnc_text.rpy:94
translate polish backpack_d2c4cf06:

    # gg "- ..."
    gg "- ..."

# game/pnc_text.rpy:95
translate polish backpack_a707915e:

    # gg "- День как день."
    gg "- Dzień jak codzień."

# game/pnc_text.rpy:98
translate polish backpack_94074f87:

    # gg "- Папа забрал меня пораньше - объяснил, что я уже выросла из школьной программы. Да я и сама это понимала, уж больно простыми были задания..."
    gg "- Ojciec odebrał mnie troche wcześniej, tłumacząc, że wykroczyłam poza program szkolny. Sama to wiedziałam, zadania były zbyt łatwe..."

# game/pnc_text.rpy:99
translate polish backpack_1e7bb71c:

    # gg "- Потом мы сели в машину и поехали домой. Дома нас встретила мама, мы втроем поужинали и разошлись по комнатам."
    gg "- Potem wsiedliśmy do samochodu i pojechaliśmy do domu. Mama spotkała nas w domu, zjedliśmy we trójkę kolację i poszliśmy do swoich pokoi."

translate polish strings:
    # game/pnc_text.rpy:100
    old "(А что было потом?)"
    new "(I co się stało?)"

# game/pnc_text.rpy:104
translate polish backpack_f52d7a56:

    # gg "- Не помню. Да и какая, в сущности, разница?"
    gg "- Nie pamiętam. A jakie to ma znaczenie, tak naprawdę?"

translate polish strings:
    # game/pnc_text.rpy:100
    old "(Не похоже, что этот день хоть что-то значит для тебя.)"
    new "(Nie wygląda na to, że ten dzień coś dla ciebie znaczy.)"

# game/pnc_text.rpy:109
translate polish backpack_3ac67b90:

    # gg "- Говорю же, день как день."
    gg "- Mówię ci, dzień jak codzień."

translate polish strings:
    # game/pnc_text.rpy:110
    old "(Ладно.)"
    new "(Dobra.)"

# game/pnc_text.rpy:115
translate polish backpack_808e1266:

    # gg "- Вот и славно."
    gg "- To dobrze."

translate polish strings:
    # game/pnc_text.rpy:110
    old "(Расскажи еще раз.)"
    new "(Opowiedz mi jeszcze raz.)"

# game/pnc_text.rpy:120
translate polish backpack_54f27d0a:

    # gg "- У тебя что, с памятью плохо?"
    gg "- Co z twoją pamięcią?"

translate polish strings:
    # game/pnc_text.rpy:121
    old "(Ну пожалуйста!)"
    new "(Proszę cię!)"


# game/pnc_text.rpy:125
translate polish backpack_37182073:

    # gg "- Ладно уж..."
    gg "- Dobra..."

# game/pnc_text.rpy:128
translate polish backpack_7fc0b6b4:

    # gg "- В тот день папа забрал меня с учебы пораньше, объяснив это тем, что мне пора взрослеть."
    gg "- Tego dnia mój tata odebrał mnie wcześniej ze szkoły, tłumacząc, że nadszedł czas, aby dorosnąć."

# game/pnc_text.rpy:129
translate polish backpack_326cf169:

    # gg "- Не то, чтобы я до конца понимала, что он имел в виду..."
    gg "- Nie to żebym w pełni rozumiała, o co mu chodzi..."

# game/pnc_text.rpy:130
translate polish backpack_dad097f6:

    # gg "- Так или иначе, я не сопротивлялась. Мы сели в машину и поехали домой."
    gg "- W każdym razie, nie opierałam się. Wsiedliśmy do samochodu i pojechaliśmy do domu."

# game/pnc_text.rpy:131
translate polish backpack_5c8684eb:

    # gg "- Дома нас встретила мама, мы втроем поужинали и разошлись по комнатам."
    gg "- Moja mama spotkała nas w domu, we trójkę zjedliśmy kolację i poszliśmy do swoich pokoi."

# game/pnc_text.rpy:134
translate polish backpack_2e83915f:

    # gg "- Доволен?"
    gg "- Zadowolony?"

# game/pnc_text.rpy:139
translate polish backpack_0fa5da10:

    # gg "Вот и славно."
    gg "- To dobrze."

# game/pnc_text.rpy:143
translate polish backpack_d2c4cf06_1:

    # gg "- ..."
    gg "- ..."

# game/pnc_text.rpy:146
translate polish backpack_f8e5dc31:

    # gg "- Папа забирал меня из школы силком, пока я кусалась и царапалась. Учителя не вмешивались; подобные сцены были для них обыденностью - мало ли в чем провинилась капризная девчонка?"
    gg "- Mój ojciec odbierał mnie ze szkoły na siłę, kiedy go gryzłam i drapałam. Nauczyciele nie interweniowali, takie sceny były dla nich codziennością - kogo obchodziło to, czym zawiniła niegrzeczna dziewczynka?"

# game/pnc_text.rpy:147
translate polish backpack_6f074fed:

    # gg "- Затем он затолкал меня в машину и мы молча ехали до самого дома."
    gg "- Potem wepchnął mnie do samochodu i całą drogę do domu jechaliśmy w milczeniu."

# game/pnc_text.rpy:148
translate polish backpack_5c8684eb_1:

    # gg "- Дома нас встретила мама, мы втроем поужинали и разошлись по комнатам."
    gg "- Moja mama spotkała nas w domu, we trójkę zjedliśmy kolację i poszliśmy do swoich pokoi."

# game/pnc_text.rpy:151
translate polish backpack_f4ea4fbc:

    # gg "- Прошу, давай не будем об этом больше..."
    gg "- Proszę, nie mówmy już o tym..."

translate polish strings:
    # game/pnc_text.rpy:152
    old "(Нет, ты расскажешь мне еще раз.)"
    new "(Nie, opowiedz mi to jeszcze raz.)"

# game/pnc_text.rpy:156
translate polish backpack_d2c4cf06_2:

    # gg "- ..."
    gg "- ..."

# game/pnc_text.rpy:157
translate polish backpack_d2c4cf06_3:

    # gg "- ..."
    gg "- ..."

# game/pnc_text.rpy:158
translate polish backpack_63b32716:

    # gg "- По пути домой папа купил молоко."
    gg "- Po drodze do domu tata kupił mleko."

# game/pnc_text.rpy:161
translate polish backpack_ec611f59:

    # gg "- Снова."
    gg "- Znowu."

# game/pnc_text.rpy:164
translate polish backpack_13c5cb72:

    # gg "- Как же я ненавижу молоко..."
    gg "- Jak ja nienawidzę mleka..."

# game/pnc_text.rpy:165
translate polish backpack_2c86c5a7:

    # gg "- Мамы дома не было."
    gg "- Mamy nie było w domu."

# game/pnc_text.rpy:168
translate polish backpack_ec611f59_1:

    # gg "- Снова."
    gg "- Znowu."

# game/pnc_text.rpy:171
translate polish backpack_e5f17701:

    # gg "- Как же я ненавижу маму..."
    gg "- Jak ja nienawidzę mojej mamy..."

# game/pnc_text.rpy:176
translate polish backpack_eed923f3:

    # "Вдруг я чувствую чей-то взгляд на своей спине. Зная, что такие моменты ни в коем случае нельзя игнорировать, я резко оборачиваюсь."
    "Nagle czuję na plecach czyjś wzrok. Wiedząc, że takich chwil nigdy nie należy ignorować, odwracam się gwałtownie."

# game/pnc_text.rpy:177
translate polish backpack_01440056:

    # "Но там ничего нет."
    "Ale tam nic nie ma."

translate polish strings:
    # game/pnc_text.rpy:172
    old "(Что было дальше?)"
    new "(Co było dalej?)"

# game/pnc_text.rpy:182
translate polish backpack_fdeda4ab:

    # gg "- Все, что было дальше, произошло уже после того, как случилось кое-что, после чего произошло все, что было после этого."
    gg "- Wszystko, co stało się potem, stało się po tym, jak coś się stało, po czym stało się wszystko, co stało się później."

# game/pnc_text.rpy:185
translate polish backpack_672cab95:

    # "Я вновь смотрю на рюкзак. Свет из окна отражается на мелких металлических деталях. А еще он отбрасывает тень - значит, он реален. К несчастью."
    "Spoglądam ponownie na plecak. Światło z okna odbija się od małych metalowych elementów. Rzuca też cień, co oznacza, że jest prawdziwy, niestety."

# game/pnc_text.rpy:188
translate polish backpack_cda0aac6:

    # gg "- Ну и пусть, какое мне вообще дело!"
    gg "- Niech tak będzie, co mnie to obchodzi!"

# game/pnc_text.rpy:191
translate polish backpack_64a10fb8:

    # "Я едва не пинаю рюкзак в порыве внезапного гнева, но в последний момент беру себя в руки."
    "W przypływie nagłej złości prawie kopię swój plecak, ale w ostatniej chwili się otrząsam."

# game/pnc_text.rpy:192
translate polish backpack_853cfd12:

    # "Если сдвину его хоть на сантиметр, вся картина развалится и я ослепну. Сколько раз это уже происходило... не сосчитать."
    "Jeśli przesunę go choćby o centymetr, cały obraz się rozpadnie, a ja oślepnę. Ile razy już się to zdarzyło... nie zliczę."

translate polish strings:
    # game/pnc_text.rpy:193
    old "(Что значит 'ослепнешь'?)"
    new "(Co masz na myśli mówiąc 'oślepnę'?)"

# game/pnc_text.rpy:197
translate polish backpack_3052d71a:

    # gg "- Мне понадобились месяцы, чтобы выучить расположение каждого предмета в комнате. Именно поэтому я вижу все так четко и ясно."
    gg "- Zajęło mi miesiące, aby nauczyć się lokalizacji każdego przedmiotu w pokoju. Dlatego widzę wszystko tak jasno i wyraźnie."

# game/pnc_text.rpy:200
translate polish backpack_24c29394:

    # gg "- Тебе не понять."
    gg "- Nie zrozumiesz tego."

translate polish strings:
    # game/pnc_text.rpy:201
    old "(Посмотри под ноги.)"
    new "(Spójrz pod nogi.)"

# game/pnc_text.rpy:203
translate polish backpack_585ebf61:

    # "Я опускаю глаза и вижу, как со стороны рюкзака ко мне ползет маленькое насекомое. Светится едва-едва, и даже взлететь не может... по всей видимости, этот светлячок очень устал."
    "Spuszczam wzrok i widzę małego owada pełznącego w moją stronę od strony plecaka. Ledwo się świeci, nawet nie może wystartować... Najwyraźniej ten świetlik jest bardzo zmęczony."

# game/pnc_text.rpy:204
translate polish backpack_28b7c84e:

    # "Я наклоняюсь, чтобы подобрать его."
    "Pochylam się, żeby go podnieść."

# game/pnc_text.rpy:205
translate polish backpack_0b155769:

    # "От прикосновения светлячок ярко замерцал и вдруг взлетел!"
    "Po tym jak go dotknęłam, świetlik jasno zamigotał i wzleciał w górę!"

# game/pnc_text.rpy:208
translate polish backpack_875b757a:

    # gg "- Молодец, малыш! Так держать!"
    gg "- Brawo, maluchu! Brawo!"

# game/pnc_text.rpy:211
translate polish backpack_bf1a1939:

    # "Сделав победный круг по комнате, он на большой скорости понесся в мою сторону. Я зажмурилась в ожидании того, как светлячок залетит мне в ухо."
    "Zrobiąc zwycięskie okrążenie wokół pokoju, świetlik ruszył z dużą prędkością w moją stronę. Zacisnęłam oczy, czekając aż świetlik wleci mi do ucha."

# game/pnc_text.rpy:212
translate polish backpack_094d4a3b:

    # "Так и произошло; оказавшись внутри, он какое-то время продолжал жужжать у меня в черепе, а потом затих."
    "I tak się stało; gdy znalazł się w środku, jeszcze przez chwilę brzęczał mi w czaszce, a potem zamilkł."

# game/pnc_text.rpy:215
translate polish backpack_c68f72e4:

    # gg "- Этот какой-то грустный..."
    gg "- Ten jest jakiś smutny..."

translate polish strings:
    # game/pnc_text.rpy:216
    old "(Интересно, почему?)"
    new "(Ciekawe czemu?)"

# game/pnc_text.rpy:220
translate polish backpack_a097dd72:

    # gg "- Это неважно. Главное, что теперь он не одинок!"
    gg "- To nie ma znaczenia. Najważniejsze jest to, że teraz nie jest sam!"

translate polish strings:
    # game/pnc_text.rpy:221
    old "(Ладно. Давай искать дальше?)"
    new "(Dobra. Szukamy dalej?)"

# game/pnc_text.rpy:244
translate polish papers_cb8dd79e:

    # "Обычные тетрадные листы, приклеенные к стене на скотч. На них изображены картинки с цифрами - единственная информация, которую я воспринимаю без особых трудностей."
    "Zwykłe kartki z zeszytu, przyklejone taśmą do ściany. Są na nich obrazki cyfr - jedyna informacja, którą bez większych trudności jestem w stanie odebrać."

translate polish strings:
    # game/pnc_text.rpy:245
    old "(Дозировка и побочные эффекты?)"
    new "(Dawkowanie i skutki uboczne?)"

# game/pnc_text.rpy:248
translate polish papers_90766208:

    # gg "- Угу."
    gg "- Mhm."

translate polish strings:
    # game/pnc_text.rpy:249
    old "(Я думал, ты знаешь их наизусть.)"
    new "(Myślałem, że znasz je na pamięć.)"

# game/pnc_text.rpy:253
translate polish papers_ea9753d4:

    # gg "- Да..."
    gg "- Tak..."

translate polish strings:
    # game/pnc_text.rpy:256
    old "(Это ведь не твой почерк, верно?)"
    new "(To nie jest twoje pismo, nieprawdaż?)"

# game/pnc_text.rpy:260
translate polish papers_d2c4cf06:

    # gg "- ..."
    gg "- ..."

# game/pnc_text.rpy:263
translate polish papers_e9c33d7f:

    # "Конечно же, нет. Обрывистые и неровные линии, корявые и некрасивые цифры... Не почерк; скорее, царапины от когтей."
    "Oczywiście, że nie. Linie są postrzępione i poszarpane, liczby są krzywe i brzydkie... Nie wygląda jak pismo ręczne, bardziej jak ślady po pazurach."

translate polish strings:
    # game/pnc_text.rpy:264
    old "(Не забудь сказать спасибо маме.)"
    new "(Nie zapomnij podziękować swojej mamie.)"

# game/pnc_text.rpy:268
translate polish papers_c31fcb47:

    # gg "- Отстань!"
    gg "- Przestań!"

# game/pnc_text.rpy:271
translate polish papers_cf0ae0d1:

    # "От моего крика листы забеспокоились, зашелестели; спустя секунду из-под одного лениво показался светлячок."
    "Od mojego krzyku szeleszcząc zadrgały kartki. Sekundę później spod jednej z nich leniwie wyłonił się świetlik."

# game/pnc_text.rpy:272
translate polish papers_3f22d077:

    # "Деловито оглянувшись, он деловито вспорхнул и не менее деловито залетел мне в ухо."
    "Rozejrzał się poważnie, a potem w równie poważny sposób śmignął mi do ucha." 
# game/pnc_text.rpy:277
translate polish papers_fc3f9e8b:

    # gg "- Давай искать дальше."
    gg "- Szukajmy dalej."

# game/pnc_text.rpy:299
translate polish bed_4400afce:

    # "Хи-хи, это мой спальный мешок! Мягкий и теплый; я уверена, что любое живое существо не отказалось бы провести в нем минутку-другую."
    "Hi-hi, to jest mój śpiwór! Miękki i ciepły. Jestem pewna, że każda żywa istota chętnie spędziłaby w nim minutę lub dwie."

# game/pnc_text.rpy:300
translate polish bed_649f7dfb:

    # "Зарыться поглубже, прихватив с собой пару любимых вещей, закрыть глаза и..."
    "Schowałaby się głęboko, zabrałaby ze sobą kilka ulubionych rzeczy, zamknęłaby oczy i..." 

translate polish strings:
    # game/pnc_text.rpy:301
    old "(Эй! Ты что, уже спишь?)"
    new "(Ej! Czy już zasnęłaś?)"

# game/pnc_text.rpy:304
translate polish bed_8930ec26:

    # gg "- А?.."
    gg "- A?.."

# game/pnc_text.rpy:307
translate polish bed_a8bbb4e1:

    # "Я слегка ударяю себя по щекам, чтобы прийти в чувство. Время уже далеко за полночь; в обычные дни я уже сплю как убитая. Но сейчас никак нельзя!.."
    "Uderzam się lekko w policzki, żeby przywrócić się do zmysłów. Jest już dobrze po północy; w normalne dni śpię jak zabita. Ale teraz nie ma takiej możliwości!"

# game/pnc_text.rpy:310
translate polish bed_fc3f9e8b:

    # gg "- Давай искать дальше."
    gg "- Szukajmy dalej."

translate polish strings:
    # game/pnc_text.rpy:311
    old "(Эй, а может внутри кто-то есть?)"
    new "(Ej, może jest ktoś w środku?)"

# game/pnc_text.rpy:315
translate polish bed_f621a758:

    # gg "- Не-а. Моим мыслям несвойственно усыплять, скорее, наоборот: они всегда провоцируют бессонницу. И сегодня как раз такой день."
    gg "- Nie. Moje myśli nie mają na celu mnie uśpić, a wręcz przeciwnie: zawsze wywołują u mnie bezsenność. I dziś jest jeden z tych dni."

translate polish strings:
    # game/pnc_text.rpy:316
    old "(Что?)"
    new "(Co?)"

# game/pnc_text.rpy:320
translate polish bed_1c6c319f:

    # gg "- Здесь искать бессмысленно, говорю."
    gg "- Nie ma sensu tu szukać - mówię."

# game/pnc_text.rpy:340
translate polish clock_686cd361:

    # "Я гляжу на часы - время неумолимо движется."
    "Spoglądam na zegarek - czas płynie nieubłaganie."

# game/pnc_text.rpy:342
translate polish clock_df7eb0c2:

    # gg "- Уже так поздно..."
    gg "- Jest tak późno..."

translate polish strings:
    # game/pnc_text.rpy:343
    old "(Устала?)"
    new "(Zmęczyłaś się?)"

# game/pnc_text.rpy:347
translate polish clock_27a18cb3:

    # gg "- Еще как..."
    gg "- Jak najbardziej..."

# game/pnc_text.rpy:350
translate polish clock_33ee45a6:

    # "Я демонстративно громко зеваю и вытягиваю руки в стороны."
    "Ziewam wyzywająco głośno i wyciągam ręce w boki."

# game/pnc_text.rpy:351
translate polish clock_038f9fa3:

    # "Раз-два."
    "Raz-dwa."

# game/pnc_text.rpy:352
translate polish clock_332f57b4:

    # "Затем поднимаю их над головой."
    "Następnie unoszę je nad głowę."

# game/pnc_text.rpy:353
translate polish clock_557547f8:

    # "Три-четыре."
    "Trzy-cztery."

# game/pnc_text.rpy:354
translate polish clock_6e34fd04:

    # "Может, небольшая гимнастика поможет взбодриться?"
    "Może trochę ćwiczeń pomogłoby się rozbudzić?"

translate polish strings:
    # game/pnc_text.rpy:355
    old "(Неплохая идея! Помнишь упражнения, которым тебя учили?)"
    new "(Niezły pomysł! Pamiętasz ćwiczenia, których cię uczyli?)"

# game/pnc_text.rpy:359
translate polish clock_649f3fc1:

    # gg "- Вроде, помню..."
    gg "- Chyba pamiętam..."

# game/pnc_text.rpy:362
translate polish clock_8d94999f:

    # "Я неуверенно встаю в стойку; пятки вместе, носки врозь... Или как там было?"
    "Stanęłam niepewnie; pięty razem, palce stóp osobno... Czy jak tam było?"

# game/pnc_text.rpy:365
translate polish clock_a39e73c9:

    # gg "- Ладно, будь что будет. Засекай пять минут!"
    gg "- Dobra, nieważne co się stanie. Odlicz mi pięć minut!"

translate polish strings:
    # game/pnc_text.rpy:366
    old "(Засек. Хотя у тебя часы прямо перед носом, вообще-то.)"
    new "(Odliczam. Chociaż tak naprawdę masz zegar tuż przed nosem.)"

# game/pnc_text.rpy:370
translate polish clock_3866490e:

    # gg "- Я не могу слишком долго смотреть на стрелки."
    gg "- Nie mogę zbyt długo patrzeć na wskazówki."

# game/pnc_text.rpy:373
translate polish clock_3629485d:

    # "Сначала они будто бы идут в обратном направлении, затем и вовсе исчезают..."
    "Na początku wydaję się że idą w przeciwnym kierunku, potem zupełnie znikają..."

# game/pnc_text.rpy:374
translate polish clock_a20cefa7:

    # "..."
    "- ..."

# game/pnc_text.rpy:375
translate polish clock_8af69835:

    # "А после этого всегда происходит какая-нибудь ерунда."
    "A potem zawsze dzieje się jakiś absurd."

# game/pnc_text.rpy:376
translate polish clock_37721a79:

    # "В последний раз мне померещилась пара глаз на циферблате..."
    "Ostatni raz widziałam parę oczu na tarczy..."

# game/pnc_text.rpy:377
translate polish clock_44335f8e:

    # "А еще..."
    "Ponadto..."

# game/pnc_text.rpy:378
translate polish clock_912ad87c:

    # "Когда-то давно мне слышались голоса..."
    "Dawno temu słyszałam głosy..."

# game/pnc_text.rpy:379
translate polish clock_38d6eb28:

    # "Они будто... звали на помощь?"
    "One jakby... wołały o pomoc?"

# game/pnc_text.rpy:380
translate polish clock_7dea574f:

    # "Ерунда, сущая ерунда."
    "Nonsens, czysty nonsens."

# game/pnc_text.rpy:381
translate polish clock_dba34053:

    # "Ерунда же?"
    "Nonsens, co?"

# game/pnc_text.rpy:382
translate polish clock_0f7c6a07:

    # "Ерунда."
    "Nonsens."

# game/pnc_text.rpy:385
translate polish clock_b35d4af1:

    # gg "- Ну что, засек время?"
    gg "- Odliczyłeś już?"

translate polish strings:
    # game/pnc_text.rpy:386
    old "(Боже, наконец-то...)"
    new "(Boże, w końcu...)"

# game/pnc_text.rpy:390
translate polish clock_213f59bc:

    # gg "- О чем ты?"
    gg "- O co ci chodzi?"

translate polish strings:
    # game/pnc_text.rpy:391
    old "(Я уже полчаса не могу до тебя достучаться.)"
    new "(Od pół godziny nie mam z tobą kontaktu.)"

# game/pnc_text.rpy:395
translate polish clock_8930ec26:

    # gg "- А?.."
    gg "- A?.."

translate polish strings:
    # game/pnc_text.rpy:396
    old "(Забудь. Светлячка видишь?)"
    new "(Nieważne. Widzisz świetlika?)"

# game/pnc_text.rpy:400
translate polish clock_1f91f806:

    # gg "- Н-нет..."
    gg "- N-nie..."

translate polish strings:
    # game/pnc_text.rpy:401
    old "(Тогда давай искать дальше.)"
    new "(W takim razie szukajmy dalej.)"

# game/pnc_text.rpy:422
translate polish can_73aa1f9a:

    # "Приблизившись к мусорному баку, я с любопытством заглядываю внутрь."
    "Podchodząc do kosza na śmieci, zaglądam z ciekawością do środka."

# game/pnc_text.rpy:423
translate polish can_9cefa99d:

    # "Упаковки из-под лекарств, тетрадные листы и прочий мусор. Скука..."
    "Opakowania po lekach, kartki z zeszytów i inne śmieci. Nic takiego..."

# game/pnc_text.rpy:425
translate polish can_602f184f:

    # gg "- Здесь ничего. И правильно, ни один уважающий себя светлячок не стал бы прятаться в мусорке!"
    gg "- Nic tu nie ma. I słusznie, żaden szanujący się świetlik nie schowałby się w koszu!"

translate polish strings:
    # game/pnc_text.rpy:426
    old "(Пожалуй, соглашусь.) "
    new "(Raczej bym się z tym zgodził.)"

# game/pnc_text.rpy:448
translate polish fan_352aa8f3:

    # gg "- Хи-хи!"
    gg "- Hi-hi!"

translate polish strings:
    # game/pnc_text.rpy:449
    old "(Что смешного?)"
    new "(Co cię tak bawi?)"

# game/pnc_text.rpy:453
translate polish fan_ac72e700:

    # gg "- Я представила себя светлячком, который видит перед собой огромный вентилятор."
    gg "- Wyobraziłam siebie jako świetlika, który widzi przed sobą wielki wiatrak."

translate polish strings:
    # game/pnc_text.rpy:454
    old "(Ну и?..)"
    new "(No i co?..)"

# game/pnc_text.rpy:458
translate polish fan_e28ac19d:

    # gg "- Да я бы жуть как обзавидовалась!"
    gg "- Byłabym tak zazdrosna!"

# game/pnc_text.rpy:461
translate polish fan_f43e7afd:

    # gg "- Единственное, что не дает ему взлететь - это клетка, в которой он заперт... ну и провод."
    gg "- Jedyną rzeczą, która powstrzymuje go przed lotem jest klatka, w której jest zamknięty... no i kabel."

# game/pnc_text.rpy:464
translate polish fan_ecb0c3d8:

    # gg "- Он словно заключенный в тюрьме, если задуматься..."
    gg "- On jest jak w więzieniu, jeśli się nad tym zastanowić..."

# game/pnc_text.rpy:467
translate polish fan_f0cb13c4:

    # gg "- Грустно это все."
    gg "- Smutne to."

translate polish strings:
    # game/pnc_text.rpy:468
    old "(Ага.)"
    new "(Mhm.)"

# game/pnc_text.rpy:472
translate polish fan_fc3f9e8b:

    # gg "- Давай искать дальше."
    gg "- Szukajmy dalej."

# game/pnc_text.rpy:492
translate polish laptop_0178e4bf:

    # "Я смотрю на свой ноутбук. Из-за того, что я многие годы не прикасалась к нему, он покрыт слоем пыли толщиной в палец."
    "Spoglądam na mój laptop. Ponieważ nie dotykałam go od lat, pokrył się warstwą kurzu grubą jak palec."

# game/pnc_text.rpy:493
translate polish laptop_32e9c419:

    # "Очень странный предмет. Я его побаиваюсь..."
    "Bardzo dziwny przedmiot. Boję się go..."

translate polish strings:
    # game/pnc_text.rpy:498
    old "(Вот и отлично. Рассказывай!)"
    new "(To dobrze. Opowiadaj!)"

# game/pnc_text.rpy:497
translate polish laptop_369e40f2:

    # gg "- Это долгая и скучная история."
    gg "- To długa i nudna historia."

translate polish strings:
    # game/pnc_text.rpy:503
    old "(Я настаиваю!)"
    new "(Nalegam!)"

# game/pnc_text.rpy:502
translate polish laptop_7fd94592:

    # gg "- М-м..."
    gg "- E-m-m..."

# game/pnc_text.rpy:507
translate polish laptop_5f0d51e5:

    # gg "- Я не помню, как он появился в моей комнате."
    gg "- Nie pamiętam, jak pojawił się w moim pokoju."

# game/pnc_text.rpy:508
translate polish laptop_d05dfac5:

    # gg "- Наверное, кто-то из родителей принес его сюда, потому что не нашлось другого места."
    gg "- Któryś z rodziców musiał go tu przynieść, bo nie było innego miejsca dla niego."

# game/pnc_text.rpy:509
translate polish laptop_ca6f1421:

    # gg "- Мне не запрещали им пользоваться - наоборот, даже поощряли."
    gg "- Nie zabraniano mi go używać - wręcz przeciwnie, zachęcano mnie do tego."

# game/pnc_text.rpy:512
translate polish laptop_1826dfb6:

    # gg "- Еще бы, я целыми днями безвылазно сидела перед экраном! Игры, рисование, инженерный калькулятор, трехмерное моделирование..."
    gg "- Siedziałam przed ekranem całymi dniami! Gry, rysowanie, kalkulator inżynierski, modelowanie 3D..."

# game/pnc_text.rpy:515
translate polish laptop_b3ebc70c:

    # gg "- Столько развлечений!"
    gg "- Tyle zabawy!"


translate polish strings:
    # game/pnc_text.rpy:516
    old "(Занятные у тебя были хобби.)"
    new "(Zajmujące miałaś hobby.)"

# game/pnc_text.rpy:520
translate polish laptop_87077ee0:

    # gg "- Ага, были... до выхода в сеть."
    gg "- Miałam... zanim trafiłam do sieci."

translate polish strings:
    # game/pnc_text.rpy:521
    old "(М-м?)"
    new "(Hm-m?)"

# game/pnc_text.rpy:525
translate polish laptop_30b90bb2:

    # gg "- Представь себе ситуацию: ты - хомячок, что живет под землей. У тебя есть все необходимое для комфортной жизни."
    gg "- Wyobraź sobie sytuację: jesteś chomikiem, który żyje pod ziemią. Masz wszystko, czego potrzebujesz, aby wygodnie żyć."

# game/pnc_text.rpy:528
translate polish laptop_b730d7d5:

    # gg "- Представил?"
    gg "- Wyobraziłeś sobie?"

translate polish strings:
    # game/pnc_text.rpy:529
    old "(Твои аналогии как всегда на высоте.)"
    new "(Twoje analogie są tak dobre jak zawsze.)"

    # game/pnc_text.rpy:531
    old "(Ну хорошо, представил.)"
    new "(Dobrze, wyobraziłem.)"

# game/pnc_text.rpy:535
translate polish laptop_fdaff107:

    # gg "- Итак, ты - хомячок, что живет под землей. У тебя есть все необходимое для комфортной жизни, да?"
    gg "- Więc jesteś chomikiem, który żyje pod ziemią. Masz wszystko, czego potrzebujesz, aby żyć wygodnie, co nie?"

translate polish strings:
    # game/pnc_text.rpy:536
    old "(Да...)"
    new "(Tak...)"

# game/pnc_text.rpy:540
translate polish laptop_5a413449:

    # gg "- Отлично! Значит, ситуация следующая: ты - хомячок, что живет..."
    gg "- Świetnie! Więc sytuacja jest następująca: jesteś chomikiem, który żyje..."

translate polish strings:
    # game/pnc_text.rpy:541
    old "(Ладно, я тебя понял. Хочешь поговорить о чем-то другом?)"
    new "(Okej, zrozumiałem. Czy chcesz porozmawiać o czymś innym?)"

# game/pnc_text.rpy:545
translate polish laptop_d2c4cf06:

    # gg "- ..."
    gg "- ..."

# game/pnc_text.rpy:548
translate polish laptop_d254e5a2:

    # gg "- Угу..."
    gg "- Mhm..."

translate polish strings:
    # game/pnc_text.rpy:549
    old "(Все равно ведь вернешься к этой теме.)"
    new "(I tak wrócisz do tego tematu.)"

# game/pnc_text.rpy:558
translate polish laptop_d2c4cf06_1:

    # gg "- ..."
    gg "- ..."

# game/pnc_text.rpy:561
translate polish laptop_6000601f:

    # gg "- В один прекрасный день тебя выкапывают из твоей хомячьей норки и приносят в зоомагазин. Теперь клетка - твой новый дом."
    gg "- Pewnego dnia zostajesz wykopany ze swojej chomiczej nory i przynoszą cię do sklepu zoologicznego. Teraz twoim nowym domem jest klatka."

# game/pnc_text.rpy:564
translate polish laptop_03c88239:

    # gg "- Здесь гораздо удобнее и теплее, чем под землей."
    gg "- Jest tu znacznie wygodniej i cieplej niż pod ziemią."

# game/pnc_text.rpy:567
translate polish laptop_cc648f6c:

    # gg "- А самое главное - здесь у тебя много соседей. Их клетки - точные копии твоей; да и сами хомячки как две капли воды похожи на тебя - выходит, вы ничем друг от друга не отличаетесь."
    gg "- Co najważniejsze, masz tu wielu sąsiadów. Ich klatki są dokładnymi replikami twojej, a chomiki wyglądają tak samo jak ty - więc niczym się od siebie nie różnicie."

# game/pnc_text.rpy:570
translate polish laptop_88bcc6b1:

    # gg "- Кроме того, что они были рождены в этом зоомагазине."
    gg "- Pomijając ten fakt, że urodziły się w tym sklepie zoologicznym."

# game/pnc_text.rpy:573
translate polish laptop_2497aa37:

    # gg "- Ты спросишь - но на что это указывает? А я тебе отвечу - да ни на что."
    gg "- Zapytasz - o czym to świadczy? I powiem ci, że o niczym."

# game/pnc_text.rpy:576
translate polish laptop_70f10b0e:

    # gg "- Я забыла, о чем шла речь..."
    gg "- Zapomniałam co chciałam powiedzieć..."

translate polish strings:
    # game/pnc_text.rpy:577
    old "(О, боже...)"
    new "(Boże...)"

# game/pnc_text.rpy:581
translate polish laptop_7ee42079:

    # gg "- Ладно, давай начнем заново!"
    gg "- Dobrze, zacznijmy od nowa!"

translate polish strings:
    # game/pnc_text.rpy:582
    old "(В этот раз постарайся обойтись без дурацких примеров с хомяками.)"
    new "(Tym razem postaraj się obejść bez głupich przykładów z chomikami.)"

# game/pnc_text.rpy:586
translate polish laptop_3b77990a:

    # gg "- Ты же знаешь, что я не виновата."
    gg "- Wiesz, że to nie moja wina."

# game/pnc_text.rpy:589
translate polish laptop_b061a70e:

    # gg "- Итак."
    gg "- A więc."

# game/pnc_text.rpy:590
translate polish laptop_3690dc5f:

    # gg "- У меня было очень много друзей в сети. Десятки, сотни... всех не сосчитать."
    gg "Miałam wielu przyjaciół w sieci. Dziesiątki, setki... wszystkich nie da się zliczyć."

# game/pnc_text.rpy:593
translate polish laptop_f6f9494b:

    # gg "- Хотя, почему не сосчитать? Их было ровно триста семнадцать."
    gg "- W sumie co ja gadam? Było ich dokładnie trzysta siedemnaście."

# game/pnc_text.rpy:596
translate polish laptop_9ca563cd:

    # gg "- Впрочем, никто не считает точное количество хомячков, когда заходит в зоомагазин..."
    gg "- Nikt jednak nie liczy dokładnej liczby chomików, kiedy wchodzi do sklepu zoologicznego..."

translate polish strings:
    # game/pnc_text.rpy:597
    old "(Эй, не отвлекайся!)"
    new "(Ej, nie rozpraszaj się!)"

# game/pnc_text.rpy:601
translate polish laptop_b97a9039:

    # gg "- Ах да!"
    gg "- Ah tak!"

# game/pnc_text.rpy:604
translate polish laptop_ee66ebc9:

    # gg "- Из трехсот семнадцати друзей шестьдесят восемь увлекались играми - прямо как я!"
    gg "- Spośród trzystu siedemnastu znajomych, sześćdziesięciu ośmiu było fanami gier - tak jak ja!"

# game/pnc_text.rpy:605
translate polish laptop_39f06a4e:

    # gg "- Еще сто тридцать друзей любили рисовать - ну в точности как я!"
    gg "- Jeszcze stu trzydziestu przyjaciół lubiło rysować - tak samo jak ja!"

# game/pnc_text.rpy:606
translate polish laptop_be83ef93:

    # gg "- Оставшиеся сто девятнадцать друзей увлекались калькуляторами и трехмерной графикой в равной степени."
    gg "- Pozostałe sto dziewiętnaście osób po równo interesowali się kalkulatorami i grafiką trójwymiarową."

# game/pnc_text.rpy:609
translate polish laptop_048d14d4:

    # gg "- И когда я говорю ‘в равной степени’, я не имею в виду ‘по пятьдесят девять с половиной друзей с каждой стороны’."
    gg "- I kiedy mówię ‘po równo’, nie mam na myśli ‘pięćdziesięciu dziewięciu i pół przyjaciela po każdej stronie’."

# game/pnc_text.rpy:612
translate polish laptop_ddb17af4:

    # gg "- Понимаешь?"
    gg "- Rozumiesz?"

# game/pnc_text.rpy:615
translate polish laptop_66951c3e:

    # gg "- Сто девятнадцать можно разделить пополам без проблем, но с друзьями математика работает по-другому... Ну что за напасть, а?"
    gg "- Sto dziewiętnaście można bez problemu podzielić na pół, ale z przyjaciółmi matematyka działa inaczej... Co to za problem, co?"

translate polish strings:
    # game/pnc_text.rpy:616
    old "(Давай ближе к делу.)"
    new "(Przejdźmy do rzeczy.)"

# game/pnc_text.rpy:620
translate polish laptop_6d94f79c:

    # gg "- Разумеется, я знала, что настоящих людей в сети не существует."
    gg "- Oczywiście wiedziałam, że w sieci nie ma prawdziwych ludzi."

# game/pnc_text.rpy:621
translate polish laptop_09142f27:

    # gg "- И, выключая компьютер, я понимала, что все мои друзья умирают в тот же момент."
    gg "- Wyłączając komputer, wiedziałam, że wszyscy moi przyjaciele umierają w tym samym momencie."

# game/pnc_text.rpy:624
translate polish laptop_fd42c0ca:

    # gg "- И все же, я ни капли не беспокоилась..."
    gg "- Mimo to, nie byłam w ogóle zaniepokojona..."

# game/pnc_text.rpy:629
translate polish laptop_35b3eb5c:

    # gg "- Знаешь, из чего состоят компьютерные программы? Это всего-навсего комбинация чисел."
    gg "- Czy wiesz, z czego zbudowane są programy komputerowe? To tylko kombinacja liczb."

# game/pnc_text.rpy:632
translate polish laptop_ec2ec1d3:

    # gg "- Значит, и мои друзья - это числа. Не находишь это занятным?"
    gg "- Więc moi przyjaciele to też liczby. Nie sądzisz, że to jest zabawne?"

translate polish strings:
    # game/pnc_text.rpy:633
    old "(Не особо.)"
    new "(Nie do końca.)"

translate polish strings:
    # game/pnc_text.rpy:635
    old "(Почему ты называешь их друзьями?)"
    new "(Dlaczego nazywasz ich przyjaciółmi?)"

# game/pnc_text.rpy:639
translate polish laptop_2fe59e50:

    # gg "- Ну как же! Все, кто разделяет мои интересы - мои друзья. И неважно, знают ли они о моем существовании или нет."
    gg "- Jak inaczej! Każdy, kto podziela moje zainteresowania, jest moim przyjacielem. Nieważne, czy wiedzą o moim istnieniu, czy nie."

# game/pnc_text.rpy:642
translate polish laptop_a2053065:

    # gg "- Так вот! У каждой программы есть определенный алгоритм, задача - словом, математическая формула."
    gg "- A więc! Każdy program ma pewien algorytm, zadanie, wzór matematyczny."

# game/pnc_text.rpy:643
translate polish laptop_d2b39157:

    # gg "- И если решить эту формулу, ты точно будешь знать, как программа поведет себя в тот или иной момент."
    gg "- A jak go rozwiążesz, będziesz dokładnie wiedział, jak program zachowa się w tym czy innym przypadku."

translate polish strings:
    # game/pnc_text.rpy:644
    old "(Чем дальше - тем меньше я понимаю, о чем ты.)"
    new "(Im więcej mówisz, tym mniej rozumiem, co masz na myśli.)"

# game/pnc_text.rpy:648
translate polish laptop_80add5f4:

    # gg "- Тебе не нужно что-либо понимать. Просто слушай."
    gg "- Nie musisz niczego rozumieć. Wystarczy że posłuchasz."

# game/pnc_text.rpy:651
translate polish laptop_08543ea7:

    # "Я сажусь на пол, и экран ноутбука оказывается прямо у меня перед глазами. В нем я вижу лишь свое тусклое отражение и больше ничего."
    "Siadam na podłodze, ekran laptopa jest na wprost moich oczu. Widzę w nim tylko swoje niewyraźne odbicie i nic poza tym."

# game/pnc_text.rpy:654
translate polish laptop_6f1b1d71:

    # gg "- Человек из сети - это случайная картинка и случайный набор букв. Слова и поступки человека из сети - это программный код."
    gg "- Osoba w sieci to przypadkowe zdjęcie i przypadkowa mieszanka liter. Słowa i działania osoby online są kodem programowym."

# game/pnc_text.rpy:657
translate polish laptop_d2c4cf06_2:

    # gg "- ..."
    gg "- ..."

# game/pnc_text.rpy:664
translate polish laptop_d2c4cf06_3:

    # gg "- ..."
    gg "- ..."

# game/pnc_text.rpy:667
translate polish laptop_c37d7625:

    # gg "- Однажды кое-кто появился. С тех пор компьютер все время включен."
    gg "- Pewnego dnia ktoś się pojawił. Od tego czasu komputer jest cały czas włączony."

# game/pnc_text.rpy:670
translate polish laptop_bf04f233:

    # gg "- В сети не бывает настоящих людей, но ему удавалось притворяться. В какой-то момент я позволила себя обмануть..."
    gg "- W sieci nie ma prawdziwych ludzi, ale jemu udawało się udawać. W pewnym momencie dałam się nabrać..."

translate polish strings:
    # game/pnc_text.rpy:660
    old "(Дай мне знать, если тебе нужна передышка.)"
    new "(Daj mi znać, jeśli będziesz potrzebowała przerwy.)"

translate polish strings:
    # game/pnc_text.rpy:671
    old "(Эй, смотри!)"
    new "(Ej, patrz!)"

# game/pnc_text.rpy:675
translate polish laptop_8930ec26:

    # gg "- А?.."
    gg "- A?.."

# game/pnc_text.rpy:678
translate polish laptopff_744d5f7e:

    # "Вдруг из вентиляционной решетки ноутбука медленно выбирается светлячок. Я протягиваю руку; тот взбирается на ладонь, беспрестанно моргая."
    "Nagle z kratki wentylacyjnej laptopa powoli wyłania się świetlik. Wyciągam rękę, on wspina się na moją dłoń, mrugając bez przerwy."

translate polish strings:
    # game/pnc_text.rpy:679
    old "(По-моему, он пытается что-то сказать.)"
    new "(Chyba chce coś powiedzieć.)"

# game/pnc_text.rpy:684
translate polish laptopff_535e540c:

    # gg "- Я и сама вижу. Знать бы, что именно..."
    gg "- Sama to widzę. Chciałabym tylko wiedzieć co..."

translate polish strings:
    # game/pnc_text.rpy:685
    old "(Похоже на шифр. Разве тебе не хочется его разгадать?)"
    new "(To wygląda jak szyfr. Czy nie chcesz tego rozwiązać?)"

# game/pnc_text.rpy:689
translate polish laptopff_2f2a6c77:

    # gg "- Я передумала. Я на за что на свете не хочу знать, что он пытается сказать."
    gg "- Zmieniłam zdanie. Nie ma możliwości, żebym chciała wiedzieć, co on chce powiedzieć."

# game/pnc_text.rpy:690
translate polish laptopff_d9c14513:

    # "После этих слов светлячок на секунду гаснет."
    "Po tych słowach świetlik gaśnie na sekundę."

# game/pnc_text.rpy:691
translate polish laptopff_dc2ada86:

    # "Затем, словно придя в себя, загорается вновь."
    "Potem, jak gdyby oprzytomniał, znów się zapala."

# game/pnc_text.rpy:692
translate polish laptopff_7662646e:

    # "Какое-то время он обдумывает дальнейшие действия, после чего поднимается в воздух и стремительно залетает ко мне в ухо."
    "Przez chwilę zastanawia się nad swoim kolejnym ruchem, po czym wzbija się w powietrze i szybko leci do mojego ucha."

# game/pnc_text.rpy:693
translate polish laptopff_fc3f9e8b:

    # gg "- Давай искать дальше."
    gg "- Szukajmy dalej."

translate polish strings:
    # game/pnc_text.rpy:701
    old "(А как же твой рассказ?)"
    new "(A co z twoją historią?)"

# game/pnc_text.rpy:705
translate polish rasskaz_d2c4cf06:

    # gg "- ..."
    gg "- ..."

translate polish strings:
    # game/pnc_text.rpy:706
    old "(Должно быть, ты злишься, что я прервал тебя. Извини.)"
    new "(Pewnie jesteś zła, że ci przerwałem. Przepraszam.)"

# game/pnc_text.rpy:710
translate polish rasskaz_d2c4cf06_1:

    # gg "- ..."
    gg "- ..."

# game/pnc_text.rpy:713
translate polish rasskaz_5f0715b8:

    # gg "- Если ты все сделаешь правильно, я закончу рассказ. Возможно..."
    gg "- Jeśli zrobisz wszystko jak należy, dokończę tę historię. Może..."

translate polish strings:
    # game/pnc_text.rpy:714
    old "(Обещаешь?)"
    new "(Obiecujesz?)"

# game/pnc_text.rpy:718
translate polish rasskaz_cc81ff2c:

    # gg "- Обещаю."
    gg "- Obiecuję."

translate polish strings:
    # game/pnc_text.rpy:719
    old "(А если забудешь?)"
    new "(A co jeśli zapomnisz?)"

# game/pnc_text.rpy:721
translate polish rasskaz_206e880f:

    # gg "- Тогда напомни мне. Кодовым словом, например."
    gg "- To przypomnij mi. Na przykład za pomocą specjalnego szyfru."

translate polish strings:
    # game/pnc_text.rpy:722
    old "(Каким же?)"
    new "(Jakiego szyfru?)"

# game/pnc_text.rpy:724
translate polish rasskaz_d4a9506f:

    # gg "- Потом придумаю."
    gg "- Wymyślę to później."

# game/pnc_text.rpy:727
translate polish rasskaz_2e503c3b:

    # gg "- А сейчас - давай искать моих светлячков!"
    gg "- A teraz poszukajmy moich świetlików!"

# game/pnc_text.rpy:749
translate polish notebook_73622d2a:

    # "Это моя тетрадь для рисунков. Половина страниц пустует - значит, хватит еще на пару лет."
    "To jest mój szkicownik. Połowa stron jest pusta, co oznacza, że wystarczy mi jeszcze na kilka lat."

translate polish strings:
    # game/pnc_text.rpy:750
    old "(Ты так редко рисуешь? Почему?)"
    new "(Dlaczego tak rzadko rysujesz?)"

# game/pnc_text.rpy:753
translate polish notebook_2fdb1c40:

    # gg "- Разве не очевидно? Если закончатся страницы - придется покупать новую тетрадь."
    gg "- Czy to nie jest oczywiste? Jeśli skończą ci się kartki, musisz kupić nowy notatnik."

# game/pnc_text.rpy:754
translate polish notebook_25c9dcf1:

    # gg "- До канцелярского магазина пешком не добраться, придется ехать на автобусе."
    gg "- Do sklepu papierniczego nie można dojść pieszo, trzeba jechać autobusem."

# game/pnc_text.rpy:757
translate polish notebook_0fdb62bd:

    # gg "- Ты вообще представляешь, каким кошмаром это может обернуться?"
    gg "- Czy masz pojęcie, w jaki koszmar może się to przerodzić?"

translate polish strings:
    # game/pnc_text.rpy:758
    old "(Так, может, попросишь маму купить тебе тетрадь?)"
    new "(Dlaczego więc nie poprosisz mamy, żeby kupiła ci zeszyt?)"

# game/pnc_text.rpy:762
translate polish notebook_b5dc11a0:

    # gg "- Что купить? Кого попросить? Ты вообще умеешь расставлять акценты в речи?"
    gg "- Co kupić? Kogo zapytać? Czy w ogóle wiesz, jak stawiać akcenty w swoich wypowiedziach?"

translate polish strings:
    # game/pnc_text.rpy:763
    old "(Не придуривайся. Лучше попроси маму купить тебе тетрадь.)"
    new "(Nie udawaj głupiej. Lepiej poproś mamę, żeby kupiła ci zeszyt.)"

# game/pnc_text.rpy:767
translate polish notebook_61128a51:

    # gg "- Лучше? То есть ты просишь от меня совершить сразу несколько действий, при этом говоря, что одно лучше другого?"
    gg "- Lepiej? Więc prosisz mnie o zrobienie kilku rzeczy naraz, jednocześnie twierdząc, że jedna jest lepsza od drugiej?"

# game/pnc_text.rpy:770
translate polish notebook_7b0afc12:

    # gg "- Тогда зачем мне выполнять то, которое хуже?"
    gg "- To dlaczego mam wykonywać tą gorszą?"

# game/pnc_text.rpy:773
translate polish notebook_3e4cfd0b:

    # gg "- Ты и пары слов связать не можешь, хи-хи!"
    gg "- Nie potrafisz nawet sklecić dwóch słów razem, hi-hi!"

translate polish strings:
    # game/pnc_text.rpy:774
    old "(Боже, как с тобой тяжело...)"
    new "(Boże, jak ciężko jest być z tobą...)"

# game/pnc_text.rpy:778
translate polish notebook_ff6dd08d:

    # gg "- Тебе недостает чуткости. Разве это моя вина?"
    gg "- Nie skupiasz się na własnych wypowiedziach. Czy to moja wina?"

# game/pnc_text.rpy:784
translate polish notebook_a5db7b1c:

    # "Я подхожу чуть ближе к тетради, переступая через провода, спальный мешок, трещины в ламинате и отблески из окна."
    "Zbliżam się nieco do szkicownika, omijając kable, śpiwór, pęknięcia w laminacie i odbicia w oknie."

# game/pnc_text.rpy:785
translate polish notebook_508d510d:

    # "Тетрадь лежит на табуретке; с высоты моего взгляда кажется, что у табуретки недостает двух ножек. Опускаюсь на корточки - все ножки на месте."
    "Szkicownik leży na taborecie; z mojej perspektywy wydaje się, że taboretowi brakuje dwóch nóg. Przykucnęłam - wszystkie nogi są w miejscu."

# game/pnc_text.rpy:786
translate polish notebook_dde63762:

    # "Могу ли я придумать интересную аллегорию?"
    "Czy mogę wymyślić jakąś ciekawą alegorię?"

translate polish strings:
    # game/pnc_text.rpy:787
    old "(Давай без этого, а?)"
    new "(Lepiej nie, okej?)"

# game/pnc_text.rpy:789
translate polish notebook_c146e361:

    # "Я поднимаюсь и смотрю на тетрадь в упор."
    "Podnoszę się i beznamiętnie wpatruję w zeszyt."

# game/pnc_text.rpy:790
translate polish notebook_bcd03463:

    # "Листы белоснежно чистые; последний рисунок похоронен на предыдущей странице. Так и должно быть."
    "Kartki są śnieżnobiałe; ostatni rysunek jest pogrzebany na poprzedniej stronie. Jest tak, jak powinno być."

translate polish strings:
    # game/pnc_text.rpy:791
    old "(Жаль, мне бы хотелось взглянуть.)"
    new "(Szkoda, chętnie bym zajrzał.)"

# game/pnc_text.rpy:795
translate polish notebook_f01e6c1d:

    # gg "- В другой раз."
    gg "- Innym razem."

# game/pnc_text.rpy:798
translate polish notebook_8dcb67c3:

    # "Вдруг в комнату ворвался прохладный ветер - тетрадные листы зашелестели."
    "Nagle do pokoju wpadł chłodny powiew wiatru - kartki zeszytu zaszeleściły."

# game/pnc_text.rpy:801
translate polish notebook_705c7ef0:

    # gg "- Н-нет!.."
    gg "- N-nie!.."

# game/pnc_text.rpy:804
translate polish notebook_ce173ba3:

    # "Я зажмуриваюсь."
    "Zaciskam oczy."

# game/pnc_text.rpy:805
translate polish notebook_4a5bbcff:

    # "Отчетливый и характерный звук перелистываемых страниц отдается головной болью - я знаю, что сейчас произойдет..."
    "Wyraźny i charakterystyczny dźwięk przewracanych stron przyprawia mnie o ból głowy - wiem, co zaraz się wydarzy..."

# game/pnc_text.rpy:806
translate polish notebook_a20cefa7:

    # "..."
    "..."

# game/pnc_text.rpy:807
translate polish notebook_b092dc1b:

    # "Шелест прекратился, хотя ветер продолжал завывать из всех щелей. Это значит только одно - тетрадь открыта на первой странице."
    "Szelest ustał, choć wiatr nadal wył z każdej szczeliny. Oznaczało to tylko jedno - zeszyt był otwarty na pierwszej stronie."

# game/pnc_text.rpy:808
translate polish notebook_1dec8145:

    # "Если я подожду еще немного, ветер захлопнет ее."
    "Jeśli poczekam jeszcze trochę, wiatr zamknie go."

# game/pnc_text.rpy:809
translate polish notebook_759776ee:

    # "Мне не придется смотреть... если я подожду еще немного."
    "Nie będę musiała na to patrzeć... jeśli poczekam trochę dłużej."

# game/pnc_text.rpy:810
translate polish notebook_f01278fc:

    # "Если я..."
    "Jeśli..."

translate polish strings:
    # game/pnc_text.rpy:811
    old "(Открой глаза.)"
    new "(Otwórz oczy.)"

# game/pnc_text.rpy:813
translate polish notebook_827bf4c2:

    # gg "- Нет!"
    gg "- Nie!"

translate polish strings:
    # game/pnc_text.rpy:814
    old "(Все хорошо, просто открой глаза.)"
    new "(Wszystko w porządku, po prostu otwórz oczy.)"

# game/pnc_text.rpy:816
translate polish notebook_271f7539:

    # gg "- Ни за что! Я знаю, что ты врешь!"
    gg "- Nie ma mowy! Wiem, że kłamiesz!"

translate polish strings:
    # game/pnc_text.rpy:817
    old "(Успокойся.)"
    new "(Spokojnie.)"

# game/pnc_text.rpy:819
translate polish notebook_827bf4c2_1:

    # gg "- Нет!"
    gg "- Nie!"

# game/pnc_text.rpy:822
translate polish notebook_827bf4c2_2:

    # gg "- Нет!"
    gg "- Nie!"

# game/pnc_text.rpy:825
translate polish notebook_827bf4c2_3:

    # gg "- Нет!"
    gg "- Nie!"

# game/pnc_text.rpy:828
translate polish notebook_827bf4c2_4:

    # gg "- Нет!"
    gg "- Nie!"

# game/pnc_text.rpy:831
translate polish notebook_d2c4cf06:

    # gg "- ..."
    gg "- ..."

# game/pnc_text.rpy:834
translate polish notebook_d2c4cf06_1:

    # gg "- ..."
    gg "- ..."

# game/pnc_text.rpy:837
translate polish notebook_d2c4cf06_2:

    # gg "- ..."
    gg "- ..."

# game/pnc_text.rpy:838
translate polish notebook_7e89ef29:

    # gg "- Ладно."
    gg "- Dobrze."

# game/pnc_text.rpy:841
translate polish notebook_9b2c1786:

    # "Я с опаской открываю глаза. Тетрадь все так же распахнута на середине; ни рисунков, ничего - листы по-прежнему чистые."
    "Ostrożnie otwieram oczy. Szkicownik jest nadal otwarty, a w środku nie ma żadnych rysunków, nic - kartki są nadal puste."

# game/pnc_text.rpy:842
translate polish notebook_57fd477a:

    # gg "- Померещилось?.."
    gg "- Zdawało mi się?"

translate polish strings:
    # game/pnc_text.rpy:843
    old "(Не знаю. Померещилось ли?)"
    new "(Nie wiem. Czy to było urojone?)"

# game/pnc_text.rpy:847
translate polish notebook_094deede:

    # gg "- Ты же у нас все знаешь, вот и скажи мне!"
    gg "- To ty tutaj wiesz wszystko, więc powiedz mi!"

translate polish strings:
    # game/pnc_text.rpy:848
    old "(В следующий раз не закрывай глаза.)"
    new "(Następnym razem nie zamykaj oczu.)"

# game/pnc_text.rpy:852
translate polish notebook_558198df:

    # gg "- Что ты?.."
    gg "- Co ty?.."

# game/pnc_text.rpy:855
translate polish notebook_efe61eb0:

    # "Не успела я договорить, как тетрадные листы вновь зашевелились."
    "Zanim zdążyłam dokończyć zdanie, kartki zeszytu znów się poruszyły."

translate polish strings:
    # game/pnc_text.rpy:856
    old "(Не закрывай глаза!)"
    new "(Nie zamykaj oczu!)"

# game/pnc_text.rpy:860
translate polish notebook_d0521114:

    # gg "- Не заставляй меня, мне же страшно!"
    gg "- Nie zmuszaj mnie, boję się!"

# game/pnc_text.rpy:865
translate polish notebook_6372ec47:

    # "Шелест усиливается, листы приподнимаются - я могу разглядеть очертания рисунков на предыдущих страницах."
    "Szelest nasila się, kartki unoszą się - widzę zarysy rysunków na poprzednich stronach."

# game/pnc_text.rpy:866
translate polish notebook_cf24a82c:

    # "Нет уж! Все, что было в прошлом, должно там и оставаться!"
    "Nie ma szans! To, co było w przeszłości, musi pozostać w przeszłości!"

translate polish strings:
    # game/pnc_text.rpy:861
    old "(Верь мне.)"
    new "(Zaufaj mi.)"

# game/pnc_text.rpy:869
translate polish notebook_25767d3e:

    # gg "- Ты меня не убедил! Все, я закрываю глаза, слышишь?"
    gg "- Nie przekonałeś mnie! Zamykam oczy, słyszysz mnie?"

# game/pnc_text.rpy:874
translate polish notebook_64646323:

    # "Между страниц просачивается едва различимый свет. С каждым порывом ветра он становится все ярче и ярче..."
    "Między stronami sączy się ledwie wyczuwalne światło. Z każdym podmuchem wiatru staje się coraz jaśniejsze i jaśniejsze..."

translate polish strings:
    # game/pnc_text.rpy:870
    old "(Смотри, смотри же!)"
    new "(Patrz, patrz!)"

# game/pnc_text.rpy:877
translate polish notebook_9a40790e:

    # gg "- Светлячок!"
    gg "- Świetlik!"

# game/pnc_text.rpy:880
translate polish notebook_b496e578:

    # "Ветер вмиг прекращается. На секунду мир погружается в полную тишину, но лишь на секунду..."
    "Wiatr ustaje w jednej chwili. Na sekundę świat pogrąża się w kompletnej ciszy, ale tylko na sekundę..."

# game/pnc_text.rpy:881
translate polish notebook_b8632a5e:

    # "Вечно преследующий меня шум неумолимо заполоняет все вокруг. Но сейчас это неважно!"
    "Wszechobecny hałas nieubłaganie wypełnia wszystko dookoła. Ale teraz to już nie ma znaczenia!"

# game/pnc_text.rpy:884
translate polish notebook_ca849c5e:

    # gg "- Боже, малыш! Я так перепугалась..."
    gg "- O mój Boże, maluchu! Tak się bałam..."

# game/pnc_text.rpy:887
translate polish notebook_ba5348c8:

    # "В ответ светлячок моргает, после чего поднимается в воздух и с громким жужжанием влетает мне в ухо."
    "W odpowiedzi na to świetlik mruga, po czym wzbija się w powietrze i z głośnym brzęczeniem leci do mojego ucha."

# game/pnc_text.rpy:888
translate polish notebook_72b512d0:

    # "Какое-то время он ищет подходящее место в моей голове, не прекращая жужжать, но потом затихает."
    "Przez chwilę szuka właściwego miejsca w mojej głowie, nie przestając brzęczeć, ale potem cichnie."

# game/pnc_text.rpy:891
translate polish notebook_5794d60f:

    # gg "- Фух..."
    gg "- Uf-f..."

translate polish strings:
    # game/pnc_text.rpy:892
    old "(Ты как, нормально?)"
    new "(Nic ci nie jest?)"

# game/pnc_text.rpy:896
translate polish notebook_cf4086f9:

    # gg "- У нас мало времени, давай искать дальше."
    gg "- Nie mamy zbyt wiele czasu, szukajmy dalej."

# game/pnc_text.rpy:916
translate polish pills_311114e8:

    # "Я смотрю на кучу лекарств и голова идет кругом. Я не хочу сейчас думать об этом, совсем не хочу..."
    "Patrzę na stertę leków i zaczyna mi się kręcić w głowie. Nie chcę teraz o tym myśleć, w ogóle..."

translate polish strings:
    # game/pnc_text.rpy:917
    old "(Что с тобой?)"
    new "(Co się dzieje?)"

# game/pnc_text.rpy:920
translate polish pills_73c963bb:

    # gg "- Сегодня я едва не пропустила курс. Что за безрассудство! Я ведь могла умереть..."
    gg "- Prawie nie zdążyłam na dzisiejszy kurs. Co za lekkomyślność! Mogłam umrzeć..."

translate polish strings:
    # game/pnc_text.rpy:921
    old "(Эй, успокойся. Ты уже все исправила.)"
    new "(Ej, uspokój się. Już to naprawiłaś.)"

# game/pnc_text.rpy:925
translate polish pills_4ca8d596:

    # gg "- Да, по твоему приказу!"
    gg "- Tak, na twoje życzenie!"

translate polish strings:
    # game/pnc_text.rpy:926
    old "(Это обвинение?)"
    new "(Czy to jest zarzut?)"

# game/pnc_text.rpy:930
translate polish pills_d08b4fbc:

    # gg "- Конечно же нет! Только это меня и спасло."
    gg "- Oczywiście, że nie! To była jedyna rzecz, która mnie uratowała."

translate polish strings:
    # game/pnc_text.rpy:931
    old "(Что ж... вполне здравая мысль.)"
    new "(Cóż... to rozsądny pomysł.)"

translate polish strings:
    # game/pnc_text.rpy:926
    old "(Все могло быть гораздо хуже.)"
    new "(Mogło być znacznie gorzej.)"

# game/pnc_text.rpy:938
translate polish pills_21c1bac1:

    # gg "- Ага..."
    gg "- Mhm..."

translate polish strings:
    # game/pnc_text.rpy:921
    old "(Ты и так умрешь, чего волноваться?)"
    new "(I tak umrzesz, po co się martwić?)"

# game/pnc_text.rpy:943
translate polish pills_29ef1128:

    # gg "- Ой, и правда!"
    gg "- O, rzeczywiście!"

# game/pnc_text.rpy:946
translate polish pills_d2c4cf06:

    # gg "- ..."
    gg "- ..."

# game/pnc_text.rpy:950
translate polish pills_30a63250:

    # "Я тяжело вздыхаю, подхожу ближе и протягиваю руку..."
    "Westchnęłam ciężko, przysunęłam się bliżej i wyciągnęłam rękę..."

# game/pnc_text.rpy:953
translate polish pills_282e87f2:

    # gg "- Ух ты, тепло!"
    gg "- Ale ciepło!"

# game/pnc_text.rpy:956
translate polish pills_d8114ff1:

    # "Не успели слова вылететь из моего рта, как одна из баночек перевернулась; из нее градом посыпались таблетки, а затем..."
    "Gdy tylko słowa te wyszły z moich ust, jeden z pojemników przewrócił się; pigułki rozsypały się, a potem..."

# game/pnc_text.rpy:959
translate polish pills_0225fb97:

    # gg "- Светлячок! Ура!"
    gg "- Świetlik! Hura!"

# game/pnc_text.rpy:962
translate polish pills_b0537a94:

    # "Сделав пару кругов над моей макушкой, он наконец садится на протянутую руку. Спешно пробежав по ней до плеча, светлячок заползает прямо мне в ухо - ум слегка проясняется."
    "Po okrążeniu czubka mojej głowy, w końcu siada na wyciągniętej ręce. Po pospiesznym zbiegnięciu po nim na ramię, świetlik wpełzł mi do ucha - mój umysł stał się nieco jaśniejszy."

# game/pnc_text.rpy:982
translate polish umbrella_6177059b:

    # "От зонта веет едва ощутимой прохладой. Немудрено, ведь только он защищает меня от грозовых туч, что иногда собираются под потолком."
    "Od parasola delikatnie wieje chłodem. To jedyna rzecz, która chroni mnie przed burzowymi chmurami, które czasami zbierają się pod sufitem." #?????????????????????????????????

# game/pnc_text.rpy:983
translate polish umbrella_7211d4a7:

    # "Какое счастье, что он справляется с этим даже без моего участия!"
    "Co za szczęście, że potrafi sobie z tym poradzić nawet bez mojego udziału!"

# game/pnc_text.rpy:985
translate polish umbrella_e9ea09c8:

    # gg "- И все же, светлячок не станет прятаться в подобном месте. Иначе он простудится и не сможет летать!"
    gg "- Jednak w takim miejscu świetlik by się nie schował. Inaczej się przeziębi i nie będzie w stanie latać!"

translate polish strings:
    # game/pnc_text.rpy:986
    old "(И ты не хочешь проверить?)"
    new "(Sprawdziłabyś może?)"

# game/pnc_text.rpy:990
translate polish umbrella_2c1f3804:

    # gg "- Зачем? Я точно знаю - здесь мы ничего не найдем."
    gg "- Po co? Wiem na pewno, że nic tu nie znajdziemy."

translate polish strings:
    # game/pnc_text.rpy:986
    old "(Ладно. Давай искать дальше.)"
    new "(No dobrze. Szukajmy dalej.)"

# game/pnc_text.rpy:1019
translate polish tumba_b9934e56:

    # gg "- Это вряд ли. Все ящики намертво заперты."
    gg "- Nie wydaje mi się. Wszystkie szuflady są zablokowane."

translate polish strings:
    # game/pnc_text.rpy:1020
    old "(А если...)"
    new "(A co jeśli...)"

# game/pnc_text.rpy:1022
translate polish tumba_fc1c9c4f:

    # gg "- Я не хочу даже думать о том, что внутри. Невесть чего вообразить можно!"
    gg "- Nawet nie chcę myśleć o tym, co jest w środku. Nie wiadomo, co można sobie wyobrazić!"

translate polish strings:
    # game/pnc_text.rpy:1048
    old "(Ладно, давай поищем где-нибудь еще.)"
    new "(Okej, poszukajmy gdzie indziej.)"

# game/pnc_text.rpy:1045
translate polish towel_acd71dda:

    # "Я обращаю свой взгляд к неприметной полке рядом с зеркалом. На ней стоит стакан с зубной щеткой, а рядом висит маленькое полотенце. Прелесть!"
    "Zwracam wzrok na niepozorną półkę obok lustra. Na niej stoi szklanka z szczotką do zębów, a obok niej wisi mały ręcznik. Pięknie!"

# game/pnc_text.rpy:1047
translate polish towel_1a28ab52:

    # gg "- Мои светлячки умные, хорошие и не станут туда лезть - у них есть понятия о личной гигиене!"
    gg "- Moje świetliki są mądre, grzeczne i nie wejdą tam - mają pojęcie o higienie osobistej!"

# game/pnc_text.rpy:1068
translate polish plants_b2dcd22e:

    # gg "- Точно! Насекомые же любят опылять цветы и все такое!"
    gg "- Właśnie! Owady lubią zapylać kwiaty czy coś w tym stylu!"

translate polish strings:
    # game/pnc_text.rpy:1069
    old "(Эм-м... типа того.)"
    new "(Em-m... tak jakby.)"

# game/pnc_text.rpy:1073
translate polish plants_37284d6f:

    # "Я подхожу вплотную к полке с цветами. Принюхиваюсь - от листьев пахнет пылью и картоном. И еще смертью."
    "Podchodzę do półki z kwiatami. Wącham - liście pachną kurzem, kartonem a na dodatek jeszcze śmiercią."

translate polish strings:
    # game/pnc_text.rpy:1074
    old "(Ты в курсе, что цветы давно высохли?)"
    new "(Czy wiesz, że kwiaty już dawno uschły?)"
    
translate polish strings:
    # game/pnc_text.rpy:1076
    old "(Вряд ли мертвый цветок может привлечь насекомое.)"
    new "(To mało prawdopodobne, aby martwy kwiat przyciągnął owada.)"

# game/pnc_text.rpy:1080
translate polish plants_d40b9e9e:

    # gg "- Тут, знаешь ли, выбирать не приходится."
    gg "- Nie ma wyboru, wiesz."

# game/pnc_text.rpy:1083
translate polish plants_eb554241:

    # gg "- Хотя... ты прав. Давай искать дальше."
    gg "- Chociaż... masz rację. Szukajmy dalej."

translate polish strings:
    # game/pnc_text.rpy:1084
    old "(Почему бы просто их не выбросить?)"
    new "(Dlaczego po prostu ich nie wyrzucić?)"

# game/pnc_text.rpy:1088
translate polish plants_bb89c88c:

    # gg "- Ты что, совсем меня не слушал?"
    gg "- Czy ty mnie w ogóle słuchałeś?"

# game/pnc_text.rpy:1093
translate polish plants_d2c4cf06:

    # gg "- ..."
    gg "- ..."

# game/pnc_text.rpy:1111
translate polish cond_5ae0230c:

    # "Я поднимаю глаза высоко-высоко к потолку."
    "Podnoszę wzrok wysoko do sufitu."

# game/pnc_text.rpy:1112
translate polish cond_3bb16f8c:

    # "Из кондиционера доносится топот множества маленьких лапок."
    "Z klimatyzatora dobiega tupot wielu małych łapek."

# game/pnc_text.rpy:1114
translate polish cond_ce0adfe1:

    # gg "- Ну вот..."
    gg "- Proszę bardzo..."

translate polish strings:
    # game/pnc_text.rpy:1115
    old "(Что такое?)"
    new "(Co jest?)"

# game/pnc_text.rpy:1119
translate polish cond_f224b446:

    # gg "- Светлячки не дружат с тараканами. Надо поискать в другом месте."
    gg "- Świetliki nie przyjaźnią się z karaluchami. Powinniśmy poszukać gdzieś indziej."

translate polish strings:
    # game/pnc_text.rpy:1120
    old "(Боже, откуда там тараканы?)"
    new "(Boże, skąd się wzięły te karaluchy?)"

# game/pnc_text.rpy:1124
translate polish cond_86021029:

    # gg "- Ты уже забыл?"
    gg "- Zapomniałeś już?"

# game/pnc_text.rpy:1125
translate polish cond_1e339c58:

    # gg "- Сам же сказал мне представить, будто мои мысли - это тараканы."
    gg "- Sam kazałeś mi sobie wyobrazić, że moje myśli są karaluchami."

translate polish strings:
    # game/pnc_text.rpy:1126
    old "(Да, но...)"
    new "(Tak, ale...)"

# game/pnc_text.rpy:1130
translate polish cond_911b6235:

    # gg "- Затем они стали светлячками, да... Но тараканы ведь не могут просто взять и исчезнуть!"
    gg "- Potem stały się świtlikami, tak... Ale karaluchy nie mogą tak po prostu zniknąć!"

# game/pnc_text.rpy:1133
translate polish cond_c734e0a6:

    # gg "- Вот они и нашли себе местечко."
    gg "- Więc znalazły sobie miejsce."

# game/pnc_text.rpy:1136
translate polish cond_a474b417:

    # gg "- Понял?"
    gg "- Zrozumiałeś?"

translate polish strings:
    # game/pnc_text.rpy:1137
    old "(Понял.)"
    new "(Zrozumiałem.)"
translate polish strings:
    # game/pnc_text.rpy:1137
    old "(Не понял.)"
    new "(Nie zrozumiałem.)"
translate polish strings:
    # game/pnc_text.rpy:1137
    old "(Сделаю вид, что понял.)"
    new "(Będę udawał, że zrozumiałem.)"

# game/pnc_text.rpy:1165
translate polish bulbs_ebc87901:

    # gg "- Ты серьезно?"
    gg "- Serio?"

translate polish strings:
    # game/pnc_text.rpy:1166
    old "(А что не так?)"
    new "(Coś jest nie tak?)"

# game/pnc_text.rpy:1168
translate polish bulbs_30c3bd25:

    # gg "- Сам подумай: стали бы светлячки лететь на свет?"
    gg "- Zastanów się: czy świetliki poleciałyby do światła?"

# game/pnc_text.rpy:1169
translate polish bulbs_c15c589f:

    # gg "- Мне кажется, они вполне самодостаточны в этом плане."
    gg "- Myślę, że pod tym względem są całkiem samowystarczalne."

# game/pnc_text.rpy:1170
translate polish bulbs_d2c4cf06:

    # gg "- ..."
    gg "- ..."

# game/pnc_text.rpy:1173
translate polish bulbs_6f05c6bd:

    # gg "- Если только они целенаправленно не хотят снизить себе самооценку."
    gg "- Chyba, że celowo chcą obniżyć swoją samoocenę."

# game/pnc_text.rpy:1176
translate polish bulbs_cb7a643e:

    # gg "- Хм-м..."
    gg "- Hm-m..."

# game/pnc_text.rpy:1196
translate polish vent_ac59bddc:

    # gg "- Отсюда так просто не выбраться... Хи-хи..."
    gg "- Nie ma stąd łatwego wyjścia... Hi-hi..."

translate polish strings:
    # game/pnc_text.rpy:1216
    old "(А это что?)"
    new "(Co to jest?)"

# game/pnc_text.rpy:1219
translate polish posters_9d2cceaf:

    # gg "- Ах, это..."
    gg "- Ah, to..."

# game/pnc_text.rpy:1222
translate polish posters_badaf50e:

    # gg "- Это фотографии моих самых счастливых моментов!"
    gg "- To są zdjęcia z moich najszczęśliwszych chwil!"

translate polish strings:
    # game/pnc_text.rpy:1223
    old "(На них ведь ничего нет...)"
    new "(Ale nic na nich nie ma...)"

# game/pnc_text.rpy:1227
translate polish posters_62804578:

    # gg "- Я так долго смотрела на них, что буквально сожгла взглядом, хи-хи!"
    gg "- Wpatrywałam się w nie tak długo, że dosłownie wypaliłam je wzrokiem, hi-hi!"

# game/pnc_text.rpy:1228
translate polish posters_c0104c7b:

    # gg "- Теперь они просто закрывают трещины в стенах."
    gg "- Teraz są tylko po to, aby zakrywać pęknięcia w ścianach."

translate polish strings:
    # game/pnc_text.rpy:1229
    old "(Трещины?)"
    new "(Pęknięcia?)"

# game/pnc_text.rpy:1233
translate polish posters_0639eea2:

    # gg "- Неважно. Дальше искать будем или как?"
    gg "- Nieważne. Będziemy szukać dalej, czy co?"

translate polish strings:
    # game/pnc_text.rpy:1234
    old "(Будем, будем...)"
    new "(Dobra, dobra...)"

# game/pnc_text.rpy:1254
translate polish smth_7b670ab8:

    # gg "- Что это?"
    gg "- Co to?"

# game/pnc_text.rpy:1275
translate polish shkaf_be2fa242:

    # "Я запрокидываю голову и чуть не падаю. Шкаф висит под самым потолком - метров сто от пола, не меньше."
    "Odchylam głowę do tyłu i prawie się przewracam. Szafka wisi pod sufitem - sto metrów od podłogi, nie mniej."

# game/pnc_text.rpy:1277
translate polish shkaf_8ee16e1e:

    # gg "- Издеваешься?.."
    gg "- Chyba sobie żartujesz?.."

# game/pnc_text.rpy:1278
translate polish shkaf_597bb54a:

    # gg "- Хоть это и моя комната, но многое здесь предназначено отнюдь не для меня."
    gg "- Mimo że to mój pokój, wiele rzeczy nie jest przeznaczonych dla mnie."

# game/pnc_text.rpy:1281
translate polish shkaf_3d885d51:

    # gg "- Ну и ладно!"
    gg "- A co mnie to obchodzi!"

# game/pnc_text.rpy:1284
translate polish shkaf_d4166c15:

    # gg "- Мне вообще плевать!"
    gg "- W ogóle mnie to nie obchodzi!"

# game/pnc_text.rpy:1285
translate polish shkaf_db2e8cc7:

    # gg "- Да-да, плевать! И еще как!"
    gg "- Tak, nie obchodzi mnie to! I to jak!"

# game/pnc_text.rpy:1286
translate polish shkaf_9fbd832c:

    # gg "- Вообще все равно! И я нисколько не переживаю!"
    gg "- W ogóle mnie to nie interesuje! I nie przejmuję się tym ani trochę!"

# game/pnc_text.rpy:1287
translate polish shkaf_2ecec224:

    # gg "- Даже самую малость! Даже крупицу от самой малости!" #??????????????????????????????????????????????????????????????????????
    gg "- Nawet w najmniejszym kawałku! Nawet w najmniejszym ułamku najmniejszego kawałka!"

# game/pnc_text.rpy:1288
translate polish shkaf_a267440e:

    # gg "- Даже на одну тысячную процента не переживаю! Вот настолько мне все равно!"
    gg "- Nie obchodzi mnie nawet na jedną tysięczną procenta! Tak bardzo mnie to nie obchodzi!"


# game/pnc_text.rpy:1293
