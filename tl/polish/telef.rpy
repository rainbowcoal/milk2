# game/telef.rpy:36
translate polish telef_0fb4b444:

    # piz "- Добрый день, спасибо, что выбрали нашу пиццерию!"
    piz "- Dzień dobry, dziękujemy za wybór naszej pizzerii!"

# game/telef.rpy:38
translate polish telef_ad65ab06:

    # tel "- Знаете, здесь так пусто... Впрочем, мне от этого ни хорошо, ни плохо."
    tel "- Wiesz, tu jest tak pusto... W sumie nie jest to dla mnie ani dobre, ani złe."

# game/telef.rpy:41
translate polish telef_9641db4c:

    # tel "- Я совсем одна, и в то же время вроде бы нет - в голове много мыслей, с которыми уж точно не соскучишься."
    tel "- Jestem zupełnie sama, a jednocześnie tak mi się nie wydaje - w mojej głowie kłębi się mnóstwo myśli, z którymi nie da się nudzić."

# game/telef.rpy:44
translate polish telef_3fa36954:

    # tel "- С ними можно создать целый мир. Уверена, если очень постараться, он заполнит всю пустоту вокруг!"
    tel "- Możesz stworzyć z nimi cały świat. Jestem pewna, że jak się postarasz, to wypełni pustkę wokół ciebie!"

# game/telef.rpy:47
translate polish telef_08a33cd2:

    # tel "- Хотя..."
    tel "- Chociaż..."

# game/telef.rpy:50
translate polish telef_8e730ebd:

    # tel "- Сколько бы я ни думала, окружение не менялось. Да, что-то происходило в моей голове, но по-прежнему оставалось в ее пределах."
    tel "- Bez względu na to, jak dużo myślałam, otoczenie nie zmieniało się. To znaczy, coś się działo w mojej głowie, ale wciąż utrzymywało się w jej granicach."

# game/telef.rpy:53
translate polish telef_1e072587:

    # tel "- Не то чтобы я как-то сдерживала это... Может, оно само боялось выходить?"
    tel "- Nie to żeby jakoś to wstrzymywałam... Być może to po prostu bało się wyjść?"

# game/telef.rpy:60
translate polish telef_cbfe431f:

    # piz "- Какую пиццу Вы хотели бы заказать?"
    piz "- Jaki rodzaj pizzy Państwo chciałoby zamówić?"

# game/telef.rpy:62
translate polish telef_93e9366a:

    # tel "- Так вот! В любом случае, в моей голове не так много места, где можно было бы развернуться."
    tel "- W każdym razie! Nie ma zbyt wiele miejsca w mojej głowie, na jakiekolwiek myśli."

# game/telef.rpy:65
translate polish telef_6b32b2a4:

    # tel "- Так что каждая мысль наворачивала бессмысленный и беспощадный круг, безнадежно возвращаясь в начало."
    tel "- I tak każda myśl zataczała bezsensowne i bezlitosne koło, beznadziejnie wracając do początku."

# game/telef.rpy:68
translate polish telef_50d3a2e6:

    # tel "- А ведь когда-то должен быть конец. Нельзя блуждать так вечно. Как вы считаете?"
    tel "- Ale w pewnym momencie musi nastąpić koniec. Przecież nie można wiecznie się tak włóczyć. Co o tym sądzisz?"

# game/telef.rpy:71
translate polish telef_dc7ad40c:

    # tel "- Конечно, звучит это очень страшно, но не страшнее постоянного существования в пустоте."
    tel "- Oczywiście, brzmi to bardzo przerażająco, ale nie jest to bardziej przerażające niż przebywanie w próżni przez cały czas."

# game/telef.rpy:74
translate polish telef_6ff2f2e7:

    # tel "- Здесь определенно безопасно, и не случится ничего плохого. Как и хорошего, впрочем."
    tel "- Na pewno jest tu bezpiecznie i nic złego się nie stanie. W sumie nic dobrego też."

# game/telef.rpy:82
translate polish telef_81b16851:

    # piz "- Обратите внимание, что у нас проходит акция - три пиццы по цене двух!"
    piz "- Przypominamy, że trwa promocja - trzy pizze w cenie dwóch!"

# game/telef.rpy:84
translate polish telef_a7ed4e99:

    # tel "- Да... Наверное, ничего хорошего в одних и тех же мыслях нет. Да и какой в них смысл вообще?"
    tel "- Tak... Chyba nie ma nic dobrego w tych samych myślach. I jaki jest w ogóle sens ich istnienia?"

# game/telef.rpy:87
translate polish telef_2257250d:

    # tel "- Я могла бы сбежать отсюда, но, кажется, мои же мысли мне совсем не помогают."
    tel "- Chciałabym stąd uciec, ale moje własne myśli wcale mi nie pomagają."

# game/telef.rpy:90
translate polish telef_656cea78:

    # tel "- Им должно быть стыдно... Наверное."
    tel "- Powinni się wstydzić... Raczej."

# game/telef.rpy:93
translate polish telef_6796371b:

    # tel "- Никто не виноват, что здесь даже двери не видно. С ней было бы гораздо проще!"
    tel "- To niczyja wina, że nie widać nawet drzwi, z nimi byłoby o wiele łatwiej!"

# game/telef.rpy:96
translate polish telef_2379eeca:

    # tel "- Я пыталась её найти - и это пустая трата времени."
    tel "- Próbowałam je znaleźć - i to totalna strata czasu."

# game/telef.rpy:99
translate polish telef_d2a7bb09:

    # tel "- Сколько ни ходи, ничего не находится (ой, игра слов!), и это лишает меня всякой надежды на спасение."
    tel "- Bez względu na to, ile chodzę, nic nie mogę znaleźć - to pozbawia mnie jakiejkolwiek nadziei na zbawienie."

# game/telef.rpy:106
translate polish telef_dfb41c51:

    # piz "- Также у нас есть система скидок для новых клиентов. Подробней можно узнать в личном кабинете!"
    piz "- Posiadamy również system rabatowy dla nowych klientów. Więcej dowiesz się na naszej stronie!"

# game/telef.rpy:108
translate polish telef_ca637c50:

    # tel "- Вам не кажется, что моё пребывание здесь - это пустая трата времени? Какой в этом смысл?"
    tel "- Czy nie uważasz, że moja obecność tutaj to strata czasu? Jaki to ma sens?"

# game/telef.rpy:111
translate polish telef_57a0318a:

    # tel "- Я могу просто думать. И то, мои мысли такие же бессмысленные и пустые, как всё вокруг."
    tel "- Mogę po prostu myśleć. I tak moje myśli są bezsensowne i puste, jak wszystko inne wokół mnie."

# game/telef.rpy:114
translate polish telef_a0f1d467:

    # tel "- Значит ли это, что я не заполняю пустоту, а просто являюсь её частью?"
    tel "- Czy to znaczy, że nie wypełniam pustki, a po prostu jestem jej częścią?"

# game/telef.rpy:117
translate polish telef_4afd3358:

    # tel "- Зачем мне тогда чувствовать себя? Знать, что я существую?"
    tel "- Dlaczego więc mam się czuć sobą? Wiedzieć, że istnieję?"

# game/telef.rpy:120
translate polish telef_8d654971:

    # tel "- Впрочем, я даже не уверена насчёт этого."
    tel "- Nie jestem nawet tego pewna."

# game/telef.rpy:123
translate polish telef_e0d77aa7:

    # tel "- В этом месте всегда ни холодно, ни горячо. Вообще никак."
    tel "- W tym miejscu zawsze nie jest ani zimno, ani gorąco. W ogóle nijak."

# game/telef.rpy:126
translate polish telef_12086626:

    # tel "- И в то же время, если подумать о тепле, я согреваюсь."
    tel "- A jednocześnie, gdy myślę o cieple, robi mi się cieplej."

# game/telef.rpy:129
translate polish telef_94d3c3d2:

    # tel "- Может, этот мир полностью зависит от моих мыслей?"
    tel "- Może ten świat jest całkowicie zależny od moich myśli?"

# game/telef.rpy:132
translate polish telef_f6724c1b:

    # tel "- Не хотелось бы признавать, что я полностью пуста."
    tel "- Nie chcę uwierzyć, że jestem kompletnie pusta."

# game/telef.rpy:135
translate polish telef_3050aa69:

    # tel "- Ведь все исчезло не по моей вине? Да?"
    tel "- To nie była moja wina, że wszystko zniknęło, prawda? Tak?"

# game/telef.rpy:138
translate polish telef_79831019:

    # tel "- Разве я не могу просто приспособиться и привыкнуть к ничему вокруг, раз ничего не могу с этим сделать?"
    tel "- Czy nie mogę się po prostu dostosować i przyzwyczaić do tego, że nic tu nie ma, skoro nie mogę nic z tym zrobić?"

# game/telef.rpy:145
translate polish telef_f2990826:

    # piz "- Вы уже готовы сделать заказ?"
    piz "- Czy są Państwo już gotowi do złożenia zamówienia?"

# game/telef.rpy:147
translate polish telef_eb595c33:

    # tel "- Да. Правильно."
    tel "- Tak. Może coś w tym jest."

# game/telef.rpy:150
translate polish telef_6974591b:

    # tel "- Мне должно быть все равно."
    tel "- Nie powinnam się przejmować."

# game/telef.rpy:153
translate polish telef_00ae3d4b:

    # tel "- Здесь пусто, и мне от этого ни хорошо, ни плохо."
    tel "- Jest tu pusto i nie czuję się z tym ani dobrze, ani źle."

# game/telef.rpy:156
translate polish telef_99292db0:

    # tel "- Я тут одна, и в то же время нет - в голове много мыслей, с которыми уж точно не соскучишься."
    tel "- Jestem tu sama, a jednocześnie nie jestem - w mojej głowie kłębi się mnóstwo myśli, którymi na pewno nie można się nudzić."

# game/telef.rpy:159
translate polish telef_a154ab2e:

    # tel "- С ними можно создать целый мир. Здесь определённо безопасно, и не случится ничего плохого. Как и хорошего, впрочем."
    tel "- Za ich pomocą można stworzyć cały świat. Na pewno jest tu bezpiecznie i nic złego się nie stanie. W sumie nic dobrego też."

# game/telef.rpy:162
translate polish telef_b6b644a9:

    # tel "- Мое пребывание здесь - это пустая трата времени. Я не заполняю пустоту, я - лишь её часть. И это лишает меня всякой надежды на спасение."
    tel "- Moja obecność tutaj to strata czasu. Nie wypełniam pustki, jestem tylko jej częścią. A to pozbawia mnie wszelkiej nadziei na zbawienie."

# game/telef.rpy:165
translate polish telef_6974591b_1:

    # tel "- Мне должно быть все равно."
    tel "- Nie powinnam się przejmować."

# game/telef.rpy:168
translate polish telef_00ae3d4b_1:

    # tel "- Здесь пусто, и мне от этого ни хорошо, ни плохо."
    tel "- Jest tu pusto i nie czuję się z tym ani dobrze, ani źle."

# game/telef.rpy:171
translate polish telef_e2c78ebc:

    # tel "- Никто не виноват, что здесь даже двери не видно. Какой в них смысл вообще?"
    tel "- To niczyja wina, że nie widać nawet drzwi. Jaki jest w ogóle sens ich istnienia?"

# game/telef.rpy:174
translate polish telef_c73a444b:

    # tel "- Кажется, мне совсем не помогают. Им должно быть стыдно."
    tel "- Wydaje się, że w ogóle mi nie pomagają. Powinny się za siebie wstydzić."

# game/telef.rpy:177
translate polish telef_b6ca2f7e:

    # tel "- Не хотелось бы признавать, но я тут одна."
    tel "- Nie chcę uwierzyć, ale jestem tu sama."

# game/telef.rpy:180
translate polish telef_ab7b08f9:

    # tel "- Ничего не могу с этим сделать."
    tel "- Nic nie mogę na to poradzić."

# game/telef.rpy:187
translate polish telef_3e6504e0:

    # piz "- Обратите внимание, что у нас проходит акция - четыре пиццы по цене двух!"
    piz "- Przypominamy, że trwa promocja - cztery pizze w cenie dwóch!"

# game/telef.rpy:189
translate polish telef_b01fcae5:

    # tel "- Мне всё равно, что здесь пусто, слышите?! Да мне от этого ни хорошо, ни плохо!"
    tel "- Nie obchodzi mnie, że tu jest pusto, słyszysz?! To nie jest ani dobre, ani złe dla mnie!"

# game/telef.rpy:192
translate polish telef_d12ea076:

    # tel "- Я одна."
    tel "- Jestem sama."

# game/telef.rpy:195
translate polish telef_3b62ce74:

    # tel "- В моей голове много мыслей, ими я ослепляю мир вокруг."
    tel "- Mam mnóstwo myśli w głowie, którymi zaślepiam sobie świat wokół mnie."

# game/telef.rpy:198
translate polish telef_00952fc2:

    # tel "- Здесь не так много места, но по крайней мере безопасно."
    tel "- Nie ma tu zbyt wiele miejsca, ale przynajmniej jest bezpiecznie."

# game/telef.rpy:201
translate polish telef_a3134265:

    # tel "- Хотя и мне тут никогда не будет хорошо."
    tel "- Chociaż tutaj też nigdy nie będę szczęśliwa."

# game/telef.rpy:204
translate polish telef_c080a9e5:

    # tel "- Значит, моё пребывание здесь - пустая трата времени?"
    tel "- Więc moja obecność tutaj to strata czasu?"

# game/telef.rpy:207
translate polish telef_bb5e0514:

    # tel "- Я должна решить, и мои мысли помогут мне."
    tel "- Muszę się zdecydować, a moje myśli mi w tym pomogą."

# game/telef.rpy:210
translate polish telef_579630b4:

    # tel "- Они направят к выходу... и тогда я смогу собой гордиться."
    tel "- Skierują mnie do wyjścia... i wtedy mogę być z siebie dumna."

# game/telef.rpy:213
translate polish telef_78d815b7:

    # tel "- И тогда я смогу спастись."
    tel "- I wtedy będę mogła być zbawiona."

# game/telef.rpy:216
translate polish telef_08a33cd2_1:

    # tel "- Хотя..."
    tel "- Chociaż..."

# game/telef.rpy:219
translate polish telef_b84fe9f0:

    # tel "- Уже как-то всё равно."
    tel "- Nie dbam już o to."

# game/telef.rpy:222
translate polish telef_00ae3d4b_2:

    # tel "- Здесь пусто, и мне от этого ни хорошо, ни плохо."
    tel "- Jest tu pusto i nie czuję się z tym ani dobrze, ani źle."

# game/telef.rpy:225
translate polish telef_e9a5efe4:

    # tel "- Я одна, а в моей голове много мыслей. Можно сказать, целый мир."
    tel "- Jestem sama i mam mnóstwo myśli w głowie. Można powiedzieć, że cały świat."

# game/telef.rpy:228
translate polish telef_baaec456:

    # tel "- Если очень постараться, он сможет заполнить всю пустоту вокруг!"
    tel "- Jak się postarasz, to wypełni pustkę wokół ciebie!"

# game/telef.rpy:231
translate polish telef_08a33cd2_2:

    # tel "- Хотя..."
    tel "- Chociaż..."

# game/telef.rpy:234
translate polish telef_6bca4e1c:

    # tel "- Сколько бы я ни думала, окружение не менялось. Да, что-то происходило вне моей головы, но..."
    tel "- Bez względu na to, jak dużo myślałam, otoczenie nie zmieniało się. Tak, coś się działo poza moją głową, ale..."

# game/telef.rpy:237
translate polish telef_38f2807a:

    # tel "- Что?"
    tel "- Co?"

# game/telef.rpy:240
translate polish telef_8e61e085:

    # tel "- Моим мыслям не хватает места."
    tel "- Brakuje miejsca na moje własne myśli."

# game/telef.rpy:243
translate polish telef_52047db9:

    # tel "- Оно уже чем-то заполнено..."
    tel "- Moja głowa jest już czymś wypełniona..."

# game/telef.rpy:246
translate polish telef_b7f5fcf1:

    # tel "- Если вокруг ничего нет, здесь есть я."
    tel "- Jeśli nie ma nic w pobliżu, to ja jestem tutaj."

# game/telef.rpy:249
translate polish telef_bd4928d8:

    # tel "- А в моей голове много мыслей."
    tel "- A w mojej głowie kłębi się mnóstwo myśli."

# game/telef.rpy:252
translate polish telef_5f0c56b8:

    # tel "- Если очень постараться..."
    tel "- Jeśli bardzo się postarasz..."

# game/telef.rpy:255
translate polish telef_5804bb80:

    # tel "- ..."
    tel "- ..."

# game/telef.rpy:258
translate polish telef_92e6ca5d:

    # tel "- Значит, мир на самом деле не пустой."
    tel "- Tak więc świat wcale nie jest pusty."

# game/telef.rpy:261
translate polish telef_1aa5a66b:

    # tel "- Я ничего не вижу."
    tel "- Nic nie widzę."

# game/telef.rpy:272
translate polish telef_d1226ccf:

    # piz "- Время истекло, перезагрузите страницу."
    piz "- Czas minął, odśwież stronę."

